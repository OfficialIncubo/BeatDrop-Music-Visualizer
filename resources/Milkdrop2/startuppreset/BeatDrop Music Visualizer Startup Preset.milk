MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=5.000
fGammaAdj=1.000
fDecay=1.000
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=1.000
fWaveSmoothing=0.000
fWaveParam=0.000
fModWaveAlphaStart=1.000
fModWaveAlphaEnd=1.000
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=1.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.500
wave_y=0.500
ob_size=0.000
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.000
ib_r=0.000
ib_g=0.000
ib_b=0.000
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=1.000
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.000
per_frame_init_1=timeQ = 0;
per_frame_init_2=progress_fade_in = 0;
per_frame_init_3=
per_frame_init_4=q1 = int(rand(2)); // Random Peaks toggle
per_frame_init_5=q3 = int(rand(2)); // Random Oscilloscope toggle
per_frame_init_6=q4 = .625; // FFT height
per_frame_1=q2 = bass_att; // Pass bass for logo pulsing
per_frame_2=timeQ += 1/fps;
per_frame_3=q5 = min(timeQ * 1.5, 1);
warp_1=`shader_body
warp_2=`{
warp_3=`    uv = uv_orig;
warp_4=`    float num_bars = 24.0;
warp_5=`    float num_blocks = 32.0;
warp_6=`    float bar_spacing = 0.005;
warp_7=`    float block_spacing = 0.01;
warp_8=`
warp_9=`    float total_unit = 1.0 / num_bars;
warp_10=`    float actual_bar_width = total_unit - bar_spacing;
warp_11=`    float bar_index = floor(uv.x / total_unit);
warp_12=`    float bar_x_start = bar_index * total_unit + bar_spacing * 0.5;
warp_13=`    float bar_x_end = bar_x_start + actual_bar_width;
warp_14=`    float inside_bar = step(bar_x_start, uv.x) * step(uv.x, bar_x_end);
warp_15=`
warp_16=`    // Logarithmic hz mapping: 20 to 15000 Hz
warp_17=`    float ratio = bar_index / (num_bars - 1.0);
warp_18=`    float hz = 20.0 * pow(15000.0/20.0, ratio);
warp_19=`    float fft_val = get_fft_hz(hz) * q4;
warp_20=`    float num_lit_blocks = fft_val * num_blocks;
warp_21=`
warp_22=`    // Mirror Y axis symmetrically: originate at center (0.5), pushing towards edges
warp_23=`    float y_pos = abs(uv.y - 0.5) * 2.0;
warp_24=`
warp_25=`    float block_unit = 1.0 / num_blocks;
warp_26=`    float block_index = floor(y_pos / block_unit);
warp_27=`    float block_y_start = block_index * block_unit + block_spacing * 0.5;
warp_28=`    float block_y_end = block_y_start + (block_unit - block_spacing);
warp_29=`
warp_30=`    float inside_block = step(block_y_start, y_pos) * step(y_pos, block_y_end);
warp_31=`    float block_lit = step(block_index, num_lit_blocks - 1.0);
warp_32=`
warp_33=`    // Calculate peaks (toggled purely by q1)
warp_34=`    float peak_val = get_fft_peak_hz(hz) * q4;
warp_35=`    float peak_block = max(0.0, floor(peak_val * num_blocks - 1.0));
warp_36=`    float is_peak = step(abs(block_index - peak_block), 0.1);
warp_37=`
warp_38=`    float block_active = saturate(block_lit + is_peak * q1);
warp_39=`    float mask = inside_bar * inside_block * block_active;
warp_40=`
warp_41=`    // BeatDrop Gradient (Dark Purple -> Purple -> Violet)
warp_42=`    float height_ratio = block_index / num_blocks;
warp_43=`    float3 c1 = float3(.098, .0, .325); 
warp_44=`    float3 c2 = float3(.2, .016, .627); 
warp_45=`    float3 c3 = float3(.475, .161, .773); 
warp_46=`    float3 c4 = float3(.5, .2, .8); 
warp_47=`
warp_48=`    float3 col1 = lerp(c1, c2, saturate(height_ratio / 0.33));
warp_49=`    float3 col2 = lerp(c2, c3, saturate((height_ratio - 0.33) / 0.33));
warp_50=`    float3 col3 = lerp(c3, c4, saturate((height_ratio - 0.66) / 0.34));
warp_51=`
warp_52=`    float r1 = 1.0 - step(0.33, height_ratio);
warp_53=`    float r2 = step(0.33, height_ratio) * (1.0 - step(0.66, height_ratio));
warp_54=`    float r3 = step(0.66, height_ratio);
warp_55=`
warp_56=`    float3 block_color = col1 * r1 + col2 * r2 + col3 * r3;
warp_57=`    block_color += is_peak * q1 * 0.3; // Visually highlight peaks
warp_58=`
warp_59=`    ret = block_color * mask;
warp_60=`}
comp_1=`#define BeatDrop sampler_fc_BeatDropLogo
comp_2=`sampler BeatDrop;
comp_3=`float4 texsize_BeatDropLogo;
comp_4=`
comp_5=`shader_body
comp_6=`{
comp_7=`    // 1. Fetch Spectrum Background
comp_8=`    float3 ret_bg = tex2D(sampler_main, uv).xyz;
comp_9=`
comp_10=`    // 2. Center Oscilloscope (toggled by q3)
comp_11=`    float wave_val = get_wave(uv.x);
comp_12=`    float wave_y = 0.5 - wave_val * 0.5;
comp_13=`    float dist = abs(uv.y - wave_y);
comp_14=`    float glow = 0.005 / (dist + 0.001);
comp_15=`    float3 wave_col = lerp(float3(.2, .016, .627), float3(.475, .161, .773), uv.x);
comp_16=`    float3 wave_render = wave_col * pow(glow, 1.2) * q3;
comp_17=`
comp_18=`    ret = ret_bg + wave_render;
comp_19=`
comp_20=`    // 3. BeatDrop Logo Layer
comp_21=`    float2 sz = (texsize_BeatDropLogo/texsize).xy + 0.25;
comp_22=`    float2 scale = texsize_BeatDropLogo.zw * texsize.xy * max(sz.x, sz.y) * 1.5;
comp_23=`    float pulse = 1.05 - 0.1 * q2; // Scale responds directly to bass intensity
comp_24=`    float2 uv_logo = (uv - 0.5) * scale * pulse + 0.5;
comp_25=`
comp_26=`    // Bound logic to prevent wrapping
comp_27=`    float inside_logo = step(0.0, uv_logo.x) * step(uv_logo.x, 1.0) * step(0.0, uv_logo.y) * step(uv_logo.y, 1.0);
comp_28=`    float3 logo = tex2D(BeatDrop, uv_logo).xyz;
comp_29=`
comp_30=`    // Chroma Key logic (Extract elements brighter than the dark background)
comp_31=`    float logo_lum = dot(logo, float3(0.33, 0.33, 0.33));
comp_32=`    float alpha = smoothstep(0.02, 0.15, logo_lum) * inside_logo * q5;
comp_33=`
comp_34=`    // Combine final top layer
comp_35=`    ret = lerp(ret, logo, alpha);
comp_36=`}
