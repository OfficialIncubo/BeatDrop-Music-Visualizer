per_frame_init_1=rr = 1;
per_frame_1=warp =0;
per_frame_2=wave_a =0;
per_frame_3=
per_frame_4=tt = tt*.9 + bass_att*.05;
per_frame_5=
per_frame_6=ttt = if(above(tt,1),ttt*.5 + tt,ttt*.1);
per_frame_7=zz = ttt* .005 * ((frame % 2)*2-1);
per_frame_8=
per_frame_9=
per_frame_10=rrr = min(.1, max(.01,rrr*ttt));
per_frame_11=rr = rr + rrr;
per_frame_12=dx = sin(rr) * zz;
per_frame_13=dy = cos(rr) * zz;
per_frame_14=monitor =rrr;
per_pixel_1=
per_pixel_2=v_ang = time+sin(x*(sin(time*.32)*3+4)+y*(sin(time*.42)*3+4));
per_pixel_3=
per_pixel_4=vx = (x-.5)*cos(v_ang) - (y-.5)*sin(v_ang)+.5;
per_pixel_5=vy = (x-.5)*sin(v_ang) +(y-.5)*cos(v_ang)+.5;
per_pixel_6=
per_pixel_7=eff1 = above(vx,sin(time*.5)*.7+.5);
per_pixel_8=eff2 = above(vy,(cos(time*.5)*.6+.5));
per_pixel_9=
per_pixel_10=eff3 = eff1*eff2;       //in both eff1 and eff2
per_pixel_11=eff4 = bnot(eff1+eff2); //neither eff1 not eff2
per_pixel_12=
per_pixel_13=//eff1, eff2, eff3, eff4 are time dependent regions of the screen
per_pixel_14=//Use them below...
per_pixel_15=
per_pixel_16=
per_pixel_17=
per_pixel_18=zoom = (1-.01*eff1+.02*eff2);
per_pixel_19=rot = .01*eff3-.01*eff4;
