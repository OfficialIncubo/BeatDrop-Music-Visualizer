per_frame_1=// *************** Efek warna ***************
per_frame_2=// Kecerahan
per_frame_3=q1 = 0.8;
per_frame_4=q2 = 1.0;
per_frame_5=
per_frame_6=q3 = 1.0; // Menambahkan Merah (Red)
per_frame_7=q4 = 0.5; // Menambahkan Biru (Blue)
per_frame_8=
per_frame_9=// *************** Ukuran piksel ***************
per_frame_10=q5 = 0.022; // Piksel X
per_frame_11=q6 = 0.023; // Piksel Y
per_pixel_1=// Menghitung koordinat dasar yang disesuaikan dengan ukuran piksel layar
per_pixel_2=zz_x = x * pixelsx * q5;
per_pixel_3=zz_y = y * pixelsy * q6;
per_pixel_4=
per_pixel_5=// Menghitung faktor distorsi menggunakan gelombang trigonometri dan variabel Q
per_pixel_6=h1 = cos(zz_y * 0.8) * sin(-zz_y);
per_pixel_7=h2 = sin(zz_x) * cos(zz_y * 0.9);
per_pixel_8=
per_pixel_9=// Mengaplikasikan pergerakan ke variabel dx dan dy
per_pixel_10=// Dibagi dengan pixelsx dan pixelsy sebagai ekuivalen dari texsize.zw (1/texsize.xy)
per_pixel_11=dx = (h1 * 5) / pixelsx;
per_pixel_12=dy = (h2 * 5) / pixelsy;
warp_1=`#define sampler_pic sampler_Image415
warp_2=`sampler2D sampler_pic;
warp_3=`
warp_4=`shader_body
warp_5=`{
warp_6=`    ret = tex2D( sampler_main, uv ).xyz;
warp_7=`
warp_8=`    // ERROR DIFFUSION DITHER - looks great
warp_9=`    float2 dither_uv = uv_orig*texsize.xy*texsize_noise_lq.zw + rand_frame.xy;
warp_10=`    ret += (tex2D(sampler_noise_lq, dither_uv).xyz-0.5)/256.0*1;
warp_11=`
warp_12=`    // mix in img...
warp_13=`    float3 pic = tex2D(sampler_pic, uv_orig*aspect.xy).xyz;
warp_14=`    float lum = lum(pic);
warp_15=`    float use_it = abs(lum*0.8+0.1 - (0.5+roam_cos.y*0.25));
warp_16=`    float LFNoise = tex2D(sampler_noise_lq, uv*0.1 + time*0.01).x*6-2;
warp_17=`    use_it = saturate(1 - use_it*(3+9*rand_preset.x) - LFNoise);
warp_18=`    ret = lerp(ret, pic, use_it.xxx);
warp_19=`
warp_20=`    // darken over time
warp_21=`    //ret -= 0.004;
warp_22=`    //ret *= 0.99;
warp_23=`    ret *= 0.97 + 0.03*saturate( length(uv - uv_orig)*200 );  // center only
warp_24=`}
warp_25=`
comp_1=`shader_body
comp_2=`{
comp_3=`    ret = tex2D(sampler_main, uv).xyz*-2 +
comp_4=`              GetBlur1(uv)*2 +
comp_5=`              GetBlur2(uv)*2 - 0.7;
comp_6=`    
comp_7=`    // 1. Menghitung seberapa gelap warna piksel saat ini
comp_8=`    // length(ret) menghasilkan 0 jika hitam pekat, dan makin besar jika terang.
comp_9=`    // clamp(1.0 - length, 0, 1) akan bernilai 1 di area hitam, dan 0 di area terang.
comp_10=`   float darkness = clamp(1.0 - length(ret), q1, q2);
comp_11=`    
comp_12=`   // 2. Menambahkan warna ungu (Merah + Biru) khusus pada area gelap
comp_13=`   // Kamu bisa mengubah angka 0.8 untuk mengatur seberapa terang ungunya
comp_14=`   ret.x += darkness * q3;
comp_15=`   ret.z += darkness * q4;
comp_16=`
comp_17=`}
