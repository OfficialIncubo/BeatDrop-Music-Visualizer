###################################################################################################

MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5.000
fGammaAdj=1.900
fDecay=0.970
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=1
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=1.000
fWaveSmoothing=0.630
fWaveParam=-1.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.331
fZoomExponent=1.00000
fShader=0.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=1.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_init_1=q1=0.0;
per_frame_init_2=q2=40.0;
per_frame_init_3=q5=0.0;
per_frame_init_4=q6=0.0;
per_frame_init_5=time_delay=0.0;
per_frame_init_6=rand_laser=rand(140);
per_frame_init_7=temp1 = 0;
per_frame_init_8=temp2 = 0;
per_frame_1=// SKELETON (kept intact, medium retrigger; ring spawn rate also follows bass independently)
per_frame_2=time_delay = if(time_delay >= .30 && bass > 2, 0, time_delay += 1/fps);
per_frame_3=rand_laser = if(time_delay == 0, rand(140), rand_laser);
per_frame_4=
per_frame_5=// Custom variable mapping to feed the Comp Shader
per_frame_6=q1 = rand_laser;                          // color palette seed
per_frame_7=q2 = time_delay;                          // beat clock (0 = beat), drives the center flare
per_frame_8=temp1 += (0.45 + bass_att*0.6)/fps;       // ring expansion master clock (continuous, never resets)
per_frame_9=temp2 += (0.3 + treb_att*0.3)/fps;        // spoke shimmer rotation clock
per_frame_10=q3 = temp1;
per_frame_11=q4 = temp2;
per_frame_12=q6 = 0.5 + 0.5*sin(time*0.3 + rand_laser*0.04); // slow color drift phase
warp_1=`shader_body {}
comp_1=`shader_body
comp_2=`{
comp_3=`    float aspect = texsize.x * texsize.z;
comp_4=`    float2 center = float2(0.5, 0.5);
comp_5=`    float2 p = uv - center;
comp_6=`    p.x *= aspect;
comp_7=`    float r = length(p);
comp_8=`    float a = atan2(p.y, p.x);
comp_9=`
comp_10=`    float col_sel = fmod(q1 * 2.2, 4.0);
comp_11=`    float3 col1, col2;
comp_12=`    if (col_sel < 1.0) { col1 = float3(0.0, 0.9, 1.0); col2 = float3(1.0, 1.0, 1.0); }
comp_13=`    else if (col_sel < 2.0) { col1 = float3(1.0, 0.2, 0.0); col2 = float3(1.0, 0.8, 0.0); }
comp_14=`    else if (col_sel < 3.0) { col1 = float3(0.7, 0.0, 1.0); col2 = float3(0.0, 1.0, 0.5); }
comp_15=`    else { col1 = float3(1.0, 0.3, 0.6); col2 = float3(0.3, 0.7, 1.0); }
comp_16=`
comp_17=`    float beat_strike = exp(-q2 * 4.0);
comp_18=`
comp_19=`    // 1. SHOCKWAVE RINGS
comp_20=`    // On every beat retrigger, a new expanding ring is spawned (tracked via its
comp_21=`    // birth time relative to q3, the master beat-cycle clock) and grows outward
comp_22=`    // until it fades past the frame edge. Several rings can be in flight at
comp_23=`    // once since each is keyed to its own spawn offset.
comp_24=`    float3 lasers = float3(0,0,0);
comp_25=`    int RINGS = 4;
comp_26=`    for (int i = 0; i < RINGS; i++) {
comp_27=`        float spawn_offset = float(i) * 0.33;
comp_28=`        float age = fmod(q3 + spawn_offset, 1.0); // 0 = just spawned, 1 = fully expanded/faded
comp_29=`        float ring_r = age * 0.85;
comp_30=`        float d = abs(r - ring_r);
comp_31=`        float thickness = 0.006 + age*0.01;
comp_32=`        float core = exp(-pow(d/thickness, 2.0));
comp_33=`        float glow = exp(-pow(d/(thickness*6.0), 2.0)) * 0.4;
comp_34=`        float fade = smoothstep(1.0, 0.7, age) * smoothstep(0.0, 0.08, age);
comp_35=`        float3 col = lerp(col1, col2, age);
comp_36=`        lasers += col * (core + glow) * fade * 1.3;
comp_37=`    }
comp_38=`
comp_39=`    // 2. Radial spoke shimmer riding each ring, like laser refraction on the wavefront
comp_40=`    float spokes = 0.5 + 0.5*sin(a*16.0 + q4);
comp_41=`    lasers *= (0.7 + 0.3*spokes);
comp_42=`
comp_43=`    // 3. Smoke from MilkDrop's blur buffer
comp_44=`    float3 smoke = GetBlur2(uv).rgb * 0.55;
comp_45=`    float3 bg = smoke * col1 * 0.12;
comp_46=`
comp_47=`    // 4. Center burst flare exactly on the beat (the moment of impact)
comp_48=`    float core_flare = exp(-r * 8.0) * (0.3 + beat_strike * 1.8);
comp_49=`    lasers += lerp(col1,col2,0.5) * core_flare;
comp_50=`
comp_51=`    // 5. Smooth non-seizure breathing
comp_52=`    float breathe = 0.82 + 0.18*sin(time*0.5 + q6*3.14159);
comp_53=`
comp_54=`    float3 final_rgb = (lasers + bg) * breathe;
comp_55=`    ret = final_rgb;
comp_56=`}
