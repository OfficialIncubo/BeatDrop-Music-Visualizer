###################################################################################################

MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5.000
fGammaAdj=1.880
fDecay=0.970
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=1
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=1.000
fWaveSmoothing=0.630
fWaveParam=-1.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.331
fZoomExponent=1.00000
fShader=0.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=1.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_init_1=q1=0.0;
per_frame_init_2=q2=40.0;
per_frame_init_3=q5=0.0;
per_frame_init_4=q6=0.0;
per_frame_init_5=time_delay=0.0;
per_frame_init_6=rand_laser=rand(120);
per_frame_init_7=temp1 = 0;
per_frame_init_8=temp2 = 0;
per_frame_1=// SKELETON (kept intact, medium-slow retrigger fits the hypnotic figure-8 pacing)
per_frame_2=time_delay = if(time_delay >= .40 && bass > 2, 0, time_delay += 1/fps);
per_frame_3=rand_laser = if(time_delay == 0, rand(120), rand_laser);
per_frame_4=
per_frame_5=// Custom variable mapping to feed the Comp Shader
per_frame_6=q1 = rand_laser;                          // color palette seed
per_frame_7=q2 = time_delay;                          // beat clock (0 = beat)
per_frame_8=temp1 += (0.55 + mid_att*0.35)/fps;       // figure-8 phase clock (never resets, traces the loop)
per_frame_9=temp2 += (0.08 + treb_att*0.10)/fps;      // slow scale-wobble clock
per_frame_10=q3 = temp1;
per_frame_11=q4 = temp2;
per_frame_12=q6 = 0.5 + 0.5*sin(time*0.25 + rand_laser*0.04); // slow color drift phase
per_frame_13=warp = 0;
warp_1=`sampler sampler_rand00;
warp_2=`
warp_3=`shader_body {
warp_4=`    ret = (tex2d(sampler_rand00, uv).xyz) * (.5 + sin(time*2)/2 );
warp_5=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float aspect = texsize.x * texsize.z;
comp_4=`    float2 center = float2(0.5, 0.5);
comp_5=`    float2 p = uv - center;
comp_6=`    p.x *= aspect;
comp_7=`
comp_8=`    float col_sel = fmod(q1 * 1.6, 4.0);
comp_9=`    float3 col1, col2;
comp_10=`    if (col_sel < 1.0) { col1 = float3(0.0, 1.0, 0.8); col2 = float3(1.0, 0.0, 0.5); }
comp_11=`    else if (col_sel < 2.0) { col1 = float3(1.0, 0.7, 0.0); col2 = float3(0.6, 0.0, 1.0); }
comp_12=`    else if (col_sel < 3.0) { col1 = float3(0.2, 0.6, 1.0); col2 = float3(1.0, 1.0, 0.2); }
comp_13=`    else { col1 = float3(1.0, 1.0, 1.0); col2 = float3(1.0, 0.2, 0.2); }
comp_14=`
comp_15=`    float beat_strike = exp(-q2 * 4.0);
comp_16=`
comp_17=`    // 1. FIGURE-8 TRACE
comp_18=`    // A bright point endpoint follows a Lissajous/figure-8 path (x = sin(t),
comp_19=`    // y = sin(2t)) and drags a fading trail behind it, like a single laser
comp_20=`    // pointer being moved by hand in a hypnotic figure-8 pattern. The trail is
comp_21=`    // built from several lagged samples of the same curve rather than a
comp_22=`    // straight beam, since the path itself is the "beam".
comp_23=`    float3 lasers = float3(0,0,0);
comp_24=`    float scale = 0.32 + 0.04*sin(q4);
comp_25=`    int TRAIL = 24;
comp_26=`    for (int i = 0; i < TRAIL; i++) {
comp_27=`        float lag = float(i) * 0.075;
comp_28=`        float t = q3 - lag;
comp_29=`        float2 curve_p = float2(sin(2*t), sin(3*t + 1.5708)) * scale;
comp_30=`
comp_31=`        float d = length(p - curve_p);
comp_32=`        float w = 1.0 - (float(i)/float(TRAIL)); // newer samples brighter
comp_33=`        float core = exp(-pow(d/0.010, 2.0)) * w;
comp_34=`        float glow = exp(-pow(d/0.045, 2.0)) * 0.35 * w;
comp_35=`
comp_36=`        float3 col = lerp(col1, col2, w*0.5 + 0.5*sin(t*0.5));
comp_37=`        lasers += col * (core + glow);
comp_38=`    }
comp_39=`
comp_40=`    // 2. Bright leading dot at the very head of the trace, flares on beat
comp_41=`    float2 head_p = float2(sin(2*q3), sin(3*q3 + 1.5708)) * scale;
comp_42=`    float head = exp(-length(p-head_p)*55.0) * (1.0 + beat_strike*2.0);
comp_43=`    lasers += lerp(col1,col2,0.5) * head * 1.4;
comp_44=`
comp_45=`    // 3. Faint static guide showing the full figure-8 path, very subtle
comp_46=`    float2 dir_guide = float2(cos(q3*3.0), sin(q3*3.0));
comp_47=`    float guide = 0.0;
comp_48=`    // cheap path proximity test via a few fixed phase samples around the loop
comp_49=`    for (int g = 0; g < 8; g++) {
comp_50=`        float gt = float(g) * 0.7853981;
comp_51=`        float2 gp = float2(sin(2*gt), sin(3*gt+1.5708)) * scale;
comp_52=`        guide += exp(-length(p-gp)*18.0) * 0.06;
comp_53=`    }
comp_54=`    lasers += lerp(col1,col2,0.3) * guide;
comp_55=`
comp_56=`    // 4. Smoke from MilkDrop's blur buffer
comp_57=`    float3 smoke = GetBlur2(uv).rgb;
comp_58=`    float3 bg = smoke * col2 * 0.13;
comp_59=`
comp_60=`    // 5. Smooth non-seizure breathing
comp_61=`    float breathe = 0.82 + 0.18*sin(time*0.4 + q6*M_PI);
comp_62=`
comp_63=`    float3 final_rgb = (lasers + bg) * breathe;
comp_64=`    ret = final_rgb;
comp_65=`}
