per_frame_init_1=tp=0;tb=0;P=0.47;rot=0;rt=0;env=0;spin=0;scr=0;sm1=0;sm2=0;sm3=0;bm=1;bd=0.3;
per_frame_1=dt=min(max(time-tp,0.004),0.1);tp=time;bm = bm + (bass-bm)*(1-exp(-dt/0.8));bd = bd + (abs(bass-bm)-bd)*(1-exp(-dt/2.5));
per_frame_2=beat=above((bass-bm)/max(bd,0.1),1.3)*above(time-tb,0.3);
per_frame_3=beat=max(beat,above(time-tb,1.2));
per_frame_4=P=if(beat,min(max(0.5*P+0.5*(time-tb),0.3),0.9),P);
per_frame_5=tb=if(beat,time,tb);
per_frame_6=rt=rt+beat*0.5236+dt*0.03;
per_frame_7=rot=rot+(rt-rot)*(1-exp(-dt*11));
per_frame_8=env=if(beat,1,env*exp(-dt*4.5));
per_frame_9=spin=spin+dt*(0.12+0.22*mid_att);
per_frame_10=scr=scr+dt*(0.45+0.35*bass_att);
per_frame_11=sm1=sm1+(bass_att-sm1)*(1-exp(-dt*3));
per_frame_12=sm2=sm2+(treb_att-sm2)*(1-exp(-dt*3));
per_frame_13=sm3=sm3+(mid_att-sm3)*(1-exp(-dt*3));
per_frame_14=q1=rot;q2=env;q3=time-tb;q4=P;q5=spin;
per_frame_15=q6=0.109*(1+0.045*env+0.012*sin(time*0.6));
per_frame_16=q7=sm2;q8=sm3;q9=sm1;q10=time*0.05;
per_frame_17=q11=0.5625;q12=0.56;q13=scr;q14=0.5+(q12-0.5)*q11;
per_frame_18=zoom=1+(0.004+0.012*env)*60*dt;rot=0;cx=0.5;cy=1-q12;
per_frame_19=echo=0;
warp_1=`shader_body
warp_2=`{
warp_3=`  float2 d = texsize.zw;
warp_4=`  float3 c = tex2D(sampler_main, uv).xyz;
warp_5=`  float3 n = tex2D(sampler_main, uv + float2(d.x,0)*1.5).xyz + tex2D(sampler_main, uv - float2(d.x,0)*1.5).xyz;
warp_6=`  n += tex2D(sampler_main, uv + float2(0,d.y)*1.5).xyz + tex2D(sampler_main, uv - float2(0,d.y)*1.5).xyz;
warp_7=`  ret = lerp(c, n*0.25, 0.16);
warp_8=`  ret *= float3(0.60, 0.58, 0.66);
warp_9=`  ret = max(ret - 0.004, float3(0,0,0));
warp_10=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float asp = texsize.x*texsize.w;
comp_4=`  float hz = 0.62;
comp_5=`  float2 sc = float2(0.5, 1.0-q12);
comp_6=`  float2 pc = (uv - sc)*float2(asp,1);
comp_7=`  // sky
comp_8=`  float t = saturate((hz-uv.y)/hz);
comp_9=`  float3 sky = lerp(float3(0.42,0.04,0.38), float3(0.03,0.0,0.12), pow(t,0.55));
comp_10=`  // stars
comp_11=`  float2 cell = floor(uv*float2(asp,1)*70.0);
comp_12=`  float h = frac(sin(dot(cell, float2(12.9898,78.233)))*43758.5453);
comp_13=`  float2 cf = frac(uv*float2(asp,1)*70.0)-0.5;
comp_14=`  float star = step(0.97,h)*smoothstep(0.22,0.0,length(cf))*(0.5+0.5*sin(time*2+h*40));
comp_15=`  sky += star*float3(0.8,0.8,1.0)*t;
comp_16=`  // striped sun
comp_17=`  float dist = length(pc);
comp_18=`  float disc = smoothstep(0.402,0.396,dist);
comp_19=`  float sy = (uv.y-0.30)*16.0;
comp_20=`  float bars = smoothstep(0.0,0.25,frac(sy)-(uv.y-0.30)*1.9);
comp_21=`  bars = lerp(1.0, bars, smoothstep(0.30,0.5,uv.y));
comp_22=`  float3 sun = lerp(float3(1.0,0.45,0.35), float3(0.75,0.06,0.6), saturate((uv.y-0.1)/0.5));
comp_23=`  sky = lerp(sky, sun*0.28*(0.8+0.4*q2), disc*bars);
comp_24=`  // floor
comp_25=`  float dy = max(uv.y-hz, 0.0005);
comp_26=`  float dep = 1.0/dy;
comp_27=`  float gx = (uv.x-0.5)*asp*dep*0.5;
comp_28=`  float gz = dep*0.35 + q13;
comp_29=`  float fx = abs(frac(gx)-0.5);
comp_30=`  float fz = abs(frac(gz)-0.5);
comp_31=`  float wx = 0.022;
comp_32=`  float wz = 0.05 + 0.02*q2;
comp_33=`  float lx = smoothstep(0.5-wx,0.5,fx) + 0.25*smoothstep(0.5-wx*5,0.5,fx);
comp_34=`  float lz = smoothstep(0.5-wz,0.5,fz) + 0.25*smoothstep(0.5-wz*5,0.5,fz);
comp_35=`  float fade = smoothstep(0.02,0.2,dy);
comp_36=`  float3 gc = lerp(float3(1.0,0.12,0.75), float3(0.25,0.55,1.0), saturate(dy*2.2));
comp_37=`  float3 flr = lerp(float3(0.30,0.02,0.33), float3(0.02,0.0,0.07), saturate(dy*2.5));
comp_38=`  flr += (float3(0.15,0.65,1.0)*lx + float3(1.0,0.12,0.7)*lz)*fade*(0.75+0.7*q2);
comp_39=`  float below = step(hz, uv.y);
comp_40=`  float3 bg = lerp(sky, flr, below);
comp_41=`  bg += float3(1.0,0.2,0.7)*exp(-abs(uv.y-hz)*70.0)*0.6;
comp_42=`  // line art layer with chroma split + bloom
comp_43=`  float2 sh = (uv-0.5)*0.006;
comp_44=`  float3 m = float3(tex2D(sampler_main, uv+sh).x, tex2D(sampler_main, uv).y, tex2D(sampler_main, uv-sh).z);
comp_45=`  float3 bl = GetBlur1(uv)*1.0 + GetBlur2(uv)*0.45;
comp_46=`  float th = 0.3*sin(time*0.17+1.0);
comp_47=`  float3 kk = float3(0.57735,0.57735,0.57735);
comp_48=`  m = m*cos(th) + cross(kk,m)*sin(th) + kk*dot(kk,m)*(1.0-cos(th));
comp_49=`  bl = bl*cos(th) + cross(kk,bl)*sin(th) + kk*dot(kk,bl)*(1.0-cos(th));
comp_50=`  ret = bg*(1.0-saturate(lum(m)*0.6)) + m*1.25 + bl*0.42;
comp_51=`  ret = ret/(1.0+ret*0.18);
comp_52=`  float2 vc = uv-0.5;
comp_53=`  ret *= 1.0 - dot(vc,vc)*1.1;
comp_54=`  ret = pow(saturate(ret), float3(0.95,0.97,0.93));
comp_55=`}
