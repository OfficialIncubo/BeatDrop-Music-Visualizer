per_frame_1=warp = 0;
per_frame_2=zoom = 1;
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    float ret2 = tex2D( sampler_main, uv).xyz;
warp_6=`    ret = lerp(ret,ret2,ret*.2); 
warp_7=`    // darken (decay) over time
warp_8=`    ret *= .999;
warp_9=`    ret -= .002;
warp_10=`}
comp_1=`shader_body {
comp_2=`    float2 uv_base = uv;
comp_3=`    float wall_start = 0.45 + (bass_att * 0.02);
comp_4=`    float3 final_color = float3(0.0, 0.0, 0.0);
comp_5=`
comp_6=`    float wall_x = (uv_base.x - wall_start) / (1.0 + 0.1 * sin(time * 0.145) - wall_start);
comp_7=`    float z_depth = 1.0 / (max(0.001, 1.0 - wall_x));
comp_8=`    float wall_y = (uv_base.y - 0.5) * z_depth + 0.5;
comp_9=`
comp_10=`    float2 grid_uv;
comp_11=`    grid_uv.x = (z_depth - 1.0 + time * (0.66 + (q6 * 0.00001))) * 0.5;
comp_12=`    grid_uv.y = wall_y + (q7 * 0.02) + sin(time * 0.2);
comp_13=`
comp_14=`    float extrude_strength = 0.22 + (0.1 * mid_att);
comp_15=`    float2 view_dir = float2(0.35, (uv_base.y - 0.5) * 0.8) * extrude_strength;
comp_16=`
comp_17=`    float2 curr_uv = grid_uv;
comp_18=`    float layer_depth = 1.0;
comp_19=`    float step_size = 1.0 / 24.0;
comp_20=`    float hit_height = 0.0;
comp_21=`    float is_side_wall = 0.0;
comp_22=`
comp_23=`    float block_scale = 5;
comp_24=`
comp_25=`    for (int i = 0; i < 24; i++) {
comp_26=`        if (layer_depth > hit_height) {
comp_27=`            float2 cell_id = floor(curr_uv * block_scale);
comp_28=`            float rand_h = frac(sin(dot(cell_id, float2(12.9898, 78.233))) * 43758.5453);
comp_29=`            hit_height = rand_h * saturate(0.65 + treb_att * 0.25);
comp_30=`
comp_31=`            if (layer_depth > hit_height) {
comp_32=`                curr_uv += view_dir * step_size;
comp_33=`                layer_depth -= step_size;
comp_34=`                is_side_wall = 1.0;
comp_35=`            }
comp_36=`        }
comp_37=`    }
comp_38=`
comp_39=`    float screen_tile_scale = 1.75;
comp_40=`    float2 uv_wall = frac(curr_uv * screen_tile_scale);
comp_41=`
comp_42=`    float fog_factor = pow(saturate(1.0 - wall_x), 2.2 + abs(mid_att - 1.0) * 0.15);
comp_43=`
comp_44=`    float3 sharp_tex = tex2D(sampler_main, uv_wall).xyz;
comp_45=`    float3 med_blur  = GetBlur1(uv_wall);
comp_46=`    float3 heavy_blur = GetBlur3(uv_wall);
comp_47=`
comp_48=`    float blur_mix = 1.0 - fog_factor;
comp_49=`    float3 wall_tex = lerp(sharp_tex, med_blur, smoothstep(0.0, 0.5, blur_mix));
comp_50=`    wall_tex = lerp(wall_tex, heavy_blur, smoothstep(0.4, 1.0, blur_mix));
comp_51=`
comp_52=`    float side_shade = lerp(1.0, 0.5, is_side_wall);
comp_53=`    float depth_ao = 0.65 + 0.35 * hit_height;
comp_54=`
comp_55=`    float2 cell_uv = frac(curr_uv * block_scale);
comp_56=`    float2 dist_to_edge = min(cell_uv, 1.0 - cell_uv);
comp_57=`    float min_edge_dist = min(dist_to_edge.x, dist_to_edge.y);
comp_58=`
comp_59=`    float edge_width = 0.02 + blur_mix * 0.08;
comp_60=`    float edge_glow = smoothstep(edge_width, 0.0, min_edge_dist) * fog_factor;
comp_61=`    float3 glow_color = (wall_tex + float3(0.15, 0.35, 0.5)) * edge_glow * (0.2 + treb_att * 0.1);
comp_62=`
comp_63=`    final_color = ((wall_tex * side_shade * depth_ao) + glow_color * 0.25) * fog_factor;
comp_64=`
comp_65=`    ret = final_color;
comp_66=`    ret *= 4.50; // gamma
comp_67=`    ret -= abs((ret-1)*.03);
comp_68=`}
