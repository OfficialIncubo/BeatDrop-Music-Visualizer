shapecode_3_g2=1.000
shapecode_3_b2=0.000
shapecode_3_a2=0.000
shapecode_3_border_r=1.000
shapecode_3_border_g=1.000
shapecode_3_border_b=1.000
shapecode_3_border_a=0.100
per_frame_1=
per_frame_2=//zoom = 0.99;
per_frame_3=ib_r = sin(time*1.25*4)*0.3+0.7;
per_frame_4=ib_g = sin(time*4)*0.3+0.3;
per_frame_5=ib_b = sin(time/3*4)*0.5+0.5;
per_frame_6=wave_r = 1- ib_r;
per_frame_7=wave_g = 1- ib_g;
per_frame_8=wave_b = 1- ib_b;
per_frame_9=//wave_mystery = -1+bass/2;
per_frame_10=wave_x = 0.5+sin(time*3)*0.3;
per_frame_11=wave_y = 0.5+cos(time*2.187)*0.3;
per_pixel_1=r = bass/4;
per_pixel_2=cx1 = 0.5+sin(time*0.618)*0.2;
per_pixel_3=cy1 = 0.5+cos(time*1.618)*0.2;
per_pixel_4=d = sqrt((x-cx1)*(x-cx1)+(y-cy1)*(y-cy1));
per_pixel_5=dir = (bass)*(r*r-d*d)*0.3;
per_pixel_6=x1 = if( above(d,r),0,  sin(y-cy1)*dir);
per_pixel_7=y1 = if( above(d,r),0, -sin(x-cx1)*dir);
per_pixel_8=
per_pixel_9=
per_pixel_10=cx1 = 0.5+sin(time*2.618)*0.3;
per_pixel_11=cy1 = 0.5+cos(time*3.14)*0.3;
per_pixel_12=d = sqrt((x-cx1)*(x-cx1)+(y-cy1)*(y-cy1));
per_pixel_13=dir = -(mid)*(r*r-d*d)*0.3;
per_pixel_14=x2 = if( above(d,r),0,  sin(y-cy1)*dir);
per_pixel_15=y2 = if( above(d,r),0, -sin(x-cx1)*dir);
per_pixel_16=
per_pixel_17=cx1 = 0.5+sin(-time*2.618)*0.4;
per_pixel_18=cy1 = 0.5+cos(-time*1.14)*0.4;
per_pixel_19=d = sqrt((x-cx1)*(x-cx1)+(y-cy1)*(y-cy1));
per_pixel_20=dir = -(treb)*(r*r-d*d)*0.3;
per_pixel_21=x3 = if( above(d,r),0,  sin(y-cy1)*dir);
per_pixel_22=y3 = if( above(d,r),0, -sin(x-cx1)*dir);
per_pixel_23=
per_pixel_24=
per_pixel_25=dx = x1+x2+x3;
per_pixel_26=dy = y1+y2+y3;
warp_1=`shader_body
warp_2=`{
warp_3=`
warp_4=`    float2 dither_uv = uv_orig*texsize.xy*texsize_noise_lq.zw*2 + rand_frame.xy;
warp_5=`    uv+= (tex2D(sampler_noise_lq, dither_uv).xy-0.5)*texsize.zw;
warp_6=`
warp_7=`    // PAINTERLY EFFECT:
warp_8=`    float2 t = -0.004 + 0.04*saturate(float2(bass,treb)-1);
warp_9=`    float2 uv2 = uv;
warp_10=`    float2 delta2 = texsize.zw*float2(1,1);
warp_11=`    float3 blurry_color = tex2D( sampler_main, 
warp_12=`        lerp(uv,uv_orig,-1) + delta2 ).xyz;
warp_13=`    uv2.xy += (blurry_color.xy-0.4) * t;
warp_14=`    //uv2.xy -= (blurry_color.zx-0.37) * s;
warp_15=`
warp_16=`    // sample previous frame
warp_17=`    ret = tex2D( sampler_main, uv2 ).xyz;
warp_18=`
warp_19=`    // darken over time
warp_20=`    ret -= 0.0008 + (tex2D(sampler_noise_lq, dither_uv)-0.5)*0.02;    
warp_21=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float2 uv_adj = uv - 0.5;
comp_4=`    float2 eps = texsize.zw * 1.5;
comp_5=`
comp_6=`    // 1. Generate surface normal from the frame buffer
comp_7=`    float h = length(GetPixel(uv));
comp_8=`    float h_r = length(GetPixel(uv + float2(eps.x, 0)));
comp_9=`    float h_l = length(GetPixel(uv - float2(eps.x, 0)));
comp_10=`    float h_u = length(GetPixel(uv + float2(0, eps.y)));
comp_11=`    float h_d = length(GetPixel(uv - float2(0, eps.y)));
comp_12=`    
comp_13=`    // Z-depth of normal controls how much the lasers "bend" over the shapes
comp_14=`    float3 N = normalize(float3(h_l - h_r, h_d - h_u, 0.25));
comp_15=`
comp_16=`    // 2. Distort the laser path using the surface normal 
comp_17=`    float2 l_uv = uv_adj + N.xy * 0.15;
comp_18=`
comp_19=`    // 3. Epic Party Laser Generators
comp_20=`    // Volumetric beam math: 1.0 / abs(distance) gives a bright core with soft glowing edges
comp_21=`    
comp_22=`    // Laser Beam 1 (Wide, sweeping master beam)
comp_23=`    float a1 = time * 0.8;
comp_24=`    float2 d1 = float2(cos(a1), sin(a1));
comp_25=`    float w1 = dot(l_uv, d1) + sin(time * 1.3) * 0.4;
comp_26=`    float b1 = 0.008 / (abs(w1) + 0.002);
comp_27=`    float3 c1 = saturate(abs(frac(time * 0.2 + h * 0.2 + float3(1.0, 0.66, 0.33)) * 6.0 - 3.0) - 1.0);
comp_28=`
comp_29=`    // Laser Beam 2 (Counter-rotating, aggressive sweep)
comp_30=`    float a2 = -time * 1.1 + 2.0;
comp_31=`    float2 d2 = float2(cos(a2), sin(a2));
comp_32=`    float w2 = dot(l_uv, d2) + cos(time * 0.9) * 0.3;
comp_33=`    float b2 = 0.006 / (abs(w2) + 0.0015);
comp_34=`    float3 c2 = saturate(abs(frac(time * 0.35 + 0.5 + h * 0.3 + float3(1.0, 0.66, 0.33)) * 6.0 - 3.0) - 1.0);
comp_35=`
comp_36=`    // Laser Beam 3 (Fast, erratic strobe beam)
comp_37=`    float a3 = time * 2.5 + sin(time * 0.5);
comp_38=`    float2 d3 = float2(cos(a3), sin(a3));
comp_39=`    float w3 = dot(l_uv, d3) + sin(time * 3.1) * 0.2;
comp_40=`    float b3 = 0.004 / (abs(w3) + 0.001);
comp_41=`    float3 c3 = saturate(abs(frac(time * 0.5 + 0.8 + float3(1.0, 0.66, 0.33)) * 6.0 - 3.0) - 1.0);
comp_42=`
comp_43=`    // Combine lasers and multiply by a vignette to fade them into the darkness at the edges
comp_44=`    float3 lasers = (b1 * c1 * 1.5) + (b2 * c2 * 2.0) + (b3 * c3 * 2.5);
comp_45=`    float vignette = smoothstep(0.8, 0.1, length(uv_adj));
comp_46=`    lasers *= vignette;
comp_47=`
comp_48=`    // 4. Background and Surface Illumination
comp_49=`    // Deep club-room black/purple background driven by audio height
comp_50=`    float3 bg = h * float3(0.01, 0.005, 0.02);
comp_51=`    
comp_52=`    // Add ambient specular reflection from the lasers onto the 3D surface
comp_53=`    float3 ambient_glow = max(0, dot(N, float3(0, 0, 1))) * lasers * 0.4;
comp_54=`
comp_55=`    float3 col = bg + lasers + ambient_glow;
comp_56=`
comp_57=`    // 5. ACES Tonemapping 
comp_58=`    // Crucial for lasers: keeps the centers white-hot while preserving intense neon colors on the glow
comp_59=`    col = saturate((col * (2.51 * col + 0.03)) / (col * (2.43 * col + 0.59) + 0.14));
comp_60=`
comp_61=`    ret = col;
comp_62=`}