wave_0_per_point33=f3 = sin(q2*0.1 + 1.5707);
wave_0_per_point34=f4 = sin(q2*0.1 + 3.14);
wave_0_per_point35=
wave_0_per_point36=//take only values above zero
wave_0_per_point37=f1 = f1*above(f1,0);
wave_0_per_point38=f2 = f2*above(f2,0);
wave_0_per_point39=f3 = f3*above(f3,0);
wave_0_per_point40=f4 = f4*above(f4,0);
wave_0_per_point41=
wave_0_per_point42=//set shape activation
