shape_3_init1=t1 = int(rand(100))*0.01;
shape_3_init2=t2 = int(rand(100))*0.01;
shape_3_per_frame1=x = x + 0.07*sin(q1*0.15+3);
shape_3_per_frame2=y = y + 0.03*sin(q1*0.19+1);
shape_3_per_frame3=tex_ang = q1*(0.01 + 0.0001*t1);
shape_3_per_frame4=r = min(1,max(0,r + 0.01*sin(time*0.0417 + 1)));
shape_3_per_frame5=g = min(1,max(0,g + 0.01*sin(time*0.391 + 2)));
shape_3_per_frame6=b = min(1,max(0,b + 0.01*sin(time*0.432 + 4)));
shape_3_per_frame7=r2 = min(1,max(0,r2 + 0.01*sin(time*0.457 + 3)));
shape_3_per_frame8=g2 = min(1,max(0,g2 + 0.01*sin(time*0.0437 + 5)));
shape_3_per_frame9=b2 = min(1,max(0,b2 + 0.01*sin(time*0.484 + 6)));
per_frame_init_1=bassc  = 0;
per_frame_init_2=midc   = 0;
per_frame_init_3=mcount = 0;
per_frame_init_4=bcount = 0;
per_frame_init_5=q11    = 0;
per_frame_1=decay    = 0.9;
per_frame_2=warp     = 0;
per_frame_3=bassc    = if(above(bass, bassc), bassc + bass* 0.07, bassc - 0.03);
per_frame_4=midc     = if(above(mid,  midc),  midc  + mid * 0.07, midc  - 0.03);
per_frame_5=q1       = bassc;
per_frame_6=q2       = midc;
per_frame_7=ra       = 10;
per_frame_8=treb_avg = tic * (treb_avg * (1 / tic - ra) + ra * treb);
per_frame_9=mid_avg  = tic * (mid_avg  * (1 / tic - ra) + ra * mid);
per_frame_10=bass_avg = tic * (bass_avg * (1 / tic - ra) + ra * bass);
per_frame_11=vav      = tic * (vav      * (1 / tic - ra) + ra * (bass + treb + mid) * 0.33333);
per_frame_12=wave_r   = wave_r + 0.2 * sin(time * 0.111);
per_frame_13=wave_g   = wave_g + 0.2 * sin(time * 0.344);
per_frame_14=wave_b   = wave_b + 0.2 * sin(time * 0.222);
per_frame_15=q11     += bass;
per_pixel_1=zoom = pow(rad,2.34);
warp_1=`shader_body
warp_2=`
warp_3=`{
warp_4=`
warp_5=`    float2 d            = texsize.zw * 4;
warp_6=`    float3 dx           = (GetBlur1(uv + float2(1,0)*d) - GetBlur1(uv-float2(1,0)*d));
warp_7=`    float3 dy           = (GetBlur1(uv + float2(0,1)*d) - GetBlur1(uv-float2(0,1)*d));
warp_8=`    float2 dither_uv    = uv_orig * texsize.xy*texsize_noise_lq.zw * 1.2 + rand_frame.xy;
warp_9=`    float2 my_uv        =  lerp(uv_orig, uv, 2) ;
warp_10=`    float2 uv_x         = my_uv + float2(dx.x, dy.x) * texsize.zw * 8;
warp_11=`    float2 uv_y         = my_uv + float2(dx.y, dy.y) * texsize.zw * 8;
warp_12=`    float2 uv_z         = my_uv + float2(dx.z, dy.z) * texsize.zw * 8;
warp_13=`    ret.x               = GetPixel(uv_x).x - (GetPixel(uv_x) - GetBlur3(uv_x)).x  * 0.02;
warp_14=`    ret.y               = GetPixel(uv_y).y - (GetPixel(uv_y) - GetBlur3(uv_y)).y  * 0.02;
warp_15=`    ret.z               = GetPixel(uv_z).z - (GetPixel(uv_z) - GetBlur3(uv_z)).z  * 0.02;
warp_16=`    float3 retd         = ret;
warp_17=`    if(frame%4==0)ret.z = 0.2171 - retd.x;
warp_18=`
warp_19=`}
comp_1=`shader_body
comp_2=`
comp_3=`{
comp_4=`
comp_5=`/////////////Section_1
comp_6=`
comp_7=`    float2 uv_echo = (uv - 0.5)*float2(-1,1) + 0.5;
comp_8=`    ret            = tex2D(sampler_main, uv).xyz*saturate(GetBlur2(uv)*2.8 - 0.13); 
comp_9=`    float3 ret2    = tex2D(sampler_main, uv_echo).xyz*saturate(GetBlur2(uv_echo)*2.8 - 0.13);
comp_10=`    ret            = abs(ret-ret2);
comp_11=`    ret           *= sqrt(ret);
comp_12=`    ret            = sin((pow(bass+mid+treb,.2175)*.9*roam_sin))* pow(ret,.9-ret);
comp_13=`
comp_14=`    
comp_15=`
comp_16=`
comp_17=`/////////////Section_2
comp_18=`
comp_19=`    float2 uv2     = uv - 0.5;
comp_20=`    float L        = length(uv2);
comp_21=`    float2 uvH     = uv2 / L;
comp_22=`    uv2            = uvH * 0.420 + 0.5;
comp_23=`    float2 uv3     = uvH * 0.210 + 0.5;
comp_24=`    float3 streak = tex2D(sampler_main, uv2).xyz;
comp_25=`    streak         = saturate(streak - L * 0.575); 
comp_26=`    float3 streak2 = tex2D(sampler_main, uv3).xyz;
comp_27=`    float streak2H = saturate(L - 0.1);
comp_28=`    streak2        = saturate(streak - streak2H * 1.5) * saturate(streak2H * 100);
comp_29=`    ret           += streak * q11 + 0.142;
comp_30=`    ret            = max(ret,streak2);
comp_31=`    ret           *= 1 + pow(saturate(1 - L * 2), 16) * 4;
comp_32=`
comp_33=`}
