comp_19=`if(frame%02==0)ret.x=.71-ret7.y;
comp_20=`
comp_21=`float2 uv_swimmer =frac(0.5 + (uv-0.5)+float2(q19,q20)*float2(-1,1));
comp_22=`float4 noise9 = tex3D(sampler_noisevol_hq, 
comp_23=`                      ((dz.xyy*q28
comp_24=`                       )*texsize.xyy*texsize_noisevol_hq.zww
comp_25=`                      ).xyz*
comp_26=`                      float3(1,1,0)*0.05 + 
comp_27=`                      time*float3(0,0,1)*q31
comp_28=`                     );
comp_29=`if(ret.x> q26*q13         && ret.x<= q23*q11        )ret.z -= (noise9).x*.5; 
comp_30=`if(ret.y> q25*q11         && ret.y<= q22*q12        )ret.x -= (noise9).y*.5; 
comp_31=`if(ret.z> q24*q12         && ret.z<= q21*q13        )ret.y -= (noise9).z*.5; 
comp_32=`
comp_33=`if(frame%11==0)ret.y=.71-ret7.z;
comp_34=`
comp_35=`ret = lerp(ret,float3(3,2,1),GetBlur3(uv_swimmer -float2(dx.y,dy.y)).x);
comp_36=`ret = lerp(ret,0,GetBlur2(uv_swimmer-dz).x);
comp_37=`
comp_38=`if(frame%13==0)ret.z=.71-ret7.x;
comp_39=`
comp_40=`ret = lerp(ret,float3(0,0,0),1.5*GetPixel(uv_swimmer).x);
comp_41=`ret-=slow_roam_sin.wzy*roam_cos.zxy*.4;
comp_42=`
