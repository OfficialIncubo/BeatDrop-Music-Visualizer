per_frame_44=ref_ang = atan2(x2-x1,y2-y1)+asin(1); // common tangent
per_frame_45=v1 = sqrt(vx1*vx1+vy1*vy1);v2 = sqrt(vx2*vx2+vy2*vy2);w1 = atan2(vx1,vy1);w2 = atan2(vx2,vy2);
