wavecode_1_r=1.000
wavecode_1_g=1.000
wavecode_1_b=1.000
wavecode_1_a=1.000
wave_1_per_point1=gn = 0.42/gmegabuf(1001);
wave_1_per_point2=m = int(sample*511 + 0.5);
wave_1_per_point3=ci = int(m/32);
wave_1_per_point4=pi_ = m % 32;
wave_1_per_point5=k = 0 + ci;
wave_1_per_point6=eta = min(1.5, max(0.07, 0.7854 + 0.55*gmegabuf((int(k*7) + 4800) % 480)*gn));
wave_1_per_point7=xi = 6.2831853*k/48 + 0.9*gmegabuf((int(k*7 - 40) + 4800) % 480)*gn + time*0.1;
wave_1_per_point8=ps = 6.2831853*min(29, max(0, pi_ - 1))/29;
wave_1_per_point9=p0 = cos(eta)*cos(ps);
wave_1_per_point10=p1 = cos(eta)*sin(ps);
wave_1_per_point11=p2 = sin(eta)*cos(xi + ps);
wave_1_per_point12=p3 = sin(eta)*sin(xi + ps);
wave_1_per_point13=ta = time*0.13;
wave_1_per_point14=r1 = p1*cos(ta) - p3*sin(ta);
wave_1_per_point15=r3 = p1*sin(ta) + p3*cos(ta);
wave_1_per_point16=d = 1/(1.2 - r3);
wave_1_per_point17=x = 0.5 + p0*d*0.26;
wave_1_per_point18=y = 0.5 + r1*d*0.26;
wave_1_per_point19=a = if(equal(pi_,0) || equal(pi_,31) || above(d, 3), 0, 0.55);
wave_1_per_point20=x = 0.5 + (x - 0.5)*q32;
wave_1_per_point21=y = 0.5 + (y - 0.5)*q29;
