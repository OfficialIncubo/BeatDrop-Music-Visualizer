wave_0_per_point1=i = int(sample*479 + 0.5);
wave_0_per_point2=v = (value1 + value2)*0.5;
wave_0_per_point3=gmegabuf(i) = v;
wave_0_per_point4=pk = if(equal(i,0), 0, pk);
wave_0_per_point5=pk = max(pk, abs(v));
wave_0_per_point6=gmegabuf(1001) = if(equal(i,479), max(max(pk, gmegabuf(1001)*0.985), 0.004), gmegabuf(1001));
wavecode_1_enabled=1
wavecode_1_samples=512
wavecode_1_sep=0
wavecode_1_bSpectrum=0
wavecode_1_bUseDots=0
wavecode_1_bDrawThick=0
wavecode_1_bAdditive=1
wavecode_1_scaling=1.00000
