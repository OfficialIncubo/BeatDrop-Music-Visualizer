wave_3_per_point1=gn = 0.42/gmegabuf(1001);
wave_3_per_point2=m = int(sample*511 + 0.5);
wave_3_per_point3=ci = int(m/32);
wave_3_per_point4=pi_ = m % 32;
wave_3_per_point5=k = 32 + ci;
wave_3_per_point6=eta = min(1.5, max(0.07, 0.7854 + 0.55*gmegabuf((int(k*7) + 4800) % 480)*gn));
wave_3_per_point7=xi = 6.2831853*k/48 + 0.9*gmegabuf((int(k*7 - 40) + 4800) % 480)*gn + time*0.1;
wave_3_per_point8=ps = 6.2831853*min(29, max(0, pi_ - 1))/29;
wave_3_per_point9=p0 = cos(eta)*cos(ps);
wave_3_per_point10=p1 = cos(eta)*sin(ps);
wave_3_per_point11=p2 = sin(eta)*cos(xi + ps);
wave_3_per_point12=p3 = sin(eta)*sin(xi + ps);
wave_3_per_point13=ta = time*0.13;
wave_3_per_point14=r1 = p1*cos(ta) - p3*sin(ta);
wave_3_per_point15=r3 = p1*sin(ta) + p3*cos(ta);
wave_3_per_point16=d = 1/(1.2 - r3);
wave_3_per_point17=x = 0.5 + p0*d*0.26;
wave_3_per_point18=y = 0.5 + r1*d*0.26;
wave_3_per_point19=a = if(equal(pi_,0) || equal(pi_,31) || above(d, 3), 0, 0.55);
wave_3_per_point20=x = 0.5 + (x - 0.5)*q32;
wave_3_per_point21=y = 0.5 + (y - 0.5)*q29;
per_frame_1=q30 = 0.7;
per_frame_2=q26 = time*0.03 + bass_att*0.05;
per_frame_3=q32 = min(1, pixelsy/pixelsx);
per_frame_4=q29 = min(1, pixelsx/pixelsy);
warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_main, uv).xyz;
warp_4=`    ret = ret*q30 - 0.003;
warp_5=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float2 p = uv;
comp_4=`    ret = tex2D(sampler_main, p).xyz;
comp_5=`    float l = dot(ret, float3(0.333, 0.333, 0.333));
comp_6=`    float3 hue = 0.5 + 0.5*cos(6.2831853*(q26 + float3(0, 0.33, 0.67)));
comp_7=`    ret = lerp(float3(l, l, l), l*hue*1.6, 0.75);
comp_8=`    ret = 1 - exp(-ret*1.8);
comp_9=`}
