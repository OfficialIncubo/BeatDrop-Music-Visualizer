warp_1=`shader_body
warp_2=`{
warp_3=`  ret = max(tex2D(sampler_main, uv).xyz * pow(0.7, q30) - 0.002 * max(q30, 1.0), 0.0);
warp_4=`}
comp_1=`sampler sampler_pw_noise_lq;
comp_2=`shader_body
comp_3=`{
comp_4=`  // the background sky turns with the figures, around the same pole above the screen
comp_5=`  float2 pr = (uv - float2(0.5, -0.25)) * aspect.xy;
comp_6=`  float cs = cos(q1);
comp_7=`  float sn = sin(q1);
comp_8=`  float2 su = float2(pr.x * cs - pr.y * sn, pr.x * sn + pr.y * cs) / aspect.xy + float2(0.5, -0.25);
comp_9=`  float3 col = lerp(float3(0.005, 0.008, 0.025), float3(0.02, 0.025, 0.06), uv.y);
comp_10=`  float band = exp(-pow((su.y - 0.35 - 0.25 * su.x), 2.0) * 40.0);
comp_11=`  float2 drift = float2(q3 * 1.5, 0.0);
comp_12=`  float neb = tex3D(sampler_noisevol_hq, float3(su * float2(2.4, 1.4) + drift, q3)).x * 0.6 + tex3D(sampler_noisevol_hq, float3(su * float2(6.0, 3.4) + drift * 2.0, q3 + 0.3)).x * 0.4;
comp_13=`  col += float3(0.11, 0.09, 0.16) * band * neb;
comp_14=`  float4 st = tex2D(sampler_pw_noise_lq, su * texsize.xy / 512.0);
comp_15=`  float tw = 0.45 + 0.55 * sin(time * (1.6 + st.z * 4.0) + st.w * 30.0);
comp_16=`  col += saturate((st.x * st.y - 0.96) * 40.0) * tw * (0.45 + 0.25 * q2) * float3(0.85, 0.9, 1.0);
comp_17=`  // a shooting star every 1.6 s from a hashed point in the upper sky, gone after 1.1 s
comp_18=`  float mt = time / 1.6;
comp_19=`  float mk = floor(mt);
comp_20=`  float mf = mt - mk;
comp_21=`  float2 ms = float2(0.15 + 0.7 * frac(sin(mk * 12.9898) * 43758.5), 0.05 + 0.3 * frac(sin(mk * 78.233) * 43758.5));
comp_22=`  float2 md = normalize(float2((0.8 + 0.4 * frac(sin(mk * 3.1) * 917.3)) * (frac(sin(mk * 7.7) * 331.1) > 0.5 ? 1.0 : -1.0), 0.45));
comp_23=`  float2 rel = (uv - ms) * aspect.xy - md * mf * 1.1;
comp_24=`  float back = -dot(rel, md);
comp_25=`  float perp = length(rel + back * md);
comp_26=`  float meteor = exp(-perp * 450.0) * step(0.0, back) * exp(-back * 7.0) * saturate(1.0 - mf / 0.7);
comp_27=`  col += float3(0.9, 0.95, 1.0) * meteor * 1.8;
comp_28=`  float3 m = tex2D(sampler_main, uv).xyz;
comp_29=`  col += m * 1.4 + GetBlur1(uv) * float3(0.6, 0.7, 1.0) * 0.8 + GetBlur2(uv) * float3(0.4, 0.5, 0.9) * 0.4;
comp_30=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.6;
comp_31=`  ret = 1.0 - exp(-col * 1.5);
comp_32=`}
