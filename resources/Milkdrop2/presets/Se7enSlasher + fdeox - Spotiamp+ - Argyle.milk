warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float3 hsv(float h, float s, float v)
warp_7=`{
warp_8=`    float4 k = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
warp_9=`    float3 p = abs(frac(h + k.xyz) * 6.0 - k.www);
warp_10=`    return v * lerp(k.xxx, saturate(p - k.xxx), s);
warp_11=`}
warp_12=`
warp_13=`shader_body
warp_14=`{
warp_15=`    uv.y = 1.0 - uv.y;
warp_16=`
warp_17=`    // Standardized Spotiamp+ UV scaling
warp_18=`    float2 my_uv = uv - 0.5;
warp_19=`    my_uv.x /= aspect.y;
warp_20=`
warp_21=`    float sz = 4.0 + mid_att;
warp_22=`    float2 p = my_uv * sz;
warp_23=`    p = float2(p.x + p.y, p.x - p.y) * 0.7071 + float2(time * 0.5, 0.0);
warp_24=`    
warp_25=`    float2 id = floor(p);
warp_26=`    float k = step(0.5, frac(abs(id.x + id.y) * 0.5));
warp_27=`    
warp_28=`    float step1 = floor(time * 0.5);
warp_29=`    float3 c1 = hsv(0.55 + step1 * 0.1, 0.6, 0.8);
warp_30=`    float3 c2 = hsv(0.05 + step1 * 0.1, 0.7, 0.6);
warp_31=`
warp_32=`    float fft_idx = abs(sin(id.x * 0.13 + id.y * 0.07));
warp_33=`    float3 col = lerp(c1, c2, k) * (0.55 + 0.6 * get_fft(fft_idx));
warp_34=`
warp_35=`    float2 q = my_uv * sz * 2.0;
warp_36=`    float st = min(abs(frac(q.x + q.y + time) - 0.5), abs(frac(q.x - q.y) - 0.5));
warp_37=`    col += float3(1.0, 1.0, 1.0) * smoothstep(0.03, 0.0, st) * 0.35 * (0.5 + treb_att);
warp_38=`
warp_39=`    ret = col;
warp_40=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
