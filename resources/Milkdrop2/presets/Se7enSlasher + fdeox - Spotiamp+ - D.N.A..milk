warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`
warp_7=`shader_body
warp_8=`{
warp_9=`    float3 col = 0;
warp_10=`    float t = time * 0.25;
warp_11=`
warp_12=`    // 1. Shift origin (0,0) to screen center
warp_13=`    float2 uvX = (uv - float2(.5, .48)) * 2;
warp_14=`
warp_15=`    // 2. Y-flip for DirectX coordinate space
warp_16=`    uvX.y = -uvX.y;
warp_17=`
warp_18=`    for (int k = 0; k < 26; k++){
warp_19=`        float fk = float(k);
warp_20=`        float y = (fk / 26.0) * 2.0 - 1.0;
warp_21=`        float ph = y * 4.0 + t * 2.2;
warp_22=`        float x1 = sin(ph) * 0.42;
warp_23=`        float x2 = sin(ph + 3.14159) * 0.42;
warp_24=`        float dep = 0.55 + 0.45 * cos(ph);
warp_25=`        float e = get_fft(fk / 26.0);
warp_26=`        float radius = 0.030 + 0.022 * dep;
warp_27=`
warp_28=`        // Helix node positions
warp_29=`        float2 pa = float2(x1, y);
warp_30=`        float2 pb = float2(x2, y);
warp_31=`
warp_32=`        // Strand A (Blue node)
warp_33=`        col += float3(0.3, 0.8, 1.0) * (smoothstep(radius, 0.0, length(uvX - pa))
warp_34=`             + smoothstep(radius * 2.6, 0.0, length(uvX - pa)) * 0.25) * dep * (1.1 + e * 2.2);
warp_35=`
warp_36=`        // Strand B (Pink node)
warp_37=`        col += float3(1.0, 0.4, 0.7) * (smoothstep(radius, 0.0, length(uvX - pb))
warp_38=`             + smoothstep(radius * 2.6, 0.0, length(uvX - pb)) * 0.25) * dep * (1.1 + e * 2.2);
warp_39=`
warp_40=`        // Connecting rung line segment
warp_41=`        float2 ab = pb - pa; 
warp_42=`        float h2 = saturate(dot(uvX - pa, ab) / dot(ab, ab));
warp_43=`        col += float3(0.6, 0.9, 0.7) * smoothstep(0.014, 0.0, length(uvX - pa - ab * h2)) * (0.35 + e * 1.6);
warp_44=`    }
warp_45=`
warp_46=`    ret = col;
warp_47=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
