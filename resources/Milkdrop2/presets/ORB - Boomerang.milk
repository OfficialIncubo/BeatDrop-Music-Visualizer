per_frame_1=basstime = basstime + bass*0.03;
per_frame_2=basstime2 = basstime + bass*0.03;
per_frame_3=q1 = basstime2;
per_frame_4=
per_frame_5=//start in most active range
per_frame_6=basstime = if(below(basstime,450),450,basstime);
per_frame_7=basstime = if(above(basstime,495),450,basstime);
per_frame_8=
per_frame_9=basstime = basstime + bass_att*0.03;
per_frame_10=vol = pow(bass+mid+treb,2);
per_frame_11=basssum = vol;
per_frame_12=
per_frame_13=stickybit = time%2;
per_frame_14=
per_frame_15=//avg vol
per_frame_16=//buffer 1
per_frame_17=volAvg = volAvg + vol*equal(stickybit,1);
per_frame_18=//number of samples 1 or framerate
per_frame_19=sample1 = sample1 + equal(stickybit,1);
per_frame_20=//buffer 2
per_frame_21=volAvg2 = volAvg2 + vol*equal(stickybit,0);
per_frame_22=//number of samples 2
per_frame_23=sample2 = sample2 + equal(stickybit,0);
per_frame_24=
per_frame_25=//transision
per_frame_26=edge = bnot(equal(bit2,stickybit));
per_frame_27=
per_frame_28=volAvg = volAvg - volAvg*edge*stickybit;
per_frame_29=volAvg2 = volAvg2 - volAvg2*edge*equal(stickybit,0);
per_frame_30=
per_frame_31=sample1 = sample1  - sample1*edge*stickybit;
per_frame_32=sample2 = sample2  - sample2*edge*equal(stickybit,0);
per_frame_33=
per_frame_34=//test vol against avg buffer lvl
per_frame_35=diff = if(equal(stickybit,1), (basssum/(volAvg2/sample2)) , 0);
per_frame_36=diff = if(equal(stickybit,0), (basssum/(volAvg/sample1)), diff);
per_frame_37=
per_frame_38=q3 = diff;
per_frame_39=
per_frame_40=bit2 = time%2;
per_frame_41=
per_frame_42=difftime = difftime + diff*0.03;
per_frame_43=q2 = difftime;
per_frame_44=
per_frame_45=//fix a strange error
per_frame_46=difftime = if(above(difftime,2000),0, difftime);
per_frame_47=
per_frame_48=subs = meshx/ meshy;
per_frame_49=q5 = subs;
per_frame_50=
per_frame_51=
per_frame_52=//another state machine for shape tracking
per_frame_53=state = state + above(diff,3);
per_frame_54=state = if(above(state,5), 0, state);
per_frame_55=
per_frame_56=xs = 0;
per_frame_57=ys = 0;
per_frame_58=
per_frame_59=//add bouns on beat
per_frame_60=xs = xs + 0.1*equal(2,bass_clip);
per_frame_61=ys = ys + 0.1*equal(2,bass_clip);
per_frame_62=
per_frame_63=//state 0 elipse
per_frame_64=xs = xs + (equal(0,state))*atan(bass_time*4)*0.1;
per_frame_65=ys = ys + (equal(0,state))*cos(bass_time*4)*0.1;
per_frame_66=
per_frame_67=//state 1 diag
per_frame_68=xs = xs + (equal(1,state))*cos(bass_time*4)*0.1;
per_frame_69=ys = ys + (equal(1,state))*cos(bass_time*4)*0.1;
per_frame_70=
per_frame_71=//state 2 -circle
per_frame_72=xs = xs + (equal(2,state))*cos(bass_time*4)*0.1;
per_frame_73=ys = ys + (equal(2,state))*sin(bass_time*4)*0.1;
per_frame_74=
per_frame_75=//state 3 parametric arc
per_frame_76=xs = xs + (equal(3,state))*cos(bass_time*5)*0.1;
per_frame_77=ys = ys + (equal(3,state))*cos(bass_time*9)*0.1;
per_frame_78=
per_frame_79=//state 4 arc
per_frame_80=xs = xs + (equal(4,state))*atan(bass_time*6)*0.1;
per_frame_81=ys = ys + (equal(4,state))*cos(bass_time*2)*0.1;
per_frame_82=
per_frame_83=//state 5 infinity
per_frame_84=xs = xs + (equal(5,state))*cos(bass_time*2)*0.1;
per_frame_85=ys = ys + (equal(5,state))*sin(bass_time*1)*0.1;
per_frame_86=
per_frame_87=//count
per_frame_88=xpass = xs + xpass;
per_frame_89=ypass = ys + ypass;
per_frame_90=
per_frame_91=ib_r = ib_r + 0.5*sin(time*0.899);
per_frame_92=ib_g = ib_g + 0.5*sin(time*0.687);
per_frame_93=ib_b = ib_b + 0.5*sin(time*1.225);
per_frame_94=
per_frame_95=//project and publish
per_frame_96=q6 = 0.4*sin(xpass*1);
per_frame_97=q7 = 0.4*sin(ypass*1);
per_frame_98=
per_frame_99=mv_a = diff;
per_frame_100=mv_l = diff;
per_frame_101=mv_x = (diff +1)*22;
per_frame_102=mv_y = (diff +1)*16;
per_frame_103=
per_frame_104=rarr = int(rand(100))*0.01;
per_frame_105=
per_frame_106=decay_r = 0.75 + 0.25*(abs(sin(diff+rarr)));
per_frame_107=decay_g = 0.75 + 0.25*(abs(cos(diff+rarr)));
per_frame_108=decay_b = 0.75 + 0.25*(abs(atan(diff+rarr)));
per_pixel_1=zoom = 1.02;
