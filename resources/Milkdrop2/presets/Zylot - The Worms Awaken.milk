shape_0_init1=pulse = 0;
shape_0_per_frame1=x = gmegabuf(instance);
shape_0_per_frame2=y = gmegabuf(1000+instance);
shape_0_per_frame3=
shape_0_per_frame4=rad = .03+(gmegabuf(2000+instance%10)*.02);
shape_0_per_frame5=
shape_0_per_frame6=r = if(instance%10 == 9,1,1);
shape_0_per_frame7=b = if(instance%10 == 9,0,1);
shape_0_per_frame8=g = if(instance%10 == 9,0,1);
per_frame_init_1=
per_frame_init_2=i = 0;
per_frame_init_3=loop(1000000,gmegabuf(i) = 0;i=i+1;);
per_frame_init_4=
per_frame_init_5=x = 0;
per_frame_init_6=loop(20,
per_frame_init_7=  gmegabuf(500+x) = .5+(rand(1000)*.001);
per_frame_init_8=  gmegabuf(600+x) = .5+(rand(1000)*.001);
per_frame_init_9=  gmegabuf(700+x) = .2+(rand(400)*.001);
per_frame_init_10=x=x+1;
per_frame_init_11=)
per_frame_1=wave_a = 0;
per_frame_2=
per_frame_3=q1 = aspecty;
per_frame_4=
per_frame_5=i=0;
per_frame_6=
per_frame_7=loop(20,
per_frame_8=  s = 0;
per_frame_9=
per_frame_10=  loop(10,
per_frame_11=    gmegabuf((i*10)+s) = .5+(gmegabuf(700+i)*sin(((time + (s*.02))*gmegabuf(500+i))));
per_frame_12=    gmegabuf(1000+(i*10)+s) = .5+(gmegabuf(700+i)*cos(((time + (s*.02))*gmegabuf(600+i))));
per_frame_13=    s = s+1;
per_frame_14=  )  
per_frame_15=
per_frame_16=
per_frame_17=;
per_frame_18=i=i+1;
per_frame_19=);
per_frame_20=
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`    
warp_6=`    // burrow through the mud..
warp_7=`    
warp_8=`    if(ret.x > .2 && ret.y > .2 && ret.z > .2){
warp_9=`      ret = 0;
warp_10=`    }
warp_11=`
warp_12=`    // refill the mud..
warp_13=`
warp_14=`    if(ret.x < .3+(.04*sin(uv.x*10+time*.523))){ret.x += abs(ret.x-1)*.00045 + .00175+(.0005*sin(time*.223));}
warp_15=`    if(ret.y < .2+(.03*cos(uv.y*10+time*.523))){ret.y += abs(ret.y-1)*.00045 + .00175+(.0005*sin(time*.223));}
warp_16=`}
comp_1=`shader_body
comp_2=`{
comp_3=`
comp_4=`    float4 noise = tex2D(sampler_noise_lq, (uv*10)+time*11);
comp_5=`
comp_6=`    ret = tex2D(sampler_main, uv).xyz;
comp_7=`    float3 ret2 = tex2D(sampler_main, (-uv*.5)-.25).xyz;
comp_8=`    float3 ret3 = tex2D(sampler_main, (float2(uv.x,-uv.y)*.25)-.5).xyz;
comp_9=`
comp_10=`    ret *= 2.00; //gamma
comp_11=`    ret2 = ret2*.5;
comp_12=`    ret3 = ret3*.20;
comp_13=`    
comp_14=`
comp_15=`    ret = lerp(noise,ret,abs(ret-1)+bass_att*.1);
comp_16=`
comp_17=`    if(ret.x+ret.y+ret.z < .01){ret = ret2;}
comp_18=`    if(ret.x+ret.y+ret.z < .01){ret = ret3;}    
comp_19=`}
