shape_0_per_frame17=y = (1.1-gmegabuf(1+(instance*20))*1.5)+((gmegabuf(1+(instance*20))*sin(time*gmegabuf(1+(instance*20)+3)))*cos(time*gmegabuf(1+(instance*20)+2)));
shape_0_per_frame18=
