shape_0_per_frame25=gmegabuf(1+(instance*20)+2) = if(gmegabuf(1+(instance*20)+6)>0,gmegabuf(1+(instance*20)+2),(rand(10000)-5000) * .0003);
shape_0_per_frame26=gmegabuf(1+(instance*20)+3) = if(gmegabuf(1+(instance*20)+6)>0,gmegabuf(1+(instance*20)+3),(rand(10000)-5000) * .0003);
shape_0_per_frame27=gmegabuf(1+(instance*20)+4) = if(gmegabuf(1+(instance*20)+6)>0,gmegabuf(1+(instance*20)+4),(rand(10000)-5000) * .0003);
shape_0_per_frame28=
