shape_0_per_frame32=a2 = a;
per_frame_init_1=
per_frame_init_2=i = 0;
per_frame_init_3=loop(1000000,gmegabuf(i) = 0;i=i+1;);
per_frame_init_4=
per_frame_init_5=x = 0;
per_frame_init_6=loop(500,
per_frame_init_7=  gmegabuf(1+(x*20)) = 0;                             //spread
per_frame_init_8=  gmegabuf(1+(x*20)+1) = (rand(10000)-5000) * .0003;  //time vals 1 through 4
per_frame_init_9=  gmegabuf(1+(x*20)+2) = (rand(10000)-5000) * .0003;
per_frame_init_10=  gmegabuf(1+(x*20)+3) = (rand(10000)-5000) * .0003;
per_frame_init_11=  gmegabuf(1+(x*20)+4) = (rand(10000)-5000) * .0003;
per_frame_init_12=  gmegabuf(1+(x*20)+5) = 30+rand(100);               //max duration 
per_frame_init_13=  gmegabuf(1+(x*20)+6) = gmegabuf((x*10)+5);          //duration tracker
per_frame_init_14=  gmegabuf(1+(x*20)+7) = rand(100)*.01;               //three color sets       
per_frame_init_15=  gmegabuf(1+(x*20)+8) = rand(100)*.01;
per_frame_init_16=  gmegabuf(1+(x*20)+9) = rand(100)*.01;
per_frame_init_17=  gmegabuf(1+(x*20)+10) = rand(100)*.01;      //X base position
per_frame_init_18=  gmegabuf(1+(x*20)+11) = rand(100)*.01;      //For tracking VOL for opactiy
per_frame_init_19=
per_frame_init_20=  x=x+1;
per_frame_init_21=)
per_frame_1=wave_a = 0;
per_frame_2=
per_frame_3=q1 = aspecty;
per_frame_4=
per_frame_5=
per_pixel_1=dy = (y-.22)*.004;
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`        
warp_6=`    if(frame%2==0){ret = ret*.98 - .002;}
warp_7=`
warp_8=`    if(uv.y > .66){
warp_9=`      ret = 0;
warp_10=`    }
warp_11=`}
comp_1=`float3 get_city_mask(float2 uv_base, float horizon){
comp_2=`  //let's build a city....
comp_3=`
comp_4=`  float3 mask = float3(0, 0, 0);    
comp_5=`  
comp_6=`  if(uv_base.y <= horizon+.004){
comp_7=`    if(uv_base.y >= .655){mask = 1;}
comp_8=`    if(uv_base.y >= .64 && uv_base.x >= .1 && uv_base.x <= .85){mask = 1;}
comp_9=`    if(uv_base.y >= .62 && uv_base.x >= .15 && uv_base.x <= .82){mask = 1;}
comp_10=`    if(uv_base.y >= .55 && uv_base.x >= .158 && uv_base.x <= .195){mask = 1;}
comp_11=`    if(uv_base.y >= .50 && uv_base.x >= .178 && uv_base.x <= .205){mask = 1;}
comp_12=`    if(uv_base.y >= .58 && uv_base.x >= .205 && uv_base.x <= .245){mask = 1;}
comp_13=`    if(uv_base.y >= .60 && uv_base.x >= .245 && uv_base.x <= .315){mask = 1;}
comp_14=`    if(uv_base.y >= .48 && uv_base.x >= .315 && uv_base.x <= .345){mask = 1;}
comp_15=`    if(uv_base.y >= .51 && uv_base.x >= .345 && uv_base.x <= .355){mask = 1;}
comp_16=`    if(uv_base.y >= .45 && uv_base.x >= .355 && uv_base.x <= .390){mask = 1;}
comp_17=`    if(uv_base.y >= .49 && uv_base.x >= .390 && uv_base.x <= .410){mask = 1;}
comp_18=`    if(uv_base.y >= .54 && uv_base.x >= .410 && uv_base.x <= .475){mask = 1;}
comp_19=`    if(uv_base.y >= .37 && uv_base.x >= .371 && uv_base.x <= .373){mask = 1;}
comp_20=`    if(uv_base.y >= .56 && uv_base.x >= .475 && uv_base.x <= .520){mask = 1;}
comp_21=`    if(uv_base.y >= .53 && uv_base.x >= .520 && uv_base.x <= .540){mask = 1;}
comp_22=`    if(uv_base.y >= .56 && uv_base.x >= .540 && uv_base.x <= .575){mask = 1;}
comp_23=`    if(uv_base.y >= .60 && uv_base.x >= .575 && uv_base.x <= .620){mask = 1;}
comp_24=`    if(uv_base.y >= .50 && uv_base.x >= .620 && uv_base.x <= .655){mask = 1;}
comp_25=`    if(uv_base.y >= .58 && uv_base.x >= .655 && uv_base.x <= .700){mask = 1;}
comp_26=`    if(uv_base.y >= .54 && uv_base.x >= .700 && uv_base.x <= .715){mask = 1;}
comp_27=`    if(uv_base.y >= .61 && uv_base.x >= .715 && uv_base.x <= .785){mask = 1;}
comp_28=`    if(uv_base.y >= .56 && uv_base.x >= .935 && uv_base.x <= .950){mask = 1;}
comp_29=`  }
comp_30=`
comp_31=`  return mask;
comp_32=`  
comp_33=`}
comp_34=`
comp_35=`float3 make_city_lights(float2 uv_base, float horizon){
comp_36=`   //add pulsing window lights and also a red light atop the radio tower.
comp_37=`
comp_38=`   float3 lights = float3(0,0,0);
comp_39=`
comp_40=`   float3 mask = get_city_mask(uv_base, horizon);
comp_41=`   float2 window_scale = float2(100+1.5*sin(10+uv_base.x*25+uv_base.y+int(time*.5)), 50.0+1.5*cos(10+uv_base.y*25+uv_base.y+int(time*.5)));
comp_42=`   float2 grid = frac(uv_base * window_scale);
comp_43=`   float  window_pattern = step(0.95, grid.x) * step(0.95, grid.y);
comp_44=`   float3 window_color = float3(1.0, 0.85, 0.4+(bass_att*.2));
comp_45=`   
comp_46=`   if(uv_base.y >= .45){lights = lerp(lights, window_color*(treb_att*.6+.1*sin(uv_base.x*20+time*8.76)), window_pattern*mask);}
comp_47=`
comp_48=`   float3 red_light = float3(.5+.5*cos(time),0,0);
comp_49=`
comp_50=`   if(uv_base.y >= .37 && uv_base.y <= .375 && uv_base.x >= .371 && uv_base.x <= .373){
comp_51=`     lights = lights + red_light;
comp_52=`   }
comp_53=`      
comp_54=`
comp_55=`   return lights;
comp_56=`}
comp_57=`
comp_58=`shader_body
comp_59=`{
comp_60=`
comp_61=`    float2 uv_base = uv;
comp_62=`    float horizon = 0.66;
comp_63=`    float3 final_color = float3(0, 0, 0);
comp_64=`   
comp_65=`    float3 mask = get_city_mask(uv_base, horizon);     
comp_66=`    float3 lights = make_city_lights(uv_base, horizon);    
comp_67=`
comp_68=`    if(mask.x == 1){
comp_69=`      final_color = float3(0,0,0);
comp_70=`    }else if(uv_base.y < horizon){
comp_71=`      final_color = tex2D(sampler_main, uv_base).xyz;
comp_72=`      final_color.z = max((abs(uv_base.y*2-1)-.3)*.1*mid_att,final_color.z);
comp_73=`    }else{
comp_74=`      float water_y = (uv_base.y - horizon) / (1.0 - horizon);
comp_75=`      float perspective_x = (uv_base.x - .5) / (water_y + 0.1) + 0.5;
comp_76=`
comp_77=`      float z_depth = 1.0 / (pow(water_y,2) + 0.05);
comp_78=`
comp_79=`      float wave1 = sin(z_depth * 18.0 + perspective_x * 12.0 - time * 5.0) * cos(perspective_x * 15.0 + z_depth * 4.0);
comp_80=`      float wave2 = sin(z_depth * 32.0 - perspective_x * 18.0 - time * 7.5) * sin(perspective_x * 22.0 - z_depth * 6.0);
comp_81=`
comp_82=`      float noise_ripple = sin(perspective_x * 50.0 + z_depth * 60.0 - time * 12.0) * 0.3;
comp_83=`
comp_84=`      float wave_amplitude = 0.015 * water_y; 
comp_85=`      float ripple_distortion = (wave1 + wave2 + noise_ripple * wave_amplitude) * wave_amplitude;
comp_86=`
comp_87=`      float2 uv_reflect;
comp_88=`      uv_reflect.x = uv_base.x + ripple_distortion;
comp_89=`      uv_reflect.y = horizon - (uv_base.y - horizon) * 0.85;
comp_90=`      
comp_91=`      uv_reflect = clamp(uv_reflect, 0.001, 0.999);
comp_92=`
comp_93=`      float3 reflection = tex2D(sampler_main, uv_reflect).xyz;
comp_94=`      float3 reflection_mask = get_city_mask(uv_reflect, horizon);
comp_95=`      float3 reflected_lights = make_city_lights(uv_reflect, horizon);
comp_96=`
comp_97=`      if(reflection_mask.x == 1.0){
comp_98=`        reflection = reflected_lights;
comp_99=`      }else{
comp_100=`        reflection = max(reflection, reflected_lights);
comp_101=`      }
comp_102=`      float3 water_tint = float3(0.6, 0.8, 0.95);
comp_103=`      float specular_mask = max(0.0, wave1 + wave2 + noise_ripple);
comp_104=`      float specular = pow(specular_mask, 4.0) * 0.2 * water_y;
comp_105=`      final_color = (reflection * water_tint) + (specular)*(.5+(bass_att*.3));
comp_106=`
comp_107=`      float horizon_fade = smoothstep(0.0, 0.1, water_y);
comp_108=`      final_color = lerp(tex2D(sampler_main, uv_base).xyz, final_color, horizon_fade);
comp_109=`    }
comp_110=`
comp_111=`    ret = final_color;
comp_112=`    //ret = mask;
comp_113=`
comp_114=`    ret = max(ret, make_city_lights(uv_base, horizon));
comp_115=`
comp_116=`    ret *= 2.00; //gamma
comp_117=`
comp_118=`        
comp_119=`}
