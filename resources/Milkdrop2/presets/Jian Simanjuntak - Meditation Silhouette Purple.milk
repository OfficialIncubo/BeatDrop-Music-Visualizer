shapecode_2_b2=1.000
shapecode_2_a2=0.500
shapecode_2_border_r=0.000
shapecode_2_border_g=0.000
shapecode_2_border_b=0.000
shapecode_2_border_a=0.000
shape_2_per_frame1=spread = 0.8; 
shape_2_per_frame2=y_base = (instance / (num_inst * 0.4));
shape_2_per_frame3=y = 0.0 + (y_base * spread);
shape_2_per_frame4=x = 0.010;
shape_2_per_frame5=
shape_2_per_frame6=// Warna
shape_2_per_frame7=r = q3; g = q4; b = q5;
shape_2_per_frame8=r2 = q3; g2 = q4; b2 = q5;
shapecode_3_enabled=1
shapecode_3_sides=20
shapecode_3_additive=0
shapecode_3_thickOutline=0
shapecode_3_textured=0
shapecode_3_num_inst=35
shapecode_3_x=0.500
shapecode_3_y=0.500
shapecode_3_rad=0.09820
shapecode_3_ang=0.00000
shapecode_3_tex_ang=1.00531
shapecode_3_tex_zoom=1.53110
shapecode_3_r=1.000
shapecode_3_g=1.000
shapecode_3_b=1.000
shapecode_3_a=0.160
shapecode_3_r2=1.000
shapecode_3_g2=1.000
shapecode_3_b2=1.000
shapecode_3_a2=0.000
shapecode_3_border_r=1.000
shapecode_3_border_g=1.000
shapecode_3_border_b=1.000
shapecode_3_border_a=0.000
shape_3_per_frame1=i = instance;
shape_3_per_frame2= 
shape_3_per_frame3=f1 = .3 + .07*sin(i*12.9);
shape_3_per_frame4=f2 = .25 + .06*cos(i*7.3);
shape_3_per_frame5= 
shape_3_per_frame6=mx = .85*sin(time*f1 + i*7.1) + .08*sin(time*1.7 + i);
shape_3_per_frame7=my = .40*sin(time*f2 + i*3.7) + .08*cos(time*1.3 + i*2);
shape_3_per_frame8= 
shape_3_per_frame9=x = .5 + mx/q6;
shape_3_per_frame10=y = .5 + my;
shape_3_per_frame11= 
shape_3_per_frame12=blink = abs(sin(time*(1 + .5*sin(i)) + i));
shape_3_per_frame13=rad = 0.04 + .012*blink;
shape_3_per_frame14=
shape_3_per_frame15=r = q3; g = q4; b = q5;
shape_3_per_frame16=r2 = q3; g2 = q4; b2 = q5;
per_frame_1=// ========== Terowongan =========
per_frame_2=dec = pow(0.9,30/fps);
per_frame_3=dsl = pow(0.99,30/fps);
per_frame_4=beat = max(max(bass,mid),treb);
per_frame_5=avg = avg*dsl + beat*(1-dsl);
per_frame_6=is_beat = above(beat,.2+avg+peak)*above(time,t0+.2);
per_frame_7=t0 = is_beat*time + (1-is_beat)*t0;
per_frame_8=peak = is_beat*beat + (1-is_beat)*peak*dec;
per_frame_9=mov = mov + (.012+.015*(bass_att+mid_att+treb_att)/3)*30/fps;
per_frame_10=
per_frame_11=q1 = mov;
per_frame_12=q2 = peak;
per_frame_13=
per_frame_14=// Warna pada bagian terowongan
per_frame_15=q3 = 1.0; q4 = 0.8; q5 = 0.6;
per_frame_16=
per_frame_17=q6 = aspecty; // shapecode particle
per_frame_18=
per_frame_19=wave_a = 1;
per_frame_20=warp = 0.9;
per_frame_21=
per_frame_22=vol = bass*8 + mid*5 + treb*3;
per_frame_23=m = m*0.97 + vol*0.08;
per_frame_24=beat_mod = above(vol,res)*above(vol,m)*above(vol,16);
per_frame_25=diff = (1-beat_mod)*diff + beat_mod*(vol-res);
per_frame_26=res = beat_mod*(vol + m*0.1) + (1-beat_mod)*(res -  (0.1+diff*0.02)*60/fps);
per_frame_27=res = max(0,res);
per_frame_28=
per_frame_29=d_x = if(beat_mod, (rand(2000)-1000)*0.001 , d_x);
per_frame_30=d_y = if(beat_mod, (rand(2000)-1000)*0.001 , d_y);
per_frame_31=r = if(beat_mod, (rand(2000)-1000)*0.001 , r);
per_frame_32=z = if(beat_mod, rand(1000)*0.001 , z);
per_frame_33=zoom = 1.09 + z*0.03;
per_frame_34=rot = r*0.04;
per_frame_35=dx = d_x*0.01;
per_frame_36=dy = d_y*0.01;
per_frame_37=
per_frame_38=// ========== Acak pada terowongan =========
per_frame_39=time_random_tunnel = int(time) % 25;
per_frame_40=
per_frame_41=q7 = if(below(time_random_tunnel, 5), 6, 
per_frame_42=        if(below(time_random_tunnel, 10), 8, 
per_frame_43=        if(below(time_random_tunnel, 15), 10, 
per_frame_44=        if(below(time_random_tunnel, 20), 12, 14))));
per_frame_45=
per_frame_46=// ======= Posisi pada lambang meditasi ========
per_frame_47=q8 = 0.20; // Posisi kiri dan kanan
per_frame_48=q9 = 0.24; // Posisi atas dan bawah
warp_1=`shader_body
warp_2=`{
warp_3=`
warp_4=`uv = lerp(uv_orig,uv,0.05);
warp_5=`
warp_6=`float2 d = texsize.zw * 4;
warp_7=`float3 dx = ( GetBlur1(uv + float2(1,0)*d) - GetBlur1(uv-float2(1,0)*d) );
warp_8=`float3 dy = ( GetBlur1(uv + float2(0,1)*d) - GetBlur1(uv-float2(0,1)*d) );
warp_9=`
warp_10=`uv += float2(lum(dx),lum(dy))*texsize.zw*4;
warp_11=`ret = tex2d(sampler_fc_main, uv) - 0.008;
warp_12=`
warp_13=`}
comp_1=`sampler sampler_SpiritualMeditation_Mask02;
comp_2=`
comp_3=`float2 center_uv1;
comp_4=`float3 ret1, ret2, line_color1, line_color2, bg, fg, cc, fp;
comp_5=`
comp_6=`shader_body
comp_7=`{
comp_8=`    // =========== Warna garis ===========
comp_9=`    line_color1 = float3(0.25, 0.0, 0.55);
comp_10=`    line_color2 = float3(0.8, 0.6, 0.3);
comp_11=`    
comp_12=`    float blend_factor = smoothstep(0.1, 0.8, uv.y);
comp_13=`    ret1 = lerp(line_color1, line_color2, blend_factor);
comp_14=`
comp_15=`    // =========== Terowongan ===========
comp_16=`    float2 p = (uv - 0.5) * aspect.xy;
comp_17=`    float r = length(p) + 0.0800;
comp_18=`    float a = atan2(p.y, p.x) / 6.28318;
comp_19=`    float v = 1.0 / (r + 0.15) * 0.6 + q1 + sin(r * 10.0 - q1 * 8.0) * 0.09;
comp_20=`    float2 t = float2(a * q7, v);
comp_21=`    float3 c = GetPixel(t) + GetBlur1(frac(t)) * float3(q3, q4, q5);
comp_22=`    float glow = exp(-r * 6.0) * (2.4 + q2);
comp_23=`    ret2 = c * saturate(r * 2.5) + glow * float3(1.0, 0.8, 0.6);
comp_24=`
comp_25=`    float msk = saturate(dot(ret2, float3(0.299, 0.587, 0.114)));
comp_26=`    bg = lerp(ret1, ret2, msk) * 0.85;
comp_27=`
comp_28=`    // ========= Lambang meditasi =========
comp_29=`    center_uv1.x = (uv.x - q8) * 1.7;
comp_30=`    center_uv1.y = (uv.y - q9) * 1.3;
comp_31=`
comp_32=`    float inside_fg = smoothstep(0.0, 0.10, center_uv1.x) * 
comp_33=`                           smoothstep(1.0, 0.88, center_uv1.x) *
comp_34=`                           smoothstep(-0.070, 0.06, center_uv1.y) * 
comp_35=`                           smoothstep(1.5, 0.88, center_uv1.y);
comp_36=`
comp_37=`    fg = tex2D(sampler_SpiritualMeditation_Mask02, center_uv1).xyz;
comp_38=`    fg *= 1.00;
comp_39=`
comp_40=`    cc = float3(0.0, 0.0, 0.0);
comp_41=`    float whiteness = min(fg.r, min(fg.g, fg.b));
comp_42=`    fp = lerp(fg, cc * (fg / max(whiteness, 0.001)), whiteness);
comp_43=`
comp_44=`    float fg_mask = saturate(dot(fg, float3(1.0, 1.0, 1.0))) * inside_fg;
comp_45=`
comp_46=`    ret = lerp(bg, fp, fg_mask);
comp_47=`}
