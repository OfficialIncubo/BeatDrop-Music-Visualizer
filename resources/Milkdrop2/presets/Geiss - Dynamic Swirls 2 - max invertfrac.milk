nMotionVectorsY=9.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_init_1=//x=1-x; //y=1-y;
per_frame_1=wave_r = wave_r + (0.60*cos(time*(1.8-bass_att)+mid_att) + 0.40*sin(zoom)*0.3 );
per_frame_2=wave_g = wave_g + bass_att*( 0.60*tan(0.5*time) + 0.40*sin(time) );
per_frame_3=wave_b = wave_b + 0.350*( 0.80*sin(0.614*time) + 0.03*log10(time)*bass );
per_frame_4=q1 = (sx*2-1) + 0.32*tan( 0.60*sin(0.374*time) + 0.40*sin(0.294*time) );
per_frame_5=q2 = (cy*2-1) + 0.52*( 0.60*sin(0.393*time) + 0.40*sin(0.223*time) );
per_frame_6=q3 = (cy*2-1) + 0.32*( 0.60*sin(0.174*time) + 0.40*sin(0.364*time)+zoom );
per_frame_7=q4 = (sy*2-1) + 0.82*( 0.60*sin(0.234*time) + 0.40*tan(0.271*-time) );
per_frame_8=qx=1 -(x*y); qy=(x+y)*y; qang=(qx+qy)*ang; qrad=(qx=qy)*rad; q16=qrad*(q3+q4);
per_frame_9=rot=rot +0.7*tan(qang);
per_frame_10=
per_frame_11=decay = decay - 0.01*equal(frame%5,0);
per_pixel_1=qx=1 -(x*y); qy=(x+y)*y; qang=(qx+qy)*ang; qrad=(qx=qy)*rad; q16=qrad*(q3+q4);
per_pixel_2=
per_pixel_3=du = x*2-1 - q1;
per_pixel_4=dv = y*2-1 - q2;
per_pixel_5=dist = sqrt(du*du+dv*dv);
per_pixel_6=ang2 = atan2(du,dv);
per_pixel_7=mult = 0.24/(dist*1.4);
per_pixel_8=dx = mult*sin(ang2-qang)*qrad;
per_pixel_9=dy = mult*cos(ang2+qrad);
per_pixel_10=du = x*2-1 + q3;
per_pixel_11=dv = y*2-1 * q4;
per_pixel_12=dist = sqrt(du*du+dv*dv);
per_pixel_13=ang2 = atan2(du,dv);
per_pixel_14=mult = 0.06/(dist+0.7)*sin(time)*bass_att;
per_pixel_15=dx = dx + mult*sin(ang2+1.5)*3;
per_pixel_16=dy = dy + mult*sin(ang2+1.5)*3;
per_pixel_17=size=1-(qrad*qang)*sin(x-y)-qx;
per_pixel_18=//mx=mid*sin(x*y)+qx; my=mid*sin(y-x)-qy;
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`
warp_6=`    // motion blur:
warp_7=`    // 'v' points exactly one pixel, in the direction of motion
warp_8=`    float2 v = normalize(uv-uv_orig)*texsize.zw;
warp_9=`    float3 s;
warp_10=`    ret = min(ret, tex2D(sampler_main, uv+v)*0.97);
warp_11=`    ret = max(ret, tex2D(sampler_main, uv-v)*0.97);
warp_12=`    ret = max(ret, tex2D(sampler_main, uv+v*2)*0.90);
warp_13=`    ret = max(ret, tex2D(sampler_main, uv-v*2)*0.90);
warp_14=`
warp_15=`    // darken over time
warp_16=`    ret *= 0.95;
warp_17=`
warp_18=`    // add noise
warp_19=`    //float2 uv_noise = uv*texsize_noise_lq.zw*texsize.xy + rand_frame.xy;
warp_20=`    //ret += (tex2D(sampler_noise_lq, uv_noise)*2-1)*0.02;
warp_21=`}
comp_1=`float2 cmul(float2 mul1, float2 mul2) {
comp_2=`   float2 mul = float2(mul1.x*mul2.x - mul1.y*mul2.y, mul1.y*mul2.x + mul1.x*mul2.y);
comp_3=`   return mul;
comp_4=` }
comp_5=` float2 cdiv(float2 div1, float2 div2) {
comp_6=`   float2 div = float2( (div1.x*div2.x + div1.y*div2.y)/(div2.x*div2.x + div2.y*div2.y),
comp_7=`   (div1.y*div2.x + div1.x*div2.y)/(div2.x*div2.x + div2.y*div2.y) );
comp_8=`   return div;
comp_9=` }
comp_10=` float2 cpow(float2 base, float ex) {
comp_11=`   float moduz = sqrt(base.x*base.x + base.y*base.y);
comp_12=`   float thetaz = atan2(base.y, base.x);
comp_13=`   float2 pow = float2(pow(moduz, ex)*cos(thetaz*ex), pow(moduz, ex)*sin(thetaz*ex));
comp_14=`   return pow;
comp_15=` }
comp_16=` float2 cexp(float2 base, float2 ex) {
comp_17=`   float moduz = sqrt(base.x*base.x + base.y*base.y);
comp_18=`   float thetaz = atan2(base.y, base.x);
comp_19=`   float mp = pow(moduz, ex.x)*exp(-ex.y*thetaz);
comp_20=`   float2 sol = mp*float2(cos(ex.y*log(moduz) + ex.x*thetaz), sin(ex.y*log(moduz) + ex.x*thetaz));
comp_21=`   return sol;
comp_22=` }
comp_23=` 
comp_24=`
comp_25=`shader_body
comp_26=`{
comp_27=`float2 zoom = 1.5;
comp_28=`   float2 c = float2(q4, q5);
comp_29=`   float2 uv1 = (uv-0.5)*zoom;
comp_30=`   float2 zp = 2-uv1;
comp_31=`   
comp_32=`   uv1 = cexp(uv1, zp)+c;     
comp_33=`   ret = GetPixel(uv1);
comp_34=`}
