per_frame_46=q56 = 0;
warp_1=`shader_body
warp_2=`{
warp_3=`  ret = max(tex2D(sampler_main, uv).xyz * pow(0.8, q30) - 0.002 * max(q30, 1.0), 0.0);
warp_4=`}
comp_1=`sampler sampler_pw_noise_lq;
comp_2=`float grass(float2 u, float scale, float h0, float seed)
comp_3=`{
comp_4=`  float x = u.x * scale;
comp_5=`  float c = floor(x);
comp_6=`  float f = frac(x) - 0.5;
comp_7=`  float4 n = tex2D(sampler_pw_noise_lq, float2((c + seed) / 256.0, seed / 256.0));
comp_8=`  float hgt = h0 + 0.12 * n.x;
comp_9=`  float lean = (n.y - 0.5) * 0.6 + 0.08 * sin(time * 0.6 + c);
comp_10=`  float top = 1.0 - hgt;
comp_11=`  float t = saturate((u.y - top) / hgt);
comp_12=`  float w = 0.22 * (0.6 + 0.4 * n.z) * t;
comp_13=`  float blade = step(abs(f - lean * (1.0 - t)), w * (0.25 + t)) * step(top, u.y);
comp_14=`  return blade;
comp_15=`}
comp_16=`shader_body
comp_17=`{
comp_18=`  float3 sky = lerp(float3(0.16, 0.12, 0.28), float3(0.02, 0.02, 0.07), saturate(1.0 - uv.y * 1.5));
comp_19=`  sky += float3(0.35, 0.18, 0.12) * exp(-abs(uv.y - 0.62) * 9.0) * 0.5;
comp_20=`  float4 st = tex2D(sampler_pw_noise_lq, uv * texsize.xy / 512.0);
comp_21=`  sky += saturate((st.x * st.y - 0.982) * 50.0) * step(uv.y, 0.45) * (0.5 + 0.5 * sin(time * 1.7 + st.z * 20.0));
comp_22=`  float crown = tex3D(sampler_noisevol_hq, float3(uv.x * 1.6, 0.2, 0.3)).x * 0.06 + tex3D(sampler_noisevol_hq, float3(uv.x * 7.0, 0.6, 0.1)).x * 0.025;
comp_23=`  float tree = smoothstep(0.6 - crown - 0.002, 0.6 - crown + 0.002, uv.y);
comp_24=`  float3 col = lerp(sky, float3(0.015, 0.02, 0.03), tree);
comp_25=`  float3 fly = tex2D(sampler_main, uv).xyz;
comp_26=`  float3 halo = GetBlur1(uv) * 1.2 + GetBlur2(uv) * 0.9 + GetBlur3(uv) * 0.6;
comp_27=`  float mist = exp(-abs(uv.y - 0.7) * 7.0) * (0.5 + 0.5 * tex3D(sampler_noisevol_hq, float3(uv * float2(2.0, 0.8), q1)).x);
comp_28=`  col += float3(0.25, 0.3, 0.35) * mist * 0.18 + halo * float3(0.7, 0.9, 0.35) * (0.5 + mist);
comp_29=`  col += fly * 1.4;
comp_30=`  float g1 = grass(uv, 70.0, 0.22, 3.0);
comp_31=`  float g2 = grass(uv + float2(0.37, 0.0), 120.0, 0.14, 11.0);
comp_32=`  col = lerp(col, float3(0.01, 0.015, 0.012) + halo * 0.15, g1);
comp_33=`  col = lerp(col, float3(0.005, 0.008, 0.006), g2);
comp_34=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.6;
comp_35=`  ret = 1.0 - exp(-col * 1.5);
comp_36=`}
