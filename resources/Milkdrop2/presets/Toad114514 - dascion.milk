shape_1_per_frame1=r = .5 + .3 * sin(time);
shape_1_per_frame2=g = .5 + .3 * sin(time/1.5);
shape_1_per_frame3=b = .5 + .3 * sin(time/3.7);
shape_1_per_frame4=
