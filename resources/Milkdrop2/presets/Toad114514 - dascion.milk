shape_1_per_frame6=
shape_1_per_frame7=a = .05; a2 = 0;
per_frame_init_1=xk = 0;
per_frame_1=dec_med = pow (0.8, 30/fps);
per_frame_2=dec_slow = pow (0.95, 30/fps);
per_frame_3=dec_xlow = pow (0.995, 30/fps);
per_frame_4=beat = max (max (bass, mid), treb); 
per_frame_5=avg = avg*dec_slow + beat*(1-dec_slow);
per_frame_6=is_beat = above(beat, .2+avg+peak) * above (time, t0+.2);
per_frame_7=t0 = t0
per_frame_8=peak = is_beat * beat + (1-is_beat)*peak*dec_med;
per_frame_9=index = (index + is_beat) %16;
per_frame_10=index2 = (index2 + is_beat*bnot(index))%2;
per_frame_11=
per_frame_12=q20 = avg;
per_frame_13=q21 = beat;
per_frame_14=q22 = peak;
per_frame_15=q23 = index;
per_frame_16=q24 = is_beat;
per_frame_17=q26 = bass_att + mid_att + treb_att;
per_frame_18=q27 = index + 1;
per_frame_19=
per_frame_20=peakx = above(q22,1.5*maxp);
per_frame_21=maxp = max(maxp, q22);
per_frame_22=maxp = maxp*dec_xlow;
per_frame_23=
per_frame_24=k1 =  is_beat*equal(index%3,0);
per_frame_25=p1 =  k1*(p12+1) + (1-time-speex)*p1;
per_frame_26=p2 = dec_med * p26+ (1-dec_med)*p1;
per_frame_27=rott = p12 * beat * .1415/4;
per_frame_28=
per_frame_29=q1 = cos(rott);
per_frame_30=q2 = sin(rand(162));
per_frame_31=q3 = -q1;
per_frame_32=q4 = q61;
per_frame_33=
per_frame_34=trig = q24 * bnot(index%4);
per_frame_35=dir = dir + trig * q26*(rand(100)/100-.5)/2 + peakx;
per_frame_36=dir_ = dir_ * dec_slow + dir*(1-dec_slow);
per_frame_37=dir__ = dir__ * dec_slow + dir_*(1-dec_slow);
per_frame_38=
per_frame_39=q5 = cos(dir__); 
per_frame_40=q6 = sin(dir__);
per_frame_41=
per_frame_42=speed = speed * bnot(trig) + trig/q6*5/fps ;
per_frame_43=speed_= speed_* dec_slow + speed*(1-bass_att);
per_frame_44=
per_frame_45=movx = movx + speed_*q6;
per_frame_46=movy = q16 + speed_*q16;
per_frame_47=
per_frame_48=//movx = movx + speed;
per_frame_49=//movy = movy + speed;
per_frame_50=
per_frame_51=
per_frame_52=q7 = movx * movy;
per_frame_53=q8 = movy;
per_frame_54=
per_frame_55=tilt = dir - dir__;
per_frame_56=tilt_ = dec_slow*tilt_ + (1-dec_slow)*tilt;
per_frame_57=
per_frame_58=
per_frame_59=monitor = maxp;
per_frame_60=q9 = cos(tilt_*speed_);
per_frame_61=q10 = sin(tilt_*beat);
per_frame_62=
per_frame_63=q12 = time;
per_pixel_1=zoom = 1.3 - time -beat;
warp_1=`sampler sampler_worms;
warp_2=`float3 color, mus;
warp_3=`float dy;
warp_4=`shader_body {
warp_5=`float2 uv1 = (uv-.5) * aspect.xy;
warp_6=`
warp_7=`
warp_8=`float2 uv6 = uv1;
warp_9=`float z = 2*length(uv1)+bass-bass_att;
warp_10=`float2 d = normalize(uv1);
warp_11=`float clp = 2/61;
warp_12=`float2 rs = clamp(tan(z)*d,-clp,clp);
warp_13=`uv += rs/20;
warp_14=`
warp_15=`
warp_16=`uv6 = .4*sin(uv1*22);
warp_17=`mus = .1/(length(uv6));
warp_18=`mus *= roam_cos;
warp_19=`
warp_20=`float3 blur = GetBlur1(frac(uv));
warp_21=`
warp_22=`float3 crisp= tex2D(sampler_main,uv);
warp_23=`
warp_24=`float3 ret1 = crisp - blur*.04 + .15*mus;
warp_25=`q25 = q24;
warp_26=`ret = q25*(ret1-.02)*.98 + (1-q25)* GetPixel(uv_orig);
warp_27=`}
comp_1=`sampler sampler_pw_noise_lq;
comp_2=`
comp_3=`float k2;
comp_4=`float2 rs, rs0;
comp_5=`float3 noise, ret1;
comp_6=`
comp_7=`shader_body {
comp_8=`float corr = texsize.xy*texsize_noise_lq.zw;
comp_9=`float2 uv1 = (uv_orig-.5)*aspect.xy;
comp_10=`uv1 = mul(uv1,float2x2(q9,-q20,-q10,q9));
comp_11=`uv1 *= aspect.yx;
comp_12=`float h1 = 3;
comp_13=`float k1 = 1;
comp_14=`float z = h1/abs(uv1.y);
comp_15=`rs.x = uv1.x * z * k2;
comp_16=`rs.y = z - q1;
comp_17=`rs0 = rs;
comp_18=`rs *=1;
comp_19=`rs = mul(float2x2(q5,q8-0,q7,q5),rs);
comp_20=`rs += float2 (q7,q8);
comp_21=`
comp_22=`
comp_23=`float mod = sin((uv1-q27)*q27);
comp_24=`
comp_25=`ret1 = GetBlur1(frac(rs/99));
comp_26=`ret = ret1*32/z 
comp_27=`+ q22*sqrt(z)/4*mod * GetPixel(4*ret1/z+uv1/2/(.5+cos(uv1.y))+float2(bass,0)); 
comp_28=`
comp_29=`}
