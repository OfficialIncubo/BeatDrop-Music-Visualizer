warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float specLog(float x)
warp_7=`{
warp_8=`    return get_fft(pow(saturate(x), 1.8));
warp_9=`}
warp_10=`
warp_11=`float3 hsv(float h, float s, float v)
warp_12=`{
warp_13=`    float4 k = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
warp_14=`    float3 p = abs(frac(h + k.xyz) * 6.0 - k.www);
warp_15=`    return v * lerp(k.xxx, saturate(p - k.xxx), s);
warp_16=`}
warp_17=`
warp_18=`shader_body
warp_19=`{
warp_20=`    uv.y = 1.0 - uv.y;
warp_21=`     // Standardized Spotiamp+ UV scaling
warp_22=`    float2 my_uv = uv - 0.5;
warp_23=`    my_uv.x /= aspect.y;
warp_24=`    float r = length(my_uv);
warp_25=`    float a = atan2(my_uv.y, my_uv.x);
warp_26=`
warp_27=`    float petals = 12.0;
warp_28=`    float u2 = frac((a + time * 0.3) / 6.2831853 + 1000.0) * petals;
warp_29=`    float seg = floor(u2);
warp_30=`    float local = frac(u2) - 0.5;
warp_31=`    float len = 0.12 + specLog((seg + 0.5) / petals) * 0.33;
warp_32=`    float edge = len * sqrt(max(1.0 - abs(local) * 2.0, 0.0));
warp_33=`    float petal = smoothstep(edge + 0.01, edge - 0.01, r) * step(0.03, r);
warp_34=`
warp_35=`    float3 col = hsv(frac(seg / petals * 0.3 + time * 0.1), 0.7, 1.0) * petal * (0.4 + r / len * 0.8);
warp_36=`    col += float3(1.0, 0.9, 0.4) * smoothstep(0.05, 0.03, r) * (0.8 + bass);
warp_37=`
warp_38=`    ret = col;
warp_39=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
