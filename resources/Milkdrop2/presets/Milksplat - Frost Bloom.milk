warp_58=`if(q30>0.5) {
warp_59=`
warp_60=`float2 pos=float2((uv_orig.x-0.5)*texsize.x*texsize.w,0.5-uv_orig.y);
warp_61=`float3 previous=ms8_decode(tex2Dlod(sampler_pc_main,float4(uv_orig,0.00000001,0.00000001))).rgb;
warp_62=`float sd=ms_frost_shape(pos);
