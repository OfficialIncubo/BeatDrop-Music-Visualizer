warp_1=`// MILKSPLAT PORT CREDIT BEGIN
warp_2=`// Original preset: Frost Bloom by Milksplat.
warp_3=`// Copyright (c) 2026 Milksplat contributors.
warp_4=`// Original license: MIT OR Apache-2.0; see bundled licenses.
warp_5=`// Source: https://github.com/delphium226/milksplat/blob/dc87fd6a854f544b0a20bfd801055e4850e1e328/presets/frost-bloom.splat
warp_6=`// Adapted to MilkDrop 2 / BeatDrop HLSL (Shader Model 3, 8-bit feedback).
warp_7=`// MILKSPLAT PORT CREDIT END
warp_8=`float4 ms8_decode(float4 v) {
warp_9=`float r=floor(v.r*255.0+0.5),g=floor(v.g*255.0+0.5);
warp_10=`float width=floor(g/16.0);
warp_11=`float bits=r*16.0+g-width*16.0;
warp_12=`float d=bits>=4094.5?9.0:bits*(0.6/4094.0);
warp_13=`return float4(d,0.08*(width/15.0)*(width/15.0),v.b,v.a);
warp_14=`}
warp_15=`
warp_16=`float ms_dot2(float2 v,float2 w){return v.x*w.x+v.y*w.y+0.00000001;}
warp_17=`float ms_length2(float2 v){return sqrt(v.x*v.x+v.y*v.y+0.00000001);}
warp_18=`float ms_frost_branch(float2 pos,float k,float origin,float spacing,float branchlength,float width) {
warp_19=`float xk=origin+k*spacing;
warp_20=`float hk=frac(sin(k*12.9898+q9*78.233)*43758.5453);
warp_21=`float xf=xk/0.46;
warp_22=`float lk=0.46*branchlength*3.2*xf*(1.0-xf)*(0.75+0.5*hk);
warp_23=`float wb=width*0.7;
warp_24=`float2 dv=pos-float2(xk,0.00000001);
warp_25=`float al=ms_dot2(dv,float2(0.5,0.866));
warp_26=`float perp=ms_dot2(dv,float2(-0.866,0.5));
warp_27=`float branchsd=min(min(wb*(1.0-0.6*al/max(lk,0.001))-abs(perp),al+wb),lk-al);
warp_28=`float sp2=spacing*0.42;
warp_29=`float tj=clamp(floor(al/sp2+0.5),1.0,12.0)*sp2;
warp_30=`float lt=(lk-tj)*0.5*branchlength/0.32;
warp_31=`float2 delta=pos-(float2(xk,0.00000001)+float2(0.5,0.866)*tj);
warp_32=`float wt=wb*0.6;
warp_33=`float sd1=min(min(wt-abs(delta.y),delta.x+wt),lt-delta.x);
warp_34=`float a2=ms_dot2(delta,float2(-0.5,0.866));
warp_35=`float p2=ms_dot2(delta,float2(-0.866,-0.5));
warp_36=`float sd2=min(min(wt-abs(p2),a2+wt),lt*0.7-a2);
warp_37=`float twigs=lerp(-9.0,max(sd1,sd2),1.0-step(lk*0.85,tj));
warp_38=`return lerp(-9.0,max(branchsd,twigs),step(0.00000001,k)*step(xk,0.46*0.92));
warp_39=`}
warp_40=`float ms_frost_shape(float2 pos) {
warp_41=`float ct=cos(q4),st=sin(q4);
warp_42=`float2 pr=float2(ct*pos.x-st*pos.y,st*pos.x+ct*pos.y);
warp_43=`float2 folded=abs(pr);
warp_44=`float2 n60=float2(-0.8660254,0.5);
warp_45=`float2 n30=float2(-0.5,0.8660254);
warp_46=`folded-=2.0*max(ms_dot2(folded,n60),0.00000001)*n60;
warp_47=`folded-=2.0*max(ms_dot2(folded,n30),0.00000001)*n30;
warp_48=`float sd=q5*0.866-ms_dot2(folded,float2(0.866,0.5));
warp_49=`sd=max(sd,min(q8*(1.0-0.55*folded.x/0.46)-folded.y,0.46-folded.x));
warp_50=`float origin=q5*0.9;
warp_51=`float kn=clamp(floor((folded.x-origin)/q6),0.00000001,20.0);
warp_52=`sd=max(sd,ms_frost_branch(folded,kn-1.0,origin,q6,q7,q8));
warp_53=`sd=max(sd,ms_frost_branch(folded,kn,origin,q6,q7,q8));
warp_54=`sd=max(sd,ms_frost_branch(folded,kn+1.0,origin,q6,q7,q8));
warp_55=`return sd;
warp_56=`}
