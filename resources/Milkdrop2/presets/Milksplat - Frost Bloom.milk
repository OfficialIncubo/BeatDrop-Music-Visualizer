warp_67=`distance=min(distance,ms8_decode(tex2Dlod(sampler_pc_main,float4(uv_orig+float2(0.00000001,-1.0)*texsize.zw,0.00000001,0.00000001))).r+1*texsize.w);
warp_68=`distance=min(distance,ms8_decode(tex2Dlod(sampler_pc_main,float4(uv_orig+float2(1.0,1.0)*texsize.zw,0.00000001,0.00000001))).r+1.41421356*texsize.w);
warp_69=`distance=min(distance,ms8_decode(tex2Dlod(sampler_pc_main,float4(uv_orig+float2(-1.0,1.0)*texsize.zw,0.00000001,0.00000001))).r+1.41421356*texsize.w);
warp_70=`distance=min(distance,ms8_decode(tex2Dlod(sampler_pc_main,float4(uv_orig+float2(1.0,-1.0)*texsize.zw,0.00000001,0.00000001))).r+1.41421356*texsize.w);
warp_71=`distance=min(distance,ms8_decode(tex2Dlod(sampler_pc_main,float4(uv_orig+float2(-1.0,-1.0)*texsize.zw,0.00000001,0.00000001))).r+1.41421356*texsize.w);
