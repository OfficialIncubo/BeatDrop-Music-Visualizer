per_frame_1=q25=min(max((bass-bass_att)*1.85,0),1.50);
per_frame_2=q26=min(max((mid-mid_att)*1.65,0),1.35);
per_frame_3=q27=min(max((treb-treb_att)*1.80,0),1.35);
per_frame_4=q28=min(max((bass_att-0.78)*1.15,0),1.25);
per_frame_5=q29=max(q25,q29*0.58);
per_frame_6=q30=max(q26,q30*0.50);
per_frame_7=q31=max(q27,q31*0.34);
per_frame_8=q32=min(max((bass_att+mid_att+treb_att)/3-0.72,0),1.20);
per_frame_9=wave_r=0.50+0.25*sin(1.4*time)+0.25*sin(2.25*time)+0.24*q29;
per_frame_10=wave_g=0.50+0.25*sin(1.7*time)+0.25*sin(2.11*time)+0.22*q30;
per_frame_11=wave_b=0.50+0.25*sin(1.84*time)+0.25*sin(2.3*time)+0.30*q31;
per_frame_12=warp=0;
per_frame_13=ib_r=wave_b+0.22*q31;
per_frame_14=ib_g=wave_r+0.18*q30;
per_frame_15=ib_b=wave_g+0.20*q31;
per_frame_16=ob_r=wave_r*sin(wave_b)+0.34*q29;
per_frame_17=ob_g=wave_g*sin(wave_r)+0.28*q30;
per_frame_18=ob_b=wave_b*sin(wave_g)+0.38*q31;
per_frame_19=ob_size=0.18+0.085*q29+0.006*q32;
per_frame_20=ib_size=0.042+0.052*q30+0.014*q31;
per_frame_21=ob_a=0.44+0.30*q29+0.04*q32;
per_frame_22=ib_a=0.40+0.26*q30+0.16*q31;
per_frame_23=wave_scale=1.46+0.38*q29+0.22*q31;
per_frame_24=wave_a=0.56+0.22*q30+0.22*q31;
per_frame_25=zoom=zoom-0.05-0.006*q28;
per_pixel_1=thresh=above(bass_att,thresh)*2+(1-above(bass_att,thresh))*((thresh-1.3)*0.96+1.3);
per_pixel_2=dx_r=equal(thresh,2)*0.015*sin(5*time)+(1-equal(thresh,2))*dx_r;
per_pixel_3=dy_r=equal(thresh,2)*0.015*sin(6*time)+(1-equal(thresh,2))*dy_r;
per_pixel_4=rot=rot+rad*(1.1*sin(time)-rad)*0.38;
per_pixel_5=rot=rot+above(rad,0.7-0.2*sin(bass))*0.025;
per_pixel_6=rot=rot+q29*0.060*(0.35+rad)+q30*0.080*(1-0.45*rad)*sin(2*ang)+q31*0.018*sin(16*ang+6*time);
per_pixel_7=zoom=zoom-above(rad,0.5+0.1*sin(1-rad*cos(time)))*below((0.5*sin(time))-rad,0.5)*0.09*rad;
per_pixel_8=zoom=zoom+below(rad,0.75+0.5*sin(bass*time))*0.025;
per_pixel_9=zoom=zoom-0.02*((sin(time)-rad)*1-rad);
per_pixel_10=zoom=zoom+0.03*(0.10+(1+rad))*below(rad,0.1)*above(bass,1);
per_pixel_11=zoom=zoom+q29*(0.10+0.14*(1-rad))+q28*0.012*(0.70-rad);
per_pixel_12=cx=cx+q30*0.030*sin(2*ang+time)*(1-rad)+q31*0.007*sin(12*ang);
per_pixel_13=cy=cy+q30*0.030*cos(2*ang-time)*(1-rad)+q31*0.007*cos(14*ang);
per_pixel_14=dx=dx+q31*0.005*cos(18*ang-7*time)*(1-rad);
per_pixel_15=dy=dy+q31*0.005*sin(20*ang+8*time)*(1-rad);
