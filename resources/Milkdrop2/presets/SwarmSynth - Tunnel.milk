wave_0_per_point1=i = int(sample*479 + 0.5);
wave_0_per_point2=v = (value1 + value2)*0.5;
wave_0_per_point3=gmegabuf(i) = v;
wave_0_per_point4=st = equal(i, 0);
wave_0_per_point5=pk = if(st, 0, pk); nc = if(st, 0, nc); fc = if(st, 0, fc); lc = if(st, 0, lc); arm = if(st, 0, arm);
wave_0_per_point6=pk = max(pk, abs(v));
wave_0_per_point7=arm = if(below(v, -0.08*gmegabuf(1001)), 1, arm);
wave_0_per_point8=c_ = arm*above(v, 0);
wave_0_per_point9=gmegabuf(1100 + nc) = if(c_, i, gmegabuf(1100 + nc));
wave_0_per_point10=nc = nc + c_; fc = if(c_*equal(nc, 1), i, fc); lc = if(c_, i, lc); arm = arm*(1 - c_);
wave_0_per_point11=en = equal(i, 479);
wave_0_per_point12=pr = if(above(nc, 1), (lc - fc)/(nc - 1), 240);
wave_0_per_point13=gmegabuf(1002) = if(en, gmegabuf(1002)*0.85 + min(240, max(8, pr))*0.15, gmegabuf(1002));
wave_0_per_point14=gmegabuf(1003) = if(en, if(nc, lc, 470), gmegabuf(1003));
wave_0_per_point15=gmegabuf(1004) = if(en, nc, gmegabuf(1004));
wave_0_per_point16=gmegabuf(1001) = if(en, max(max(pk, gmegabuf(1001)*0.985), 0.004), gmegabuf(1001));
wavecode_1_enabled=1
wavecode_1_samples=504
wavecode_1_sep=0
wavecode_1_bSpectrum=0
wavecode_1_bUseDots=0
wavecode_1_bDrawThick=0
wavecode_1_bAdditive=1
wavecode_1_scaling=1.00000
wavecode_1_smoothing=0.00000
wavecode_1_r=1.000
wavecode_1_g=1.000
wavecode_1_b=1.000
wavecode_1_a=1.000
wave_1_per_point1=gn = 0.9/gmegabuf(1001);
wave_1_per_point2=j = int(sample*503 + 0.5);
wave_1_per_point3=k_ = int(j/63); i_ = j - k_*63;
wave_1_per_point4=n = k_*63 + (i_ + 1) % 63;
wave_1_per_point5=vv = above(i_, 0);
wave_1_per_point6=vo = vv;
wave_1_per_point7=k_ = int(n/63); i_ = n - k_*63;
wave_1_per_point8=vx = gmegabuf((int(q15 - k_*q16 - q16 + i_*q16/63) + 48000) % 480)*gn;
wave_1_per_point9=wt = 1/(1 + k_*0.330); sw_ = (1 - wt)*0.5;
wave_1_per_point10=rd = 0.55 + 0.4*vx;
wave_1_per_point11=an = 6.2831853*i_/63 + q1;
wave_1_per_point12=px = rd*cos(an)*wt + sw_*sin(q1*0.7); py = rd*sin(an)*wt + sw_*cos(q1*0.5);
wave_1_per_point13=dd = 1 - k_/8; vv = 1;
wave_1_per_point14=fc_ = 1 - q8*(1 - dd);
wave_1_per_point15=rx = px*cos(q10) - py*sin(q10); ry = px*sin(q10) + py*cos(q10);
wave_1_per_point16=x = 0.5 + rx*q7*q32; y = 0.5 - ry*q7*q29;
wave_1_per_point17=a = vo*vv*0.245*(0.25 + 0.75*fc_);
wavecode_2_enabled=1
wavecode_2_samples=504
wavecode_2_sep=0
wavecode_2_bSpectrum=0
wavecode_2_bUseDots=1
wavecode_2_bDrawThick=1
wavecode_2_bAdditive=1
wavecode_2_scaling=1.00000
wavecode_2_smoothing=0.00000
