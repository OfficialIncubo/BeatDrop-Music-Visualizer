wavecode_2_g=1.000
wavecode_2_b=1.000
wavecode_2_a=1.000
wave_2_per_point1=gn = 0.9/gmegabuf(1001);
wave_2_per_point2=n = int(sample*503 + 0.5);
wave_2_per_point3=k_ = int(n/63); i_ = n - k_*63;
wave_2_per_point4=vx = gmegabuf((int(q15 - k_*q16 - q16 + i_*q16/63) + 48000) % 480)*gn;
wave_2_per_point5=wt = 1/(1 + k_*0.330); sw_ = (1 - wt)*0.5;
wave_2_per_point6=rd = 0.55 + 0.4*vx;
wave_2_per_point7=an = 6.2831853*i_/63 + q1;
wave_2_per_point8=px = rd*cos(an)*wt + sw_*sin(q1*0.7); py = rd*sin(an)*wt + sw_*cos(q1*0.5);
wave_2_per_point9=dd = 1 - k_/8; vv = 1;
wave_2_per_point10=fc_ = 1 - q8*(1 - dd);
wave_2_per_point11=rx = px*cos(q10) - py*sin(q10); ry = px*sin(q10) + py*cos(q10);
wave_2_per_point12=x = 0.5 + rx*q7*q32; y = 0.5 - ry*q7*q29;
wave_2_per_point13=a = vv*0.495*(0.25 + 0.75*fc_);
wavecode_3_enabled=1
