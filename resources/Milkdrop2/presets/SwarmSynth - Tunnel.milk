wavecode_3_g=1.000
wavecode_3_b=1.000
wavecode_3_a=1.000
wave_3_per_point1=gn = 0.9/gmegabuf(1001);
wave_3_per_point2=j = int(sample*503 + 0.5);
wave_3_per_point3=i_ = int(j/8); k_ = j - i_*8;
wave_3_per_point4=n = k_*63 + i_;
wave_3_per_point5=vv = above(k_, 0);
wave_3_per_point6=vo = vv;
wave_3_per_point7=k_ = int(n/63); i_ = n - k_*63;
wave_3_per_point8=vx = gmegabuf((int(q15 - k_*q16 - q16 + i_*q16/63) + 48000) % 480)*gn;
wave_3_per_point9=wt = 1/(1 + k_*0.330); sw_ = (1 - wt)*0.5;
wave_3_per_point10=rd = 0.55 + 0.4*vx;
wave_3_per_point11=an = 6.2831853*i_/63 + q1;
wave_3_per_point12=px = rd*cos(an)*wt + sw_*sin(q1*0.7); py = rd*sin(an)*wt + sw_*cos(q1*0.5);
wave_3_per_point13=dd = 1 - k_/8; vv = 1;
wave_3_per_point14=fc_ = 1 - q8*(1 - dd);
wave_3_per_point15=rx = px*cos(q10) - py*sin(q10); ry = px*sin(q10) + py*cos(q10);
wave_3_per_point16=x = 0.5 + rx*q7*q32; y = 0.5 - ry*q7*q29;
wave_3_per_point17=a = vo*vv*0.245*(0.25 + 0.75*fc_);
per_frame_init_1=hd_ = 0; dir_ = 1; ay_ = 0; ax_ = 0; ft_ = 0; t4_ = 0; lt_ = 0; lh_ = 0; pn_ = 0;
per_frame_init_2=gmegabuf(1001) = 0.1; gmegabuf(1002) = 100; gmegabuf(1003) = 470; gmegabuf(1004) = 0;
per_frame_1=dt_ = min(0.25, max(0, time - lt_)); lt_ = time;
per_frame_2=hit = above(bass, 1.4)*above(bass, bass_att*1.2)*above(time - lh_, 0.25); lh_ = if(hit, time, lh_);
per_frame_3=dir_ = if(0*hit, -dir_, dir_);
per_frame_4=ay_ = ay_ + dir_*0.3000*dt_;
per_frame_5=ax_ = ax_ + dir_*0.0000*dt_;
per_frame_6=ft_ = ft_ + 0.0000*dt_;
per_frame_7=t4_ = t4_ + 0.2700*dt_;
per_frame_8=q1 = ay_; q2 = 0.4363 + ax_; q3 = 4.800;
per_frame_9=pn_ = pn_*0.8 + 0.2*min(1, max(0, (bass_att - 0.8)/1.2));
per_frame_10=q7 = 0.4400*(1 + 0.0000*pn_);
per_frame_11=q8 = 0.700;
per_frame_12=q10 = 0.0000 + ft_; q28 = q10; q27 = 6;
per_frame_13=q11 = 96; q12 = 1.6 + 1.4*sin(time*0.7);
per_frame_14=q13 = min(240, max(8, gmegabuf(1002)));
per_frame_15=q16 = q13;
per_frame_16=q14 = max(1, min(110, q16*0.2500*(1 + 0.0000*sin(time*0.35))));
per_frame_17=q15 = gmegabuf(1003);
per_frame_18=q6 = min(q16*2.000, max(40, 470 - 6*q14))/504;
per_frame_19=q30 = 0.600;
per_frame_20=q26 = time*0.03 + bass_att*0.04;
per_frame_21=q32 = min(1, pixelsy/pixelsx); q29 = min(1, pixelsx/pixelsy);
per_frame_22=q17 = cos(t4_); q18 = sin(t4_);
per_frame_23=q19 = cos(t4_*0.73 + 0.6); q20 = sin(t4_*0.73 + 0.6);
per_frame_24=q21 = cos(t4_*0.41 + 1.1); q22 = sin(t4_*0.41 + 1.1);
warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_main, uv).xyz*q30;
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float2 sc = float2(q32, q29);
comp_4=`    float2 d = (uv - 0.5)/sc; d.y = -d.y;   // y up, as SwarmSynth
comp_5=`    float3 c = tex2D(sampler_main, uv).xyz;
comp_6=`    float3 o = 1 - exp(-c*2.2);
comp_7=`    ret = o;
comp_8=`}
