MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5.000
fGammaAdj=1.900
fDecay=0.970
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=1
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=1.000
fWaveSmoothing=0.630
fWaveParam=-1.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.331
fZoomExponent=1.00000
fShader=0.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=1.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_init_1=q1=0.0;
per_frame_init_2=q2=40.0;
per_frame_init_3=q5=0.0;
per_frame_init_4=q6=0.0;
per_frame_init_5=time_delay=0.0;
per_frame_init_6=rand_laser = rand(100);
per_frame_1=time_delay = if(time_delay >= .35 && (bass+mid+treb)*.5 > 1.8, 0, time_delay += 1/fps);
per_frame_2=rand_laser = if(time_delay == 0, rand(100), rand_laser); // Random seed from 0 to 100
per_frame_3=
per_frame_4=// We MUST assign these to Q variables so the comp shader can communicate with them
per_frame_5=q1 = rand_laser; // Tells the shader which pattern/color to use
per_frame_6=q2 = time_delay; // Tells the shader when a beat triggers (0 = beat)
per_frame_7=q3 = bass;       // Used for smooth, non-seizure brightness pulsing
warp_1=`shader_body{}
comp_1=`// Math function to draw a glowing 2D laser beam
comp_2=`// Notice the new 'focus' parameter to control beam width dynamically
comp_3=`float3 GetLaser(float2 uva, float2 origin, float angle, float3 color_vec, float focus) {
comp_4=`    float2 p = uva - origin;
comp_5=`    
comp_6=`    float2 dir = float2(cos(angle), sin(angle));
comp_7=`    float2 n = float2(-dir.y, dir.x);
comp_8=`    
comp_9=`    float line_dist = abs(dot(p, n));
comp_10=`    float along = dot(p, dir);
comp_11=`    
comp_12=`    // Core becomes tighter when 'focus' is higher
comp_13=`    float core = exp(-line_dist * (4000.0 * focus));
comp_14=`    float glow = 0.0015 / (line_dist + 0.0005);
comp_15=`    
comp_16=`    float intensity = (core + glow) * smoothstep(-0.02, 0.1, along);
comp_17=`    return color_vec * intensity;
comp_18=`}
comp_19=`
comp_20=`shader_body
comp_21=`{
comp_22=`    // 1. DYNAMIC COLOR & PATTERN SELECTION
comp_23=`    float seed = q1; 
comp_24=`    float f_mode = fmod(seed, 4.0);
comp_25=`    float col_sel = fmod(seed * 3.14, 4.0); 
comp_26=`    
comp_27=`    float3 col1, col2;
comp_28=`    if (col_sel < 1.0) {
comp_29=`        col1 = float3(1.0, 0.0, 0.5); // Synth Pink
comp_30=`        col2 = float3(0.0, 1.0, 0.8); // Miami Cyan
comp_31=`    } else if (col_sel < 2.0) {
comp_32=`        col1 = float3(0.5, 1.0, 0.0); // Toxic Lime
comp_33=`        col2 = float3(1.0, 0.3, 0.0); // Flare Orange
comp_34=`    } else if (col_sel < 3.0) {
comp_35=`        col1 = float3(0.4, 0.0, 1.0); // Deep Violet
comp_36=`        col2 = float3(0.1, 0.4, 1.0); // Plasma Blue
comp_37=`    } else {
comp_38=`        col1 = float3(1.0, 0.8, 0.2); // Golden Light
comp_39=`        col2 = float3(1.0, 1.0, 1.0); // Pure White
comp_40=`    }
comp_41=`
comp_42=`    // 2. BACKGROUND & SMOKE
comp_43=`    // Create a subtle scrolling grid to give the illusion of a club ceiling/floor
comp_44=`    float grid = abs(frac(uv.y * 10.0 + time * 0.5) - 0.5) + abs(frac(uv.x * 10.0 + time * 0.3) - 0.5);
comp_45=`    float3 bg = float3(0.05, 0.05, 0.05) / (grid + 0.1);
comp_46=`    
comp_47=`    // Blend with MilkDrop's blur buffers for ambient smoke
comp_48=`    float3 smoke = GetBlur2(uv).rgb * 0.8;
comp_49=`    bg = lerp(bg, smoke * col2, 0.4) * 0.5;
comp_50=`
comp_51=`    // 3. ADVANCED BEAT REACTIVITY
comp_52=`    float beat_strike = exp(-q2 * 4.0); // Sharp transient (1.0 on beat, decays toward 0)
comp_53=`    float slow_pulse = 0.7 + 0.3 * sin(time * 3.0 + q3 * 0.4);
comp_54=`    
comp_55=`    // Beams get extremely tight/focused exactly on the beat, then widen out
comp_56=`    float beam_focus = 1.0 + beat_strike * 3.0; 
comp_57=`
comp_58=`    // 4. LASER RENDERER
comp_59=`    float3 lasers = float3(0, 0, 0);
comp_60=`
comp_61=`    if (f_mode < 1.0) {
comp_62=`        // MODE 0: Perimeter Cage (Shooting horizontally from walls)
comp_63=`        for (int i = 0; i < 8; i++) {
comp_64=`            float f = i / 7.0;
comp_65=`            float y_pos = 0.1 + f * 0.8;
comp_66=`            
comp_67=`            // Left wall
comp_68=`            float2 o_L = float2(0.0, y_pos);
comp_69=`            float a_L = 0.0 + sin(time * 2.0 + i) * 0.2 + beat_strike * 0.1;
comp_70=`            lasers += GetLaser(uv, o_L, a_L, col1, beam_focus);
comp_71=`            
comp_72=`            // Right wall
comp_73=`            float2 o_R = float2(1.0, y_pos);
comp_74=`            float a_R = 3.14 + sin(time * 2.1 - i) * 0.2 - beat_strike * 0.1;
comp_75=`            lasers += GetLaser(uv, o_R, a_R, col2, beam_focus);
comp_76=`        }
comp_77=`    } 
comp_78=`    else if (f_mode < 2.0) {
comp_79=`        // MODE 1: Triangle Sweeper (Top center + Bottom corners)
comp_80=`        float2 o_T = float2(0.5, 0.9);
comp_81=`        float2 o_BL = float2(0.1, 0.1);
comp_82=`        float2 o_BR = float2(0.9, 0.1);
comp_83=`        
comp_84=`        for(int i = 0; i < 6; i++) {
comp_85=`            float f = i / 5.0;
comp_86=`            float sweep = sin(time * 1.5 + f * 3.14);
comp_87=`            
comp_88=`            lasers += GetLaser(uv, o_T, -1.57 + sweep * 0.8, col1, beam_focus);
comp_89=`            lasers += GetLaser(uv, o_BL, 0.5 + sweep * 0.5, col2, beam_focus);
comp_90=`            lasers += GetLaser(uv, o_BR, 2.64 - sweep * 0.5, lerp(col1, col2, 0.5), beam_focus);
comp_91=`        }
comp_92=`    }
comp_93=`    else if (f_mode < 3.0) {
comp_94=`        // MODE 2: Double Helix Twist
comp_95=`        for(int i = 0; i < 16; i++) {
comp_96=`            float f = i / 15.0;
comp_97=`            float offset = sin(time * 2.0 + f * 6.28) * 0.3;
comp_98=`            float2 origin1 = float2(0.5 + offset, -0.1);
comp_99=`            float2 origin2 = float2(0.5 - offset, 1.1);
comp_100=`            
comp_101=`            float angle1 = 1.57 + sin(time + i * 0.2) * 0.3;
comp_102=`            float angle2 = -1.57 + cos(time + i * 0.2) * 0.3;
comp_103=`            
comp_104=`            lasers += GetLaser(uv, origin1, angle1, col1, beam_focus);
comp_105=`            lasers += GetLaser(uv, origin2, angle2, col2, beam_focus);
comp_106=`        }
comp_107=`    }
comp_108=`    else {
comp_109=`        // MODE 3: Chaos Bouncers (Top/Bottom arrays snapping to the beat)
comp_110=`        for(int i = 0; i < 10; i++) {
comp_111=`            float f = i / 9.0;
comp_112=`            float x_pos = 0.2 + f * 0.6;
comp_113=`            
comp_114=`            float2 o_Top = float2(x_pos, 1.0);
comp_115=`            float2 o_Bot = float2(x_pos, 0.0);
comp_116=`            
comp_117=`            // Angles get aggressively pushed outward when the beat hits
comp_118=`            float ang_T = -1.57 + sin(time * 4.0 + i) * 1.2 * beat_strike;
comp_119=`            float ang_B = 1.57 + cos(time * 4.0 - i) * 1.2 * beat_strike;
comp_120=`            
comp_121=`            lasers += GetLaser(uv, o_Top, ang_T, col1, beam_focus);
comp_122=`            lasers += GetLaser(uv, o_Bot, ang_B, col2, beam_focus);
comp_123=`        }
comp_124=`    }
comp_125=`
comp_126=`    // Apply global anti-seizure brightness pulse
comp_127=`    lasers *= slow_pulse;
comp_128=`
comp_129=`    // 5. CENTER FLARE
comp_130=`    // Adds a burst of light in the center of the screen strictly on the beat
comp_131=`    float center_flare = 0.02 / (length(uv - float2(0.5, 0.5)) + 0.01);
comp_132=`    float3 flare = center_flare * col1 * beat_strike * 0.5;
comp_133=`
comp_134=`    // Final Composition
comp_135=`    ret = bg + lasers + flare;
comp_136=`}
