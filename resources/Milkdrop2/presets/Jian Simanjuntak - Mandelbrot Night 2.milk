shapecode_3_g2=0.000
shapecode_3_b2=0.000
shapecode_3_a2=0.000
shapecode_3_border_r=0.200
shapecode_3_border_g=0.700
shapecode_3_border_b=0.500
shapecode_3_border_a=0.000
shape_3_per_frame1=sample = instance / num_inst;
shape_3_per_frame2=t_offset = sample * 12.56 + time * -0.3;
shape_3_per_frame3=y = 0.5 + 0.3 * sin(t_offset);
shape_3_per_frame4=x = 0.07+ 1.5 * sample; 
shape_3_per_frame5=z_depth = cos(t_offset);
shape_3_per_frame6=rad = 0.13 * (1 + 0.4 * z_depth);
per_frame_init_1=q1 = rand(100) / 100; // Bulan
per_frame_1=// ---- Bulan ----
per_frame_2=q1 = if(equal(frame, 0), rand(100) / 100, q1);
per_frame_3=
per_frame_4=q2 = 0.04; // Kecepatan pada awan
per_frame_5=
per_frame_6=// ---- Gerakan mandelbrot ----
per_frame_7=q4 = 1.6 + 0.8*sin(time*0.1);          // zoom
per_frame_8=q5 = -0.75; 
per_frame_9=q6 = time*0.25;             // pusat x, rotasi dasar
per_frame_10=q7 = 3 + 2;                // kekuatan twist
per_frame_11=q8 = time*0.08;                         // geser ke kanan
per_frame_12=
per_frame_13=wave_a = 0;
warp_1=`shader_body
warp_2=`{
warp_3=`    // Membuat pergeseran gelombang berbasis waktu dan posisi horizontal (uv.x)
warp_4=`    float wavehills = cos(uv.x * 14.0 - 0.6) * 0.10;
warp_5=`    
warp_6=`    // Menentukan batas ketinggian bukit (garis lengkung bergeser)
warp_7=`    float hill_line = 0.95 + wavehills;
warp_8=`
warp_9=`    // Pilihan Warna
warp_10=`    // Ubah nilai-nilai di bawah ini untuk mengganti warna sesuai selera Anda:
warp_11=`    float3 color_bottom = float3(0.0, 0.0, 0.0); 
warp_12=`    float3 color_top = float3(1.0, 1.0, 1.0);
warp_13=` 
warp_14=`    if (uv.y > hill_line)
warp_15=`    {
warp_16=`        ret = color_top;
warp_17=`    }
warp_18=`    else
warp_19=`    {
warp_20=`        ret = color_bottom;
warp_21=`    }
warp_22=`}
comp_1=`float3 line_color1, line_color2; // sky
comp_2=`
comp_3=`float rad_moon, dist_moon, circle_mask; // moon
comp_4=`float2 circle_pos;
comp_5=`float3 circle_color;
comp_6=`
comp_7=`float mir_clouds, cloud_mask, y0, z; // cloud
comp_8=`float2 centered_clouds, uv_cloud;
comp_9=`float3 cloud_color;
comp_10=`
comp_11=`float mandelbrot_mask; // Mandelbrot
comp_12=`float2 uv_mandelbrot;
comp_13=`float3 gradient_hue;
comp_14=`
comp_15=`float3 ret1, ret2;
comp_16=`
comp_17=`shader_body
comp_18=`{
comp_19=`    // ======== Langit ========
comp_20=`    line_color1 = float3(0.0, 0.0, 0.0);
comp_21=`    line_color2 = float3(0.0, 0.0, 0.0);
comp_22=`
comp_23=`    float blend_factor = smoothstep(0.2, 0.6, uv.y);
comp_24=`    ret1 = lerp(line_color1, line_color2, blend_factor);
comp_25=`
comp_26=`    // ======== Bulan ========
comp_27=`    circle_pos = float2(q1, 0.2); 
comp_28=`    rad_moon = 0.01; 
comp_29=`    circle_color = float3(3.0, 3.0, 3.0); 
comp_30=`    dist_moon = length((uv - circle_pos) * aspect.xy);
comp_31=`    circle_mask = 1.0 - smoothstep(rad_moon - 0.002, rad_moon + 0.100, dist_moon);
comp_32=`    ret1 = lerp(ret1, circle_color, circle_mask);  
comp_33=`
comp_34=`    // ======== Awan ======== 
comp_35=`    mir_clouds = 1.0 - uv.y;
comp_36=`    centered_clouds = uv - float2(0.4, 0.0); 
comp_37=`    y0 = 0.25; 
comp_38=`    z = y0 / max(mir_clouds, 0.00);
comp_39=`    uv_cloud = float2(centered_clouds.x * z, z + time * q2);
comp_40=`    float noise_base = tex2D(sampler_noise_hq, uv_cloud * 2.0).r;
comp_41=`    float noise_detail = tex2D(sampler_noise_lq, uv_cloud * 0.5).r;
comp_42=`    float cloud_pattern = saturate(noise_base * 0.75 + noise_detail * 0.25);
comp_43=`    cloud_color = float3(0.5, 0.5, 0.5); 
comp_44=`    cloud_mask = smoothstep(1.2, 0.35, uv.y) * cloud_pattern;
comp_45=`    ret1 = lerp(ret1, cloud_color, cloud_mask * 0.65);
comp_46=`
comp_47=`    // ======== Mandelbrot ========
comp_48=`    float2 p = (uv-0.5)*aspect.xy;
comp_49=`    float r = length(p);
comp_50=`    float a = 2*atan2(p.y,p.x) + r*q7 + q6;
comp_51=`    float2 c = r*float2(cos(a),sin(a))*q4*2 + float2(q5,0);
comp_52=`    float2 z = 0;
comp_53=`    for(int i=0;i<8;i++) z = clamp(float2(z.x*z.x-z.y*z.y, 2*z.x*z.y)+c, -2, 2);
comp_54=`    uv_mandelbrot = z*0.25+0.5;
comp_55=`    uv_mandelbrot.x -= q8;
comp_56=`    ret2 = tex2D(sampler_main, uv_mandelbrot).xyz;
comp_57=`    gradient_hue = float3(uv.x * bass, uv.y * mid, 1.0 - uv.x);
comp_58=`    ret2 *= gradient_hue;
comp_59=`
comp_60=`    mandelbrot_mask = saturate(dot(ret2, float3(0.299, 0.587, 0.114)));
comp_61=`
comp_62=`    ret = lerp(ret1, ret2*5, mandelbrot_mask);
comp_63=`}
