shapecode_0_border_r=1.000
shapecode_0_border_g=1.000
shapecode_0_border_b=1.000
shapecode_0_border_a=0.000
shape_0_per_frame1=// Posisi bintang (melayang halus di area tengah layar)
shape_0_per_frame2=x = 0.5 + 0.68 * sin(time * 9.7);
shape_0_per_frame3=y = 0.55 + 0.09 * cos(time * 9.5);
shape_0_per_frame4=
shape_0_per_frame5=// Ukuran bintang yang membesar saat ada dentuman bass
shape_0_per_frame6=rad = 0.03 + 0.03 * sin(time * 3.0) + (bass_att - 1.0) * 0.08;
shape_0_per_frame7=
shape_0_per_frame8=// Rotasi bintang
shape_0_per_frame9=ang = time * 0.5;
shape_0_per_frame10=
shape_0_per_frame11=// Warna keemasan dinamis
shape_0_per_frame12=r = 1.0;
shape_0_per_frame13=g = 0.8 + 0.15 * sin(time * 2.0);
shape_0_per_frame14=b = 0.3;
shape_0_per_frame15=
shape_0_per_frame16=// Pengaturan garis tepi (border)
shape_0_per_frame17=border_r = 1.0;
shape_0_per_frame18=border_g = 0.9;
shape_0_per_frame19=border_b = 0.5;
shape_0_per_frame20=border_a = a * 0.6;
