shapecode_3_border_g=0.700
shapecode_3_border_b=0.500
shapecode_3_border_a=0.000
per_frame_1=// Kecepatan waktu cahaya
per_frame_2=q1 = 9.3;
per_frame_3=q2 = 0.2;
per_frame_4=
per_frame_5=// Ukuran garis cahaya
per_frame_6=q3 = 14.0;
per_frame_7=q4 = 30.0;
per_frame_8=
per_frame_9=// Vignette hitam bagian bawah
per_frame_10=q5 = 1.5;
per_frame_11=q6 = 0.2;
warp_1=`shader_body
warp_2=`{
warp_3=`    // Menggerakkan koordinat UV sedikit ke atas agar partikel terlihat jatuh pelan ke bawah
warp_4=`    float2 uv_shift = uv + float2(0.0, 0.0015);
warp_5=`    
warp_6=`    // Mengambil sampel warna frame sebelumnya
warp_7=`    float3 ret_col = tex2D(sampler_main, uv_shift).xyz;
warp_8=`
warp_9=`    // Menambahkan efek noise procedural kecil untuk kilauan bintang acak
warp_10=`    float noise = frac(sin(dot(uv * time, float2(12.9898, 78.233))) * 43758.5453);
warp_11=`    float sparkle = pow(noise, 18.0) * (bass * 0.3);
warp_12=`
warp_13=`    // Mengurangi intensitas warna secara perlahan (fade out)
warp_14=`    ret_col = ret_col * 0.96 - 0.005;
warp_15=`
warp_16=`    // Menambahkan kilauan bintang ke output
warp_17=`    ret_col += float3(sparkle, sparkle * 0.85, sparkle * 0.4);
warp_18=`
warp_19=`    ret = ret_col;
warp_20=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    // Mengambil warna dasar partikel dari warp shader
comp_4=`    float3 base_uv = tex2D(sampler_main, uv).xyz;
comp_5=`
comp_6=`    // Membuat pola sorot cahaya vertikal (God Rays) menggunakan fungsi Gelombang Sinus
comp_7=`    float rays1 = sin(uv.x *q3 + time * q1) * 0.5 + 0.5;
comp_8=`    float rays2 = cos(uv.x * q4 - time * q2) * 0.5 + 0.5;
comp_9=`    float ray_pattern = pow(rays1 * rays2, 2.0);
comp_10=`
comp_11=`    // Gradasi intensitas cahaya: Makin ke atas (uv.y mendekati 0) makin terang
comp_12=`    float top_light = pow(1.0 - uv.y, 1.8);
comp_13=`    
comp_14=`    // Warna emas kehangatan khas sorot langit (Golden Warm Rays)
comp_15=`    float3 gold_color = float3(1.0, 0.82, 0.45);
comp_16=`    float3 light_rays = gold_color * ray_pattern * top_light * (1.2 + mid * 0.3);
comp_17=`
comp_18=`    // Vignette hitam di bagian bawah & samping agar sudut bawah tetap gelap
comp_19=`    float vignette = smoothstep(q5, q6, uv.y) * (1.0 - length(uv - float2(0.5, 0.0)) * 0.6);
comp_20=`
comp_21=`    // Menggabungkan partikel bintang, sorot cahaya, dan pewarnaan akhir
comp_22=`    float3 final_color = (base_uv * 1.5) + light_rays;
comp_23=`    final_color *= vignette;
comp_24=`
comp_25=`    ret = final_color;
comp_26=`}
