wave_0_per_frame1=// t1 digunakan untuk mengatur kecepatan jatuh/melayangnya bintang
wave_0_per_frame2=t1 = time * 9.05; 
wave_0_per_frame3=
wave_0_per_frame4=// t2 digunakan untuk menangkap dentuman bass agar bintang berkedip lebih terang
wave_0_per_frame5=t2 = bass_att * 0.3;
wave_0_per_frame6=
wave_0_per_frame7=// Mengatur warna dasar bintang menjadi emas/kuning cerah
wave_0_per_frame8=r = 1.0;
wave_0_per_frame9=g = 0.85;
wave_0_per_frame10=b = 0.4;
wave_0_per_point1=// Membuat koordinat acak (pseudo-random) berdasarkan nilai 'sample' (0.0 hingga 1.0)
wave_0_per_point2=seed_x = sample * 1337.5453;
wave_0_per_point3=seed_y = sample * 3731.3545;
wave_0_per_point4=
wave_0_per_point5=pos_x = seed_x - int(seed_x); // Menghasilkan nilai X acak 0.0 - 1.0
wave_0_per_point6=pos_y = seed_y - int(seed_y); // Menghasilkan nilai Y acak 0.0 - 1.0
wave_0_per_point7=
wave_0_per_point8=// Menambahkan efek melayang ke bawah menggunakan t1 dari per_frame
wave_0_per_point9=pos_y = pos_y + t1;
wave_0_per_point10=pos_y = pos_y - int(pos_y); // Membungkus (wrap) bintang agar kembali ke atas saat melewati layar bawah
wave_0_per_point11=
wave_0_per_point12=// Menetapkan posisi akhir ke layar
wave_0_per_point13=x = pos_x;
wave_0_per_point14=y = pos_y;
wave_0_per_point15=
wave_0_per_point16=// Membuat efek kedipan (twinkle) acak yang bereaksi dengan waktu dan bass (t2)
wave_0_per_point17=twinkle = sin(sample * 1000 + time * 9); 
wave_0_per_point18=a = (twinkle * 0.4 + 0.6) * (0.5 + t2);
