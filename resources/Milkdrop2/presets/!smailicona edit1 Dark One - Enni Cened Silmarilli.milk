shape_0_per_frame1=r = 2*q1;
shape_0_per_frame2=g = 2*q2;
shape_0_per_frame3=b = 2*q3;
shape_0_per_frame4=
shape_0_per_frame5=r2 = abs(cos(time/13.27))-q3;;
shape_0_per_frame6=g2 = 1-q4;
shape_0_per_frame7=b2 = abs(sin(time/13.14+240))-q1;
shape_0_per_frame8=
shape_0_per_frame9=temp  = temp+q4/3;
shape_0_per_frame10=ang = temp;
shape_0_per_frame11=
shape_0_per_frame12=
shape_0_per_frame13=border_r = r;
shape_0_per_frame14=border_g = g;
shape_0_per_frame15=border_b = b;
per_frame_1=maxDec = .0001;
per_frame_2=q5 = .987654321;
per_frame_3=
per_frame_4=
per_frame_5=bassMax = bassMax + (above(bass,bassMax) * (bass-bassMax)) - (above(bassMax,bass) * (bassMax*maxDec));
per_frame_6=bassLvl = (above(bass,bassLvl) * (bass)) + (above(bassLvl,bass) * (bassLvl*q5));
per_frame_7=q1 = bassLvl/bassMax;
per_frame_8=
per_frame_9=midMax = midMax + (above(mid,midMax) * (mid-midMax)) - (above(midMax,mid) * (midMax*maxDec));
per_frame_10=midLvl = (above(mid,midLvl) * (mid)) + (above(midLvl,mid) * (midLvl*q5));
per_frame_11=q2 = midLvl/midMax;
per_frame_12=
per_frame_13=trebMax = trebMax + (above(treb,trebMax) * (treb-trebMax)) - (above(trebMax,treb) * (trebMax*maxDec));
per_frame_14=trebLvl = (above(treb,trebLvl) * (treb)) + (above(trebLvl,treb) * (trebLvl*q5));
per_frame_15=q3 = trebLvl/trebMax;
per_frame_16=
per_frame_17=vol = (bass+treb+mid)/3;
per_frame_18=beat = above(vol,volLvl)*volLvl/vol;
per_frame_19=volMax = volMax + (above(vol,volMax) * (vol-volMax)) - (above(volMax,vol) * (volMax*maxDec));
per_frame_20=volLvl = (above(vol,volLvl) * (vol)) + (above(volLvl,vol) * (volLvl*q5));
per_frame_21=q4 = volLvl/volMax;
per_frame_22=
per_frame_23=q6 = beat;
per_frame_24=
per_frame_25=monitor = volMax;
per_pixel_1=zoom = abs(sin(ang*(q1*10)+time*2)/(q4));
comp_1=`float3 ret1, neu, blur;
comp_2=`
comp_3=`shader_body
comp_4=`{
comp_5=`float2 uv2;
comp_6=`float ang2, c, s;
comp_7=`uv -= 0.5;
comp_8=`uv *= aspect.xy;    
comp_9=`
comp_10=`float2 tmp = uv;
comp_11=`float dist = 1;
comp_12=`float dista = 0;
comp_13=`float inten = 1;
comp_14=`float mask = 0;
comp_15=`ret1 = 0;
comp_16=`int anz = 4;
comp_17=`float n = 1;
comp_18=`//uv = mul(uv,float2x2(_qa));
comp_19=`while (n <= anz) {
comp_20=`    ang2 = 6.28*n/anz;
comp_21=`    c = cos(ang2);
comp_22=`    s = sin(ang2);
comp_23=`    uv2.x =  uv.x*c - uv.y*s;
comp_24=`    uv2.y =  uv.x*s + uv.y*c;
comp_25=`
comp_26=`    dist = 1-frac(.25*n+time/1); //evtl sqrt !
comp_27=`    inten =  pow(dist,.3)*(1-dist)*2;
comp_28=`//    inten =  (1-dist);
comp_29=`
comp_30=`    neu =  GetPixel (2*uv2*dist + 0.5 );
comp_31=`    blur = GetBlur1 (2*uv2*dist + 0.54 );
comp_32=`    neu += blur;
comp_33=`//    neu *= (neu >= 0);
comp_34=`  //  mask = 1-(neu*inten >= .1) * (dist < dista);
comp_35=`    ret1 = ret1*.9+neu*inten;
comp_36=`    dista = dist;
comp_37=`n++;
comp_38=`}
comp_39=`
comp_40=`float dz = ret1/2;
comp_41=`float2 rs1 = uv*8 + time;
comp_42=`
comp_43=`float scale = 64;
comp_44=`rs1 = rs1 + dz*scale*.4;
comp_45=`
comp_46=`float lava = tex2D (sampler_noise_hq,rs1/scale).x;
comp_47=`lava = saturate(-abs (lava) + 1);
comp_48=`float3 lay1 = saturate(float3 (lava,lava*(lava-0.55)*2,(lava-1)*16));
comp_49=`
comp_50=`ret = ret1*1 + 0*float3(0,0,.3)*rad + lay1*0;
comp_51=`ret*=ret;//
comp_52=`ret/=3-((rad*2-1)*.5+.15*sin(blur*time))-2;
comp_53=`ret-=float3(int(ret.x),int(ret.y),int(ret.z));
comp_54=`}
