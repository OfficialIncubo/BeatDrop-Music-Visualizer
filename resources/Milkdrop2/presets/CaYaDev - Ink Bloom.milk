wave_0_per_frame1=pa = pa + (0.45 + 0.35*mid_att)/fps;
wave_0_per_frame2=t1 = 0.5 + 0.3*cos(pa*0.7) + 0.08*sin(pa*1.9);
wave_0_per_frame3=t2 = 0.5 + 0.3*sin(pa*0.53 + 1) + 0.08*cos(pa*2.3);
wave_0_per_frame4=t3 = pa*1.3;
wave_0_per_frame5=a = 0.09*min(1, q30);
wave_0_per_point1=d = (sample - 0.5)*0.22;
wave_0_per_point2=x = t1 + d*cos(t3) - value1*0.05*sin(t3);
wave_0_per_point3=y = t2 + d*sin(t3) + value1*0.05*cos(t3);
wave_0_per_point4=r = 0.55;
wave_0_per_point5=g = 0.5;
wave_0_per_point6=b = 0.25;
