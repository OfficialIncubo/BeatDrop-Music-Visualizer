wavecode_1_g=1
wavecode_1_b=1
wavecode_1_a=0.2
wave_1_per_frame1=a = 0.25*min(1, q30)*max(0, q4 - 0.9);
wave_1_per_frame2=t1 = q5;
wave_1_per_frame3=t2 = q6;
wave_1_per_point1=hh = abs(sin(sample*91.7 + time*13.1)*4375.5);
wave_1_per_point2=hh = hh - floor(hh);
wave_1_per_point3=ha = abs(sin(sample*47.3 + time*7.7)*2731.1);
wave_1_per_point4=ha = ha - floor(ha);
wave_1_per_point5=x = t1 + 0.16*sqrt(hh)*cos(ha*6.28);
wave_1_per_point6=y = t2 + 0.16*sqrt(hh)*sin(ha*6.28);
wave_1_per_point7=r = 0.5;
wave_1_per_point8=g = 0.15;
wave_1_per_point9=b = 0.4;
