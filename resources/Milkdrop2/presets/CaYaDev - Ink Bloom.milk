shape_3_per_frame6=a2 = a*0.35;
per_frame_init_1=last = 0;
per_frame_init_2=slot = 0;
per_frame_init_3=pa = 0;
per_frame_init_4=x_0 = 0.5;
per_frame_init_5=y_0 = 0.5;
per_frame_init_6=t_0 = -10;
per_frame_init_7=s_0 = 1;
per_frame_init_8=x_1 = 0.5;
per_frame_init_9=y_1 = 0.5;
per_frame_init_10=t_1 = -10;
per_frame_init_11=s_1 = 1;
per_frame_init_12=x_2 = 0.5;
per_frame_init_13=y_2 = 0.5;
per_frame_init_14=t_2 = -10;
per_frame_init_15=s_2 = 1;
per_frame_init_16=x_3 = 0.5;
per_frame_init_17=y_3 = 0.5;
per_frame_init_18=t_3 = -10;
per_frame_init_19=s_3 = 1;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.25)*((time - last) > 0.45);
per_frame_5=go = ((beat + ((time - last) > 1.2)) > 0);
per_frame_6=last = if(go, time, last);
per_frame_7=slot = if(go, (slot + 1)%4, slot);
per_frame_8=q1 = time*0.012;
per_frame_9=q2 = 1.8 + 0.8*min(bass_att, 2);
per_frame_10=q3 = mid_att;
per_frame_11=q4 = min(treb_att, 2);
per_frame_12=x_0 = if(go*equal(slot, 0), 0.15 + 0.7*(rand(1000)*0.001), x_0);
per_frame_13=y_0 = if(go*equal(slot, 0), 0.15 + 0.7*(rand(1000)*0.001), y_0);
per_frame_14=t_0 = if(go*equal(slot, 0), time, t_0);
per_frame_15=s_0 = if(go*equal(slot, 0), 0.7 + 0.6*(rand(1000)*0.001), s_0);
per_frame_16=q5 = x_0;
per_frame_17=q6 = y_0;
per_frame_18=q7 = t_0;
per_frame_19=q17 = s_0;
per_frame_20=x_1 = if(go*equal(slot, 1), 0.15 + 0.7*(rand(1000)*0.001), x_1);
per_frame_21=y_1 = if(go*equal(slot, 1), 0.15 + 0.7*(rand(1000)*0.001), y_1);
per_frame_22=t_1 = if(go*equal(slot, 1), time, t_1);
per_frame_23=s_1 = if(go*equal(slot, 1), 0.7 + 0.6*(rand(1000)*0.001), s_1);
per_frame_24=q8 = x_1;
per_frame_25=q9 = y_1;
per_frame_26=q10 = t_1;
per_frame_27=q18 = s_1;
per_frame_28=x_2 = if(go*equal(slot, 2), 0.15 + 0.7*(rand(1000)*0.001), x_2);
per_frame_29=y_2 = if(go*equal(slot, 2), 0.15 + 0.7*(rand(1000)*0.001), y_2);
per_frame_30=t_2 = if(go*equal(slot, 2), time, t_2);
per_frame_31=s_2 = if(go*equal(slot, 2), 0.7 + 0.6*(rand(1000)*0.001), s_2);
per_frame_32=q11 = x_2;
per_frame_33=q12 = y_2;
per_frame_34=q13 = t_2;
per_frame_35=q19 = s_2;
per_frame_36=x_3 = if(go*equal(slot, 3), 0.15 + 0.7*(rand(1000)*0.001), x_3);
per_frame_37=y_3 = if(go*equal(slot, 3), 0.15 + 0.7*(rand(1000)*0.001), y_3);
per_frame_38=t_3 = if(go*equal(slot, 3), time, t_3);
per_frame_39=s_3 = if(go*equal(slot, 3), 0.7 + 0.6*(rand(1000)*0.001), s_3);
per_frame_40=q14 = x_3;
per_frame_41=q15 = y_3;
per_frame_42=q16 = t_3;
per_frame_43=q20 = s_3;
warp_1=`float pot(float3 q)
warp_2=`{
warp_3=`  return tex3D(sampler_noisevol_hq, q).x + 0.5 * tex3D(sampler_noisevol_hq, q * 2.1 + 0.3).x;
warp_4=`}
warp_5=`shader_body
warp_6=`{
warp_7=`  float3 q = float3(uv * float2(1.1, 0.62), q1);
warp_8=`  float e = 0.02;
warp_9=`  float dx = pot(q + float3(e, 0.0, 0.0)) - pot(q - float3(e, 0.0, 0.0));
warp_10=`  float dy = pot(q + float3(0.0, e, 0.0)) - pot(q - float3(0.0, e, 0.0));
warp_11=`  float2 vel = float2(dy, -dx) * float2(0.62, 1.1);
warp_12=`  float2 u2 = uv - vel * 0.012 * q2 * q30;
warp_13=`  float3 ink = tex2D(sampler_main, u2).xyz;
warp_14=`  ink = lerp(ink, GetBlur1(u2), 0.08 * min(1.0, q30));
warp_15=`  ret = max(ink * pow(0.9992, q30) - 0.002 * max(q30, 1.0), 0.0);
warp_16=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float3 ink = tex2D(sampler_main, uv).xyz;
comp_4=`  float3 soft = GetBlur1(uv);
comp_5=`  float3 wide = GetBlur2(uv);
comp_6=`  float grain = tex2D(sampler_noise_hq, uv * texsize.xy / 256.0).x;
comp_7=`  float mottle = tex3D(sampler_noisevol_hq, float3(uv * float2(2.4, 1.35), 0.3)).x;
comp_8=`  float3 paper = float3(0.93, 0.9, 0.83) * (0.95 + 0.03 * grain + 0.05 * (mottle - 0.5));
comp_9=`  float2 v = uv - 0.5;
comp_10=`  paper *= 1.0 - dot(v, v) * 0.55;
comp_11=`  float3 dens = ink * 2.6 + soft * 0.4;
comp_12=`  float3 edge = saturate(ink - wide * 0.85);
comp_13=`  dens += edge * 2.2;
comp_14=`  float3 col = paper * exp(-dens);
comp_15=`  col += (soft - ink) * 0.04;
comp_16=`  ret = col;
comp_17=`}
