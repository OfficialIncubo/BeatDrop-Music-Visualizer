per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=q1 = time*0.03;
per_frame_5=q2 = 0.6 + 0.5*bass_att;
per_frame_6=q3 = treb_att;
per_frame_7=q4 = time*0.004;
per_frame_8=ph0 = ph0 + 0.9000*(0.6 + 0.4*mid_att)/fps;
per_frame_9=q5 = ph0 + 0.0000;
per_frame_10=ph1 = ph1 + 0.6278*(0.6 + 0.4*mid_att)/fps;
per_frame_11=q6 = ph1 + 2.4000;
per_frame_12=ph2 = ph2 + 0.4761*(0.6 + 0.4*mid_att)/fps;
per_frame_13=q7 = ph2 + 4.7999;
per_frame_14=ph3 = ph3 + 0.3803*(0.6 + 0.4*mid_att)/fps;
per_frame_15=q8 = ph3 + 7.1999;
per_frame_16=ph4 = ph4 + 0.3148*(0.6 + 0.4*mid_att)/fps;
per_frame_17=q33 = ph4 + 9.5998;
per_frame_18=ph5 = ph5 + 0.2673*(0.6 + 0.4*mid_att)/fps;
per_frame_19=q34 = ph5 + 11.9998;
per_frame_20=ph6 = ph6 + 0.2315*(0.6 + 0.4*mid_att)/fps;
per_frame_21=q35 = ph6 + 14.3998;
per_frame_22=ph7 = ph7 + 0.2036*(0.6 + 0.4*mid_att)/fps;
per_frame_23=q36 = ph7 + 16.7997;
per_frame_24=ph8 = ph8 + 0.1813*(0.6 + 0.4*mid_att)/fps;
per_frame_25=q37 = ph8 + 19.1997;
per_frame_26=ph9 = ph9 + 0.1631*(0.6 + 0.4*mid_att)/fps;
per_frame_27=q38 = ph9 + 21.5996;
per_frame_28=ph10 = ph10 + 0.1480*(0.6 + 0.4*mid_att)/fps;
per_frame_29=q39 = ph10 + 23.9996;
per_frame_30=ph11 = ph11 + 0.1353*(0.6 + 0.4*mid_att)/fps;
per_frame_31=q40 = ph11 + 26.3996;
warp_1=`shader_body
warp_2=`{
warp_3=`  float k = pow(0.94, q30);
warp_4=`  ret = lerp(tex2D(sampler_main, uv).xyz, GetBlur1(uv), 0.36 * min(1.0, q30)) * k;
warp_5=`  ret = ret - 0.002 * max(q30, 1.0);
warp_6=`}
comp_1=`sampler sampler_pw_noise_lq;
comp_2=`shader_body
comp_3=`{
comp_4=`  float2 p = (uv - 0.5) * aspect.xy;
comp_5=`  float R = 0.12;
comp_6=`  float r = length(p);
comp_7=`  float3 trails = tex2D(sampler_main, uv).xyz;
comp_8=`  float3 tglow = GetBlur1(uv) * 0.8 + GetBlur2(uv) * 0.6;
comp_9=`  float2 sp = uv * texsize.xy / 512.0;
comp_10=`  float4 st = tex2D(sampler_pw_noise_lq, sp);
comp_11=`  float tw = 0.55 + 0.45 * sin(time * (1.3 + st.z * 4.0) + st.w * 30.0);
comp_12=`  float star = saturate((st.x * st.y - 0.975) * 45.0) * tw * (0.5 + 0.5 * q3);
comp_13=`  float3 bg = lerp(float3(0.01, 0.01, 0.03), float3(0.04, 0.02, 0.06), saturate(1.0 - r * 1.5));
comp_14=`  bg += tex2D(sampler_noise_hq, uv * 0.6 + q4).x * float3(0.03, 0.015, 0.05);
comp_15=`  float3 col = bg + star * float3(0.85, 0.9, 1.0);
comp_16=`  float2 e = p / float2(1.0, 0.32);
comp_17=`  float er = length(e);
comp_18=`  float band = saturate((er - 0.16) * 200.0) * saturate((0.28 - er) * 200.0);
comp_19=`  float gaps = tex2D(sampler_noise_hq, float2(er * 2.2, 0.5)).x;
comp_20=`  float3 ringc = lerp(float3(0.75, 0.62, 0.45), float3(0.95, 0.88, 0.75), gaps) * (0.35 + 0.65 * smoothstep(0.3, 0.7, gaps));
comp_21=`  float ringa = band * 0.85;
comp_22=`  float behind = step(p.y, 0.0);
comp_23=`  col = lerp(col, ringc * 0.8, ringa * behind);
comp_24=`  float pm = saturate((R - r) * 400.0);
comp_25=`  float z = sqrt(saturate(1.0 - (r * r) / (R * R)));
comp_26=`  float3 n = float3(p / R, z);
comp_27=`  float lat = n.y;
comp_28=`  float lon = atan2(n.x, z) * 0.3 + q1;
comp_29=`  float bands = tex2D(sampler_noise_hq, float2(lon * 0.5, lat * 0.6 + 0.3)).x;
comp_30=`  float bands2 = tex2D(sampler_noise_hq, float2(lon * 1.5, lat * 2.0 + 0.7)).x;
comp_31=`  float stripe = sin(lat * 11.0 + bands * 2.5 + bands2 * 0.8) * 0.5 + 0.5;
comp_32=`  float3 gas = lerp(float3(0.7, 0.38, 0.2), float3(0.98, 0.88, 0.7), stripe);
comp_33=`  gas = lerp(gas, float3(0.85, 0.55, 0.35), saturate(sin(lat * 3.0 + 1.0)) * 0.4);
comp_34=`  float storm = exp(-dot(n.xy - float2(0.35, 0.25), n.xy - float2(0.35, 0.25)) * 60.0);
comp_35=`  gas = lerp(gas, float3(0.8, 0.35, 0.25), storm * 0.7);
comp_36=`  float3 L = normalize(float3(-0.6, -0.35, 0.7));
comp_37=`  float diff = saturate(dot(n, L));
comp_38=`  float3 planet = gas * (0.05 + 1.05 * pow(diff, 0.8));
comp_39=`  planet += float3(0.3, 0.55, 1.0) * pow(1.0 - z, 3.0) * 0.6 * q2;
comp_40=`  col = lerp(col, planet, pm);
comp_41=`  col = lerp(col, ringc, ringa * (1.0 - behind));
comp_42=`  float atm = exp(-pow((r - R) * 60.0, 2.0)) * (1.0 - pm);
comp_43=`  col += float3(0.35, 0.6, 1.0) * atm * 0.5 * q2;
comp_44=`  float hide = 1.0 - pm * behind;
comp_45=`  col += (trails * 1.2 + tglow) * hide;
comp_46=`  ret = 1.0 - exp(-col * 1.5);
comp_47=`}
