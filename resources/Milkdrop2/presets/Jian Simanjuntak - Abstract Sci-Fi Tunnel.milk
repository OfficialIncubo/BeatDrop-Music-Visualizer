shape_3_init1=t1 = instance; 
shape_3_init2=t2 = rand(100) * 0.01; // Nilai acak untuk variasi goyangan pada masing-masing instance
shape_3_per_frame1=sample = instance / num_inst;
shape_3_per_frame2=
shape_3_per_frame3=// Efek bergoyang (wobbling) pada sudut dan ukuran radius
shape_3_per_frame4=ang = 0.5 * sin(time * 3 + instance * 2.1) + 0.2 * cos(time * 4);
shape_3_per_frame5=rad = 0.25 + 0.05 * sin(time * 5 + instance);
shape_3_per_frame6=
shape_3_per_frame7=// Setelan membedakan bentuk
shape_3_per_frame8=sides = (equal(instance, 0) * 3) + 
shape_3_per_frame9=    (equal(instance, 1) * 4) + 
shape_3_per_frame10=    (equal(instance, 2) * 50);
shape_3_per_frame11=
shape_3_per_frame12=// Posisi X dan Y disebar untuk 3 instance dengan efek goyangan halus
shape_3_per_frame13=x = 0.5 + 0.3 * sin(time * 1.5 + instance);
shape_3_per_frame14=y = 0.5 + 0.4 * sin(time * 3 + instance);
per_frame_1=dec = pow(0.9,30/fps);
per_frame_2=dsl = pow(0.99,30/fps);
per_frame_3=beat = max(max(bass,mid),treb);
per_frame_4=avg = avg*dsl + beat*(1-dsl);
per_frame_5=is_beat = above(beat,.2+avg+peak)*above(time,t0+.2);
per_frame_6=t0 = is_beat*time + (1-is_beat)*t0;
per_frame_7=peak = is_beat*beat + (1-is_beat)*peak*dec;
per_frame_8=mov = mov + (.012+.015*(bass_att+mid_att+treb_att)/3)*30/fps;
per_frame_9=q1 = mov;
per_frame_10=q2 = peak;
per_frame_11=q3 = (bass_att+mid_att+treb_att)/3;
per_frame_12=
per_frame_13=wave_a = 1;
warp_1=`shader_body
warp_2=`{
warp_3=`
warp_4=`uv = lerp(uv_orig,uv,0.05);
warp_5=`
warp_6=`float2 d = texsize.zw * 4;
warp_7=`float3 dx = ( GetBlur1(uv + float2(1,0)*d) - GetBlur1(uv-float2(1,0)*d) );
warp_8=`float3 dy = ( GetBlur1(uv + float2(0,1)*d) - GetBlur1(uv-float2(0,1)*d) );
warp_9=`
warp_10=`uv += float2(lum(dx),lum(dy))*texsize.zw*4;
warp_11=`ret = tex2d(sampler_fc_main, uv) - 0.200;
warp_12=`
warp_13=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float2 p = (uv-0.5)*aspect.xy;
comp_4=`    float r = length(p);
comp_5=`    float a = atan2(p.y,p.x)/6.28318;
comp_6=`    float3 acc = 0;
comp_7=`    for (int n = 0; n < 3; n++)
comp_8=`    {
comp_9=`        float2 nt = float2(a*(n+1), 1/(r+0.05)*0.02 + q1*0.1*(n+1));
comp_10=`        float s = tex2D(sampler_noise_lq, nt).r;
comp_11=`        float star = saturate((s-0.8)*5);
comp_12=`        float3 col = lerp(float3(.6,.8,1), float3(1,.7,.4), n/2.0);
comp_13=`        acc += star*col;
comp_14=`    }
comp_15=`    float glow = exp(-r*6)*(0.3+q2);
comp_16=`    ret = acc*saturate(r*8)*(1+q3) + GetBlur1(uv)*1.0 + glow*float3(.5,.7,1);
comp_17=`}
