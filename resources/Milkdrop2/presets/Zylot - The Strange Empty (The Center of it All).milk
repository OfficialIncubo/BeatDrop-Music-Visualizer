per_frame_1=wave_a = 0;
per_frame_2=
per_frame_3=q1 = aspecty;
warp_1=`shader_body
warp_2=`{
warp_3=`   
warp_4=`    float small_rip = get_fft(.5+.5*sin((rad*10)+time*2.22334));
warp_5=`    float large_rip = get_fft(.5+.5*cos(rad-(time*.5333)));
warp_6=`
warp_7=`    float small_rip_r = get_fft(.5+.5*sin(rad*10+.2))*bass;
warp_8=`    float large_rip_r = get_fft(.5+.5*cos(rad+.2))*bass;
warp_9=`    float small_rip_g = get_fft(.5+.5*sin(rad*10-.2))*treb*.75;
warp_10=`    float large_rip_g = get_fft(.5+.5*cos(rad-.2))*treb*.75;
warp_11=`    float small_rip_b = get_fft(.5+.5*sin(rad*10-.45))*mid;
warp_12=`    float large_rip_b = get_fft(.5+.5*cos(rad+.45))*mid;
warp_13=`
warp_14=`    ret = tex2D(sampler_main, uv).xyz;
warp_15=`    ret *= 2.00; //gamma
warp_16=`
warp_17=`    ret = lerp(ret,min(max(small_rip,large_rip),1),.8); 
warp_18=`    ret.x += min(max(small_rip_r,large_rip_r),.5)*.75;
warp_19=`    ret.y += min(max(small_rip_g,large_rip_g),.5)*.75;
warp_20=`    ret.z += min(max(small_rip_b,large_rip_b),.5)*.75;
warp_21=`   
warp_22=`    ret *= 0.98; 
warp_23=`    ret -=0.2;
warp_24=`}
comp_1=`shader_body
comp_2=`{    
comp_3=`  float2 center_uv = uv_orig - 0.5;
comp_4=`  float nrad = length(center_uv.x/lerp(abs(center_uv.y),max(abs(center_uv.y),.2),.15))*.13+.1*sin(time);
comp_5=`  
comp_6=`    float small_rip = get_fft(.5+.5*sin((rad*10)+time*2.22334));
comp_7=`    float large_rip = get_fft(.5+.5*cos(rad-(time*.5333)));
comp_8=`
comp_9=`  float comb_rip = small_rip * 0.6 + large_rip * 0.4;
comp_10=`
comp_11=`  float wave = sin(nrad * 100.0 + time * 15);
comp_12=`
comp_13=`  float2 ripple_uv = uv_orig + normalize(center_uv) * wave * (max(0,abs(comb_rip-.5)-.2)*(.01+vol_att*.3));
comp_14=`  ret = tex2D(sampler_main, ripple_uv).xyz;
comp_15=`
comp_16=`  ret += wave * comb_rip * 0.1;
comp_17=`
comp_18=`  ret *= 1.1; //gamma
comp_19=`  ret *= ret; //darken
comp_20=`}
