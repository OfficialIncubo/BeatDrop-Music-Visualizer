shape_1_init1=t1=time; tm2=0;
shape_1_per_frame1=tm=time-t1; speed = .012;
shape_1_per_frame2=trel = int(time*speed)- time*speed+1;
shape_1_per_frame3=tm2=bass-bass_att; tm3=max(bass,bass_att)-bass_att;tm4=tm4+tm3; 
shape_1_per_frame4=tm5=max(mid,mid_att)-mid_att;tm6=tm5+tm6;
shape_1_per_frame5=tm7=max(treb,treb_att)-treb_att;tm8=tm7+tm8;
shape_1_per_frame6=i=instance+1; pair=int(i/2); even=equal(i/2,int(i/2)); 
shape_1_per_frame7=tm16=(tm4-tm8)*speed;
shape_1_per_frame8=tm-=tm16;
shape_1_per_frame9=//kn=1/instance;
shape_1_per_frame10=//kn1=kn + (t2*k1); 
shape_1_per_frame11=k1 = (instance+trel)/num_inst; 
shape_1_per_frame12=k1 = k1 - int(k1); 
shape_1_per_frame13=posx=.9*sin((tm/7)*k1);
shape_1_per_frame14=posy=.9*cos((tm/8)*k1);
shape_1_per_frame15=posz=rad*(1+.2*sin((tm/5)*k1));
shape_1_per_frame16=rad=posz*(1/(num_inst/6));
shape_1_per_frame17=x=posx/(1+posz)+.5; y=posy/(1+posz)+.5;
shape_1_per_frame18=reg88=tm;
shape_1_per_frame19=textured=even;
