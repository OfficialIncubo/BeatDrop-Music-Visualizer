per_frame_1=monitor = reg88;
per_frame_2=//xang = 0;
per_frame_3=
warp_1=`sampler sampler_rand01;
warp_2=`sampler sampler_rand00;
warp_3=`
warp_4=`float4 texsize_rand00, texsize_rand01;
warp_5=`float frmvar;
warp_6=`shader_body
warp_7=`{
warp_8=`    // sample previous frame
warp_9=`    ret = tex2D( sampler_main, uv ).xyz;
warp_10=`    frmvar=max(q19,progress);
warp_11=`    // darken (decay) over time
warp_12=`    ret *= 0.795; //or try: ret -= 0.004;
warp_13=`ret += .25*lerp(tex2d(sampler_rand01 ,uv), tex2d(sampler_rand00 ,uv), frmvar*ret);
warp_14=`//ret=ret-(frmvar*.3);
warp_15=`}
comp_1=`float tim, tsin, tcos, psin, pcos;// cmax, cmin, cmix, cmcos;
comp_2=`sampler sampler_fw_rand01, sampler_pc_rand02, sampler_fw_rand04, sampler_pc_rand03;
comp_3=`float3 li1, li2, li3, li4, cmin, cmix, cmcos;
comp_4=`float4 texsize_rand02;
comp_5=`float2 uvroam;
comp_6=`shader_body
comp_7=`{
comp_8=`tim=(min(q17,time)/(18+(2/(mid_att+treb_att-bass_att))));   
comp_9=`tcos=cos(tim); 
comp_10=`tsin=sin(tim); 
comp_11=`psin=tsin*max(1-progress,progress)-.5*2;
comp_12=`pcos=tcos*max(1-progress,progress)-.5*2;
comp_13=`uvroam=(((uv-.5)/texsize.xy)*texsize_rand02)+(float2(slow_roam_cos.y,slow_roam_sin.z)*M_PI_2);
comp_14=`    // sample previous frame
comp_15=`    ret = tex2D( sampler_main, uv ).xyz;
comp_16=`     ret *=(GetBlur3 (uv))-.2*ret.xzx;
comp_17=`      // sample jpegs
comp_18=`li1 = tex2D(sampler_fw_rand01, uv ).xyz*.5+.5*tcos*psin;   
comp_19=`li2 = tex2D(sampler_pc_rand02, uvroam ).xyz*.5+.5*tsin*psin;   
comp_20=`li3 = tex2D(sampler_pc_rand03, uv ).xyz*.5+.5*tcos*pcos;   
comp_21=`li4 = tex2D(sampler_fw_rand04, uv ).xyz*.5+.5*tsin*pcos;
comp_22=`      //mix em
comp_23=`cmix=max(li1,max(li2,max(li3,li4)));
comp_24=`cmin=max((min(li2,li4)*.5)*tsin,(min(li1,li3)*.5)*tcos);
comp_25=`cmcos = 5.5+(.5*tcos)+float3(1/3,2/3,3/3);
comp_26=`cmcos.x -=int(cmcos.x); 
comp_27=`cmcos.y -=int(cmcos.y); 
comp_28=`cmcos.z -=int(cmcos.z);
comp_29=` 
comp_30=`    // darken (decay) over time
comp_31=`    ret *= 0.85-(.15+.0155*cmcos); //or try: ret -= 0.004;
comp_32=`    //add em
comp_33=`    ret +=.214*cmix-.34*ret;
comp_34=`    ret +=.632*cmin.xyz*cmcos;
comp_35=`    ret +=.12*(GetBlur3 (uv));
comp_36=`}
