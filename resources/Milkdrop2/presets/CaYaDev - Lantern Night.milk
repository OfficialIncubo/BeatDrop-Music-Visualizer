shape_10_per_frame6=bx = id*0.3819660 - floor(id*0.3819660);
shape_10_per_frame7=x = 0.06 + 0.88*bx + 0.03*sin(time*0.3 + id) + h*0.06*sin(id*2.3);
shape_10_per_frame8=y = 0.38 + h*0.7;
shape_10_per_frame9=flick = 0.8 + 0.2*sin(time*(7 + id*0.3) + id);
shape_10_per_frame10=fl = 1 + 0.6*q3*(sin(id*5.1) > 0.3);
shape_10_per_frame11=rad = (0.022 - 0.012*h)*(1 + 0.15*(fl - 1));
shape_10_per_frame12=fade = min(1, h*12)*min(1, (1 - h)*2.5);
shape_10_per_frame13=a = 0.9*fade*flick*min(fl, 1.4);
shape_10_per_frame14=a2 = 0.35*fade*flick;
shapecode_11_enabled=1
shapecode_11_sides=4
shapecode_11_additive=1
shapecode_11_thickOutline=0
shapecode_11_textured=0
shapecode_11_num_inst=4
shapecode_11_x=0.5
shapecode_11_y=0.5
shapecode_11_rad=0.02
shapecode_11_ang=0.785398
shapecode_11_tex_ang=0
shapecode_11_tex_zoom=1
shapecode_11_r=1
shapecode_11_g=0.75
shapecode_11_b=0.35
shapecode_11_a=0.9
shapecode_11_r2=0.9
shapecode_11_g2=0.3
shapecode_11_b2=0.05
shapecode_11_a2=0.35
shapecode_11_border_r=1
shapecode_11_border_g=1
shapecode_11_border_b=1
shapecode_11_border_a=0
shape_11_per_frame1=id = 11*4 + instance;
shape_11_per_frame2=sp = 0.03 + 0.012*sin(id*1.7);
shape_11_per_frame3=lf = time*sp + id*0.6180339;
shape_11_per_frame4=lf = lf - floor(lf);
shape_11_per_frame5=h = lf;
shape_11_per_frame6=bx = id*0.3819660 - floor(id*0.3819660);
shape_11_per_frame7=x = 0.06 + 0.88*bx + 0.03*sin(time*0.3 + id) + h*0.06*sin(id*2.3);
shape_11_per_frame8=y = 0.38 + h*0.7;
shape_11_per_frame9=flick = 0.8 + 0.2*sin(time*(7 + id*0.3) + id);
shape_11_per_frame10=fl = 1 + 0.6*q3*(sin(id*5.1) > 0.3);
shape_11_per_frame11=rad = (0.022 - 0.012*h)*(1 + 0.15*(fl - 1));
shape_11_per_frame12=fade = min(1, h*12)*min(1, (1 - h)*2.5);
shape_11_per_frame13=a = 0.9*fade*flick*min(fl, 1.4);
shape_11_per_frame14=a2 = 0.35*fade*flick;
per_frame_init_1=last = 0;
per_frame_init_2=flare = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.35)*((time - last) > 0.6);
per_frame_5=last = if(beat, time, last);
per_frame_6=flare = max(flare*pow(0.9, q30), beat);
per_frame_7=q1 = time*0.003;
per_frame_8=q2 = min(treb_att, 2);
per_frame_9=q3 = flare;
per_frame_10=q4 = time;
warp_1=`shader_body
warp_2=`{
warp_3=`  // lanterns only live above the horizon (uv.y < 0.62); the lake is painted in comp
warp_4=`  float3 c = tex2D(sampler_main, uv + float2(0.0, 0.0008) * q30).xyz;
warp_5=`  ret = max(c * pow(0.75, q30) - 0.002 * max(q30, 1.0), 0.0) * step(uv.y, 0.625);
warp_6=`}
comp_1=`sampler sampler_pw_noise_lq;
comp_2=`shader_body
comp_3=`{
comp_4=`  float hz = 0.62;
comp_5=`  float3 sky = lerp(float3(0.01, 0.012, 0.04), float3(0.06, 0.04, 0.09), saturate(uv.y / hz));
comp_6=`  float4 st = tex2D(sampler_pw_noise_lq, uv * texsize.xy / 512.0);
comp_7=`  sky += saturate((st.x * st.y - 0.98) * 40.0) * (0.5 + 0.5 * sin(q4 * 1.3 + st.z * 20.0)) * 0.6 * step(uv.y, 0.5);
comp_8=`  float cl = tex3D(sampler_noisevol_hq, float3(uv * float2(1.1, 2.6) + float2(q4 * 0.025, 0.0), q1 * 6.0)).x;
comp_9=`  sky += float3(0.06, 0.04, 0.07) * smoothstep(0.4, 0.9, cl) * step(uv.y, hz) * saturate(1.2 - uv.y * 1.2);
comp_10=`  float hill = 0.035 * tex3D(sampler_noisevol_hq, float3(uv.x * 1.3, 0.3, 0.2)).x + 0.015 * tex3D(sampler_noisevol_hq, float3(uv.x * 5.0, 0.7, 0.4)).x;
comp_11=`  float land = smoothstep(hz - hill - 0.004, hz - hill, uv.y) * step(uv.y, hz);
comp_12=`  float3 m = tex2D(sampler_main, uv).xyz;
comp_13=`  float3 glow = GetBlur1(uv) * 0.9 + GetBlur2(uv) * 0.7 + GetBlur3(uv) * 0.5;
comp_14=`  float3 col = sky + (m * 1.3 + glow * float3(1.0, 0.7, 0.4)) * step(uv.y, hz);
comp_15=`  col = lerp(col, float3(0.01, 0.01, 0.02) + glow * 0.15, land);
comp_16=`  float below = step(hz, uv.y);
comp_17=`  float dpt = uv.y - hz;
comp_18=`  float rip = sin(dpt * 260.0 / (0.15 + dpt) - q4 * 1.5) * 0.004 * (0.3 + dpt * 4.0) + (tex3D(sampler_noisevol_hq, float3(uv * float2(3.0, 20.0), q1 * 6.0)).x - 0.5) * 0.006;
comp_19=`  float2 ruv = float2(uv.x + rip, hz - dpt * 1.1);
comp_20=`  float3 refl = tex2D(sampler_main, ruv).xyz * 0.9 + GetBlur1(ruv) * float3(1.0, 0.7, 0.4) * 0.8 + GetBlur2(ruv) * float3(1.0, 0.65, 0.35) * 0.5;
comp_21=`  float3 water = lerp(float3(0.03, 0.025, 0.05), float3(0.008, 0.01, 0.02), saturate(dpt * 3.0));
comp_22=`  col = lerp(col, water + refl * (0.75 - dpt), below);
comp_23=`  col += float3(0.08, 0.05, 0.03) * exp(-abs(uv.y - hz) * 60.0) * 0.6;
comp_24=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.6;
comp_25=`  ret = 1.0 - exp(-col * 1.5);
comp_26=`}
