wavecode_1_a=0.8
wave_1_per_frame1=t1 = q6;
wave_1_per_frame2=a = 0.07*min(1, q30);
wave_1_per_point1=s = sample;
wave_1_per_point2=k = s*6.28318;
wave_1_per_point3=ph = t1 + 1.7;
wave_1_per_point4=cx = 0.5 + 0.32*sin(k*0.5 + ph*0.7)*cos(ph*0.23 + 1) + 0.08*sin(k*1.5 + ph);
wave_1_per_point5=cy = 0.5 + 0.3*cos(k*0.5 + ph*0.53)*sin(ph*0.31 + 2) + 0.06*cos(k*2.0 - ph*1.2);
wave_1_per_point6=kk = floor(s*511 + 0.5);
wave_1_per_point7=side = (kk - 2*floor(kk/2)) - 0.5;
wave_1_per_point8=w = (0.006 + 0.012*q1 + abs(value1)*0.02)*sin(3.14159*s);
wave_1_per_point9=nx = cos(k*0.5 + ph);
wave_1_per_point10=ny = sin(k*0.5 + ph);
wave_1_per_point11=x = 0.5 + (cx + nx*w*side*2 - 0.5)/q31;
wave_1_per_point12=y = 0.5 + (cy + ny*w*side*2 - 0.5)/q32;
wave_1_per_point13=e = 0.6 + 0.4*(side > 0);
wave_1_per_point14=r = 0.35*e;
wave_1_per_point15=g = 0.75*e;
wave_1_per_point16=b = 1*e;
