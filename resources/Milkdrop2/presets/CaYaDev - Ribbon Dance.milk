wave_2_per_point2=k = s*6.28318;
wave_2_per_point3=ph = t1 + 3.4;
wave_2_per_point4=cx = 0.5 + 0.32*sin(k*0.5 + ph*0.7)*cos(ph*0.23 + 2) + 0.08*sin(k*1.5 + ph);
wave_2_per_point5=cy = 0.5 + 0.3*cos(k*0.5 + ph*0.53)*sin(ph*0.31 + 4) + 0.06*cos(k*2.0 - ph*1.2);
wave_2_per_point6=kk = floor(s*511 + 0.5);
wave_2_per_point7=side = (kk - 2*floor(kk/2)) - 0.5;
wave_2_per_point8=w = (0.006 + 0.012*q1 + abs(value1)*0.02)*sin(3.14159*s);
wave_2_per_point9=nx = cos(k*0.5 + ph);
wave_2_per_point10=ny = sin(k*0.5 + ph);
wave_2_per_point11=x = 0.5 + (cx + nx*w*side*2 - 0.5)/q31;
wave_2_per_point12=y = 0.5 + (cy + ny*w*side*2 - 0.5)/q32;
wave_2_per_point13=e = 0.6 + 0.4*(side > 0);
wave_2_per_point14=r = 1*e;
wave_2_per_point15=g = 0.75*e;
wave_2_per_point16=b = 0.3*e;
wavecode_3_enabled=1
wavecode_3_samples=512
wavecode_3_sep=0
wavecode_3_bSpectrum=0
wavecode_3_bUseDots=0
wavecode_3_bDrawThick=1
wavecode_3_bAdditive=1
wavecode_3_scaling=1
wavecode_3_smoothing=0.5
wavecode_3_r=1
wavecode_3_g=1
wavecode_3_b=1
wavecode_3_a=0.8
wave_3_per_frame1=t1 = q8;
wave_3_per_frame2=a = 0.07*min(1, q30);
wave_3_per_point1=s = sample;
wave_3_per_point2=k = s*6.28318;
wave_3_per_point3=ph = t1 + 5.1;
wave_3_per_point4=cx = 0.5 + 0.32*sin(k*0.5 + ph*0.7)*cos(ph*0.23 + 3) + 0.08*sin(k*1.5 + ph);
wave_3_per_point5=cy = 0.5 + 0.3*cos(k*0.5 + ph*0.53)*sin(ph*0.31 + 6) + 0.06*cos(k*2.0 - ph*1.2);
wave_3_per_point6=kk = floor(s*511 + 0.5);
wave_3_per_point7=side = (kk - 2*floor(kk/2)) - 0.5;
wave_3_per_point8=w = (0.006 + 0.012*q1 + abs(value1)*0.02)*sin(3.14159*s);
wave_3_per_point9=nx = cos(k*0.5 + ph);
wave_3_per_point10=ny = sin(k*0.5 + ph);
wave_3_per_point11=x = 0.5 + (cx + nx*w*side*2 - 0.5)/q31;
wave_3_per_point12=y = 0.5 + (cy + ny*w*side*2 - 0.5)/q32;
wave_3_per_point13=e = 0.6 + 0.4*(side > 0);
wave_3_per_point14=r = 0.55*e;
wave_3_per_point15=g = 1*e;
wave_3_per_point16=b = 0.65*e;
per_frame_init_1=ph_0 = 0.3;
per_frame_init_2=ph_1 = 1.3;
per_frame_init_3=ph_2 = 2.3;
per_frame_init_4=ph_3 = 3.3;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=q1 = min(bass_att, 2);
per_frame_5=q2 = time*0.05;
per_frame_6=q3 = min(treb_att, 2);
per_frame_7=ph_0 = ph_0 + (0.15 + 0.12*0 + 0.2*min(mid_att, 2))/fps;
per_frame_8=q5 = ph_0;
per_frame_9=ph_1 = ph_1 + (0.15 + 0.12*1 + 0.2*min(mid_att, 2))/fps;
per_frame_10=q6 = ph_1;
per_frame_11=ph_2 = ph_2 + (0.15 + 0.12*0 + 0.2*min(mid_att, 2))/fps;
per_frame_12=q7 = ph_2;
per_frame_13=ph_3 = ph_3 + (0.15 + 0.12*1 + 0.2*min(mid_att, 2))/fps;
per_frame_14=q8 = ph_3;
warp_1=`shader_body
warp_2=`{
warp_3=`  float3 q = float3(uv * float2(1.5, 0.85), q2);
warp_4=`  float e = 0.03;
warp_5=`  float dx = tex3D(sampler_noisevol_hq, q + float3(e, 0.0, 0.0)).x - tex3D(sampler_noisevol_hq, q - float3(e, 0.0, 0.0)).x;
warp_6=`  float dy = tex3D(sampler_noisevol_hq, q + float3(0.0, e, 0.0)).x - tex3D(sampler_noisevol_hq, q - float3(0.0, e, 0.0)).x;
warp_7=`  float2 vel = float2(dy, -dx) * 0.0025 + float2(0.0, 0.0012);
warp_8=`  float3 c = tex2D(sampler_main, uv + vel * q30).xyz;
warp_9=`  c = lerp(c, GetBlur1(uv), 0.06 * min(1.0, q30));
warp_10=`  ret = max(c * pow(0.955, q30) - 0.002 * max(q30, 1.0), 0.0);
warp_11=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float3 m = tex2D(sampler_main, uv).xyz;
comp_4=`  float3 col = float3(0.01, 0.008, 0.02) + m * (0.8 + 0.3 * q3) + GetBlur1(uv) * 0.45 + GetBlur2(uv) * 0.35 + GetBlur3(uv) * 0.25;
comp_5=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.7;
comp_6=`  ret = 1.0 - exp(-col * 1.4);
comp_7=`}
