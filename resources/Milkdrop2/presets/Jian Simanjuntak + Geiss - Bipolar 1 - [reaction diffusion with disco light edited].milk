per_frame_1=dec_med = pow (0.7, 30/fps);
per_frame_2=dec_slow = pow (0.99, 30/fps);
per_frame_3=beat = max (max (bass, mid), treb); 
per_frame_4=
per_frame_5=beat = bass+mid+treb;
per_frame_6=beat = beat*beat;
per_frame_7=
per_frame_8=avg = avg*dec_slow + beat*(1-dec_slow);
per_frame_9=is_beat = above(beat, 1.2*avg+peak) * above (time, t0+.2);
per_frame_10=t0 = is_beat*time + (1-is_beat)*t0;
per_frame_11=peak = is_beat * beat + (1-is_beat)*peak*dec_med;
per_frame_12=index = (index + is_beat) %8;
per_frame_13=indexa = (indexa + is_beat) %5;
per_frame_14=index2 = (index2 + is_beat*bnot(index))%2;
per_frame_15=
per_frame_16=q20 = avg;
per_frame_17=q21 = beat;
per_frame_18=q22 = peak;
per_frame_19=q23 = index;
per_frame_20=q24 = is_beat;
per_frame_21=q26 = bass_att + mid_att + treb_att + 1;
per_frame_22=q27 = index + 1;
per_frame_23=q11 = -index2 + indexa/5;
per_frame_24=q29 = index2;
per_frame_25=monitor = q29;
per_frame_26=k1 =  is_
per_frame_27=beat*equal(index%2,0);
per_frame_28=p1 =  k1*(p1+1) + (1-k1)*p1;
per_frame_29=p2 = dec_med * p2+ (1-dec_med)*p1;
per_frame_30=rott = p2 * 3.1416/4;
per_frame_31=
per_frame_32=q7= cos(rott);
per_frame_33=q8 = sin(rott);
per_frame_34=q3 = -q2;
per_frame_35=q4 = q1;
per_frame_36=
per_frame_37=ds = ds*dec_med + q24*(1-dec_med);
per_frame_38=q25 = q13;
per_frame_39=//q25 = above(ds,.5);
per_frame_40=
per_frame_41=q10 = above(sin(time/12),.2);
per_frame_42=
per_frame_43=t_rel = time*8;
per_frame_44=//q25 = below((t_rel)-int(t_rel),.2);
per_frame_45=
per_frame_46=
per_frame_47=p3 = p3*dec_med + (1-dec_med) * (100*index + .0*q26);
per_frame_48=q30 = p3 ;
per_frame_49=
per_frame_50=p4 = dec_med*p4 + (1-dec_med)*q27;
per_frame_51=q31 = p4;
per_frame_52=q13 = abs(sin(time/12));
per_frame_53=
per_frame_54=// Misc 
per_frame_55=decay = decay - 0.01*equal(frame%40,0);
per_frame_56=rot = rot + 0.01*sin(time*0.113);
per_frame_57=rot = rot + 0.01*sin(time*0.533);
per_frame_58=rot = rot + 0.02*sin(time*-0.323);
per_frame_59=dx = dx + dx_residual;
per_frame_60=dy = dy + dy_residual;
per_frame_61=bass_thresh = above(bass_att,bass_thresh)*2 + (1-above(bass_att,bass_thresh))*((bass_thresh-1.3)*0.96+1.3);
per_frame_62=dx_residual = equal(bass_thresh,2)*0.0072*sin(time*7) + (1-equal(bass_thresh,2))*dx_residual;
per_frame_63=dy_residual = equal(bass_thresh,2)*0.0054*sin(time*9) + (1-equal(bass_thresh,2))*dy_residual;
per_pixel_1=zoom=0.9615+rad*0.1;
per_pixel_2=rot = rot * 3*(1-pow(rad*2-1,2));
warp_1=`shader_body
warp_2=`{
warp_3=`
warp_4=`    // sample previous frame
warp_5=`    ret.xyz = tex2D( sampler_main, uv ).xyz;
warp_6=`
warp_7=`      // take the difference between the crisp and blurred images,
warp_8=`      // then add it back into the image.  Creates spots and stripes over time.
warp_9=`      ret.xyz += (ret - GetBlur3(uv))*0.35;
warp_10=`      ret.xyz -= 0.004;
warp_11=`
warp_12=`      // add noise:
warp_13=`      float2 dither_uv = uv_orig*texsize.xy*texsize_noise_lq.zw * 0.4 + rand_frame.xy;
warp_14=`      ret.xyz += (tex2D(sampler_noise_lq, dither_uv).xyz-0.5)*0.18;
warp_15=`
warp_16=`      // desaturate over time, to keep the globs white
warp_17=`      ret.xyz = lerp(ret.xyz, lum(ret.xyz), 0.2);
warp_18=`}
comp_1=`float z1;
comp_2=`float2 dz, dz1, uv5, sunpos1, sunpos2;
comp_3=`float3 sun1, sun2, ray1, ray2;
comp_4=`
comp_5=`float2 rs (float2 uv_in)
comp_6=`{
comp_7=`return ((uv_in-.5))+.5;
comp_8=`}
comp_9=`
comp_10=`shader_body {
comp_11=`
comp_12=`    dz.x = lum(GetPixel(rs(uv+float2(texsize.z,0))) 
comp_13=`          - GetPixel (rs(uv-float2(texsize.z,0))));
comp_14=`    dz.y = lum(GetPixel(rs(uv+float2(0,texsize.w))) 
comp_15=`          - GetPixel (rs(uv-float2(0,texsize.w))));
comp_16=`
comp_17=`dz *=.5;
comp_18=`
comp_19=`float3 ret1 = tex2D(sampler_main,rs(uv));
comp_20=`ret1 = lerp(lum(ret1), ret1, q13);
comp_21=`
comp_22=`uv = (uv-0.5)* aspect.xy+.5;    
comp_23=`
comp_24=`sunpos1 = float2(q7,q8)*q11+.5 ;
comp_25=`uv5 = normalize(uv-sunpos1)*q12+sunpos1;
comp_26=`ray1 = saturate(q22*GetPixel(rs(uv5))/length(uv-sunpos1)/12);
comp_27=`sun1 = saturate(.01/length(uv-sunpos1+dz));
comp_28=`
comp_29=`sunpos2 = float2(-q7,-q8)*q11+.5;
comp_30=`uv5 = normalize(uv-sunpos2)*q12+sunpos2;
comp_31=`ray2 = saturate(q22*GetPixel(rs(uv5))/length(uv-sunpos2)/12);
comp_32=`sun2 = saturate(.01/length(uv-sunpos2+dz));
comp_33=`
comp_34=`
comp_35=`ret = ret1*sun1*(8-4*q10) + ray1*saturate(1-sun1*4) + sun1;
comp_36=`ret += q10 * (ret1*sun2*4 + ray2*saturate(1-sun2*4) + sun2);
comp_37=`
comp_38=`
comp_39=`//ret = GetPixel(uv_orig);
comp_40=`}
comp_41=`
comp_42=`
