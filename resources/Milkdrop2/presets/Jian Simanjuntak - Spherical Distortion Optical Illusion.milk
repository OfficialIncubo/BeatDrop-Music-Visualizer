shape_3_per_frame1=s = instance/num_inst;
shape_3_per_frame2=t = s*6.2832;
shape_3_per_frame3= 
shape_3_per_frame4=X = sin(t) + 2*sin(2*t);
shape_3_per_frame5=Y = cos(t) - 2*cos(2*t);
shape_3_per_frame6=Z = -sin(3*t);
shape_3_per_frame7= 
shape_3_per_frame8=w1 = time*.6;
shape_3_per_frame9=X2 = X*cos(w1) + Z*sin(w1);
shape_3_per_frame10=Z2 = -X*sin(w1) + Z*cos(w1);
shape_3_per_frame11= 
shape_3_per_frame12=w2 = time*.4;
shape_3_per_frame13=Y2 = Y*cos(w2) - Z2*sin(w2);
shape_3_per_frame14=Z3 = Y*sin(w2) + Z2*cos(w2);
shape_3_per_frame15= 
shape_3_per_frame16=p  = 7/(7 - Z3);
shape_3_per_frame17=sc = 0.2*(1 + .1*(bass_att-1));
shape_3_per_frame18= 
shape_3_per_frame19=x = .5 + sc*X2*p/q1;
shape_3_per_frame20=y = .5 + sc*Y2*p;
shape_3_per_frame21= 
shape_3_per_frame22=rad = 0.25*p;
shape_3_per_frame23=a = .6 + .06*Z3*4/3;
shape_3_per_frame24=r = 7 + .3*Z3;
shape_3_per_frame25=g = 5 + .5*sin(s*12 + time);
shape_3_per_frame26=b = 0;
per_frame_1=q1 = aspecty; // shapecode particle
per_frame_2=
per_frame_3=// Gaya pada tonjolan bentuk bola
per_frame_4=q2 = 0.16 + 0.08 * bass_att*0.8;
per_frame_5=q3 = 0.5 + 0.28 * sin(time * 0.8) * aspectx;
per_frame_6=q4 = 0.5 + 0.22 * abs(sin(time * 1.3)) * aspecty - 0.11;
per_pixel_1=zoom=0.9900+rad*0.5;
warp_1=`shader_body {
warp_2=`float corr = texsize.xy*texsize_noise_lq.zw;
warp_3=`float2 uv1 = float2(uv.x-0.5,uv.y-0.5)*aspect.xy;
warp_4=`float3 ret1 = GetBlur1(uv) ;
warp_5=`
warp_6=`float2 zz = uv.xy * texsize.xy *.03;
warp_7=`float h1 = (cos(zz.y*1) * sin(-zz.y));
warp_8=`float h2 = (sin(zz.x) * cos(zz.y*-1));
warp_9=`
warp_10=`uv.xy -= float2(h1,h2)*texsize.zw * 12;
warp_11=`
warp_12=`ret = tex2D(sampler_main,uv)*0.98-0.008; 
warp_13=`
warp_14=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    // Tonjolan bentuk bola
comp_4=`    float2 center = float2(q3, q4);
comp_5=`    float2 d = (uv - center) * aspect.xy;
comp_6=`    float dist = length(d);
comp_7=`    float radius = q2;
comp_8=`
comp_9=`    float2 uv_ball = uv;
comp_10=`    if (dist < radius)
comp_11=`    {
comp_12=`        float factor = sqrt(1.0 - pow(dist / radius, 2.0));
comp_13=`        uv_ball = center + (uv - center) * (1.0 - factor * 0.5);
comp_14=`    }
comp_15=`
comp_16=`    // Mirrorized 
comp_17=`    float t = 7;
comp_18=`    float c = cos(t);
comp_19=`    float s = sin(t);
comp_20=`    float2 p = (uv_ball - 0.5) * aspect.xy;
comp_21=`    p = float2(c * p.x - s * p.y, s * p.x + c * p.y);
comp_22=`    float2 uv_mod = 0.5 + p * 5.8 * aspect.zw;
comp_23=`    uv_mod = 1.0 - abs(frac(uv_mod * 1.0) * 2.0 - 1.0);
comp_24=`
comp_25=`    float3 chue = tex2D(sampler_main, uv_mod).xyz;
comp_26=`    float3 r_col = chue.x * float3(0.0, 0.00, 1.0);
comp_27=`    float3 g_col = chue.y * float3(1.0, 1.0, 0.0);
comp_28=`    float3 b_col = chue.z * float3(1.0, 0.0, 1.0);
comp_29=`
comp_30=`    ret = saturate((r_col + g_col + b_col) * 1.25);
comp_31=`    ret = abs(ret - 0.5) * 2;
comp_32=`    ret = saturate(ret);
comp_33=`    ret *= 1.5;
comp_34=`}
