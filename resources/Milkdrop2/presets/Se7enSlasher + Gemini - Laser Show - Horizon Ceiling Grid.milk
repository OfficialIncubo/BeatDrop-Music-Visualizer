ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_init_1=q1=0.0;
per_frame_init_2=q2=40.0;
per_frame_init_3=q5=0.0;
per_frame_init_4=q6=0.0;
per_frame_init_5=time_delay=0.0;
per_frame_init_6=rand_laser=rand(240);
per_frame_init_7=temp1 = temp2 = temp3 = temp4 = 0;
per_frame_1=// SKELETON (Values configured for wider, pronounced grid-sweep intervals)
per_frame_2=time_delay = if(time_delay >= 0.30 && bass > 2.2, 0, time_delay += 1/fps);
per_frame_3=rand_laser = if(time_delay == 0, rand(240), rand_laser);
per_frame_4=
per_frame_5=// Custom variable mapping
per_frame_6=q1 = time_delay;
per_frame_7=q2 = rand_laser;
per_frame_8=temp1 += 0.075 * (bass + 0.05); 
per_frame_9=temp2 += 0.050 * (mid + 0.05);
per_frame_10=temp3 += 0.008 * (treb + 0.05);
per_frame_11=q3 = temp1; q4 = temp2; q5 = temp3;
per_frame_12=temp4 = if(time_delay == 0, 1.0, temp4 * 0.95);
per_frame_13=q6 = temp4;
warp_1=`shader_body {
warp_2=`
warp_3=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float2 p = uv;
comp_4=`    float3 lasers = float3(0, 0, 0);
comp_5=`    float2 horizon = float2(0.5, 0.45); // Camera vanishing point
comp_6=`    
comp_7=`    // Dynamic color shifting based on beat state
comp_8=`    float3 grid_color = float3(1.0, 0.1, 0.1); // Cyber Crimson
comp_9=`    if(fmod(floor(q2), 3.0) == 1.0) grid_color = float3(0.0, 1.0, 0.9); // Electric Cyan
comp_10=`    if(fmod(floor(q2), 3.0) == 2.0) grid_color = float3(0.8, 0.1, 1.0); // Synthwave Violet
comp_11=`    
comp_12=`    // Only process the overhead ceiling region to ground the scene
comp_13=`    if(p.y > horizon.y)
comp_14=`    {
comp_15=`        // 1. Perspective longitudinal lines emanating from horizon to upper frame
comp_16=`        for(int i = -6; i <= 6; i++)
comp_17=`        {
comp_18=`            float x_offset = 0.5 + float(i) * 0.25 + sin(q4) * 0.15;
comp_19=`            float2 target = float2(x_offset, 1.0);
comp_20=`            float2 dir = normalize(target - horizon);
comp_21=`            
comp_22=`            float d = abs((p.y - horizon.y) * dir.x - (p.x - horizon.x) * dir.y);
comp_23=`            
comp_24=`            float core = smoothstep(0.0025, 0.0, d);
comp_25=`            float glow = exp(-d * 90.0) * 0.25 + exp(-d * 20.0) * 0.12;
comp_26=`            lasers += (core + glow) * grid_color;
comp_27=`        }
comp_28=`        
comp_29=`        // 2. Transverse cross-beams flying forward with quadratic 3D speed scaling
comp_30=`        for(int j = 0; j < 5; j++)
comp_31=`        {
comp_32=`            float prog = frac(float(j) * 0.2 + q3 * 0.4);
comp_33=`            float y_pos = horizon.y + (1.0 - horizon.y) * (prog * prog);
comp_34=`            float d_h = abs(p.y - y_pos);
comp_35=`            
comp_36=`            float core_h = smoothstep(0.003, 0.0, d_h);
comp_37=`            float glow_h = exp(-d_h * 60.0) * 0.3 + exp(-d_h * 15.0) * 0.1;
comp_38=`            lasers += (core_h + glow_h) * grid_color;
comp_39=`        }
comp_40=`    }
comp_41=`    
comp_42=`    // 3. Ambient fog modifier
comp_43=`    float smoke = sin(p.x * 8.0 - q5) * cos(p.y * 12.0 + q3);
comp_44=`    float3 final_rgb = lasers * (0.5 + 0.5 * clamp(smoke + 0.5, 0.0, 1.0));
comp_45=`    
comp_46=`    // 4. Disco Stage Light Feature: Emits a structural flash on every beat reset
comp_47=`    float3 strobe = grid_color * q6 * 0.3 * smoothstep(horizon.y, 1.0, p.y);
comp_48=`    final_rgb += strobe;
comp_49=`    
comp_50=`    ret = final_rgb;
comp_51=`}
