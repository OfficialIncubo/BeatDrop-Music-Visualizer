wave_0_per_point1=t=above(sin(20*6.2831*sample+time*16),0);
wave_0_per_point2=ax = (1.58+1.5*t*abs(value1))*cos(6.2831*sample);
wave_0_per_point3=ay = 1.3*(1.58+1.5*t*abs(value2))*sin(6.2831*sample);
wave_0_per_point4=az = 0;
wave_0_per_point5=
wave_0_per_point6=bx = ax;
wave_0_per_point7=by = ay*cos(q1) - az*sin(q1);
wave_0_per_point8=bz = ay*sin(q1) + az*cos(q1);
wave_0_per_point9=
wave_0_per_point10=ax = bx*cos(q2) - bz*sin(q2);
wave_0_per_point11=ay = by;
wave_0_per_point12=az = bx*sin(q2) + bz*cos(q2);
wave_0_per_point13=
wave_0_per_point14=bx = ax*cos(q3) - ay*sin(q3);
wave_0_per_point15=by = ax*sin(q3) + ay*cos(q3);
wave_0_per_point16=bz = az;
wave_0_per_point17=
wave_0_per_point18=vx=bx; vy=by; vz=bz;
wave_0_per_point19=
wave_0_per_point20=x=vx/abs(vz-10)+.5;
wave_0_per_point21=y=vy/abs(vz-10)+.5;
wave_0_per_point22=
wave_0_per_point23=as=above(cos(q3+1.57)*cos(q2)*vx+sin(q3+1.57)*sin(q1)*vy+sin(q2)*vz,0);
wave_0_per_point24=a=t*(.07*(1-as)+as);
