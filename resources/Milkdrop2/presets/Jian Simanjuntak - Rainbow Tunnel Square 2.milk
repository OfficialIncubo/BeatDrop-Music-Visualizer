shape_3_init1=vx = 0;
shape_3_init2=vy = 0;
shape_3_per_frame1=ti = time*.3;
shape_3_per_frame2=x = .5 + .34*sin(ti);
shape_3_per_frame3=y = .5 + .34*cos(ti);
shape_3_per_frame4=
shape_3_per_frame5=rad = rad + bass*0.6;
shape_3_per_frame6=
shape_3_per_frame7=ti = time*2.3;
shape_3_per_frame8=x = x + .1*sin(ti);
shape_3_per_frame9=y = y + .1*cos(ti);
shape_3_per_frame10=
shape_3_per_frame11=r = 0.5 + 0.5 * sin(time * 3.8);
shape_3_per_frame12=g = 0.5 + 0.5 * sin(time * 0.9 + 5.2);
shape_3_per_frame13=b = 0.5 + 0.5 * sin(time * 1.1 + 6.3);
per_frame_init_1=xpos=0;
per_frame_init_2=ypos=0;
per_frame_1=decay = 1;
per_frame_2=warp = 0;
per_frame_3=zoom = 1;
per_frame_4=
per_frame_5=wave_r = 0.5 + 0.5 * sin(time * 3.8);
per_frame_6=wave_g = 0.5 + 0.5 * sin(time * 0.9 + 5.2);
per_frame_7=wave_b = 0.5 + 0.5 * sin(time * 1.1 + 6.3);
per_frame_8=wave_a = 1;
per_frame_9=
per_frame_10=vol = (bass+mid+treb)*0.55;
per_frame_11=vol = vol;
per_frame_12=musictime = musictime+vol;
per_frame_13=jss1 = sin(musictime*0.02)*0.3;
per_frame_14=jss2 = sin(musictime*0.01)*0.3;
per_frame_15=wave_x = .5 +jss1;
per_frame_16=wave_y = .5 +jss2;
per_frame_17=
per_frame_18=ob_r = 0.5 + 0.5 * sin(time * 0.3);
per_frame_19=ob_g = 0.5 + 0.5 * sin(time * 1.7 + 1.0);
per_frame_20=ob_b = 0.5 + 0.5 * sin(time * 5.3 + 3.0);
per_frame_21=
per_frame_22=q1 = 1.0; // Kecepatan waktu kamera
per_frame_23=q2 = 1.3; // Kecepatan terowongan berjalan
per_frame_24=q3 = 5.0; // Efek kegelapan
per_pixel_1=thresh = above(bass_att,thresh)*2+(1-above(bass_att,thresh))*((thresh-1.3)*0.96+1.3);
per_pixel_2=dx_r = equal(thresh,2)*1.015*sin(5*time)+(1-equal(thresh,2))*dx_r;
per_pixel_3=dy_r = equal(thresh,2)*1.015*sin(6*time)+(1-equal(thresh,2))*dy_r;
per_pixel_4=zoom = zoom + 0.0095*(sin(14*ang) + sin(sin(time*2*sin(time)*rad))*0.3 - cos(rad)*0.5)
per_pixel_5=*above(sin(time),0);
per_pixel_6=zoom = zoom + 0.0095*(sin(15*ang) + sin(sin(time*2*sin(time)*rad))*0.3 - cos(rad)*0.1)
per_pixel_7=*below(sin(time),0);
per_pixel_8=sx = sx + 0.01*(1.99*1-rad)*sin(0.733*time)*below(sin(time),0);
per_pixel_9=sy = sy + 0.01*(1.99*1-rad)*cos(0.953*time)*above(sin(time),0);
per_pixel_10=zoom = zoom - 0.015*(0.5*abs(3)-rad)*below(rad,0.5);
comp_1=`shader_body
comp_2=`{
comp_3=`    float2 uv_c = uv - 0.5;
comp_4=`    
comp_5=`    // SIMULASI KAMERA (Melihat Sekeliling / Panning)
comp_6=`    // Angka 1.5 mengatur kecepatan putaran kamera.
comp_7=`    // Angka 0.2 mengatur radius (seberapa jauh kamera menoleh).
comp_8=`    float cam_speed = time * q1;
comp_9=`    float cam_radius = 0.3; 
comp_10=`    
comp_11=`    // Kalkulasi jalur melingkar (Kanan -> Atas -> Kiri -> Bawah -> Kanan...)
comp_12=`    float2 camera_pan = float2(cos(cam_speed), sin(cam_speed)) * cam_radius;
comp_13=`    
comp_14=`    // Terapkan pergerakan kamera dengan menggeser titik pandang (vanishing point)
comp_15=`    uv_c += camera_pan;
comp_16=`    
comp_17=`    // Efek "Mirrorized" (memantulkan 4 arah)
comp_18=`    uv_c = abs(uv_c);
comp_19=`    
comp_20=`    // Kalkulasi kedalaman (Z) untuk bentuk lorong kotak (Square Tunnel)
comp_21=`    float z = max(uv_c.x, uv_c.y);
comp_22=`    
comp_23=`    // Mencegah pembagian dengan nilai nol di ujung tengah layar.
comp_24=`    // Nilai batas atas dinaikkan ke 0.8 karena titik hilang kamera kini bergerak mendekati tepi.
comp_25=`    z = clamp(z, 0.01, 0.8);
comp_26=`    
comp_27=`    // Inisialisasi koordinat permukaan baru (uv2)
comp_28=`    float2 uv2;
comp_29=`    
comp_30=`    // Kalkulasi pergerakan maju ke dalam lorong
comp_31=`    uv2.y = 0.25 / z + (time * q2);
comp_32=`    
comp_33=`    // Memetakan sudut agar membentuk dinding datar persegi
comp_34=`    uv2.x = (uv_c.x > uv_c.y) ? (uv_c.y / z) : (uv_c.x / z);
comp_35=`    
comp_36=`    // Mengambil tekstur menggunakan fungsi tex2D
comp_37=`    float3 col = tex2D(sampler_main, frac(uv2)).xyz;
comp_38=`    
comp_39=`    // Efek kegelapan (fog) di kedalaman agar lorong tidak terlihat datar
comp_40=`    col *= (z * q3);
comp_41=`    
comp_42=`    ret = float4(col, 1.0);
comp_43=`}
