shapecode_3_border_g=0.700
shapecode_3_border_b=0.500
shapecode_3_border_a=0.000
shape_3_per_frame1=sample = instance / num_inst;
shape_3_per_frame2=t_offset = sample * 12.56 + time * -1;
shape_3_per_frame3=y = 0.5 + 0.3 * sin(t_offset);
shape_3_per_frame4=x = 0.07+ 0.9 * sample; 
shape_3_per_frame5=z_depth = cos(t_offset);
shape_3_per_frame6=rad = 0.15 * (1 + 0.1 * z_depth);
per_frame_init_1=q1 = rand(100) / 100; // Bulan
per_frame_1=// ---- Bulan ----
per_frame_2=q1 = if(equal(frame, 0), rand(100) / 100, q1);
per_frame_3=
per_frame_4=q2 = 0.04; // Kecepatan pada awan
per_frame_5=
per_frame_6=// ---- Gerakan mandelbrot ----
per_frame_7=step = int(time / 5) % 5;
per_frame_8=
per_frame_9=q4 = if(equal(step, 0), 0.50 * cos(3),
per_frame_10=     if(equal(step, 1), 0.70 * cos(3),
per_frame_11=     if(equal(step, 2), 0.70 * cos(1),
per_frame_12=     if(equal(step, 3), 1.40 * cos(8), 1.10 * cos(2)))));
per_frame_13=
per_frame_14=q5 = if(equal(step, 0), 0.80 * sin(1),
per_frame_15=     if(equal(step, 1), 0.50 * sin(5),
per_frame_16=     if(equal(step, 2), 0.50 * sin(3),
per_frame_17=     if(equal(step, 3), 5.0 * sin(3), 1.0 * sin(4)))));
per_frame_18=
per_frame_19=// ---- Warna mandelbrot ----
per_frame_20=q6 = 0.5 + 1.0 * sin(time * 1.2 + bass * 0.5);
per_frame_21=q7 = 0.5 + 1.0 * sin(time * 1.2 + mid * 0.5 + 2.094);
per_frame_22=q8 = 0.5 + 1.0 * sin(time * 1.2 + treb * 0.5 + 4.188);
per_frame_23=
per_frame_24=wave_a = 0;
warp_1=`shader_body
warp_2=`{
warp_3=`    // Membuat pergeseran gelombang berbasis waktu dan posisi horizontal (uv.x)
warp_4=`    float wavehills = cos(uv.x * 14.0 - 0.6) * 0.10;
warp_5=`    
warp_6=`    // Menentukan batas ketinggian bukit (garis lengkung bergeser)
warp_7=`    float hill_line = 0.95 + wavehills;
warp_8=`
warp_9=`    // Pilihan Warna
warp_10=`    // Ubah nilai-nilai di bawah ini untuk mengganti warna sesuai selera Anda:
warp_11=`    float3 color_bottom = float3(0.0, 0.0, 0.0); 
warp_12=`    float3 color_top = float3(1.0, 1.0, 1.0);
warp_13=` 
warp_14=`    if (uv.y > hill_line)
warp_15=`    {
warp_16=`        ret = color_top;
warp_17=`    }
warp_18=`    else
warp_19=`    {
warp_20=`        ret = color_bottom;
warp_21=`    }
warp_22=`}
comp_1=`float3 line_color1, line_color2; // sky
comp_2=`
comp_3=`float rad_moon, dist_moon, circle_mask; // moon
comp_4=`float2 circle_pos;
comp_5=`float3 circle_color;
comp_6=`
comp_7=`float mir_clouds, cloud_mask, y0, z; // cloud
comp_8=`float2 centered_clouds, uv_cloud;
comp_9=`float3 cloud_color;
comp_10=`
comp_11=`float3 crisp, blurry, edges, mcolor, fg_mandelbrot; // Mandelbrot
comp_12=`float brightness;
comp_13=`
comp_14=`shader_body
comp_15=`{
comp_16=`    // ======== Langit ========
comp_17=`    line_color1 = float3(0.0, 0.0, 0.3);
comp_18=`    line_color2 = float3(0.0, 0.0, 0.2);
comp_19=`
comp_20=`    float blend_factor = smoothstep(0.2, 0.6, uv.y);
comp_21=`    ret = lerp(line_color1, line_color2, blend_factor);
comp_22=`
comp_23=`    // ======== Bulan ========
comp_24=`    circle_pos = float2(q1, 0.2); 
comp_25=`    rad_moon = 0.01; 
comp_26=`    circle_color = float3(3.0, 3.0, 3.0); 
comp_27=`
comp_28=`    dist_moon = length((uv - circle_pos) * aspect.xy);
comp_29=`
comp_30=`    circle_mask = 1.0 - smoothstep(rad_moon - 0.002, rad_moon + 0.100, dist_moon);
comp_31=`
comp_32=`    ret = lerp(ret, circle_color, circle_mask);  
comp_33=`
comp_34=`    // ======== Awan ========
comp_35=`    mir_clouds = 1.0 - uv.y;
comp_36=`    centered_clouds = uv - float2(0.4, 0.0); 
comp_37=`    y0 = 0.25; 
comp_38=`    z = y0 / max(mir_clouds, 0.00);
comp_39=`    uv_cloud = float2(centered_clouds.x * z, z + time * q2);
comp_40=`    float noise_base = tex2D(sampler_noise_hq, uv_cloud * 2.0).r;
comp_41=`    float noise_detail = tex2D(sampler_noise_lq, uv_cloud * 0.5).r;
comp_42=`    float cloud_pattern = saturate(noise_base * 0.75 + noise_detail * 0.25);
comp_43=`    cloud_color = float3(0.25, 0.25, 0.8); 
comp_44=`    cloud_mask = smoothstep(1.2, 0.35, uv.y) * cloud_pattern;
comp_45=`    ret = lerp(ret, cloud_color, cloud_mask * 0.65);
comp_46=`
comp_47=`   // ======== Mandelbrot ========
comp_48=`    float2 zm = (uv-0.5)*aspect.xy*2.50;
comp_49=`    float2 cz = float2(q4,q5);
comp_50=`    for(int i=0;i<8;i++) zm = clamp(float2(zm.x*zm.x-zm.y*zm.y, 2*zm.x*zm.y)+cz, -2, 2);
comp_51=`    float2 uv_mandelbrot = zm*0.25+0.5;
comp_52=`
comp_53=`   crisp = tex2D(sampler_main, uv_mandelbrot).xyz;
comp_54=`   blurry = GetBlur1(uv_mandelbrot);
comp_55=`   edges = abs(crisp - blurry) * 100.2;
comp_56=`   mcolor = float3(q6, q7, q8);
comp_57=`   brightness = lum(edges);
comp_58=`   fg_mandelbrot = brightness * mcolor * 1.0; 
comp_59=` 
comp_60=`  ret += fg_mandelbrot*0.10;
comp_61=`}
