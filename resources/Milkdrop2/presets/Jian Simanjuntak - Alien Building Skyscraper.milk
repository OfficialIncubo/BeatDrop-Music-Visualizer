per_frame_1=warp=0;
per_frame_2=zoom=0;
per_frame_3=
per_frame_4=// Composite shader with skyscraper
per_frame_5=// Area of skyscraper 1
per_frame_6=time_area_skyscraper = time_area_skyscraper + .001*25/fps;
per_frame_7=q5 = time_area_skyscraper;
per_frame_8=
per_frame_9=// Area of skyscraper 2
per_frame_10=time_area_skyscraper2 = time_area_skyscraper2 + .001*30/fps;
per_frame_11=q4 = time_area_skyscraper2;
per_frame_12=
per_frame_13=// Area of skyscraper 3
per_frame_14=time_area_skyscraper3 = time_area_skyscraper3 + .001*35/fps;
per_frame_15=q3 = time_area_skyscraper3;
per_frame_16=// End
warp_1=`shader_body {
warp_2=`//ret = 1;
warp_3=`}
comp_1=`sampler sampler_AlienBuilding_Clouds;
comp_2=`sampler sampler_AlienBuilding_SkyscraperBack01;
comp_3=`sampler sampler_AlienBuilding_SkyscraperBack02;
comp_4=`sampler sampler_AlienBuilding_SkyscraperBack03;
comp_5=`
comp_6=`float2 uv1, uv2, uv3, uv_time1, uv_time2, uv_time3;
comp_7=`
comp_8=`shader_body
comp_9=`{
comp_10=`
comp_11=`
comp_12=`// ***** Martin's ripples on water surface code, parameterized by Flexi *****
comp_13=`
comp_14=`float h = 0.3;                      // height of the horizon
comp_15=`float cut_off = 0.0;              // cut off lower border
comp_16=`float2 t = float2(0.1,-0.05)*time;  // velocity
comp_17=`float strength = 0.025;
comp_18=`
comp_19=`
comp_20=`float2 c = uv_orig-float2(0.5,1-h);
comp_21=`float z = 3/c.y;
comp_22=`float2 uv_water = float2(c.x*z*h,z*h)*0.25+time*0.4;
comp_23=`int mask = (c.y>0);
comp_24=`uv_water = (tex2D(sampler_noise_hq,uv_water)-0.5)*mask;
comp_25=`float2 uv_mirror = 1.0-abs(frac((c+float2(0.5,1))*0.5)*2-1)+float2(0,-cut_off);
comp_26=`uv_mirror =frac(uv_mirror-uv_water.xy*strength);
comp_27=`
comp_28=`// ***** :)
comp_29=`
comp_30=`uv = uv_mirror;
comp_31=`
comp_32=`ret = tex2D(sampler_AlienBuilding_Clouds, uv);
comp_33=`
comp_34=`// BUILDING MOD 1
comp_35=`    uv1.y = uv.y;
comp_36=`    uv1.x = uv.x;
comp_37=`    uv1 = 1.0*(uv1);
comp_38=`
comp_39=`    uv_time1 = frac(uv1+q5*float2(1,0.0)) ;
comp_40=`float uv_building = tex2D( sampler_AlienBuilding_SkyscraperBack01, uv_time1);
comp_41=`if (uv_building > .3)
comp_42=`   { ret = tex2D( sampler_AlienBuilding_SkyscraperBack01, uv_time1); }
comp_43=`//End
comp_44=`
comp_45=`// BUILDING MOD 2
comp_46=`    uv2.y = uv.y;
comp_47=`    uv2.x = uv.x;
comp_48=`    uv2 = 1.0*(uv2);
comp_49=`
comp_50=`    uv_time2 = frac(uv2+q4*float2(1,0.0)) ;
comp_51=`float uv_building2 = tex2D( sampler_AlienBuilding_SkyscraperBack02, uv_time2);
comp_52=`if (uv_building2 > .3)
comp_53=`   { ret = tex2D( sampler_AlienBuilding_SkyscraperBack02, uv_time2); }
comp_54=`//End
comp_55=`
comp_56=`// BUILDING MOD 3
comp_57=`    uv3.y = uv.y;
comp_58=`    uv3.x = uv.x;
comp_59=`    uv3 = 1.0*(uv3);
comp_60=`
comp_61=`    uv_time3 = frac(uv3+q3*float2(1,0.0)) ;
comp_62=`float uv_building3 = tex2D( sampler_AlienBuilding_SkyscraperBack03, uv_time3);
comp_63=`if (uv_building3 > .3)
comp_64=`   { ret = tex2D( sampler_AlienBuilding_SkyscraperBack03, uv_time3); }
comp_65=`//End
comp_66=`
comp_67=`ret *= 1.00; //gamma
comp_68=`
comp_69=`}
comp_70=`