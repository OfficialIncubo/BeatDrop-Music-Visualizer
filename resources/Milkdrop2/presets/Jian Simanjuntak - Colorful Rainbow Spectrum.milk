per_frame_1=// NEW PRESET MILKDROP VISUALIZATION 2025 EDITION
per_frame_2=// Author by Jian Simanjuntak 
per_frame_3=
per_frame_4=wave_r = wave_r + 0.300*( 0.90*sin(1.753*time+0) + 0.40*sin(1.315*time+1) );
per_frame_5=wave_g = wave_g + 0.300*( 0.90*sin(2.883*time+3) + 0.40*sin(1.006*time+4) );
per_frame_6=wave_b = wave_b + 0.300*( 0.90*sin(1.393*time+5) + 0.40*sin(2.733*time+2) );
per_frame_7=
per_frame_8=q8 =oldq8+ 0.001*(pow(1.2*bass+0.4*bass_att+0.2*treb+0.2*treb_att+0.2*mid+0.2*mid_att,6)/fps) +0.1/fps;
per_frame_9=oldq8 = q8;
per_frame_10=volume = 0.15*(bass_att+bass+mid+mid_att);
per_frame_11=beatrate = if(equal(beatrate,0),1,if(below(volume,0.01),1,beatrate));
per_frame_12=lastbeat = if(equal(lastbeat,0),time,lastbeat);
per_frame_13=meanbass_att = 0.1*(meanbass_att*9 + bass_att);
per_frame_14=peakbass_att = if(above(bass_att,peakbass_att),bass_att,peakbass_att);
per_frame_15=beat = if(above(volume,0.8),if(below(peakbass_att - bass_att, 0.05*peakbass_att),if(above(time - lastbeat,0.1+0.0*(beatrate-0.1)),1,0),0),0);
per_frame_16=beatrate = max(if(beat,if(below(time-lastbeat,2*beatrate),0.1*(beatrate*9 + time - lastbeat),beatrate),beatrate),0.1);
per_frame_17=peakbass_att = if(equal(beat,0),if(above(time - lastbeat,2*beatrate),peakbass_att*0.95,peakbass_att*0.995),bass_att);
per_frame_18=lastbeat = if(beat,time,lastbeat);
per_frame_19=mybeat = if(beat,mybeat+1,mybeat);
per_frame_20=mybeat = if(above(mybeat,7),0,mybeat);
per_frame_21=mybeat2 = if(equal(mybeat,1),1,0);
per_frame_22=q7 = if(beat*mybeat2,0.001+0.0001*int(rand(40)),oldq7);
per_frame_23=oldq7=q7;
per_frame_24=q6 = if(beat*mybeat2,0.001+0.0001*int(rand(40)),oldq6);
per_frame_25=oldq6=q6;
per_frame_26=q5= if(beat*mybeat2,0.001+0.0001*int(rand(40)),oldq5);
per_frame_27=oldq5=q5;
per_frame_28=q4 = if(beat*mybeat2,0.001+0.0001*int(rand(40)),oldq4);
per_frame_29=oldq4=q4;
per_frame_30=Flag = If(beat*mybeat2,if(int(Rand(2))-1,1,0),oldFlag);
per_frame_31=oldflag = flag;
per_frame_32=Ratio = If(Beat*mybeat2,100+int(rand(60)),oldRatio);
per_frame_33=OldRatio = Ratio;
per_frame_34=q3 = if(beat*mybeat2,if(flag,ratio,0.75*ratio),oldq3);
per_frame_35=oldq3=q3;
per_frame_36=q2 = if(beat*mybeat2,if(flag,0.75*ratio,ratio),oldq2);
per_frame_37=oldq2=q2;
per_pixel_1=q1 = 8.3+(sin(x+0.137*q8)-cos(y+0.213*q8));
per_pixel_2=zoom = if(above(box,1),q1*.1,zoom);
per_pixel_3=rot = if(above(box,1),0.1*rad+sin(0.385*q8),rot);
per_pixel_4=dx=if(above(box,1),dx,q4*sin((y-0.5)*q3)+q5*sin((y-0.5)*q2));
per_pixel_5=dy=if(above(box,1),dy,q6*cos((x-0.5)*q2)+q7*cos((x-0.5)*q3));
per_pixel_6=zoom = zoom + cos(ang*3)*0.03;
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`
warp_6=`    // this vector points exactly one pixel, in the direction of motion
warp_7=`    float2 v = normalize(uv-uv_orig)*texsize.zw;
warp_8=`
warp_9=`    float3 s;
warp_10=`    ret = max(ret, tex2D(sampler_main, uv+v)*0.98);
warp_11=`    ret = max(ret, tex2D(sampler_main, uv-v)*0.98);
warp_12=`    ret = max(ret, tex2D(sampler_main, uv+v*2)*0.95);
warp_13=`    ret = max(ret, tex2D(sampler_main, uv-v*2)*0.95);
warp_14=`
warp_15=`    // darken over time
warp_16=`    ret *= 0.99;
warp_17=`
warp_18=`    // add noise
warp_19=`    //float2 uv_noise = uv*texsize_noise_lq.zw*texsize.xy + rand_frame.xy;
warp_20=`    //ret += (tex2D(sampler_noise_lq, uv_noise)*2-1)*0.02;
warp_21=`}
comp_1=`float4 paletteReal(float w) {
comp_2=`    float red, green, blue;
comp_3=`    if (w >= 380. && w < 440.) {
comp_4=`        red = -(w - 440.) / (440. - 380.);
comp_5=`        green = 0.;
comp_6=`        blue = 1.;
comp_7=`    } else if (w >= 440. && w < 490.) {
comp_8=`        red = 0.;
comp_9=`        green = (w - 440.) / (490. - 440.);
comp_10=`        blue = 1.;
comp_11=`    } else if (w >= 490. && w < 510.) {
comp_12=`        red = 0.;
comp_13=`        green = 1.;
comp_14=`        blue = -(w - 510.) / (510. - 490.);
comp_15=`    } else if (w >= 510. && w < 580.) {
comp_16=`        red = (w - 510.) / (580. - 510.);
comp_17=`        green = 1.;
comp_18=`        blue = 0.;
comp_19=`    } else if (w >= 580. && w < 645.) {
comp_20=`        red = 1.;
comp_21=`        green = -(w - 645.) / (645. - 580.);
comp_22=`        blue = 0.;
comp_23=`    } else if (w >= 645. && w < 781.) {
comp_24=`        red = 1.;
comp_25=`        green = 0.;
comp_26=`        blue = 0.;
comp_27=`    } else {
comp_28=`        red = 0.;
comp_29=`        green = 0.;
comp_30=`        blue = 0.;
comp_31=`    }
comp_32=`
comp_33=`    float factor;
comp_34=`    if (w >= 380. && w < 420.) factor = .3 + .7*(w - 380.) / (420. - 380.);
comp_35=`    else if (w >= 420. && w < 701.) factor = 1.;
comp_36=`    else if (w >= 701. && w < 781.) factor = .3 + .7*(780. - w) / (80.);
comp_37=`    else factor = 0.;
comp_38=`
comp_39=`    float gamma = .8;
comp_40=`    float R = (red > 0. ? 255.*pow(red * factor, gamma) : 0.);
comp_41=`    float G = (green > 0. ? 255.*pow(green * factor, gamma) : 0.);
comp_42=`    float B = (blue > 0. ? 255.*pow(blue * factor, gamma) : 0.);
comp_43=`
comp_44=`    return float4(R/255.,G/255.,B/255.,1.);
comp_45=`}
comp_46=`
comp_47=`float4 paletteRealUniform(float u) {
comp_48=`    // Diasumsikan uniform_to_widthNanometers(u) = u * 400 + 380
comp_49=`    float w = u * 400 + 380;
comp_50=`    return paletteReal(w);
comp_51=`}
comp_52=`
comp_53=`shader_body {
comp_54=`    float4 c = tex2D(sampler_main, uv);
comp_55=`    float u = .2*c.r + .7*c.g + .1*c.b;
comp_56=`    ret = paletteRealUniform(1.-u);
comp_57=`}