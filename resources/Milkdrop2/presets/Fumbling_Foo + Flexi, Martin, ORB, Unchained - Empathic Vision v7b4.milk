warp_64=`
warp_65=`}
comp_1=`#define sat saturate
comp_2=`static float z, z0, radi;
comp_3=`static float2 uv1, uv2, uva, uv_foo, dz;
comp_4=`static const int anz = 40;
comp_5=`static const float2 moonpos = .5;
comp_6=`static const float2 hor = texsize.zw*float2(1,0);
comp_7=`static const float2 ver = texsize.zw*float2(1,0).yx;
comp_8=`float3 Get1 (float2 uvi, float par)
comp_9=`{return lerp(GetBlur1(uvi), GetPixel(uvi), 0*saturate(par/2))*par;}
comp_10=`
comp_11=`shader_body
comp_12=`{
comp_13=`    uv_foo = uv*.85 + .075;
comp_14=`   
comp_15=`    uva = (uv-0.5)*aspect.xy + .5;
comp_16=`    float moon = (pow(q24, .333) / length (uva-moonpos));
comp_17=`
comp_18=`    dz.x = lum(GetPixel(uv-hor)) - lum(GetPixel(uv+hor));
comp_19=`    dz.y = lum(GetPixel(uv-ver)) - lum(GetPixel(uv+ver));
comp_20=`
comp_21=`    float3 shine = GetPixel(uv*.85 + .075); 
comp_22=`    uv2 = (uv-moonpos)*1.4 + moonpos;
comp_23=`   
comp_24=`    radi = q10;
comp_25=`
comp_26=`    for (int n=1; n <= anz; n++)
comp_27=`    { 
comp_28=`      uv2 = (normalize(uv-moonpos)*radi+moonpos);
comp_29=`      shine += 2.5/anz*Get1((uv-moonpos)*radi+moonpos,radi) ;
comp_30=`      radi -= 0.75/anz;;
comp_31=`    }
comp_32=`
comp_33=`
comp_34=`    float2 uv_temp1 = (uv - 0.5) * texsize.xy;
comp_35=`    float2 c = ((uv-0.5)*aspect.wz);
comp_36=`    float rad_hq = length(uv_temp1);
comp_37=`    float ang_hq = atan2(c.x,-c.y);
comp_38=`
comp_39=`    uv2 = (uv2-0.5);
comp_40=`    float rad2 = rad_hq*.85;
comp_41=`    float ang2 = ang_hq * M_INV_PI_2;
comp_42=`
comp_43=`        // FIN TYPE
comp_44=`        float fins = (q26 + 6);
comp_45=`        ang2 = frac(ang2*fins)/fins;
comp_46=`              // ENABLE THIS TO MAKE THE FINS ALTERNATE: (seamless!)
comp_47=`              ang2 = abs(ang2 - 0.5/fins);
comp_48=`
comp_49=`    ang2 *= M_PI_2;
comp_50=`    uv = 0.5 + rad2*float2(cos(ang2),sin(ang2))*texsize.zw;
comp_51=`
comp_52=`
comp_53=`    uv_temp1 = (uv_foo - 0.5) * texsize.xy;
comp_54=`    c = ((uv_foo-0.5)*aspect.wz);
comp_55=`    rad_hq = length(uv_temp1);
comp_56=`    ang_hq = atan2(c.x,-c.y);
comp_57=`
comp_58=`    uv2 = (uv2-0.5);
comp_59=`    rad2 = rad_hq;
comp_60=`    ang2 = ang_hq * M_INV_PI_2;
comp_61=`
comp_62=`        // FIN TYPE
comp_63=`        fins = (q26 + 6);
comp_64=`        ang2 = frac(ang2*fins)/fins;
comp_65=`              // ENABLE THIS TO MAKE THE FINS ALTERNATE: (seamless!)
comp_66=`              ang2 = abs(ang2 - 0.5/fins);
comp_67=`
comp_68=`    ang2 *= M_PI_2;
comp_69=`    float2 uv_foo2 = 0.5 + rad2*float2(cos(ang2),sin(ang2))*texsize.zw;
comp_70=`
comp_71=`
comp_72=`    uva = (uv-0.5)*aspect.xy + .5;
comp_73=`    moon = (pow(q23, .333) / length (uva-moonpos));
comp_74=`
comp_75=`    dz.x = lum(GetPixel(uv-hor)) - lum(GetPixel(uv+hor));
comp_76=`    dz.y = lum(GetPixel(uv-ver)) - lum(GetPixel(uv+ver));
comp_77=`
comp_78=`    float3 shine2 = GetPixel(uv_foo2); 
comp_79=`    uv2 = (uv-moonpos)*1.4 + moonpos;
comp_80=`   
comp_81=`    radi = q10;
comp_82=`
comp_83=`    for (int n=1; n <= 60; n++)
comp_84=`    { 
comp_85=`      uv2 = (normalize(uv-moonpos)*radi+moonpos);
comp_86=`      shine2 += 3*(q32)*(1 - exp(-shine))/n*Get1((uv-moonpos)*radi+moonpos,.5*radi) ;
comp_87=`      radi -= .5/anz;;
comp_88=`    }
comp_89=`
comp_90=`
comp_91=`    float3 ret_t = refract((pow(GetPixel(uv)*.9 + .05, lum(exp(shine)))), (mul(-sqrt(.8 + .3*q15)*shine, pow(GetPixel(uv), pow(GetPixel(uv_foo)*(1/pow(.5*q23, .22)), shine2*(1/pow(.5*q24, .33))))) ), .75 + .25*q11);
comp_92=`    float3 ret_s = sin(min(sign(shine)*pow(pow(.3*q31, .3), shine), -pow(GetPixel(uv), sign(shine)*pow(abs(shine), 1/pow(q21, .2))) ));
comp_93=`    float3 ret_r = refract(ret_t, -ret_s, saturate((-.5*sqrt(q31) + q21)) + saturate(-(-.5*sqrt(q31) + q21)));
comp_94=`
comp_95=`    float3 ret_u = lerp(ret_t, (ret_s), lerp(sign(shine)*pow(abs(shine), -ret_s), refract(sign(ret_s)*pow(abs(ret_t), -ret_r), sign(ret_t)*pow(abs(ret_t), -ret_s), .9 + .1*q11), ret_r*sign((q23) - sqrt(.333*q27))*((q23) - sqrt(.333*q27))));
comp_96=`    float3 ret_x = (.85*lerp(max(pow(cross((pow(15*pow(q9, .15), ret_r)), pow(15*pow(q2, .15), ret_u)), 1/(1 + .2*q15)), pow(1-exp(-ret_u), pow(q25, .125))), lerp(ret_t, ret_r, ret_u), ret_s ));
comp_97=`
comp_98=`    float3 ret_c = refract(mul(GetPixel(uv)*(q17), -pow(GetPixel(uv_foo2)*pow(abs(q10), .4), pow(shine*(q27), GetPixel(uv_foo)*(2/sqrt(q23))))), (pow(GetPixel(uv_foo2)/pow(q27, .333), (exp2(shine*sqrt(q31))))), -1);
comp_99=`    float3 ret_b = pow(abs(shine), pow(cross(GetPixel(uv)/pow(q9, .3), pow(cross(8*GetPixel(uv_foo)*(q21), abs(.5*shine2*q11 + shine2)), pow(q2, .3))), q17)); // pow(pow(GetPixel(uv), pow(GetPixel(uv_foo)*sqrt(q17), .9/sqrt(q21))), 1);     
comp_100=`    float3 ret_a = (lerp((ret_b)*pow(q23, .33), (ret_c)*pow(q24, .33), -(refract(pow(abs(ret_b), (ret_c)), pow(abs(ret_c), ret_b), .75 ))));
comp_101=`
comp_102=`    ret = saturate(refract(ret_x, (lerp(ret_c, ret_a, ret_b)), 1)) + saturate(-refract(ret_x, (lerp(ret_c, ret_a, ret_b)), -1));
comp_103=`//ret = shine2;
comp_104=`}
