MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5.000
fGammaAdj=1.900
fDecay=0.970
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=1
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=1.000
fWaveSmoothing=0.630
fWaveParam=-1.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.331
fZoomExponent=1.00000
fShader=0.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=1.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_init_1=q1=0.0;
per_frame_init_2=q2=40.0;
per_frame_init_3=q5=0.0;
per_frame_init_4=q6=0.0;
per_frame_init_5=time_delay=0.0;
per_frame_init_6=rand_laser = rand(100);
per_frame_1=time_delay = if(time_delay >= .35 && (bass+mid+treb)*.5 > 1.8, 0, time_delay += 1/fps);
per_frame_2=rand_laser = if(time_delay == 0, rand(100), rand_laser); // Random seed from 0 to 100
per_frame_3=
per_frame_4=// We MUST assign these to Q variables so the comp shader can communicate with them
per_frame_5=q1 = rand_laser; // Tells the shader which pattern/color to use
per_frame_6=q2 = time_delay; // Tells the shader when a beat triggers (0 = beat)
per_frame_7=q3 = bass;       // Used for smooth, non-seizure brightness pulsing
warp_1=`sampler sampler_rand00;
warp_2=`
warp_3=`shader_body {
warp_4=`    ret = (tex2d(sampler_rand00, uv).xyz / 2) * (.25 + bass_att/2.25);
warp_5=`}
comp_1=`// Math function to draw a glowing 2D laser beam
comp_2=`// We put this OUTSIDE the shader_body so it compiles cleanly
comp_3=`float3 GetLaser(float2 uva, float2 origin, float angle, float3 color_vec) {
comp_4=`    float2 p = uva - origin;
comp_5=`    
comp_6=`    // Direction and Normal vectors for the beam
comp_7=`    float2 dir = float2(cos(angle), sin(angle));
comp_8=`    float2 n = float2(-dir.y, dir.x);
comp_9=`    
comp_10=`    // Distance field math
comp_11=`    float line_dist = abs(dot(p, n));
comp_12=`    float along = dot(p, dir);
comp_13=`    
comp_14=`    // Create an intensely bright core and a soft volumetric outer glow
comp_15=`    float core = exp(-line_dist * 4000.0);
comp_16=`    float glow = 0.001 / (line_dist + 0.0005);
comp_17=`    
comp_18=`    // Ensure the laser only shoots forward from its origin (smoothstep avoids hard cutoffs)
comp_19=`    float intensity = (core + glow) * smoothstep(-0.02, 0.1, along);
comp_20=`    
comp_21=`    return color_vec * intensity;
comp_22=`}
comp_23=`
comp_24=`shader_body
comp_25=`{
comp_26=`    // 1. DYNAMIC COLOR & PATTERN SELECTION
comp_27=`    float seed = q1; // Reads your rand_laser variable
comp_28=`    float f_mode = fmod(seed, 4.0);
comp_29=`    float col_sel = fmod(seed * 7.3, 4.0); // Scramble color independently from pattern
comp_30=`    
comp_31=`    float3 col1, col2;
comp_32=`    if (col_sel < 1.0) {
comp_33=`        col1 = float3(0.0, 1.0, 0.3); // Neon Matrix Green
comp_34=`        col2 = float3(1.0, 1.0, 0.0); // Laser Yellow
comp_35=`    } else if (col_sel < 2.0) {
comp_36=`        col1 = float3(1.0, 0.0, 0.3); // Cyberpunk Pink
comp_37=`        col2 = float3(0.0, 0.8, 1.0); // Cyan
comp_38=`    } else if (col_sel < 3.0) {
comp_39=`        col1 = float3(1.0, 0.1, 0.1); // Ruby Red
comp_40=`        col2 = float3(0.8, 0.0, 1.0); // Deep Purple
comp_41=`    } else {
comp_42=`        col1 = float3(1.0, 1.0, 1.0); // White Core
comp_43=`        col2 = float3(0.0, 0.5, 1.0); // Deep Blue
comp_44=`    }
comp_45=`
comp_46=`    // 2. SMOKE BACKGROUND
comp_47=`    // We use MilkDrop's built-in blur buffers to create a hazy/smoky atmosphere
comp_48=`    float3 smoke = GetBlur3(uv).rgb * 1.2 + GetBlur1(uv).rgb * 0.4;
comp_49=`    smoke = lerp(smoke, smoke * col1, 0.3) * 0.6; // Tint the smoke to match the laser
comp_50=`    
comp_51=`    // 3. BEAT REACTIVITY (Smooth & Safe)
comp_52=`    float beat_sync = exp(-q2 * 5.0); // Sharp transient used strictly for motion/rotation jumps
comp_53=`    float slow_pulse = 0.8 + 0.2 * sin(time * 2.0 + q3 * 0.5); // Smooth anti-seizure brightness 
comp_54=`
comp_55=`    // 4. LASER RENDERER (Looping through beams)
comp_56=`    float3 lasers = float3(0, 0, 0);
comp_57=`
comp_58=`    if (f_mode < 1.0) {
comp_59=`        // MODE 0: Dual Horizon Fans (Shooting from bottom corners)
comp_60=`        float2 o_L = float2(0.0, 1.0);
comp_61=`        float2 o_R = float2(1.0, 1.0);
comp_62=`        for (int i = 0; i < 10; i++) {
comp_63=`            float f = i / 9.0;
comp_64=`            float a_L = -1.4 + f * 1.2 + sin(time * 0.5 + i * 0.2) * 0.1 + beat_sync * 0.1;
comp_65=`            float a_R = 3.14 + 1.4 - f * 1.2 - sin(time * 0.6 + i * 0.2) * 0.1 - beat_sync * 0.1;
comp_66=`            lasers += GetLaser(uv, o_L, a_L, col1);
comp_67=`            lasers += GetLaser(uv, o_R, a_R, col2);
comp_68=`        }
comp_69=`    } 
comp_70=`    else if (f_mode < 2.0) {
comp_71=`        // MODE 1: Top-down Alien Scanner
comp_72=`        float2 o_C = float2(0.5, -0.1);
comp_73=`        for (int i = 0; i < 16; i++) {
comp_74=`            float f = i / 15.0;
comp_75=`            float a_C = 0.4 + f * 2.34 + sin(time + i * 0.1) * 0.2;
comp_76=`            a_C += beat_sync * 0.2 * (fmod((float)i, 2.0) < 1.0 ? 1.0 : -1.0); // Alternate beam stutter
comp_77=`            lasers += GetLaser(uv, o_C, a_C, col1 * (1.0 + beat_sync * 0.2));
comp_78=`        }
comp_79=`    }
comp_80=`    else if (f_mode < 3.0) {
comp_81=`        // MODE 2: Central V-Shape Tunnel
comp_82=`        float2 o_B = float2(0.5, 1.0);
comp_83=`        for (int i = 0; i < 12; i++) {
comp_84=`            float f = i / 11.0;
comp_85=`            float a_L = -1.57 - 0.05 - f * 1.0 + sin(time * 1.5) * 0.1;
comp_86=`            float a_R = -1.57 + 0.05 + f * 1.0 - sin(time * 1.5) * 0.1;
comp_87=`            lasers += GetLaser(uv, o_B, a_L, col1);
comp_88=`            lasers += GetLaser(uv, o_B, a_R, col2);
comp_89=`        }
comp_90=`        // Side scanning floor lines
comp_91=`        lasers += GetLaser(uv, float2(0.0, 0.6), -0.2 + beat_sync * 0.1, float3(1, 1, 1));
comp_92=`        lasers += GetLaser(uv, float2(1.0, 0.6), 3.14 + 0.2 - beat_sync * 0.1, float3(1, 1, 1));
comp_93=`    }
comp_94=`    else {
comp_95=`        // MODE 3: Starburst Rotator
comp_96=`        float2 o_C = float2(0.5, 0.5);
comp_97=`        for (int i = 0; i < 14; i++) {
comp_98=`            float f = i / 13.0;
comp_99=`            float a = f * 6.28 + time * 0.3 + beat_sync * 1.5 * f; // Fast jump on beat
comp_100=`            lasers += GetLaser(uv, o_C, a, lerp(col1, col2, f));
comp_101=`        }
comp_102=`    }
comp_103=`
comp_104=`    // Apply the smooth reactive brightness to lasers
comp_105=`    lasers *= slow_pulse;
comp_106=`
comp_107=`    // 5. DISCO LIGHT (Ambient top glow mapping)
comp_108=`    float top_light = exp(-length(uv - float2(0.5, -0.1)) * 3.0);
comp_109=`    float3 disco = top_light * col1 * (slow_pulse * 1.5);
comp_110=`
comp_111=`    // Final Composition (Combine smoke layer + raw lasers + overhead light)
comp_112=`    ret = smoke + lasers + disco;
comp_113=`}
