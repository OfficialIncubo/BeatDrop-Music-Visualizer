per_frame_1=q1 = 0.2 + (bass_att*0.10); // Membesarkan untuk lingkaran (zoom)
per_frame_2=q2 = 0.30; // Kehalusan untuk tepi lingkaran
per_frame_3=
per_frame_4=wave_r=int(rand(200))/200;
per_frame_5=wave_g=int(rand(200))/200;
per_frame_6=wave_b=int(rand(200))/200;
per_frame_7=
per_frame_8=// ========================================
per_frame_9=movement_mod = int(time / 5) % 2;
per_frame_10=
per_frame_11=q3 = if(movement_mod, 25, -25);
per_frame_12=rot = if(movement_mod, 0.03, -0.03);
per_frame_13=dx = if(movement_mod, -0.008, 0.008);
per_frame_14=dy = if(movement_mod, 0.008, -0.008);
per_frame_15=
per_frame_16=// --- Mirrorized ---
per_frame_17=mirr_rand = int(time / 5) % 5;
per_frame_18=
per_frame_19=q4 = if(equal(mirr_rand, 3), 0.0,
per_frame_20=        if(equal(mirr_rand, 4), 1.0, 0.5));
per_frame_21=
per_frame_22=q5 = if(equal(mirr_rand, 1), 0.0,    
per_frame_23=        if(equal(mirr_rand, 2), 1.0, 0.5));
warp_1=`shader_body
warp_2=`{
warp_3=`    uv -= 0.5;
warp_4=`    uv *= (1 + 0*uv.y + 0*uv.x);
warp_5=`    uv += 0.5;
warp_6=`
warp_7=`    // sample previous frame
warp_8=`    ret = tex2D( sampler_main, uv ).xyz;
warp_9=`
warp_10=`
warp_11=`    ret = max(ret,  tex2D(sampler_main, uv + (ret.xy-0.5)*texsize.zw*q3*float2(0,1)).xyz );   
warp_12=` 
warp_13=`    // darken (decay) over time
warp_14=`    ret = (ret - 0.015)*0.98;
warp_15=`}
comp_1=`float3 ret1, ret2;
comp_2=`
comp_3=`shader_body
comp_4=`{
comp_5=`    // =========== Circle ============
comp_6=`    float2 uv_centered = (uv - 0.5) * aspect.xy;
comp_7=`    float dist = length(uv_centered);
comp_8=`    float radius = q1;
comp_9=`    float smoothness = q2;
comp_10=`    float circle = 1.0 - smoothstep(radius - smoothness, radius + smoothness, dist);
comp_11=`
comp_12=`    float3 circle_color = float3(0.8, 0.8, 0.8);
comp_13=`    float3 bg_color = float3(0.09, 0.09, 0.09);
comp_14=`    ret1 = lerp(bg_color, circle_color, circle);
comp_15=`
comp_16=`    // ========== Mirrorized ========== 
comp_17=`    float2 uv2 = uv;
comp_18=`    if(uv2.x >= q4) { uv2.x = 1.0 - uv2.x; }
comp_19=`    if(uv2.y >= q5) { uv2.y = 1.0 - uv2.y; }
comp_20=`
comp_21=`    ret2 = tex2D(sampler_main, uv2).xyz;
comp_22=`    ret2 *= 1.00; // gamma
comp_23=`
comp_24=`    float mask = smoothstep(0.09, 0.30, max(ret2.r, max(ret2.g, ret2.b)));
comp_25=`
comp_26=`    ret = lerp(ret1, ret2, mask);
comp_27=`}
