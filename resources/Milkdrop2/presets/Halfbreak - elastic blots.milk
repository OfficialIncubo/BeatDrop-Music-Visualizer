per_frame_1=warp = treb_att-1;
per_frame_2=//wave_mystery = .25*time;
per_frame_3=//dx = .0005*sin(time);
per_frame_4=//dy = .0005*cos(time);
per_frame_5=
per_frame_6=wave_g = 1-above(treb_att,1.5);
per_frame_7=wave_r = 1-above(treb_att,1.5);
per_pixel_1=zoom = 1+.15*(rad-.33);
warp_1=`shader_body
warp_2=`{
warp_3=`    float1 d = 0.005;
warp_4=`    float1 dx = ( 2*GetBlur2(uv + float2(d,0)) - 2*GetBlur2(uv-float2(d,0)) ).x*0.5;
warp_5=`    float1 dy = ( 2*GetBlur2(uv + float2(0,d)) - 2*GetBlur2(uv-float2(0,d)) ).x*0.5;
warp_6=`    float1 dxb = ( 2*GetBlur2(uv + float2(d,0)) - 2*GetBlur2(uv-float2(d,0)) ).x*0.5;
warp_7=`    float1 dyb = ( 2*GetBlur2(uv + float2(0,d)) - 2*GetBlur2(uv-float2(0,d)) ).x*0.5;
warp_8=`    float2 my_uv = uv - float2(dx,dy)*0.005 + float2(dxb,dyb)*0.002;
warp_9=`
warp_10=`
warp_11=`
warp_12=`    float2 v = 0.1;
warp_13=`    ret.x = tex2D( sampler_fc_main, my_uv).x;
warp_14=`
warp_15=`    
warp_16=`    ret.x += (2*ret.x - 2*GetBlur3(uv).x)*.05;
warp_17=`    ret.x += 0.006;
warp_18=`
warp_19=`    ret.x = lerp( ret.x, lum(ret).x, 0);
warp_20=`
warp_21=`//--------------------------------
warp_22=`
warp_23=`    my_uv = uv + float2(dy,-dx)*0.025*(2.4-2*GetBlur3(uv).y);
warp_24=`
warp_25=`
warp_26=`
warp_27=`    v = 0.01;
warp_28=`    ret.z = tex2D( sampler_fw_main, my_uv).z;
warp_29=`
warp_30=`    
warp_31=`    ret.z += (2*ret.z - 2*GetBlur1(uv).z)*length(my_uv-uv)*60;
warp_32=`    ret.z *= 0.85;
warp_33=`    ret.z += 0.008;
warp_34=`
warp_35=`
warp_36=`
warp_37=`//--------------------------------
warp_38=`
warp_39=`    d = 0.01;
warp_40=`    my_uv = float2(-dy,dx)*0.05;
warp_41=`
warp_42=`    dx = ( 2*GetBlur2(uv + float2(d,0)) - 2*GetBlur2(uv-float2(d,0)) ).y*0.5;
warp_43=`    dy = ( 2*GetBlur2(uv + float2(0,d)) - 2*GetBlur2(uv-float2(0,d)) ).y*0.5;
warp_44=`    my_uv += uv - float2(dx,dy)*0.3;
warp_45=`
warp_46=`
warp_47=`
warp_48=`    v = 0.01;
warp_49=`    ret.y =tex2D( sampler_fw_main, my_uv).y;
warp_50=`
warp_51=`    
warp_52=`    ret.y += (2*ret.y - 2*GetBlur3(my_uv).y)*0.05 + 0.03;
warp_53=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    ret = tex2D(sampler_main, uv).xyz;
comp_4=`    float L = lum(ret);
comp_5=`    float bw = saturate(cos(L*27 + 3)*30 - 26);
comp_6=`    float L2 = lum(GetBlur1(uv));
comp_7=`    float bw2 = saturate(cos(L*27 + 3)*30 - 26);
comp_8=`ret *= max(tex2D(sampler_main, uv).y, GetBlur2(uv).y*0.5);
comp_9=`
comp_10=`    ret = float3(1.1,0.8,0.7)*ret.x*bass+0.0  +
comp_11=`          float3(0.4,0.6,0.55)*ret.y*bass+0.0 + 
comp_12=`          float3(0.7,0.6,0.9)*ret.z*bass+0.0;
comp_13=`
comp_14=`    ret = ret*ret * (1.3 + bw*bw2*5);
comp_15=`ret *= 1 - saturate(GetBlur1(uv).z*10);
comp_16=`ret += pow(tex2D( sampler_main, uv).z,1.5)*float3(1,1,1);
comp_17=`//ret = tex2D(sampler_main, uv);
comp_18=`
comp_19=`}
