per_frame_1=wave_r = wave_r + 0.350*( 0.60*sin(0.980*time) + 0.40*sin(1.047*time) );
per_frame_2=wave_g = wave_g + 0.350*( 0.60*sin(0.835*time) + 0.40*sin(1.081*time) );
per_frame_3=wave_b = wave_b + 0.350*( 0.60*sin(0.814*time) + 0.40*sin(1.011*time) );
per_frame_4=cx = cx + 0.110*( 0.60*sin(0.374*time) + 0.40*sin(0.294*time) );
per_frame_5=cy = cy + 0.110*( 0.60*sin(0.393*time) + 0.40*sin(0.223*time) );
per_frame_6=decay = decay - 0.01*equal(frame%20,0);
per_frame_7=//zoom = 1;
per_frame_8=//warp = 0;
per_frame_9=zoom = zoom + 0.5*(0.01*cos(time*0.317+1) + 0.01*cos(time*0.1132+4));
per_frame_10=rot  = rot  + 0.5*(0.01*cos(time*0.214+3) + 0.01*cos(time*0.2732+2));
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`
warp_6=`    // take the difference between the crisp and blurred images,
warp_7=`    // then add it back into the image.  Creates spots and stripes over time.
warp_8=`    ret += (ret - GetBlur1(uv))*0.2;
warp_9=`    ret *= 0.9;
warp_10=`}
comp_1=`float2 uv_r, uv_g, uv_b;
comp_2=`float3 color, glow;
comp_3=`shader_body
comp_4=`{
comp_5=`    // 1. Pusatkan kordinat dan sesuaikan aspect ratio
comp_6=`    uv -= 0.5;
comp_7=`    uv *= aspect.xy;
comp_8=`
comp_9=`    // 2. Efek Pusaran (Vortex/Swirl) berdasarkan jarak dari tengah (rad)
comp_10=`   float twist = sin(rad * 3.14 - time * 2.0) * 0.4 * bass_att;
comp_11=`   float s = sin(twist);
comp_12=`   float c = cos(twist);
comp_13=`   float2 swirled_uv = float2(uv.x * c - uv.y * s, uv.x * s + uv.y * c);
comp_14=`   
comp_15=`   // 3. Efek Zoom-in yang berdenyut seiring dentuman bass
comp_16=`   swirled_uv = swirled_uv * (0.95 - 0.05 * bass_att) + 0.5;
comp_17=`
comp_18=`   // 4. Chromatic Aberration (Pemisahan channel Merah, Hijau, Biru)
comp_19=`   // Membuat efek ala TV rusak atau kacamata 3D jadul
comp_20=`   uv_r = swirled_uv + float2(0.015 * bass_att, 0.0);
comp_21=`   uv_g = swirled_uv;
comp_22=`   uv_b = swirled_uv - float2(0.015 * bass_att, 0.0);
comp_23=`
comp_24=`   // 5. Ambil pixel dari masing-masing kordinat yang sudah digeser
comp_25=`   color.r = GetPixel(uv_r).r;
comp_26=`   color.g = GetPixel(uv_g).g;
comp_27=`   color.b = GetPixel(uv_b).b;
comp_28=`
comp_29=`   // 6. Buat pancaran cahaya (glow) tebal dari selisih blur kasar dan blur halus
comp_30=`   glow = GetBlur1(swirled_uv) - GetBlur3(swirled_uv);
comp_31=`   
comp_32=`   // 7. Buat cincin gelombang (ripple) yang merambat keluar layar
comp_33=`   // Bereaksi terhadap nada tinggi (treb_att)
comp_34=`   float ripple = abs(frac(rad * 4.0 - time * 3.0) - 0.5) * 2.0;
comp_35=`   ripple = pow(1.0 - ripple, 4.0) * treb_att;
comp_36=`
comp_37=`   // 8. Campurkan warna asli, cahaya neon, dan gelombang ripple
comp_38=`   // Memberikan tint warna biru/cyan pada ripple
comp_39=`   color = color * 0.85 + max(0, glow) * 3.0 + float3(0.1, 0.6, 1.0) * ripple * 0.6;
comp_40=`
comp_41=`   // 9. Tone mapping agar warna menyala terang tapi tidak pecah (overexposed)
comp_42=`   ret = 1.0 - exp(-color * (1.2 + bass_att * 0.3));
comp_43=`}
