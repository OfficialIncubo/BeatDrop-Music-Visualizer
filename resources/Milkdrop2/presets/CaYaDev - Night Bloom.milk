per_frame_52=q43 = h_6;
per_frame_53=t0_7 = if(go*(slot == 7), time, t0_7);
per_frame_54=x_7 = if(go*(slot == 7), 0.2 + 0.6*(rand(1000)*0.001), x_7);
per_frame_55=h_7 = if(go*(slot == 7), rand(1000)*0.001, h_7);
per_frame_56=q45 = t0_7;
per_frame_57=q46 = x_7;
per_frame_58=q47 = h_7;
warp_1=`shader_body
warp_2=`{
warp_3=`  float2 fall = float2(0.0, -0.0006) * q30;
warp_4=`  ret = tex2D(sampler_main, uv + fall).xyz * pow(0.9, q30);
warp_5=`  ret = lerp(ret, GetBlur1(uv + fall) * pow(0.9, q30), 0.25 * min(1.0, q30));
warp_6=`  ret = max(ret - 0.002 * max(q30, 1.0), 0.0);
warp_7=`}
comp_1=`sampler sampler_pw_noise_lq;
comp_2=`shader_body
comp_3=`{
comp_4=`  float3 m = tex2D(sampler_main, uv).xyz;
comp_5=`  float3 b2 = GetBlur2(uv);
comp_6=`  float3 b3 = GetBlur3(uv);
comp_7=`  float3 sky = lerp(float3(0.0, 0.01, 0.04), float3(0.03, 0.03, 0.08), uv.y);
comp_8=`  float smoke = tex2D(sampler_noise_hq, uv * float2(1.2, 0.8) + float2(q1, 0.0)).x;
comp_9=`  sky += lum(b3) * smoke * float3(0.6, 0.5, 0.5) * 0.9;
comp_10=`  float2 sp = uv * texsize.xy / 512.0;
comp_11=`  float4 st = tex2D(sampler_pw_noise_lq, sp);
comp_12=`  float star = saturate((st.x * st.y - 0.98) * 50.0) * (0.6 + 0.4 * sin(time * 2.0 + st.z * 30.0)) * (0.5 + 0.5 * q3) * saturate(0.75 - uv.y);
comp_13=`  float3 col = sky + star * 0.7 + m * 2.0 + b2 * 1.2 + b3 * 0.7;
comp_14=`  float bx = floor(uv.x * 46.0);
comp_15=`  float bh = tex2D(sampler_pw_noise_lq, float2(bx / 256.0, 0.5)).x;
comp_16=`  float roof = 0.86 - 0.11 * bh * bh;
comp_17=`  float city = step(roof, uv.y);
comp_18=`  float win = step(0.985, tex2D(sampler_pw_noise_lq, float2(floor(uv.x * 260.0) / 256.0, floor(uv.y * 150.0) / 256.0)).x) * step(roof + 0.02, uv.y);
comp_19=`  float3 cityc = float3(0.01, 0.01, 0.02) + lum(b3) * float3(0.3, 0.25, 0.3) + win * float3(1.0, 0.75, 0.4) * 0.25;
comp_20=`  col = lerp(col, cityc, city);
comp_21=`  ret = 1.0 - exp(-col * 1.5);
comp_22=`}
