per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.2)*((time - last) > 0.3);
per_frame_5=go = ((beat + ((time - last) > 1.5)) > 0);
per_frame_6=last = if(go, time, last);
per_frame_7=slot = if(go, (slot + 1)%8, slot);
per_frame_8=q1 = time*0.01;
per_frame_9=q2 = max(0, 1 - (time - last)*1.2);
per_frame_10=q3 = treb_att;
per_frame_11=t0_0 = if(go*(slot == 0), time, t0_0);
per_frame_12=x_0 = if(go*(slot == 0), 0.2 + 0.6*(rand(1000)*0.001), x_0);
per_frame_13=h_0 = if(go*(slot == 0), rand(1000)*0.001, h_0);
per_frame_14=q5 = t0_0;
per_frame_15=q6 = x_0;
per_frame_16=q7 = h_0;
per_frame_17=t0_1 = if(go*(slot == 1), time, t0_1);
per_frame_18=x_1 = if(go*(slot == 1), 0.2 + 0.6*(rand(1000)*0.001), x_1);
per_frame_19=h_1 = if(go*(slot == 1), rand(1000)*0.001, h_1);
per_frame_20=q9 = t0_1;
per_frame_21=q10 = x_1;
per_frame_22=q11 = h_1;
per_frame_23=t0_2 = if(go*(slot == 2), time, t0_2);
per_frame_24=x_2 = if(go*(slot == 2), 0.2 + 0.6*(rand(1000)*0.001), x_2);
per_frame_25=h_2 = if(go*(slot == 2), rand(1000)*0.001, h_2);
per_frame_26=q13 = t0_2;
per_frame_27=q14 = x_2;
per_frame_28=q15 = h_2;
per_frame_29=t0_3 = if(go*(slot == 3), time, t0_3);
