per_frame_43=h_5 = if(go*(slot == 5), rand(1000)*0.001, h_5);
per_frame_44=q37 = t0_5;
per_frame_45=q38 = x_5;
per_frame_46=q39 = h_5;
per_frame_47=t0_6 = if(go*(slot == 6), time, t0_6);
