PSVERSION_COMP=2
[preset00]
fRating=5.000
fGammaAdj=1.460
fDecay=0.935
FFTAttack=1.000
FFTDecay=0.350
fVideoEchoZoom=1.007
fVideoEchoAlpha=0.500
nVideoEchoOrientation=2
nWaveMode=15
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=1
bDarken=1
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=0.625
fWaveSmoothing=0.900
fWaveParam=0.000
fModWaveAlphaStart=0.880
fModWaveAlphaEnd=1.980
fWarpAnimSpeed=0.010
fWarpScale=0.010
fZoomExponent=1.00000
fShader=1.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.500
wave_y=0.500
ob_size=0.500
ob_r=0.010
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.260
ib_r=0.235
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=64.000
nMotionVectorsY=48.000
mv_dx=0.000
mv_dy=0.000
mv_l=1.000
mv_r=1.060
mv_g=1.000
mv_b=0.819
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float sdSeg(float2 p, float2 a, float2 b)
warp_7=`{
warp_8=`    float2 pa = p - a;
warp_9=`    float2 ba = b - a;
warp_10=`    float h = saturate(dot(pa, ba) / dot(ba, ba));
warp_11=`    return length(pa - ba * h);
warp_12=`}
warp_13=`
warp_14=`float3 hsv(float h, float s, float v)
warp_15=`{
warp_16=`    float4 k = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
warp_17=`    float3 p = abs(frac(h + k.xyz) * 6.0 - k.www);
warp_18=`    return v * lerp(k.xxx, saturate(p - k.xxx), s);
warp_19=`}
warp_20=`
warp_21=`shader_body
warp_22=`{
warp_23=`    uv.y = 1.0 - uv.y;
warp_24=`    float2 my_uv = (uv - 0.5) * aspect.xy * 2;
warp_25=`
warp_26=`    float2 q = my_uv - float2(0.0, -0.02);
warp_27=`    float tri = max(abs(q.x) * 0.866 + q.y * 0.5, -q.y) - 0.1;
warp_28=`    
warp_29=`    float3 col = float3(0.1, 0.12, 0.18) * step(tri, 0.0) + float3(0.9, 0.95, 1.0) * smoothstep(0.004, 0.0, abs(tri)) * 0.8;
warp_30=`    
warp_31=`        float2 beamStart = float2(-1.8 * aspect.x + 0.14, -0.58);
warp_32=`    col += float3(1.0, 1.0, 1.0) * 0.004 / (sdSeg(my_uv, beamStart, float2(-0.07, -0.01)) + 0.004) * (0.5 + vol_att);
warp_33=`    
warp_34=`    if (my_uv.x > 0.06)
warp_35=`    {
warp_36=`        float2 d = my_uv - float2(0.06, -0.01);
warp_37=`        float spread = 0.12 + bass_att * 0.075;
warp_38=`        float u = (atan2(d.y, d.x) + 0.25 + spread) / (2.0 * spread);
warp_39=`        float fft_val = get_fft(saturate(u));
warp_40=`        
warp_41=`        col += hsv(u * 0.8, 0.9, 1.0) * step(0.0, u) * step(u, 1.0) * (0.5 + fft_val * 1.5) * smoothstep(0.0, 0.1, length(d)) * 0.7;
warp_42=`    }
warp_43=`
warp_44=`    ret = col;
warp_45=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
