per_frame_12=//Kameraposition rel. zu Vogel
per_frame_13=reg00 = if(tic*bnot(count%4), rand(8)-4, reg00);
per_frame_14=reg01 = if(tic*bnot(count%6), (rand(8))/6+0, reg01);
