###################################################################################################

MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5.000
fGammaAdj=1.920
fDecay=0.970
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=1
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=1.000
fWaveSmoothing=0.630
fWaveParam=-1.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.331
fZoomExponent=1.00000
fShader=0.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=1.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_init_1=q1=0.0;
per_frame_init_2=q2=40.0;
per_frame_init_3=q5=0.0;
per_frame_init_4=q6=0.0;
per_frame_init_5=time_delay=0.0;
per_frame_init_6=rand_laser=rand(100);
per_frame_init_7=temp1 = 0;
per_frame_1=// SKELETON (kept intact, snappy retrigger to match the scissor snap rhythm)
per_frame_2=time_delay = if(time_delay >= .25 && bass > 2, 0, time_delay += 1/fps);
per_frame_3=rand_laser = if(time_delay == 0, rand(100), rand_laser);
per_frame_4=
per_frame_5=// Custom variable mapping to feed the Comp Shader
per_frame_6=q1 = rand_laser;                          // color palette seed
per_frame_7=q2 = time_delay;                          // beat clock (0 = beat)
per_frame_8=temp1 += (0.55 + mid_att*0.5)/fps;        // open/close drive clock (feeds triangle wave in shader)
per_frame_9=q3 = temp1;
per_frame_10=q6 = 0.5 + 0.5*sin(time*0.35 + rand_laser*0.05); // slow color drift phase
warp_1=`shader_body {}
comp_1=`float3 GetLaser(float2 uva, float2 origin, float angle, float3 color_vec, float focus) {
comp_2=`    float2 p = uva - origin;
comp_3=`    float2 dir = float2(cos(angle), sin(angle));
comp_4=`    float2 n = float2(-dir.y, dir.x);
comp_5=`    float line_dist = abs(dot(p, n));
comp_6=`    float along = dot(p, dir);
comp_7=`    float core = exp(-line_dist * (4000.0 * focus));
comp_8=`    float glow = 0.0018 / (line_dist + 0.0007);
comp_9=`    float intensity = (core + glow) * smoothstep(-0.05, 0.15, along) * smoothstep(1.1, 0.9, along);
comp_10=`    return color_vec * intensity;
comp_11=`}
comp_12=`
comp_13=`shader_body
comp_14=`{
comp_15=`    float2 center = float2(0.5, 0.5);
comp_16=`    float2 p = uv;
comp_17=`
comp_18=`    float col_sel = fmod(q1 * 2.1, 4.0);
comp_19=`    float3 col1, col2;
comp_20=`    if (col_sel < 1.0) { col1 = float3(1.0, 0.0, 0.2); col2 = float3(0.0, 1.0, 1.0); }
comp_21=`    else if (col_sel < 2.0) { col1 = float3(1.0, 0.6, 0.0); col2 = float3(0.5, 0.0, 1.0); }
comp_22=`    else if (col_sel < 3.0) { col1 = float3(0.0, 1.0, 0.3); col2 = float3(1.0, 0.0, 0.8); }
comp_23=`    else { col1 = float3(1.0, 1.0, 1.0); col2 = float3(0.2, 0.5, 1.0); }
comp_24=`
comp_25=`    float beat_strike = exp(-q2 * 5.5);
comp_26=`    float beam_focus = 1.0 + beat_strike * 2.8;
comp_27=`
comp_28=`    // 1. SCISSOR CROSS
comp_29=`    // Two beam-pairs pivot from fixed corner anchors and snap open/closed like
comp_30=`    // scissor blades. The opening angle is driven by a snappy triangle-wave
comp_31=`    // pulse (q3) so it has a distinct open/close rhythm instead of a smooth
comp_32=`    // sine drift, and bass hits add a sharp extra snap via beat_strike.
comp_33=`    float3 lasers = float3(0,0,0);
comp_34=`
comp_35=`    float tri = abs(fmod(q3, 2.0) - 1.0); // 0..1..0 triangle wave from accumulating clock
comp_36=`    float open_amt = 0.15 + tri * 0.65 + beat_strike * 0.25;
comp_37=`
comp_38=`    float2 anchor_bl = float2(0.0, 0.0);
comp_39=`    float2 anchor_tr = float2(1.0, 1.0);
comp_40=`    float2 anchor_br = float2(1.0, 0.0);
comp_41=`    float2 anchor_tl = float2(0.0, 1.0);
comp_42=`
comp_43=`    // Blade pair 1: bottom-left + top-right, pivoting to form one diagonal of the X
comp_44=`    float ang1 = 0.785398 + open_amt * 0.5;   // 45deg base, opens outward
comp_45=`    float ang2 = 0.785398 - open_amt * 0.5;
comp_46=`    lasers += GetLaser(p, anchor_bl, ang1, col1, beam_focus);
comp_47=`    lasers += GetLaser(p, anchor_tr, ang1 + 3.14159, col1, beam_focus);
comp_48=`    lasers += GetLaser(p, anchor_bl, ang2, col1, beam_focus) * 0.6;
comp_49=`
comp_50=`    // Blade pair 2: bottom-right + top-left, the other diagonal
comp_51=`    float ang3 = 2.356194 + open_amt * 0.5;   // 135deg base
comp_52=`    float ang4 = 2.356194 - open_amt * 0.5;
comp_53=`    lasers += GetLaser(p, anchor_br, ang3, col2, beam_focus);
comp_54=`    lasers += GetLaser(p, anchor_tl, ang3 + 3.14159, col2, beam_focus);
comp_55=`    lasers += GetLaser(p, anchor_br, ang4, col2, beam_focus) * 0.6;
comp_56=`
comp_57=`    // 2. Pivot point glow dots at the four corners
comp_58=`    float dots = exp(-length(p-anchor_bl)*30.0) + exp(-length(p-anchor_tr)*30.0)
comp_59=`               + exp(-length(p-anchor_br)*30.0) + exp(-length(p-anchor_tl)*30.0);
comp_60=`    lasers += lerp(col1,col2,0.5) * dots * 0.6;
comp_61=`
comp_62=`    // 3. Smoke from MilkDrop's blur buffer
comp_63=`    float3 smoke = GetBlur2(uv).rgb * 0.55;
comp_64=`    float3 bg = smoke * col1 * 0.12;
comp_65=`
comp_66=`    // 4. Center cross-point flash, brightens when blades are near full open + on beat
comp_67=`    float center_flare = exp(-length(p-center)*6.0) * (open_amt * 0.4 + beat_strike * 1.0);
comp_68=`    lasers += lerp(col1,col2,0.5) * center_flare;
comp_69=`
comp_70=`    // 5. Smooth non-seizure breathing
comp_71=`    float breathe = 0.82 + 0.18*sin(time*0.55 + q6*3.14159);
comp_72=`
comp_73=`    float3 final_rgb = (lasers + bg) * breathe;
comp_74=`    ret = final_rgb;
comp_75=`}
