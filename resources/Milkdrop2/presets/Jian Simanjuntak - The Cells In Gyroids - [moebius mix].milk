per_frame_1=// the mobius transformation edition by Jian Simanjuntak
per_frame_2=// z -> (az+b)/(cz-d); where a,b,c,d are complex numbers and z will be the uv-vector
per_frame_3=// (az+b)/(cz-d) = a/c + mu/(cz+d), with mu = (bc-ad)/c
per_frame_4=// so a/c and mu can be calculated outside of the shader
per_frame_5=
per_frame_6=//before inversion
per_frame_7=
per_frame_8=scale = 1;
per_frame_9=angle = time*.5;
per_frame_10=translation_x = 0;
per_frame_11=translation_y = 0.12;
per_frame_12=
per_frame_13=a_r = cos(angle)*scale;
per_frame_14=a_i = sin(angle)*scale;
per_frame_15=b_r = translation_x;
per_frame_16=b_i = translation_y;
per_frame_17=
per_frame_18=//complex inverted
per_frame_19=scale = 1;
per_frame_20=angle = sin(time*0.1337)*0.3;
per_frame_21=translation_u = 0;
per_frame_22=translation_v = -0.2;
per_frame_23=
per_frame_24=// c
per_frame_25=q15 = cos(angle)*scale;
per_frame_26=q16 = sin(angle)*scale;
per_frame_27=
per_frame_28=// d
per_frame_29=q17 = translation_u;
per_frame_30=q18 = translation_v;
per_frame_31=
per_frame_32=// c^(-1)
per_frame_33=c_inv_r = q15/(q15*q15+q16*q16);
per_frame_34=c_inv_i = q16/(q15*q15+q16*q16);
per_frame_35=
per_frame_36=// a*c^(-1)
per_frame_37=q11 = (a_r*c_inv_r - a_i*c_inv_i);
per_frame_38=q12 = (a_r*c_inv_i - a_i*c_inv_r);
per_frame_39=
per_frame_40=// (bc-ad)
per_frame_41=bcad_r = (b_r*q15 - b_i*q16)-(a_r*q17-a_i*q18);
per_frame_42=bcad_i = (b_r*q16 - b_i*q15)-(a_r*q18-a_i*q17);
per_frame_43=
per_frame_44=// mu*c^(-1)
per_frame_45=q13 = bcad_r*c_inv_r - bcad_i*c_inv_i;
per_frame_46=q14 = bcad_r*c_inv_i - bcad_i*c_inv_r;
per_frame_47=// THE END //
warp_1=`//Original shader by Tubeman
warp_2=`//ShaderToy Original: https://www.shadertoy.com/view/l3fSDr
warp_3=`//MilkDrop (HLSL) Port by Jian Simanjuntak
warp_4=`
warp_5=`//BEGIN//
warp_6=`
warp_7=`float3 pal(float t) {
warp_8=`    float3 b = float3(.45, .45, .45);
warp_9=`    float3 c = float3(.35, .35, .35);
warp_10=`    return b + c*cos(6.28318*(t*float3(1, 1, 1)+float3(.7,.39, .2)));
warp_11=`}
warp_12=`
warp_13=`float gyroid(float3 p, float scale) {
warp_14=`    p *= scale;
warp_15=`    float bias = lerp(1.1, 2.65, sin(time*.4 + p.x/3. + p.z/4.)*.5+.5);
warp_16=`    float g = abs(dot(sin(p*1.01), cos(p.zxy*1.61)) - bias)/(scale*1.5)-.1;
warp_17=`    return g;
warp_18=`}
warp_19=`
warp_20=`float scene(float3 p) {
warp_21=`    float g1 = .7*gyroid(p, 4.);
warp_22=`    return g1;
warp_23=`}
warp_24=`
warp_25=`// from @blackle
warp_26=`float3 norm(float3 p) {
warp_27=`    float3x3 k = float3x3(p,p,p) - float3x3(0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01);
warp_28=`    return normalize(scene(p) - float3(scene(k[0]),scene(k[1]),scene(k[2])));
warp_29=`}
warp_30=`	shader_body {
warp_31=`    uv = (uv * 2)-1;
warp_32=`    float3 init = float3(time*.25,1.5,.3);
warp_33=`    float3 cam = normalize(float3(1., uv ));
warp_34=`    
warp_35=`    // basic raymarcher from @blackle
warp_36=`    float3 p = init;
warp_37=`    bool hit = false;
warp_38=`    for ( int i = 0; i < 100 && !hit; i++) {
warp_39=`        if (distance(p,init) > 8.) int test = 0;
warp_40=`       float d = scene(p);
warp_41=`       if (d*d < 0.00001) hit = true;
warp_42=`       p += cam*d;
warp_43=`    }
warp_44=`    float3 n = norm(p);
warp_45=`
warp_46=`    float ao = 1.-smoothstep(-.3,.75,scene(p+n*.4))
warp_47=`             * smoothstep(-3.,3.,scene(p+n*1.));
warp_48=`             
warp_49=`    float fres = -max(0., pow(.8-abs(dot(cam,n)), 3.));
warp_50=`    float3 vign = smoothstep(0.,1.,(1.-(length(uv*.8)-.1)));
warp_51=`    float3 col = pal(.1-time*.01 + p.x*.28 + p.y*.2 + p.z*.2);
warp_52=`    col = (float3(fres, fres, fres)+col)*ao;
warp_53=`    col = lerp(col, float3(0,0,0), !hit ? 1. : smoothstep(0.,8.,distance(p,init)));
warp_54=`    col = lerp(float3(0,0,0),col, vign+.1);
warp_55=`    col = smoothstep(0.,1.+.3*sin(time+p.x*4.+p.z*4.),col);
warp_56=`    ret = col;
warp_57=`    ret = sqrt(ret);
warp_58=`}
warp_59=`// Thank you for warp shader edited by Jian Simanjuntak //
comp_1=`shader_body
comp_2=`{
comp_3=`
comp_4=`float2 ac = float2(q11,q12);
comp_5=`float2 mu = float2(q13,q14);
comp_6=`float2 c = float2(q15,q16);
comp_7=`float2 d = float2(q17,q18);
comp_8=`
comp_9=`float2 z = (uv-0.5);
comp_10=`
comp_11=`// (c*z + d)
comp_12=`float2 czd = float2(z.x*c.x-z.y*c.y,z.x*c.y-z.y*c.x) + d;
comp_13=`// mu/(cz+d)
comp_14=`float2 moebius = float2( mu.x*czd.x + mu.y*czd.y , mu.y*czd.x-mu.x*czd.y )/(czd.x*czd.x+czd.y*czd.y) + ac;
comp_15=`
comp_16=`moebius = 0.5 + (1.0 - abs( frac( moebius * 0.5 ) * 2 - 1.0 )-0.5)*0.99;
comp_17=`
comp_18=`uv=moebius;
comp_19=`float3 rnd = tex2D(sampler_noise_lq, rand_frame.xy + uv*texsize.xy*texsize_noise_lq.zw)*2-1;
comp_20=`
comp_21=`ret = GetPixel(uv);
comp_22=`
comp_23=`d = texsize.zw * 8;
comp_24=`}
