###################################################################################################

MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5.000
fGammaAdj=1.920
fDecay=0.970
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=1
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=1.000
fWaveSmoothing=0.630
fWaveParam=-1.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.331
fZoomExponent=1.00000
fShader=0.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=1.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_init_1=q1=0.0;
per_frame_init_2=q2=40.0;
per_frame_init_3=q5=0.0;
per_frame_init_4=q6=0.0;
per_frame_init_5=time_delay=0.0;
per_frame_init_6=rand_laser=rand(130);
per_frame_init_7=temp1 = 0;
per_frame_init_8=temp2 = 0;
per_frame_1=// SKELETON (kept intact, punchy retrigger to match the bounce-impact feel)
per_frame_2=time_delay = if(time_delay >= .22 && bass > 2, 0, time_delay += 1/fps);
per_frame_3=rand_laser = if(time_delay == 0, rand(130), rand_laser);
per_frame_4=
per_frame_5=// Custom variable mapping to feed the Comp Shader
per_frame_6=q1 = rand_laser;                          // color palette seed
per_frame_7=q2 = time_delay;                          // beat clock (0 = beat)
per_frame_8=temp1 += (1.1 + bass_att*0.9)/fps;        // bounce master clock (drives abs(sin) bounce curve)
per_frame_9=temp2 += (0.18 + treb_att*0.2)/fps;       // slow peak-height wobble clock
per_frame_10=q3 = temp1;
per_frame_11=q4 = temp2;
per_frame_12=q6 = 0.5 + 0.5*sin(time*0.3 + rand_laser*0.04); // slow color drift phase
warp_1=`sampler sampler_rand00;
warp_2=`
warp_3=`shader_body {
warp_4=`    ret = (tex2d(sampler_rand00, uv).xyz);
warp_5=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float aspect = texsize.x * texsize.z;
comp_4=`    float2 p = uv;
comp_5=`
comp_6=`    float col_sel = fmod(q1 * 1.5, 4.0);
comp_7=`    float3 col1, col2;
comp_8=`    if (col_sel < 1.0) { col1 = float3(0.0, 1.0, 0.5); col2 = float3(1.0, 0.5, 0.0); }
comp_9=`    else if (col_sel < 2.0) { col1 = float3(1.0, 0.0, 0.3); col2 = float3(0.2, 0.8, 1.0); }
comp_10=`    else if (col_sel < 3.0) { col1 = float3(0.7, 0.2, 1.0); col2 = float3(1.0, 1.0, 0.2); }
comp_11=`    else { col1 = float3(1.0, 1.0, 1.0); col2 = float3(0.0, 0.6, 1.0); }
comp_12=`
comp_13=`    float beat_strike = exp(-q2 * 5.0);
comp_14=`
comp_15=`    // 1. BEAT BOUNCE GRID
comp_16=`    // A row of vertical laser segments behave like bouncing balls: each has
comp_17=`    // its own phase offset so they're not synchronized, and the bounce curve
comp_18=`    // uses abs(sin(t)) which naturally produces a sharp "impact" at the bottom
comp_19=`    // and a slow float at the top -- a cheap but convincing gravity feel
comp_20=`    // without needing real per-frame physics state.
comp_21=`    float3 lasers = float3(0,0,0);
comp_22=`    int COLS = 8;
comp_23=`    for (int i = 0; i < COLS; i++) {
comp_24=`        float f = (float(i) + 0.5) / float(COLS);
comp_25=`        float x = f;
comp_26=`        float phase = float(i) * 0.9;
comp_27=`
comp_28=`        // abs(sin) bounce curve: 0 = floor impact, 1 = peak of bounce
comp_29=`        float bounce_t = q3 * (0.8 + 0.15*sin(phase)) + phase;
comp_30=`        float bounce = abs(sin(bounce_t));
comp_31=`        // ease so it lingers near the top and snaps at the bottom (squash-stretch feel)
comp_32=`        bounce = pow(bounce, 0.6);
comp_33=`
comp_34=`        float floor_y = 0.92;
comp_35=`        float peak_y = 0.15 + 0.05*sin(q4 + phase);
comp_36=`        float seg_y = lerp(floor_y, peak_y, bounce);
comp_37=`
comp_38=`        // segment stretches slightly when moving fast (near mid-bounce) and
comp_39=`        // squashes at the floor impact, like a simple squash/stretch cue
comp_40=`        float speed = abs(cos(bounce_t));
comp_41=`        float seg_len = 0.05 + speed * 0.05;
comp_42=`        float squash = 1.0 - smoothstep(0.0, 0.06, bounce) * 0.5;
comp_43=`
comp_44=`        float dx = abs(p.x - x);
comp_45=`        float dy_top = seg_y - seg_len*squash;
comp_46=`        float dy_bot = seg_y + seg_len*squash*0.3;
comp_47=`        float in_seg = step(dx, 0.006) * step(dy_top, p.y) * step(p.y, dy_bot);
comp_48=`
comp_49=`        float glow = exp(-dx*120.0) * smoothstep(dy_bot+0.05, dy_top-0.05, p.y) * 0.3;
comp_50=`
comp_51=`        // floor impact flash right when bounce is near 0
comp_52=`        float impact = smoothstep(0.08, 0.0, bounce) * exp(-abs(p.y-floor_y)*25.0) * 0.4;
comp_53=`
comp_54=`        float3 col = lerp(col1, col2, f);
comp_55=`        lasers += col * (in_seg + glow + impact);
comp_56=`    }
comp_57=`
comp_58=`    // 2. Floor glow line, brightens with average impact activity
comp_59=`    float floor_glow = exp(-abs(p.y-0.92)*18.0) * 0.15;
comp_60=`    lasers += lerp(col1,col2,0.5) * floor_glow;
comp_61=`
comp_62=`    // 3. Smoke from MilkDrop's blur buffer
comp_63=`    float3 smoke = GetBlur2(uv).rgb * 0.65;
comp_64=`    float3 bg = smoke * col1 * 0.12;
comp_65=`
comp_66=`    // 4. Beat impulse flash, additive
comp_67=`    float3 flash = lerp(col1,col2,0.5) * beat_strike * 0.3;
comp_68=`
comp_69=`    // 5. Smooth non-seizure breathing
comp_70=`    float breathe = 0.84 + 0.16*sin(time*0.5 + q6*M_PI);
comp_71=`
comp_72=`    float3 final_rgb = (lasers * breathe) + bg + flash;
comp_73=`    ret = final_rgb;
comp_74=`}
