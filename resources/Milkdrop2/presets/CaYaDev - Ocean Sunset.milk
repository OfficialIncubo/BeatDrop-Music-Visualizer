MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
per_frame_init_1=last = 0;
per_frame_init_2=swell = 0;
per_frame_init_3=ph = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.35)*((time - last) > 1.5);
per_frame_5=last = if(beat, time, last);
per_frame_6=swell = max(swell*pow(0.985, q30), beat);
per_frame_7=ph = ph + (0.6 + 0.4*min(bass_att, 2))/fps;
per_frame_8=q1 = ph;
per_frame_9=q2 = 0.6 + 0.6*min(bass_att, 2);
per_frame_10=q3 = min(treb_att, 2);
per_frame_11=q4 = 0.5*min(mid_att, 2);
per_frame_12=q5 = swell;
per_frame_13=q6 = time - last;
warp_1=`shader_body
warp_2=`{
warp_3=`  // glitter is computed here so it can keep a short trail (same per second at any frame rate)
warp_4=`  float hz = 0.52;
warp_5=`  float d = uv.y - hz;
warp_6=`  float glit = 0.0;
warp_7=`  if (d > 0.0) {
warp_8=`    float z = 0.08 / d;
warp_9=`    float2 w = float2((uv.x - 0.5) * z, z);
warp_10=`    // rotated off the texture axes so the noise grid does not show; glints are short horizontal dashes
warp_11=`    float2 wa = float2(w.x * 0.83 - w.y * 0.56, w.x * 0.56 + w.y * 0.83);
warp_12=`    float2 wb = float2(w.x * 0.92 + w.y * 0.39, -w.x * 0.39 + w.y * 0.92);
warp_13=`    float n = tex3D(sampler_noisevol_hq, float3(wa * float2(9.0, 26.0), q1 * 0.5)).x;
warp_14=`    float n2 = tex3D(sampler_noisevol_hq, float3(wb * float2(23.0, 61.0) + 0.3, q1 * 0.8)).x;
warp_15=`    float path = exp(-pow((uv.x - 0.5) / (0.04 + d * 0.5), 2.0));
warp_16=`    glit = step(0.68 - 0.04 * q3, n * 0.5 + n2 * 0.5) * path * saturate(d * 6.0);
warp_17=`  }
warp_18=`  float3 old = tex2D(sampler_main, uv).xyz;
warp_19=`  ret = max(old * pow(0.5, q30) - 0.002 * max(q30, 1.0), float3(glit, glit, glit));
warp_20=`}
comp_1=`float3 skyCol(float y)
comp_2=`{
comp_3=`  float3 top = float3(0.12, 0.08, 0.3);
comp_4=`  float3 midc = lerp(float3(0.85, 0.35, 0.35), float3(0.6, 0.3, 0.55), q4);
comp_5=`  float3 low = lerp(float3(1.0, 0.6, 0.25), float3(1.0, 0.45, 0.2), q4);
comp_6=`  float3 c = lerp(top, midc, smoothstep(0.0, 0.38, y));
comp_7=`  return lerp(c, low, smoothstep(0.32, 0.52, y));
comp_8=`}
comp_9=`shader_body
comp_10=`{
comp_11=`  float hz = 0.52;
comp_12=`  float2 sun = float2(0.5, 0.44);
comp_13=`  float2 sd = (uv - sun) * float2(1.0, 0.5625);
comp_14=`  float sr = length(sd);
comp_15=`  float3 col;
comp_16=`  if (uv.y < hz) {
comp_17=`    col = skyCol(uv.y);
comp_18=`    float band = tex3D(sampler_noisevol_hq, float3(uv.x * 1.5, uv.y * 12.0, q1 * 0.01)).x;
comp_19=`    col = lerp(col, col * float3(1.1, 0.8, 0.9), smoothstep(0.55, 0.75, band) * smoothstep(0.15, 0.45, uv.y) * 0.5);
comp_20=`    col += float3(1.0, 0.85, 0.55) * (1.0 - smoothstep(0.055, 0.058, sr)) * step(uv.y, hz);
comp_21=`    col += float3(1.0, 0.6, 0.3) * exp(-sr * 9.0) * 0.6;
comp_22=`  } else {
comp_23=`    float d = uv.y - hz;
comp_24=`    float z = 0.08 / d;
comp_25=`    float2 w = float2((uv.x - 0.5) * z, z);
comp_26=`    float h = 0.0;
comp_27=`    h += sin(w.y * 3.0 - q1 * 1.3 + w.x * 0.4) * 0.5;
comp_28=`    h += sin(w.y * 5.3 - q1 * 1.9 - w.x * 0.9) * 0.3;
comp_29=`    h += sin(w.y * 1.2 - q6 * 1.5) * 0.8 * q5;
comp_30=`    float n = tex3D(sampler_noisevol_hq, float3(w * float2(1.6, 0.8), q1 * 0.15)).x - 0.5;
comp_31=`    float slope = cos(w.y * 3.0 - q1 * 1.3) * 0.6 + n * 1.6;
comp_32=`    slope *= q2;
comp_33=`    float ry = hz - d * (0.6 + 0.4 * saturate(slope * 0.3 + 0.5));
comp_34=`    float3 refl = skyCol(clamp(ry, 0.0, hz));
comp_35=`    col = refl * (0.55 + 0.15 * slope) * float3(0.85, 0.85, 1.0);
comp_36=`    col = lerp(col, float3(0.05, 0.04, 0.12), saturate(d * 1.4));
comp_37=`    float path = exp(-pow((uv.x - 0.5) / (0.04 + d * 0.5), 2.0));
comp_38=`    col += float3(1.0, 0.65, 0.3) * path * 0.25 * (1.0 - saturate(d * 2.0));
comp_39=`    col += tex2D(sampler_main, uv).xyz * float3(1.0, 0.85, 0.6) * 1.4 + GetBlur1(uv) * float3(1.0, 0.7, 0.4) * 0.6;
comp_40=`  }
comp_41=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.5;
comp_42=`  ret = 1.0 - exp(-col * 1.4);
comp_43=`}
