per_frame_8=ob_r=ob_b-.3*sin(q3);
per_frame_9=ob_g=ob_g+.6*sin(q1);
per_frame_10=ob_b=ob_b+.4*sin(Q6);
per_frame_11=wave_r=wave_r-.3*sin(time*.54);
per_frame_12=wave_B=wave_b+.5*sin(time*.43);
per_frame_13=wave_g=wave_g*sin(time*.23);
