per_frame_15=wave_y=.5-.2*sin(time*q1);
per_pixel_1=d=.03*(sin(rad*3.14*sin(q3)))+1;
per_pixel_2=r=d-.03*(sin(ang*3.14*sin(q2)));
per_pixel_3=radx=below(0.3-rad+x,0.3+rad-x);
per_pixel_4=rady=below(0.3-rad+y,0.3+rad-y);
per_pixel_5=zoom=zoom+.09*sin(rad+3*3.14*sin(q3)*sin(q2-rad
per_pixel_6=*sin(Q1)))/2;
per_pixel_7=snare=below(0,x-rad-.3*sin(q4)-x-y*d*r)*sin(q1-d+r-q3);
per_pixel_8=//snare=below(0,x-rad-.3*sin(Q3));
per_pixel_9=dx=snare-.02*sin(Q2-radx-.02*sin(Q2))*sin(q6)*d*sin(Q2);
per_pixel_10=dy=snare+.02*sin(Q1-rady+.02*sin(Q5))*sin(q1)*r*Sin(Q3);
per_pixel_11=//dx=dx-snare+.02*sin(Q2);
per_pixel_12=//dy=dy-snare-.02*sin(Q1);
