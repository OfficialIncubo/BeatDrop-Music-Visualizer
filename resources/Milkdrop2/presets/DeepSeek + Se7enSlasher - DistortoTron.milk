MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=2
PSVERSION_COMP=3
[preset00]
fRating=1.000
fGammaAdj=1.980
fDecay=0.500
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.500
nVideoEchoOrientation=3
nWaveMode=0
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=1
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=1
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=0.118
fWaveSmoothing=0.900
fWaveParam=-0.480
fModWaveAlphaStart=0.400
fModWaveAlphaEnd=1.600
fWarpAnimSpeed=1.459
fWarpScale=2.007
fZoomExponent=1.00000
fShader=0.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.800
wave_g=0.490
wave_b=1.000
wave_x=0.500
wave_y=0.500
ob_size=0.035
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.260
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=64.000
nMotionVectorsY=48.000
mv_dx=0.000
mv_dy=0.000
mv_l=1.850
mv_r=0.500
mv_g=0.500
mv_b=0.500
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.000
per_frame_init_1=smooth_reaction = int(rand(2));
per_frame_init_2=mtime = 0;
per_frame_1=q1 = smooth_reaction;
per_frame_2=
per_frame_3=volume = (bass_att+mid_att+treb_att)*0.333;
per_frame_4=volume_exp = pow(10, volume);
per_frame_5=mtime += volume_exp*.001;
per_frame_6=q2 = mtime;
per_frame_7=
per_frame_8=oldbass += bass*2;
per_frame_9=oldbass = if (oldbass < bass, oldbass, oldbass/=1.05);
per_frame_10=q3 = oldbass*.0375;
warp_1=`shader_body
warp_2=`{
warp_3=`   
warp_4=`}
comp_1=`sampler sampler_rand00;
comp_2=`sampler sampler_rand01;
comp_3=`sampler sampler_rand02;
comp_4=`
comp_5=`shader_body
comp_6=`{
comp_7=`    if (q1)
comp_8=`    {
comp_9=`        bass = bass_att;
comp_10=`        mid = mid_att;
comp_11=`        treb = treb_att;
comp_12=`    }
comp_13=`    
comp_14=`    // Create swirling effect
comp_15=`    uv -= .5;
comp_16=`    float angle = atan2(uv.y, uv.x);
comp_17=`    float radius = length(uv) * 2.0;
comp_18=`    
comp_19=`    // Audio-reactive swirl intensity
comp_20=`    float swirl_intensity = sin(q2)*q3;
comp_21=`    float distortion_amount = treb * 2.5;
comp_22=`    
comp_23=`    // Swirl distortion
comp_24=`    angle += swirl_intensity * (1.0 / (radius + 0.1)) + sin(time + radius * 3.0) * 0.3;
comp_25=`    radius *= 1.0 + sin(time * 0.7 + angle) * distortion_amount * 0.2;
comp_26=`    
comp_27=`    // Convert back to texture coordinates
comp_28=`    float2 distorted_uv = 0.5 + radius * float2(cos(angle), sin(angle));
comp_29=`    
comp_30=`    // Sample random textures with different scales and timings
comp_31=`    float4 rand1 = tex2D(sampler_rand00, distorted_uv * (1.5 + bass * 0.8) + time * 0.1);
comp_32=`    float4 rand2 = tex2D(sampler_rand01, distorted_uv * (2.0 + mid * 1.2) + time * 0.15);
comp_33=`    float4 rand3 = tex2D(sampler_rand02, distorted_uv * (2.8 + treb * 1.5) + time * 0.2);
comp_34=`    
comp_35=`    // Combine textures with audio-reactive blending
comp_36=`    float bass_blend = 0.4 + bass * 0.3;
comp_37=`    float mid_blend = 0.3 + mid * 0.2;
comp_38=`    float treb_blend = 0.3 + treb * 0.1;
comp_39=`    
comp_40=`    // Multi-texture blending
comp_41=`    float4 color = rand1 * bass_blend + rand2 * mid_blend + rand3 * treb_blend;
comp_42=`    
comp_43=`    // Add audio-reactive pulsing
comp_44=`    float pulse = 1.0 + (bass + mid * 0.5) * 0.3 * sin(time * 4.0);
comp_45=`    color.rgb *= pulse;
comp_46=`    
comp_47=`    // Subtle color shifts based on audio
comp_48=`    color.r *= 1.0 + mid * 0.1;
comp_49=`    color.g *= 1.0 + treb * 0.1;
comp_50=`    color.b *= 1.0 + bass * 0.1;
comp_51=`    
comp_52=`    // Soft vignette to prevent seizure-inducing intensity at edges
comp_53=`    float vignette = 1.0 - smoothstep(0.3, 1.2, length(uv));
comp_54=`    color.rgb *= vignette;
comp_55=`    
comp_56=`    // Subtle edge enhancement (not too strong)
comp_57=`    float edge = length(uv) * 0.5;
comp_58=`    color.rgb += edge * 0.05 * (mid + treb);
comp_59=`    
comp_60=`    ret = color;
comp_61=`}
