MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5.000
fGammaAdj=1.950
fDecay=0.970
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=1
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=1.000
fWaveSmoothing=0.630
fWaveParam=-1.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.331
fZoomExponent=1.00000
fShader=0.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=1.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_init_1=q1=0.0;
per_frame_init_2=q2=40.0;
per_frame_init_3=q5=0.0;
per_frame_init_4=q6=0.0;
per_frame_init_5=time_delay=0.0;
per_frame_init_6=rand_laser=rand(90);
per_frame_init_7=temp1 = temp2 = 0;
per_frame_1=// SKELETON (kept intact, fast/snappy retrigger for percussive matrix feel)
per_frame_2=time_delay = if(time_delay >= .18 && bass > 1.9, 0, time_delay += 1/fps);
per_frame_3=rand_laser = if(time_delay == 0, rand(90), rand_laser);
per_frame_4=
per_frame_5=// Custom variable mapping to feed the Comp Shader
per_frame_6=q1 = rand_laser;                          // color palette + cell hash seed
per_frame_7=q2 = time_delay;                          // beat clock (0 = beat)
per_frame_8=temp1 += (0.9 + bass_att*1.2)/fps;       // matrix scan clock, drives per-cell flicker phase
per_frame_9=temp2 += (0.6 + mid_att*0.6)/fps;        // slow breathing phase
per_frame_10=q3 = temp1;
per_frame_11=q4 = temp2;
warp_1=`shader_body {}
comp_1=`shader_body
comp_2=`{
comp_3=`    float2 p = uv;
comp_4=`    float3 col_a = float3(1.0, 0.05, 0.4);
comp_5=`    float3 col_b = float3(0.0, 0.9, 1.0);
comp_6=`    float col_mix = fmod(floor(q1), 3.0);
comp_7=`    if (col_mix == 1.0) { col_a = float3(0.6, 1.0, 0.0); col_b = float3(1.0, 0.3, 0.0); }
comp_8=`    if (col_mix == 2.0) { col_a = float3(1.0, 1.0, 1.0); col_b = float3(0.3, 0.0, 1.0); }
comp_9=`
comp_10=`    float beat_strike = exp(-q2 * 6.0);
comp_11=`
comp_12=`    // 1. STROBE MATRIX GRID
comp_13=`    // A grid of cells, each acting as a tiny laser segment. Each cell gets its own
comp_14=`    // pseudo-random on/off clock derived from a hash of its grid coords + the beat seed,
comp_15=`    // so different cells snap on/off independently instead of all moving together.
comp_16=`    float cols = 10.0;
comp_17=`    float rows = 6.0;
comp_18=`    float2 cell = floor(p * float2(cols, rows));
comp_19=`    float2 cell_uv = frac(p * float2(cols, rows));
comp_20=`
comp_21=`    float hash = frac(sin(cell.x * 12.9898 + cell.y * 78.233 + q1 * 4.0) * 43758.5453);
comp_22=`    // Each cell flashes on a staggered subdivision of the main beat clock
comp_23=`    float cell_phase = frac(q3 * (0.5 + hash * 1.5) + hash * 3.0);
comp_24=`    float on = step(0.82, cell_phase) ; // short on-window, mostly off, snappy strobe feel
comp_25=`
comp_26=`    // Segment drawn inside the cell: a short diagonal or vertical bar depending on hash
comp_27=`    float bar;
comp_28=`    if (hash < 0.5) {
comp_29=`        bar = smoothstep(0.05, 0.0, abs(cell_uv.x - 0.5));
comp_30=`    } else {
comp_31=`        bar = smoothstep(0.05, 0.0, abs(cell_uv.y - 0.5));
comp_32=`    }
comp_33=`    float glow_bar = exp(-abs(cell_uv.x-0.5)*14.0)*0.3 + exp(-abs(cell_uv.y-0.5)*14.0)*0.3;
comp_34=`
comp_35=`    float3 cell_col = lerp(col_a, col_b, hash);
comp_36=`    float3 lasers = cell_col * (bar + glow_bar) * on * (0.7 + 0.3*beat_strike);
comp_37=`
comp_38=`    // 2. Sparse ambient smoke wash, very light so the grid stays crisp/snappy
comp_39=`    float3 smoke = GetBlur2(uv).rgb * 0.4;
comp_40=`    float3 bg = smoke * col_b * 0.10;
comp_41=`
comp_42=`    // 3. Hard global strobe flash exactly on the beat (kept brief + additive, not full screen white)
comp_43=`    float3 flash = col_a * beat_strike * 0.35;
comp_44=`
comp_45=`    // 4. Gentle non-seizure brightness breathing so the matrix never feels static between beats
comp_46=`    float breathe = 0.85 + 0.15*sin(time*1.2 + q4);
comp_47=`
comp_48=`    float3 final_rgb = (lasers + bg) * breathe + flash;
comp_49=`    ret = final_rgb;
comp_50=`}
