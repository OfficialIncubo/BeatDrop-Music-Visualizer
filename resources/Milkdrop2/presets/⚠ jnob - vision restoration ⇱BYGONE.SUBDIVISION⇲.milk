per_pixel_2=
per_pixel_3=t9=t9+1;
per_pixel_4=
per_pixel_5=sx=(2*below(y,.75+sin(q8-q6+rad*3.1415)*.20)*above(y,.25+cos(q7-q5+rad*3.1415)*.20)-1);
per_pixel_6=sy=(2*below(x,.75+cos(q5-q7+rad*3.1415)*.20)*above(x,.25+sin(q8-q6+rad*3.1415)*.20)-1);
per_pixel_7=
per_pixel_8=rot=3.14+sin((q6-q5+q8)*.5)*(sx-sy)*.1;
per_pixel_9=zoom=1+(sx*.4+sy*.6)*.01;
comp_1=`shader_body
comp_2=`{
comp_3=`    float2 uv_echo = (uv - 0.5)*0.993*float2(-1,1) + 0.5;
comp_4=`    ret = tex2D(sampler_main, uv).xyz; 
comp_5=`    ret *= 2.00; //gamma
comp_6=`    ret =  sqrt(ret); //brighten
comp_7=`    ret =   1-ret*(1-ret)*4;
comp_8=`//MilkDrop3 Brightness Mode:
comp_9=`ret *= 1.5;
comp_10=`//MilkDrop3 RGB Mode:
comp_11=`ret += float3(-1.2,-0.8,0.0);
comp_12=`//MilkDrop3 Invert Mode:
comp_13=`ret = 1 - ret;
comp_14=`}
