per_frame_1=// Hitung animasi sekali per-frame
per_frame_2=q1 = 0.413*( 0.60*sin(0.339*time) + 1.0*sin(0.276*time) );  // zoom
per_frame_3=q2 = 0.440*( 0.60*sin(0.381*time) + 1.80*sin(0.579*time) );  // rot
per_frame_4=q3 = 0.510*( 0.60*sin(0.374*time) + 0.20*sin(0.294*time) );  // cx
per_frame_5=q4 = 0.510*( 0.60*sin(0.393*time) + 0.40*sin(0.223*time) );  // cy
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`
warp_6=`    // motion blur:
warp_7=`    // 'v' points exactly one pixel, in the direction of motion
warp_8=`    float2 v = normalize(uv-uv_orig)*texsize.zw;
warp_9=`    float3 s;
warp_10=`    ret = max(ret, tex2D(sampler_main, uv+v)*0.97);
warp_11=`    ret = max(ret, tex2D(sampler_main, uv-v)*0.97);
warp_12=`    ret = max(ret, tex2D(sampler_main, uv+v*2)*0.90);
warp_13=`    ret = max(ret, tex2D(sampler_main, uv-v*2)*0.90);
warp_14=`
warp_15=`    // darken over time
warp_16=`    ret *= 0.95;
warp_17=`
warp_18=`    // add noise
warp_19=`    //float2 uv_noise = uv*texsize_noise_lq.zw*texsize.xy + rand_frame.xy;
warp_20=`    //ret += (tex2D(sampler_noise_lq, uv_noise)*2-1)*0.02;
warp_21=`}
comp_1=`sampler sampler_Pattern_024;
comp_2=`
comp_3=`shader_body
comp_4=`{
comp_5=`    // Hitung nilai offset berdasarkan time
comp_6=`    float zoom_offset = q1;
comp_7=`    float rot_offset = q2;
comp_8=`    float cx_offset = q3;
comp_9=`    float cy_offset = q4;
comp_10=`    
comp_11=`    // Buat koordinat UV yang terdistorsi
comp_12=`    float2 uv_centered = uv - 0.5;
comp_13=`    float2 uv_offset = uv_centered - float2(cx_offset, cy_offset);
comp_14=`    
comp_15=`    // Aplikasikan rotasi
comp_16=`    float cos_rot = cos(rot_offset);
comp_17=`    float sin_rot = sin(rot_offset);
comp_18=`    float2 uv_rotated = float2(
comp_19=`        uv_offset.x * cos_rot - uv_offset.y * sin_rot,
comp_20=`        uv_offset.x * sin_rot + uv_offset.y * cos_rot
comp_21=`    );
comp_22=`    
comp_23=`    // Aplikasikan zoom
comp_24=`    float zoom_factor = 1.0 + zoom_offset;
comp_25=`    float2 uv_mod = uv_rotated / zoom_factor + 0.5;
comp_26=`
comp_27=`    // BACKGROUND
comp_28=`    float3 bg = tex2D(sampler_Pattern_024, uv_mod*2).xyz;
comp_29=`    
comp_30=`    float3 main = tex2D(sampler_main, uv).xyz;
comp_31=`    float3 blur = GetBlur1(uv);
comp_32=`    
comp_33=`    // EDGE DETECTION
comp_34=`    float edgeStr = 4 + bass_att * 3;
comp_35=`    float3 edge = abs(main - blur) * edgeStr;
comp_36=`    
comp_37=`    // WARNA REAKSI TREBLE
comp_38=`    float3 tint = float3(1, 0.5 + 0.5*treb_att, 1 - treb_att*0.5);
comp_39=`    edge *= tint;
comp_40=`    
comp_41=`    // GABUNG DENGAN BACKGROUND
comp_42=`    ret = lerp(bg, edge, 0.9);
comp_43=`    ret *= 3.2;
comp_44=`}
