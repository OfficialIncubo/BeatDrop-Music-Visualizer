per_frame_1=q1 = 0.35; // Membesarkan untuk lingkaran (zoom)
per_frame_2=q2 = 0.20; // Kehalusan untuk tepi lingkaran
per_frame_3=
per_frame_4=wave_a = 0;
per_frame_5=
per_frame_6=// Warna lingkaran
per_frame_7=q3 = 0.7 + 0.3 * sin(time * 2.5);
per_frame_8=q4 = 0.7 + 0.3 * sin(time * 0.5 + 4.0);
per_frame_9=q5 = 0.7 + 0.3 * sin(time * 0.5 + 6.0);
per_frame_10=
per_frame_11=// Warna latar belakang lingkaran
per_frame_12=q6 = 0.7 + 0.3 * cos(time * 4.5);
per_frame_13=q7 = 0.7 + 0.3 * cos(time * 0.5 + 6.0);
per_frame_14=q8 = 0.7 + 0.3 * cos(time * 0.5 + 8.0);
per_frame_15=
per_frame_16=// ==== Gerakan pada bintang ====
per_frame_17=t_diag = time * 0.8;
per_frame_18=
per_frame_19=q10 = 0.5 + 0.35 * sin(t_diag); // Bintang 1
per_frame_20=q11 = 0.5 + 0.35 * sin(t_diag);
per_frame_21=
per_frame_22=q12 = 0.5 + 0.35 * sin(t_diag + 3.14); // Bintang 2
per_frame_23=q13 = 0.5 + 0.35 * cos(t_diag);
per_frame_24=
per_frame_25=q14 = pow(bass_att, 3.0) * 1.0; // Bass
per_frame_26=
per_frame_27=q15 = -5.7; // Rotasi
per_frame_28=q16 = 2.5;
per_frame_29=
per_frame_30=// ==== Gerakan asap (smoke) ====
per_frame_31=warp = 1.20;
per_frame_32=q17 = 1.3; // zoom
per_frame_33=
per_frame_34=// -- Written code by Jian Simanjuntak
per_frame_35=// -- Thank you for helping and keep up the good work
per_frame_36=//		
per_frame_37=// -- Don't forget follow in social media:
per_frame_38=// Instagram : @jian_simanjuntak_milkdrop
per_frame_39=// Facebook : Jian Simanjuntak MilkDrop
per_frame_40=// Twitter : Jian Simanjuntak MilkDrop
per_pixel_1=zoom = zoom + rad * q17;
warp_1=`shader_body
warp_2=`{
warp_3=`
warp_4=`uv = lerp(uv_orig,uv,0.03);
warp_5=`
warp_6=`float2 d = texsize.zw * 4;
warp_7=`float3 dx = ( GetBlur1(uv + float2(1,0)*d) - GetBlur1(uv-float2(1,0)*d) );
warp_8=`float3 dy = ( GetBlur1(uv + float2(0,1)*d) - GetBlur1(uv-float2(0,1)*d) );
warp_9=`
warp_10=`uv += float2(lum(dx),lum(dy))*texsize.zw*4;
warp_11=`ret = tex2d(sampler_fc_main, uv) - 0.008;
warp_12=`
warp_13=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float3 fg_mod = tex2D(sampler_main, uv).xyz;
comp_4=`    fg_mod *= 0.50; // gamma
comp_5=`
comp_6=`    float3 chosen_color = float3(1.0, 1.0, 1.0);
comp_7=`
comp_8=`    float brightness = dot(fg_mod, float3(0.299, 0.587, 0.114));
comp_9=`    float3 fg_ret = lerp(fg_mod, chosen_color * brightness, brightness);
comp_10=`
comp_11=`    // =========== Lingkaran ===========
comp_12=`    float2 uv_centered = (uv - 0.5) * aspect.xy;
comp_13=`    float dist = length(uv_centered);
comp_14=`    float radius = q1;
comp_15=`    float smoothness = q2;
comp_16=`    float circle = 1.0 - smoothstep(radius - smoothness, radius + smoothness, dist);
comp_17=`
comp_18=`    float3 circle_color = float3(q3, q4, q5);
comp_19=`    float3 bg_color = float3(q6, q7, q8);
comp_20=`
comp_21=`    float3 ret1 = lerp(bg_color, circle_color, circle);
comp_22=`
comp_23=`    // =========== Bintang 1 ===========
comp_24=`    float2 uv_star1 = (uv - float2(q10, q11)) * aspect.xy;
comp_25=`    float rot1 = time * q15;
comp_26=`    float c1 = cos(rot1);
comp_27=`    float s1 = sin(rot1);
comp_28=`    uv_star1 = mul(uv_star1, float2x2(c1, -s1, s1, c1));
comp_29=`
comp_30=`    float dist_star1 = length(uv_star1);
comp_31=`    float ang_star1 = atan2(uv_star1.y, uv_star1.x);
comp_32=`    float star_shape1 = pow(abs(cos(3.0 * ang_star1)), 12.0) * smoothstep(0.20, 0.0, dist_star1);
comp_33=`    float star_mask1 = saturate(star_shape1 * q14);
comp_34=`
comp_35=`    // =========== Bintang 2 ===========
comp_36=`    float2 uv_star2 = (uv - float2(q12, q13)) * aspect.xy;
comp_37=`    float rot2 = time * q16;
comp_38=`    float c2 = cos(rot2);
comp_39=`    float s2 = sin(rot2);
comp_40=`    uv_star2 = mul(uv_star2, float2x2(c2, -s2, s2, c2));
comp_41=`
comp_42=`    float dist_star2 = length(uv_star2);
comp_43=`    float ang_star2 = atan2(uv_star2.y, uv_star2.x);
comp_44=`    float star_shape2 = pow(abs(cos(3.0 * ang_star2)), 12.0) * smoothstep(0.25, 0.0, dist_star2);
comp_45=`    float star_mask2 = saturate(star_shape2 * q14);
comp_46=`
comp_47=`    // =========== Penggabungan Kedua Bintang ke Layar ===========
comp_48=`    float total_star_mask = saturate(star_mask1 + star_mask2);
comp_49=`    float3 star_color = float3(1.0, 1.0, 1.0);
comp_50=`    float3 ret2 = lerp(ret1, star_color, total_star_mask);
comp_51=`
comp_52=`    ret = lerp(ret2, fg_ret, brightness);
comp_53=`}
