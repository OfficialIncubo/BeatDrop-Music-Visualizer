MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
FFTAttack=0.500
FFTDecay=0.500
fRating=3.000
fGammaAdj=2.000
fDecay=0.980
fVideoEchoZoom=2.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.800
fWaveScale=1.645
fWaveSmoothing=0.750
fWaveParam=-0.520
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=1.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.500
wave_y=0.500
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=12.000
nMotionVectorsY=9.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_1=warp = 0;
per_frame_2=wave_r = wave_r + bass*.7;
per_frame_3=wave_g = wave_g + treb*.7;
per_frame_4=wave_b = wave_b + mid*.7;
per_frame_5=rot = .01*sin(time*.05)
per_pixel_1=ray = 3.1415926 * pow(rad,2);
per_pixel_2=zoom = (ray/rad)*3;
warp_1=`shader_body
warp_2=`{
warp_3=`    float dd = 2+sin(time*.7464526);
warp_4=`    float du = 2+sin(time*.9875432);
warp_5=`    // sample previous frame
warp_6=`    ret = max(ret, tex2D( sampler_main, uv + float2(0,dd)*texsize.zw ).xyz);
warp_7=`    ret = max(ret, tex2D( sampler_main, uv - float2(0,du)*texsize.zw ).xyz);
warp_8=`    ret = max(ret, tex2D( sampler_main, uv + float2(dd,0)*texsize.zw ).xyz);
warp_9=`    ret = max(ret, tex2D( sampler_main, uv - float2(du,0)*texsize.zw ).xyz);
warp_10=`    
warp_11=`    ret *= .7;
warp_12=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float2 uv2 = float2(1-uv.x,uv.y);    
comp_4=`
comp_5=`    ret = tex2D(sampler_main, uv).xyz;
comp_6=`    float3 ret2 = tex2D(sampler_main, uv2).xyz;
comp_7=`    ret *= 2.00; //gamma
comp_8=`    ret2 *= 2.00; //gamma
comp_9=`
comp_10=`    ret += (GetBlur1(uv)*1.2)/(rad*rad)/10;
comp_11=`    ret += (GetBlur2(uv)*1.2)/(rad*rad)/10;
comp_12=`    ret2 += (GetBlur1(uv2)*1.2)/(rad*rad)/10;
comp_13=`    ret2 += (GetBlur2(uv2)*1.2)/(rad*rad)/10;
comp_14=`
comp_15=`    ret = max(ret,ret2);
comp_16=`    ret -= abs(rad*2);
comp_17=`
comp_18=`    
comp_19=`}
