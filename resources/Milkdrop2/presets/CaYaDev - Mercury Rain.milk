MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
shapecode_0_enabled=1
shapecode_0_sides=40
shapecode_0_additive=1
shapecode_0_thickOutline=0
shapecode_0_textured=0
shapecode_0_num_inst=6
shapecode_0_x=0.5
shapecode_0_y=0.5
shapecode_0_rad=0.1
shapecode_0_ang=0
shapecode_0_tex_ang=0
shapecode_0_tex_zoom=1
shapecode_0_r=1
shapecode_0_g=0
shapecode_0_b=0
shapecode_0_a=1
shapecode_0_r2=0
shapecode_0_g2=0
shapecode_0_b2=0
shapecode_0_a2=0
shapecode_0_border_r=1
shapecode_0_border_g=1
shapecode_0_border_b=1
shapecode_0_border_a=0
shape_0_per_frame1=ph = q1*(0.6 + instance*0.13) + instance*2.3;
shape_0_per_frame2=x = 0.5 + 0.3*sin(ph*1.1 + instance)*q31;
shape_0_per_frame3=y = 1 - (instance*0.167 + q1*0.08*(1 + instance%3)) + floor(instance*0.167 + q1*0.08*(1 + instance%3));
shape_0_per_frame4=y = 0.12 + 0.76*y;
shape_0_per_frame5=rad = q2*(0.8 + 0.4*sin(ph*2 + instance));
shape_0_per_frame6=a = 0.9*min(1, q30);
per_frame_init_1=wander = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=wander = wander + (0.25 + 0.35*mid_att)/fps;
per_frame_5=q1 = wander;
per_frame_6=q2 = 0.2 + 0.07*bass_att;
per_frame_7=q3 = treb_att;
per_frame_8=q4 = cos(time*0.13);
per_frame_9=q5 = sin(time*0.11);
warp_1=`shader_body
warp_2=`{
warp_3=`  float f = tex2D(sampler_main, uv).x;
warp_4=`  ret = float3(lerp(f, GetBlur1(uv).x, 0.5) * pow(0.86, q30), 0, 0);
warp_5=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float2 d = texsize.zw * 3.0;
comp_4=`  float f = GetBlur1(uv).x;
comp_5=`  float2 d2 = d * 3.0;
comp_6=`  float fx = GetBlur1(uv + float2(d.x, 0)).x - GetBlur1(uv - float2(d.x, 0)).x + (GetBlur2(uv + float2(d2.x, 0)).x - GetBlur2(uv - float2(d2.x, 0)).x) * 0.6;
comp_7=`  float fy = GetBlur1(uv + float2(0, d.y)).x - GetBlur1(uv - float2(0, d.y)).x + (GetBlur2(uv + float2(0, d2.y)).x - GetBlur2(uv - float2(0, d2.y)).x) * 0.6;
comp_8=`  float body = smoothstep(0.3, 0.36, f);
comp_9=`  float3 n = normalize(float3(-fx * 6.0, -fy * 6.0, 0.25 + saturate(f - 0.35)));
comp_10=`  float3 L = normalize(float3(q4, q5, 0.8));
comp_11=`  float3 R = reflect(float3(0, 0, -1), n);
comp_12=`  float hor = R.y * 0.9 + R.x * 0.15 + 0.32;
comp_13=`  float3 sky = lerp(float3(0.03, 0.035, 0.045), float3(0.55, 0.6, 0.7), smoothstep(-0.05, 0.6, hor));
comp_14=`  sky += float3(0.5, 0.52, 0.55) * smoothstep(0.55, 0.75, hor) * smoothstep(0.98, 0.8, hor);
comp_15=`  sky += float3(0.12, 0.13, 0.15) * smoothstep(-0.2, -0.6, hor);
comp_16=`  sky += float3(0.9, 0.95, 1.0) * pow(saturate(1.0 - abs(R.x - 0.45) * 5.0), 3.0) * smoothstep(0.1, 0.5, R.y) * 0.8;
comp_17=`  sky += float3(1.0, 0.9, 0.75) * pow(saturate(dot(R, L)), 30.0) * (1.2 + q3 * 0.5);
comp_18=`  float rim = pow(1.0 - saturate(n.z), 3.0);
comp_19=`  float3 metal = sky * float3(0.92, 0.94, 0.98) + rim * float3(0.4, 0.5, 0.7);
comp_20=`  float2 v = uv - 0.5;
comp_21=`  float3 bg = lerp(float3(0.13, 0.14, 0.17), float3(0.02, 0.02, 0.03), saturate(length(v) * 1.5));
comp_22=`  bg += float3(0.05, 0.06, 0.08) * exp(-abs(uv.y - 0.78) * 10.0);
comp_23=`  float shadow = smoothstep(0.1, 0.35, GetBlur2(uv + float2(0.01, -0.015)).x) * 0.6;
comp_24=`  bg *= 1.0 - shadow;
comp_25=`  ret = lerp(bg, metal, body);
comp_26=`}
