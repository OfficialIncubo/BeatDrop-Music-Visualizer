per_frame_1=wave_r = wave_r + 0.350*( 0.60*sin(0.742*time) + 0.40*sin(1.021*time) );
per_frame_2=wave_g = wave_g + 0.350*( 0.60*sin(0.703*time) + 0.40*sin(0.969*time) );
per_frame_3=wave_b = cx - rot + 0.350*( 0.60*sin(1.090*time) + 0.40*sin(0.963*time) );
per_frame_4=rot = rot + 0.999*( 0.60*sin(bass*time) + 0.40*cos(0.19-6*bass-mid*time) );
per_frame_5=cx = cx + 0.110*( 0.60*sin(0.374*time) + cx*sin(cx*time) );
per_frame_6=cy = cy + 1.5 - cos(61.2);
per_pixel_1=dr = 0.01 - time * cy + max(ang,time)*min(max(bass_att-1,0.0), 0.5)*sin(rad*15);
per_pixel_2=dx = dx + dr*cos(ang)*0.75;