###################################################################################################

MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5.000
fGammaAdj=1.900
fDecay=0.970
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=1
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=1.000
fWaveSmoothing=0.630
fWaveParam=-1.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.331
fZoomExponent=1.00000
fShader=0.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=1.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_init_1=q1=0.0;
per_frame_init_2=q2=40.0;
per_frame_init_3=q5=0.0;
per_frame_init_4=q6=0.0;
per_frame_init_5=time_delay=0.0;
per_frame_init_6=rand_laser=rand(170);
per_frame_init_7=temp1 = 0;
per_frame_init_8=temp2 = 0;
per_frame_1=// SKELETON (kept intact, medium retrigger for kaleidoscope facet changes)
per_frame_2=time_delay = if(time_delay >= .35 && bass > 2, 0, time_delay += 1/fps);
per_frame_3=rand_laser = if(time_delay == 0, rand(170), rand_laser);
per_frame_4=
per_frame_5=// Custom variable mapping to feed the Comp Shader
per_frame_6=q1 = rand_laser;                          // color palette seed
per_frame_7=q2 = time_delay;                          // beat clock (0 = beat)
per_frame_8=temp1 += (0.10 + mid_att*0.18)/fps;       // wedge rotation clock (slow, continuous)
per_frame_9=temp2 += (0.30 + treb_att*0.35)/fps;      // in-wedge beam wobble clock
per_frame_10=q3 = temp1;
per_frame_11=q4 = temp2;
per_frame_12=q6 = 0.5 + 0.5*sin(time*0.28 + rand_laser*0.04); // slow color drift phase
warp_1=`shader_body {}
comp_1=`float3 GetLaser(float2 uva, float2 origin, float angle, float3 color_vec, float focus) {
comp_2=`    float2 p = uva - origin;
comp_3=`    float2 dir = float2(cos(angle), sin(angle));
comp_4=`    float2 n = float2(-dir.y, dir.x);
comp_5=`    float line_dist = abs(dot(p, n));
comp_6=`    float along = dot(p, dir);
comp_7=`    float core = exp(-line_dist * (4200.0 * focus));
comp_8=`    float glow = 0.0016 / (line_dist + 0.0006);
comp_9=`    float intensity = (core + glow) * smoothstep(-0.02, 0.1, along);
comp_10=`    return color_vec * intensity;
comp_11=`}
comp_12=`
comp_13=`shader_body
comp_14=`{
comp_15=`    float aspect = texsize.x * texsize.z;
comp_16=`    float2 center = float2(0.5, 0.5);
comp_17=`    float2 raw = uv - center;
comp_18=`    raw.x *= aspect;
comp_19=`
comp_20=`    float col_sel = fmod(q1 * 1.8, 4.0);
comp_21=`    float3 col1, col2;
comp_22=`    if (col_sel < 1.0) { col1 = float3(1.0, 0.0, 0.4); col2 = float3(0.0, 0.9, 1.0); }
comp_23=`    else if (col_sel < 2.0) { col1 = float3(1.0, 0.6, 0.0); col2 = float3(0.4, 0.0, 1.0); }
comp_24=`    else if (col_sel < 3.0) { col1 = float3(0.2, 1.0, 0.3); col2 = float3(1.0, 0.0, 0.8); }
comp_25=`    else { col1 = float3(1.0, 1.0, 0.4); col2 = float3(0.2, 0.5, 1.0); }
comp_26=`
comp_27=`    float beat_strike = exp(-q2 * 5.0);
comp_28=`    float beam_focus = 1.0 + beat_strike * 2.3;
comp_29=`
comp_30=`    // 1. KALEIDOSCOPE MIRROR
comp_31=`    // Fold the angular coordinate into a narrow wedge (mirror symmetry), draw
comp_32=`    // a small set of moving beams inside that single wedge, then the fold
comp_33=`    // itself reproduces the pattern around the full circle -- the classic
comp_34=`    // kaleidoscope-laser look, instead of placing beams individually per slice.
comp_35=`    float SLICES = 8.0;
comp_36=`    float wedge = M_PI / SLICES; // angular half-width of one mirrored wedge (M_PI = pi here)
comp_37=`    float a = atan2(raw.y, raw.x);
comp_38=`    float r = length(raw);
comp_39=`
comp_40=`    // fold angle into [0, wedge] with mirroring
comp_41=`    float folded = fmod(abs(a) + q3, wedge*2.0);
comp_42=`    folded = abs(folded - wedge);
comp_43=`
comp_44=`    float3 lasers = float3(0,0,0);
comp_45=`    int N = 4;
comp_46=`    for (int i = 0; i < N; i++) {
comp_47=`        float f = float(i) / float(N-1);
comp_48=`        float beam_ang = f * wedge * 0.9 + sin(q4 + f*3.0) * wedge * 0.25;
comp_49=`        float d = abs(folded - beam_ang) * max(r, 0.05);
comp_50=`        float hw = 0.012 * beam_focus;
comp_51=`        float core = exp(-pow(d/hw, 2.0));
comp_52=`        float glow = exp(-pow(d/(hw*5.0), 2.0)) * 0.4;
comp_53=`        float3 col = lerp(col1, col2, f);
comp_54=`        lasers += col * (core + glow);
comp_55=`    }
comp_56=`
comp_57=`    // 2. Faceted ring accents at a couple of radii for the cut-glass kaleidoscope feel
comp_58=`    float ring1 = smoothstep(0.010, 0.0, abs(r - (0.22 + 0.03*sin(q4*0.6))));
comp_59=`    float ring2 = smoothstep(0.008, 0.0, abs(r - (0.40 + 0.03*sin(q4*0.4+2.0))));
comp_60=`    lasers += lerp(col1,col2,0.5) * (ring1*0.4 + ring2*0.3);
comp_61=`
comp_62=`    // 3. Smoke from MilkDrop's blur buffer
comp_63=`    float3 smoke = GetBlur2(uv).rgb * 0.6;
comp_64=`    float3 bg = smoke * col1 * 0.14;
comp_65=`
comp_66=`    // 4. Center core flare, brightens on beat
comp_67=`    float core_flare = exp(-r * 8.0) * (0.4 + beat_strike * 1.5);
comp_68=`    lasers += lerp(col1,col2,0.5) * core_flare;
comp_69=`
comp_70=`    // 5. Smooth non-seizure breathing
comp_71=`    float breathe = 0.8 + 0.2*sin(time*0.45 + q6*M_PI);
comp_72=`
comp_73=`    float3 final_rgb = (lasers + bg) * breathe;
comp_74=`    ret = final_rgb;
comp_75=`}
