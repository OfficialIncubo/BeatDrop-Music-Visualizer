warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float3 pal(float x, float3 a, float3 b, float3 c, float3 d){ 
warp_7=`    return a + b * cos(M_PI_2 * (c * x + d)); 
warp_8=`}
warp_9=`
warp_10=`shader_body
warp_11=`{
warp_12=`    float3 col = 0;
warp_13=`    float t = time * 0.25;
warp_14=`
warp_15=`    // 1. Shift origin (0,0) to screen center
warp_16=`    float2 uvX = (uv - 0.5);
warp_17=`
warp_18=`    // 2. Flip Y for DirectX coordinate space (-0.5 to 0.5 centered)
warp_19=`    uvX.y = -uvX.y;
warp_20=`
warp_21=`    // Strings: plucked wires, each tuned to a band
warp_22=`    float n = 9.0;
warp_23=`    for (int k = 0; k < 9; k++) {
warp_24=`        float fk = float(k);
warp_25=`        
warp_26=`        // Baseline y-positions distributed symmetric around center Y = 0.0
warp_27=`        float y0 = (fk + 0.5) / n - 0.5;
warp_28=`        
warp_29=`        float amp = get_fft((fk + 0.5) / n) * 0.09;
warp_30=`        
warp_31=`        // Distance calculated from centered coordinates (uvX)
warp_32=`        float d = abs(uvX.y - (y0 + sin(uvX.x * (8.0 + fk * 3.0) + t * (3.0 + fk * 0.7)) * amp));
warp_33=`        
warp_34=`        col += pal(frac(fk / n * 0.7 + 0.15), float3(0.5, 0.5, 0.5), float3(0.45, 0.45, 0.45), float3(1, 1, 1), float3(0.0, 0.25, 0.5))
warp_35=`             * (smoothstep(0.012, 0.0, d) + smoothstep(0.06, 0.0, d) * 0.18) * (0.4 + amp * 9.0);
warp_36=`    }
warp_37=`
warp_38=`    ret = col;
warp_39=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
