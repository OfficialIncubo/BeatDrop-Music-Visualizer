bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=1.092
fWaveScale=0.721
fWaveSmoothing=0.900
fWaveParam=0.000
fModWaveAlphaStart=1.490
fModWaveAlphaEnd=0.750
fWarpAnimSpeed=1.000
fWarpScale=1.007
fZoomExponent=1.00000
fShader=0.000
zoom=1.11511
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=0.01000
sx=1.00000
sy=1.00000
wave_r=0.760
wave_g=0.480
wave_b=0.390
wave_x=0.500
wave_y=0.500
ob_size=0.005
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=1.000
ib_size=0.010
ib_r=1.000
ib_g=0.000
ib_b=0.000
ib_a=1.000
nMotionVectorsX=6.400
nMotionVectorsY=4.800
mv_dx=0.000
mv_dy=0.000
mv_l=3.000
mv_r=0.670
mv_g=0.480
mv_b=0.390
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_1=wave_b = int(rand(100))/100;
per_frame_2=wave_r = int(rand(100))/100;
per_frame_3=wave_g = int(rand(100))/100;
per_frame_4=wave_y = wave_y;
per_frame_5=bass_eff = max(max(bass,bass_att)-1,0);
per_frame_6=bass_thresh = above(bass_att,bass_thresh)*2 + (1-above(bass_att,bass_thresh))*((bass_thresh-1.3)*0.96+1.3);
per_frame_7=vol =bass+treb+mid;
per_frame_8=dx = 0.005 + 0.002*( 0.60*sin(0.234*time) + 0.40*sin(0.277*time) );
per_frame_9=dy = 0.005 + 0.002*( 0.60*sin(0.234*time) + 0.40*sin(0.277*time) );
per_frame_10=dx_r = equal(bass_thresh,2)*0.016*sin(time*3) + (1-equal(bass_eff,2))*dx_r;
per_frame_11=dy_r = equal(bass_thresh,2)*0.012*sin(time*7) + (1-equal(bass_eff,2))*dy_r;
per_frame_12=rot = rot + 0.070*( 0.60*sin(0.381*time) + 0.40*sin(0.479*time) );
per_frame_13=q1=sin(time*.7*.5)+(dx_r*dy_r)+(dx*dy);
per_frame_14=q2=sin(time*.7*.2)+(dx_r*dy_r);
per_frame_15=q3=0.1*(atan(abs(-rad+.5)))*q2;
per_frame_16=q4=dx_r;
per_frame_17=q5=dy_r;
per_frame_18=q6=bass_eff;
per_pixel_1=zoom=zoom+.05*q3+.05*q1+q6;
per_pixel_2=dx = .01*atan((rad)/.1*sin((q4*q5)*20+time*5));
per_pixel_3=zoom = zoom + q6 + rad*.2*(q2)-vol;
