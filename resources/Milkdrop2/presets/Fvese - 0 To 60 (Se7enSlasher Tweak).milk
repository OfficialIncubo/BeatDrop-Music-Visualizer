[preset00]
fRating=4.500
fGammaAdj=1.000
fDecay=0.970
fVideoEchoZoom=1.008
fVideoEchoAlpha=0.500
nVideoEchoOrientation=0
nWaveMode=2
bAdditiveWaves=1
bWaveDots=0
