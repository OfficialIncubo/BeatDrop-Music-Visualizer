MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
per_frame_init_1=flow = 0;
per_frame_init_2=last = 0;
per_frame_init_3=seed = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=flow = flow + (0.25 + 0.6*min(bass_att, 2))/fps;
per_frame_5=beat = (bass > 1.35)*((time - last) > 6);
per_frame_6=go = ((beat + ((time - last) > 14)) > 0);
per_frame_7=last = if(go, time, last);
per_frame_8=seed = if(go, seed + 1, seed);
per_frame_9=q1 = flow;
per_frame_10=q2 = seed;
per_frame_11=q3 = time - last;
per_frame_12=q4 = time*0.02 + mid_att*0.02;
per_frame_13=q5 = min(treb_att, 2);
warp_1=`sampler sampler_pw_noise_lq;
warp_2=`shader_body
warp_3=`{
warp_4=`  float2 p = (uv - 0.5) * aspect.xy * 11.0 + float2(q4 * 4.0, 0.0);
warp_5=`  float2 cell = floor(p);
warp_6=`  float2 f = frac(p) - 0.5;
warp_7=`  // the new pattern sweeps across the screen from left to right
warp_8=`  float sweep = step(uv.x, q3 * 0.12);
warp_9=`  float4 n = tex2D(sampler_pw_noise_lq, (cell + float2(q2 * 17.0, q2 * 29.0) * sweep + float2(q2 * 17.0 - 17.0, q2 * 29.0 - 29.0) * (1.0 - sweep)) / 256.0);
warp_10=`  float flip = step(0.5, n.x);
warp_11=`  float2 g = float2(f.x * (flip * 2.0 - 1.0), f.y);
warp_12=`  float2 c1 = g - float2(0.5, 0.5);
warp_13=`  float2 c2 = g + float2(0.5, 0.5);
warp_14=`  float d1 = abs(length(c1) - 0.5);
warp_15=`  float d2 = abs(length(c2) - 0.5);
warp_16=`  float d = min(d1, d2);
warp_17=`  float a1 = atan2(c1.y, c1.x);
warp_18=`  float a2 = atan2(c2.y, c2.x);
warp_19=`  float along = (d1 < d2 ? a1 : a2) * 0.6366 + (cell.x + cell.y) * 1.0;
warp_20=`  float px = 11.0 * 1.6 / texsize.x;
warp_21=`  float lw = 1.0 - smoothstep(px * 0.5, px * 1.5, d);
warp_22=`  float pulse = pow(0.5 + 0.5 * sin((along - q1 * 2.0) * 3.14159), 8.0);
warp_23=`  float3 dir = 0.5 + 0.5 * cos(6.28318 * (float3(0.0, 0.33, 0.67) + n.y * 0.35 + q4));
warp_24=`  float3 c = lw * dir * (0.12 + 1.1 * pulse);
warp_25=`  float3 old = tex2D(sampler_main, uv).xyz;
warp_26=`  ret = max(max(old * pow(0.86, q30) - 0.002 * max(q30, 1.0), 0.0), c);
warp_27=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float3 m = tex2D(sampler_main, uv).xyz;
comp_4=`  float3 col = float3(0.01, 0.012, 0.025) + m * 1.2 + GetBlur1(uv) * 0.7 + GetBlur2(uv) * 0.45;
comp_5=`  col += GetBlur3(uv) * float3(0.3, 0.35, 0.6) * (0.2 + 0.2 * q5);
comp_6=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.7;
comp_7=`  ret = 1.0 - exp(-col * 1.5);
comp_8=`}
