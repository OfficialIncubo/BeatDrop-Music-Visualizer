warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float3 pal(float x, float3 a, float3 b, float3 c, float3 d){ 
warp_7=`    return a + b * cos(M_PI_2 * (c * x + d)); 
warp_8=`}
warp_9=`
warp_10=`shader_body
warp_11=`{
warp_12=`    float3 col = 0;
warp_13=`    float t = time * 0.25;
warp_14=`
warp_15=`    // 1. Shift origin to screen center and apply aspect ratio correction
warp_16=`    float2 uvX = (uv - 0.5) * 2 * aspect.xy;
warp_17=`
warp_18=`    // 2. Y-flip for DirectX coordinate space (-0.5 to 0.5 centered)
warp_19=`    uvX.y = -uvX.y;
warp_20=`
warp_21=`    // Phyllo: sunflower spiral, seeds bloom with the spectrum
warp_22=`    for (int k = 0; k < 70; k++){
warp_23=`        float fk = float(k);
warp_24=`        float ang2 = fk * 2.39996 + t * 0.4;
warp_25=`        
warp_26=`        // Seed positions centered around (0,0)
warp_27=`        float2 q = float2(cos(ang2), sin(ang2)) * sqrt(fk / 70.0) * 0.85;
warp_28=`        
warp_29=`        float e = get_fft(fk / 70.0);
warp_30=`        
warp_31=`        // Compute distance from centered UV coordinate (uvX) to seed position (q)
warp_32=`        col += pal(frac(fk / 70.0 * 0.8 + t * 0.05), float3(0.5, 0.5, 0.5), float3(0.5, 0.5, 0.5), float3(1, 1, 1), float3(0.0, 0.15, 0.35))
warp_33=`             * smoothstep(0.035 + e * 0.03, 0.0, length(uvX - q)) * (0.25 + e * 1.6);
warp_34=`    }
warp_35=`
warp_36=`    ret = col;
warp_37=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
