warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float specLog(float x){ return get_fft(pow(clamp(x,0.0,1.0), 1.8)); }
warp_7=`float3 hsv(float h, float s, float v) {
warp_8=`    float3 rgb = clamp(abs(fmod(h*6+float3(0,4,2),6)-3)-1,0,1);
warp_9=`    return v * lerp(float3(1,1,1), rgb, s);
warp_10=`}
warp_11=`
warp_12=`shader_body
warp_13=`{
warp_14=`    float3 col = 0;
warp_15=`    //Obligatory Y flipping
warp_16=`    uv.y = 1-uv.y;
warp_17=`    float2 sc = uv;
warp_18=`
warp_19=`    float cols = 32, rows = 18;
warp_20=`    float2 g = float2(cols, rows);
warp_21=`    float2 cell = floor(sc*g);
warp_22=`    float2 f = frac(sc*g)-0.5;
warp_23=`    float v = specLog((cell.x+0.5)/g.x);
warp_24=`    float on = step(cell.y+0.5, v*g.y*1.1);
warp_25=`    float3 led = hsv(0.33 - 0.33*cell.y/g.y, 0.9, 1.0);
warp_26=`    col = led*smoothstep(0.42, 0.3, length(f))*(on + 0.07);
warp_27=`    ret = col;
warp_28=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
