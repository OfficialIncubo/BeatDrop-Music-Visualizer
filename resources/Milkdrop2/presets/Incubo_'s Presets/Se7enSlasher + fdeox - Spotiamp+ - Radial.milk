MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=5.000
fGammaAdj=1.460
fDecay=0.935
FFTAttack=1.000
FFTDecay=0.650
fVideoEchoZoom=1.007
fVideoEchoAlpha=0.500
nVideoEchoOrientation=2
nWaveMode=15
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=1
bDarken=1
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=0.625
fWaveSmoothing=0.900
fWaveParam=0.000
fModWaveAlphaStart=0.880
fModWaveAlphaEnd=1.980
fWarpAnimSpeed=0.010
fWarpScale=0.010
fZoomExponent=1.00000
fShader=1.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.500
wave_y=0.500
ob_size=0.500
ob_r=0.010
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.260
ib_r=0.235
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=64.000
nMotionVectorsY=48.000
mv_dx=0.000
mv_dy=0.000
mv_l=1.000
mv_r=1.060
mv_g=1.000
mv_b=0.819
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float specLog(float x){ return get_fft(pow(saturate(x), 1.8)); }
warp_7=`#if defined (HAS_FFT_PEAK)
warp_8=`float specLogCap(float x){ return get_fft_peak(pow(saturate(x), 1.8)); }
warp_9=`#endif
warp_10=`
warp_11=`// Cosine gradient palette
warp_12=`float3 pal(float x, float3 a, float3 b, float3 c, float3 d){ 
warp_13=`    return a + b * cos(M_PI_2 * (c * x + d)); 
warp_14=`}
warp_15=`
warp_16=`shader_body
warp_17=`{
warp_18=`    // 1. Properly center origin (0,0) and correct aspect ratio
warp_19=`    float2 uvX = (uv - 0.5) * aspect.xy;
warp_20=`    
warp_21=`    // 2. Scale coordinate space
warp_22=`    uvX *= 3.0;
warp_23=`    
warp_24=`    // 3. Proper Y-flip for centered UV coordinates (-1 to 1 space)
warp_25=`    uvX.y = -uvX.y;
warp_26=`
warp_27=`    float3 col = 0;
warp_28=`    
warp_29=`    // Calculate polar coordinates from centered UVs
warp_30=`    float a = atan2(uvX.y, uvX.x);
warp_31=`    float r = length(uvX);
warp_32=`    float t = time * 0.25;
warp_33=`
warp_34=`    float bars = 64.0;
warp_35=`    
warp_36=`    // Map angle (-PI to PI) smoothly across 0..1 range for radial repetition
warp_37=`    float ax = frac((a + M_PI) / (2.0 * M_PI));
warp_38=`    float bi = (floor(ax * bars) + 0.5) / bars;
warp_39=`    
warp_40=`    float h = pow(specLog(abs(bi * 2.0 - 1.0)), 0.6);
warp_41=`    #if defined (HAS_FFT_PEAK)
warp_42=`    float hCap = pow(specLogCap(abs(bi * 2.0 - 1.0)), 0.6);
warp_43=`    #endif
warp_44=`
warp_45=`    float inner = 0.22 + bass * 0.04;
warp_46=`    float edge = inner + h * 0.50;
warp_47=`    #if defined (HAS_FFT_PEAK)
warp_48=`    float edgeCap = inner + hCap * 0.50;
warp_49=`    #endif
warp_50=`
warp_51=`    float gap = smoothstep(0.10, 0.28, frac(ax * bars));
warp_52=`    float body = step(inner, r) * step(r, edge) * gap;
warp_53=`    
warp_54=`    #if defined (HAS_FFT_PEAK)
warp_55=`    float tip = smoothstep(0.018, 0.0, abs(r - edgeCap)) * gap;
warp_56=`    #else
warp_57=`    float tip = smoothstep(0.018, 0.0, abs(r - edge)) * gap;
warp_58=`    #endif
warp_59=`
warp_60=`    col = pal(frac(bi + t * 0.1), float3(0.5, 0.4, 0.5), float3(0.5, 0.45, 0.4), float3(1, 1, 1), float3(0.0, 0.2, 0.4));
warp_61=`    col *= body * 0.7 + tip * 2.0;
warp_62=`    col += float3(0.5, 0.7, 1.0) * smoothstep(inner, inner * 0.35, r) * (0.15 + bass * 0.8);
warp_63=`
warp_64=`    ret = col;
warp_65=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
