wave_y=0.500
ob_size=0.500
ob_r=0.010
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.260
ib_r=0.235
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=64.000
nMotionVectorsY=48.000
mv_dx=0.000
mv_dy=0.000
mv_l=1.000
mv_r=1.060
mv_g=1.000
mv_b=0.819
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float sdSeg(float2 p, float2 a, float2 b)
warp_7=`{
warp_8=`    float2 pa = p - a;
warp_9=`    float2 ba = b - a;
warp_10=`    float h = saturate(dot(pa, ba) / dot(ba, ba));
warp_11=`    return length(pa - ba * h);
warp_12=`}
warp_13=`
warp_14=`float3 hsv(float h, float s, float v)
warp_15=`{
warp_16=`    float4 k = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
warp_17=`    float3 p = abs(frac(h + k.xyz) * 6.0 - k.www);
warp_18=`    return v * lerp(k.xxx, saturate(p - k.xxx), s);
warp_19=`}
warp_20=`
warp_21=`shader_body
warp_22=`{
warp_23=`    uv.y = 1.0 - uv.y;
warp_24=`    float2 my_uv = (uv - 0.5) * aspect.xy * 2;
warp_25=`
warp_26=`    float ay = time * 0.6;
warp_27=`    float ax = time * 0.37;
warp_28=`    float s = 0.22 * (1.0 + bass_att * 0.1);
warp_29=`    float glow = 0.0;
warp_30=`
warp_31=`    for (int ai = 0; ai < 3; ai++)
warp_32=`    {
warp_33=`        for (int ei = 0; ei < 4; ei++)
warp_34=`        {
warp_35=`            float fe = float(ei);
warp_36=`            float2 sg = float2(fmod(fe, 2.0) * 2.0 - 1.0, floor(fe / 2.0) * 2.0 - 1.0);
warp_37=`            float3 p0 = float3(-1.0, sg);
warp_38=`            float3 p1 = float3(1.0, sg);
warp_39=`            if (ai == 1)
warp_40=`            {
warp_41=`                p0 = float3(sg.x, -1.0, sg.y);
warp_42=`                p1 = float3(sg.x, 1.0, sg.y);
warp_43=`            }
warp_44=`            if (ai == 2)
warp_45=`            {
warp_46=`                p0 = float3(sg, -1.0);
warp_47=`                p1 = float3(sg, 1.0);
warp_48=`            }
warp_49=`
warp_50=`            float3 ry_p0 = float3(p0.x * cos(ay) - p0.z * sin(ay), p0.y, p0.x * sin(ay) + p0.z * cos(ay));
warp_51=`            p0 = float3(ry_p0.x, ry_p0.y * cos(ax) - ry_p0.z * sin(ax), ry_p0.y * sin(ax) + ry_p0.z * cos(ax)) * s;
warp_52=`
warp_53=`            float3 ry_p1 = float3(p1.x * cos(ay) - p1.z * sin(ay), p1.y, p1.x * sin(ay) + p1.z * cos(ay));
warp_54=`            p1 = float3(ry_p1.x, ry_p1.y * cos(ax) - ry_p1.z * sin(ax), ry_p1.y * sin(ax) + ry_p1.z * cos(ax)) * s;
warp_55=`
warp_56=`            float2 A = p0.xy * 1.2 / (1.2 + p0.z);
warp_57=`            float2 B = p1.xy * 1.2 / (1.2 + p1.z);
warp_58=`            glow += 0.0025 / (sdSeg(my_uv, A, B) + 0.002);
warp_59=`        }
warp_60=`    }
warp_61=`
warp_62=`    float3 col = hsv(frac(time * 0.1 + 0.45), 0.6, 1.0) * glow * 0.6;
warp_63=`
warp_64=`    ret = col;
warp_65=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
