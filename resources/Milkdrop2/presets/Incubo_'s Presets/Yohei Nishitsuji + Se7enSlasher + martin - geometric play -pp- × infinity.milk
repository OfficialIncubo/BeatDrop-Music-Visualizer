MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=2
PSVERSION_COMP=4
[preset00]
fRating=5.000
fGammaAdj=1.000
fDecay=0.980
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=0.000
fWaveSmoothing=0.000
fWaveParam=0.000
fModWaveAlphaStart=0.000
fModWaveAlphaEnd=0.000
fWarpAnimSpeed=1.459
fWarpScale=2.007
fZoomExponent=1.00000
fShader=0.000
zoom=0.99990
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=0.01000
sx=0.99990
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.015
ob_r=0.000
ob_g=0.000
ob_b=1.000
ob_a=0.000
ib_size=0.260
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=12.000
nMotionVectorsY=9.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_init_1=speed_=1;vx = 0; vy = 0; vz = 0;
per_frame_init_2=trel = 0; p1 = 0; dir = 0;
per_frame_init_3=ang0 = 0;
per_frame_1=dec_med = exp (-3/fps);
per_frame_2=dec_slow = exp (-1/fps);
per_frame_3=
per_frame_4=beat = bass+mid+treb; 
per_frame_5=avg = avg*dec_slow + beat*(1-dec_slow);
per_frame_6=is_beat = above(beat, .2+avg+peak) * above (time, t0+.5);
per_frame_7=t0 = is_beat*time + (1-is_beat)*t0;
per_frame_8=peak = is_beat * beat + (1-is_beat)*peak*dec_med;
per_frame_9=index = (index + is_beat) %16;
per_frame_10=index2 = (index2 + is_beat*bnot(index))%8;
per_frame_11=
per_frame_12=q20 = avg;
per_frame_13=q21 = beat;
per_frame_14=q22 = peak;
per_frame_15=q24 = is_beat;
per_frame_16=vol = bass_att + mid_att + treb_att;
per_frame_17=vol_ = dec_med * vol_ + (1-dec_med)* vol;
per_frame_18=vol__ = dec_med * vol__ + (1-dec_med)* vol_;
per_frame_19=q27 = index + 1;
per_frame_20=q28 = index2 + 1;
per_frame_21=
per_frame_22=k1 =  is_beat*equal(index%4,0);
per_frame_23=p1 =  k1*(p1+1) + (1-k1)*p1;
per_frame_24=p2 = dec_med * p2+ (1-dec_med)*p1;
per_frame_25=rott = p2 * 3.1416/4;
per_frame_26=
per_frame_27=q1 = cos(rott);
per_frame_28=q2 = sin(rott);
per_frame_29=q3 = -q2;
per_frame_30=q4 = q1;
per_frame_31=
per_frame_32=trig = q24 * bnot(index%8);
per_frame_33=vx = vx*bnot(trig) + trig* (rand(100)/100-.5);
per_frame_34=vy = vy*bnot(trig) + trig* (rand(100)/100-.5);
per_frame_35=vz = vz*bnot(trig) + trig* (rand(100)/100-.5);
per_frame_36=
per_frame_37=q10 = 0.2+vy*vy*4;
per_frame_38=q11 = cos(time/9)*.5+.3;
per_frame_39=
per_frame_40=speed = min(vol_-vol__+.5,1);
per_frame_41=speed = max(speed,-.5);
per_frame_42=speed_ = bnot(trig)*speed_ + trig*speed;
per_frame_43=movz = movz + 1/fps*speed_;
per_frame_44=q9 = movz;
per_frame_45=
per_frame_46=q12 = min(q22,6)*2;
per_frame_47=//q13 = 1.5+sin(time/5);
per_frame_48=trig = bnot(index%4) * q24;
per_frame_49=dir = bnot(trig)*dir + trig*(rand(10)-5);
per_frame_50=
per_frame_51=trel = trel + .2/fps*dir;
per_frame_52=
per_frame_53=q5 = cos(trel);
per_frame_54=q6 = sin(trel+0*q27*(q28%2));
per_frame_55=q7 = -q6;
per_frame_56=q8 = q5;
per_frame_57=
per_frame_58=px = px * dec_med + (1-dec_med)*vx;
per_frame_59=py = py * dec_med + (1-dec_med)*vy;
per_frame_60=q15 = px/3;
per_frame_61=q16 = py/3;
per_frame_62=
per_frame_63=q13 = min(2,1+abs(8*px*py));
per_frame_64=
per_frame_65=ang0 = ang0*dec_med + vz*(1-dec_med);
per_frame_66=q17 = ang0*2; 
per_frame_67=
per_frame_68=zoom = 1.1;
per_frame_69=rot = .2*sin(bnot(q28%2)*q28) ;
per_frame_70=dx = .00;
per_frame_71=
per_frame_72=monitor = q11;
warp_1=`shader_body {
warp_2=`    ret = float4(0.0, 0.0, 0.0, 1.0);
warp_3=`}
comp_1=`float3 hsv(float h, float s, float v) {
comp_2=`    float4 t = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
comp_3=`    float3 p = abs(frac(float3(h, h, h) + t.xyz) * 6.0 - float3(t.w, t.w, t.w));
comp_4=`    return v * lerp(float3(t.x, t.x, t.x), clamp(p - float3(t.x, t.x, t.x), 0.0, 1.0), s);
comp_5=`}
comp_6=`
comp_7=`shader_body {
comp_8=`    // Screen coordinate setup and aspect ratio correction
comp_9=`    float2 my_uv = uv * 2.0 - 1.0;
comp_10=`    my_uv.x *= (aspect.x / aspect.y);
comp_11=`    my_uv.y = -my_uv.y; // Flip Y to match gl_FragCoord orientation
comp_12=`    my_uv += float2(q15, q16)*5; //camera move
comp_13=`    
comp_14=`    // Ray origin and direction
comp_15=`    float3 ray_dir = normalize(float3(my_uv, 1.0));
comp_16=`    
comp_17=`    float z = 0.0;
comp_18=`    float d = 0.0;
comp_19=`    float3 o = float3(0.0, 0.0, 0.0);
comp_20=`    bool marching = true;
comp_21=`    
comp_22=`    // Main volumetric raymarch loop
comp_23=`    for (int i = 0; i < 100; i++) {
comp_24=`        // Mimicking the original "i+++z<1e2" bounds check logic
comp_25=`        if ((float)i + z > 100.0) {
comp_26=`            marching = false;
comp_27=`        }
comp_28=`        
comp_29=`        if (marching) {
comp_30=`            float3 q = ray_dir * (z * q13);
comp_31=`            q.z += q9 * 5.0; // Fly forward through the tunnel
comp_32=`            
comp_33=`            // Apply Z-based rotation
comp_34=`            float base_twist = q.z * .1;
comp_35=`            float dyn_twist = (z/100) * M_PI * (q1*10);
comp_36=`            float a = base_twist + dyn_twist;
comp_37=`            float cosA = cos(a);
comp_38=`            float sinA = sin(a);
comp_39=`            float2 tempXY = q.xy;
comp_40=`            q.x = tempXY.x * cosA - tempXY.y * sinA;
comp_41=`            q.y = tempXY.x * sinA + tempXY.y * cosA;
comp_42=`            
comp_43=`            // Domain-warp turbulence
comp_44=`            float s_val = 1;
comp_45=`            for (int j = 0; j < 5; j++) {
comp_46=`                q += (abs(cos(float3(q.y, q.z, q.x) * s_val)) - 0.68) / s_val;
comp_47=`                s_val *= 2.0; // Identical to GLSL s/=.5
comp_48=`            }
comp_49=`            
comp_50=`            // Distance estimate & Accumulation
comp_51=`            d = 0.005 + abs((length(q.xy) - 6.0) * q.x) / 8;
comp_52=`            z += d;
comp_53=`            
comp_54=`            o += hsv(0.3 + sin(q.x) * 0.2, 0.5, 0.2) * exp(-z * 0.1) / d;
comp_55=`        }
comp_56=`    }
comp_57=`    
comp_58=`    // Tonemap
comp_59=`    o = 1-exp(-(o / 2e2 * (1 + q12/2)));
comp_60=`    
comp_61=`    ret = float4(o, 1.0);
comp_62=`}
