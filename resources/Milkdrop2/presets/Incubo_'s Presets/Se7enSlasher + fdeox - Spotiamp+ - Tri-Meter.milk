fVideoEchoZoom=1.007
fVideoEchoAlpha=0.500
nVideoEchoOrientation=2
nWaveMode=15
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=1
bDarken=1
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=0.625
fWaveSmoothing=0.900
fWaveParam=0.000
fModWaveAlphaStart=0.880
fModWaveAlphaEnd=1.980
fWarpAnimSpeed=0.010
fWarpScale=0.010
fZoomExponent=1.00000
fShader=1.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.500
wave_y=0.500
ob_size=0.500
ob_r=0.010
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.260
ib_r=0.235
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=64.000
nMotionVectorsY=48.000
mv_dx=0.000
mv_dy=0.000
mv_l=1.000
mv_r=1.060
mv_g=1.000
mv_b=0.819
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float3 hsv(float h, float s, float v) {
warp_7=`    float3 rgb = clamp(abs(fmod(h*6+float3(0,4,2),6)-3)-1,0,1);
warp_8=`    return v * lerp(float3(1,1,1), rgb, s);
warp_9=`}
warp_10=`
warp_11=`shader_body
warp_12=`{
warp_13=`    float3 col = 0;
warp_14=`    //Obligatory Y flipping
warp_15=`    uv.y = 1-uv.y;
warp_16=`
warp_17=`    float2 sc = uv;
warp_18=`    float mc = floor(sc.x*3.0);
warp_19=`    float fx = frac(sc.x*3.0);
warp_20=`    float v = mc < 0.5 ? bass_att/3 : (mc < 1.5 ? mid_att/3 : treb_att/3);
warp_21=`    v = clamp(v*1.4, 0.0, 1.0);
warp_22=`    float seg = floor(sc.y*20.0);
warp_23=`    float fy = frac(sc.y*20.0);
warp_24=`    float on = step(seg/20.0, v - 0.001);
warp_25=`    float box = step(0.15,fx)*step(fx,0.85)*step(0.15,fy)*step(fy,0.85);
warp_26=`    col = hsv(0.33 - 0.33*seg/19.0, 0.85, 1.0)*box*(on + 0.08);
warp_27=`    ret = col;
warp_28=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
