warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`// High-quality spatial-temporal hash for perfect TV static
warp_7=`float hash31(float3 p3)
warp_8=`{
warp_9=`    p3 = frac(p3 * 0.1031);
warp_10=`    p3 += dot(p3, p3.yzx + 33.33);
warp_11=`    return frac((p3.x + p3.y) * p3.z);
warp_12=`}
warp_13=`
warp_14=`float3 hsv(float h, float s, float v)
warp_15=`{
warp_16=`    float4 k = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
warp_17=`    float3 p = abs(frac(h + k.xyz) * 6.0 - k.www);
warp_18=`    return v * lerp(k.xxx, saturate(p - k.xxx), s);
warp_19=`}
warp_20=`
warp_21=`shader_body
warp_22=`{
warp_23=`    uv.y = 1.0 - uv.y;
warp_24=`    float2 sc = uv;
warp_25=`
warp_26=`    // Barrel distortion
warp_27=`    float2 cc = sc - 0.5;
warp_28=`    float2 p = 0.5 + cc * (1.0 + dot(cc, cc) * 0.25);
warp_29=`
warp_30=`    // Colour bars
warp_31=`    float bar_idx = floor(p.x * 7.0) / 7.0;
warp_32=`    float3 bars = hsv(bar_idx, 0.8, 0.9) * (0.4 + get_fft(bar_idx + 0.07) * 1.2);
warp_33=`
warp_34=`    // 3D Hash Static
warp_35=`    float stat = hash31(float3(floor(p * float2(160.0, 120.0)), floor(time * 30.0)));
warp_36=`
warp_37=`    // Mix picture with static based on audio volume
warp_38=`    float3 col = lerp(bars, float3(stat, stat, stat), clamp(0.85 - vol_att * 1.5, 0.1, 0.9));
warp_39=`
warp_40=`    // Scanlines (using fixed frequency)
warp_41=`    col *= 0.75 + 0.25 * sin(p.y * 1200.0);
warp_42=`
warp_43=`    // V-Sync rolling bar
warp_44=`    col *= 1.0 - 0.35 * exp(-pow((frac(p.y + (time * 0.15)) - 0.5) * 8.0, 2.0));
warp_45=`
warp_46=`    // Branchless screen edge cutoff
warp_47=`    float bounds = step(0.0, p.x) * step(p.x, 1.0) * step(0.0, p.y) * step(p.y, 1.0);
warp_48=`    col *= bounds;
warp_49=`
warp_50=`    ret = col;
warp_51=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
