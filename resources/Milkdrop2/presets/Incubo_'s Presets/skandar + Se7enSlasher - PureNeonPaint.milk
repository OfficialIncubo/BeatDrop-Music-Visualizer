per_frame_init_1=q1=time;
per_frame_init_2=temp=0;
per_frame_1=temp+=bass_att*.025;
per_frame_2=q1=temp;
warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_main, uv).xyz;
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    uv.y = 1-uv.y; // Y flipping is obligatory while porting shaders from ShaderToy, FragCoord.xyz etc.
comp_4=`
comp_5=`    float2 p;
comp_6=`    float3 c;
comp_7=`    float3 c0;
comp_8=`    float w0;
comp_9=`    float wt;
comp_10=`    float wp;
comp_11=`    float wb;
comp_12=`   float w;
comp_13=`   float a;
comp_14=`   float s;
comp_15=`   float co;
comp_16=`
comp_17=`   // --- ENHANCED TUNNEL DISTORTION ---
comp_18=`   float2 centered_uv = uv - float2(0.5, 0.5);
comp_19=`   float dist = length(centered_uv);
comp_20=`   
comp_21=`   float blend = smoothstep(0.0, 0.45, dist);
comp_22=`   float2 distorted_uv = centered_uv * pow(dist + 0.02, -0.95) * 0.18;
comp_23=`   float2 final_uv = float2(0.5, 0.5) + lerp(centered_uv * 0.4, distorted_uv, blend);
comp_24=`   p.x=final_uv.x;
comp_25=`   p.y=final_uv.y*texsize.y*texsize.z;
comp_26=`
comp_27=`   // --- ZOOM OUT TO REVEAL FINE FRACTAL DETAIL ---
comp_28=`   p=float2(0.125,0.75) + (p-float2(0.125,0.75))*0.08;
comp_29=`   float T=time*0.25+q1;
comp_30=`   c.x=clamp(
comp_31=`       1.0-0.7*length(p-float2(0.1,0.0)),
comp_32=`       0.0,1.0)*2.0-1.0;
comp_33=`   c.y=clamp(
comp_34=`       1.0-0.7*length(p-float2(0.9,0.0)),
comp_35=`       0.0,1.0)*2.0-1.0;
comp_36=`   c.z=clamp(
comp_37=`       1.0-0.7*length(p-float2(0.5,1.0)),
comp_38=`       0.0,1.0)*2.0-1.0;
comp_39=`   c0=float3(0.0,0.0,0.0);
comp_40=`   w0=0.0;
comp_41=`   wt=-0.060000;
comp_42=`   wp=0.501500;
comp_43=`   wb=0.050000;
comp_44=`   a=1.6+T*0.65*wt+(p.x+0.7)*23.0*wp;
comp_45=`   s=sin(a*15.83);
comp_46=`   co=cos(a*15.83);
comp_47=`   c.xz=float2(c.x*s+c.z*co,c.x*co-c.z*s);
comp_48=`   a=c.z*c.x*wb+1.7+T*wt+(p.y+1.1)*15.0*wp;
comp_49=`   s=sin(a*15.83);
comp_50=`   co=cos(a*15.83);
comp_51=`   c.xy=float2(c.x*s+c.y*co,c.x*co-c.y*s);
comp_52=`   a=c.x*c.y*wb+2.4-T*0.79*wt
comp_53=`    +(p.x+p.y*(frac(0.0/2.0)-0.25)*4.0)*17.0*wp;
comp_54=`   s=sin(a*15.83);
comp_55=`   co=cos(a*15.83);
comp_56=`   c.yz=float2(c.y*s+c.z*co,c.x*co-c.z*s);
comp_57=`   a=c.y*c.z*wb+1.6-T*0.65*wt+(p.x+0.7)*23.0*wp;
comp_58=`   s=sin(a*15.83);
comp_59=`   co=cos(a*15.83);
comp_60=`   c.xz=float2(c.x*s+c.z*co,c.x*co-c.z*s);
comp_61=`   a=c.z*c.x*wb+1.7-T*wt+(p.y+1.1)*15.0*wp;
comp_62=`   s=sin(a*15.83);
comp_63=`   co=cos(a*15.83);
comp_64=`   c.xy=float2(c.x*s+c.y*co,c.x*co-c.y*s);
comp_65=`   w=1.5;
comp_66=`   c0+=c*w;
comp_67=`   w0+=w;
comp_68=`   for(int i=1;i<16;i++)
comp_69=`   {
comp_70=`       wt=(float(i*i)/256.0-0.2)*0.3;
comp_71=`       wp=0.5+(float(i)+1.0)*(float(i)+1.5)*0.001;
comp_72=`       wb=0.05+float(i)/16.0*0.1;
comp_73=`       a=1.6+T*0.65*wt+(p.x+0.7)*23.0*wp;
comp_74=`       s=sin(a*15.83);
comp_75=`       co=cos(a*15.83);
comp_76=`       c.xz=float2(c.x*s+c.z*co,c.x*co-c.z*s);
comp_77=`       a=c.z*c.x*wb+1.7+T*wt+(p.y+1.1)*15.0*wp;
comp_78=`       s=sin(a*15.83);
comp_79=`       co=cos(a*15.83);
comp_80=`       c.xy=float2(c.x*s+c.y*co,c.x*co-c.y*s);
comp_81=`       a=c.x*c.y*wb+2.4-T*0.79*wt
comp_82=`        +(p.x+p.y*(frac(float(i)/2.0)-0.25)*4.0)*17.0*wp;
comp_83=`       s=sin(a*15.83);
comp_84=`       co=cos(a*15.83);
comp_85=`       c.yz=float2(c.y*s+c.z*co,c.y*co-c.z*s);
comp_86=`       a=c.y*c.z*wb+1.6-T*0.65*wt+(p.x+0.7)*23.0*wp;
comp_87=`       s=sin(a*15.83);
comp_88=`       co=cos(a*15.83);
comp_89=`       c.xz=float2(c.x*s+c.z*co,c.x*co-c.z*s);
comp_90=`       a=c.z*c.x*wb+1.7-T*wt+(p.y+1.1)*15.0*wp;
comp_91=`       s=sin(a*15.83);
comp_92=`       co=cos(a*15.83);
comp_93=`       c.xy=float2(c.x*s+c.y*co,c.x*co-c.y*s);
comp_94=`       w=1.5-float(i)/16.0;
comp_95=`       c0+=c*w;
comp_96=`       w0+=w;
comp_97=`   }
comp_98=`   c0=c0/w0*1.5+0.1;
comp_99=`   c0*=0.6+dot(c0,float3(1.0,1.0,1.0))/sqrt(3.0)*0.6;
comp_100=`   // --- HIGH DYNAMIC RANGE (HDR) COLOR PIPELINE ---
comp_101=`   float3 hdr_rim = pow(length(sin(c0*3.141592654*4.0))/sqrt(3.0), 12.0) * 0.85;
comp_102=`  float3 green_zone = float3(0.0, 4.0, 0.4) * pow(saturate(c0.g), 1.4);
comp_103=`  float3 red_zone = float3(4.2, 0.1, 0.2) * pow(saturate(c0.r), 1.6);
comp_104=`  float3 cyan_zone = float3(0.0, 2.2, 3.8) * pow(saturate(c0.b), 1.8);
comp_105=`  
comp_106=`  float3 hdr_color = green_zone + red_zone + cyan_zone + hdr_rim;
comp_107=`  
comp_108=`  // Tone mapping, contrast boost, and gamma scaling
comp_109=`  hdr_color = hdr_color / (hdr_color + 0.35); 
comp_110=`  float3 final_color = smoothstep(0.05, 0.95, hdr_color);
comp_111=`  final_color = pow(final_color, float3(1.2, 1.2, 1.2));
comp_112=`  ret = saturate(final_color);
comp_113=`}
