MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=2
[preset00]
fRating=5.000
fGammaAdj=1.460
fDecay=0.935
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.007
fVideoEchoAlpha=0.500
nVideoEchoOrientation=2
nWaveMode=15
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=1
bDarken=1
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=0.625
fWaveSmoothing=0.900
fWaveParam=0.000
fModWaveAlphaStart=0.880
fModWaveAlphaEnd=1.980
fWarpAnimSpeed=0.010
fWarpScale=0.010
fZoomExponent=1.00000
fShader=1.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.500
wave_y=0.500
ob_size=0.500
ob_r=0.010
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.260
ib_r=0.235
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=64.000
nMotionVectorsY=48.000
mv_dx=0.000
mv_dy=0.000
mv_l=1.000
mv_r=1.060
mv_g=1.000
mv_b=0.819
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float specLog(float x)
warp_7=`{ 
warp_8=`    return get_fft(pow(saturate(x), 1.8)); 
warp_9=`}
warp_10=`
warp_11=`#if defined (HAS_FFT_PEAK)
warp_12=`float specLogCap(float x)
warp_13=`{ 
warp_14=`    return get_fft_peak(pow(saturate(x), 1.8)); 
warp_15=`}
warp_16=`#endif
warp_17=`
warp_18=`shader_body
warp_19=`{
warp_20=`    uv.y = 1.0 - uv.y;
warp_21=`    float2 sc = uv;
warp_22=`
warp_23=`    // Standardized Spotiamp+ UV scaling
warp_24=`    uv -= 0.5;
warp_25=`    uv.x /= aspect.y;
warp_26=`
warp_27=`    float hz = -0.08;
warp_28=`    
warp_29=`    // Background gradient
warp_30=`    float3 col = lerp(float3(0.05, 0.0, 0.12), float3(0.55, 0.08, 0.45), smoothstep(0.5, hz, uv.y));
warp_31=`
warp_32=`    // Synthwave Sun
warp_33=`    float2 sp = uv - float2(0.0, 0.12);
warp_34=`    float sr = 0.26 + bass_att * 0.03;
warp_35=`    float sun = smoothstep(sr, sr - 0.01, length(sp));
warp_36=`    
warp_37=`    // Sun horizontal blind cutouts
warp_38=`    float gap = step(0.0, sin(sp.y * 70.0 - time * 2.0) + 1.0 + sp.y * 9.0);
warp_39=`    sun *= (sp.y > -0.02) ? 1.0 : gap;
warp_40=`
warp_41=`    // Sun coloring and ambient backlight glow
warp_42=`    col = lerp(col, lerp(float3(1.0, 0.85, 0.25), float3(1.0, 0.2, 0.55), smoothstep(0.26, -0.2, sp.y)), sun);
warp_43=`    col += float3(1.0, 0.3, 0.6) * 0.3 * exp(-length(sp) * 4.0);
warp_44=`
warp_45=`    // Spectrum Equalizer Mountains Horizon
warp_46=`    float fft_pos = saturate(abs(sc.x - 0.5) * 1.8);
warp_47=`    float mh = hz + 0.02 + specLog(fft_pos) * 0.2;
warp_48=`
warp_49=`    if (uv.y < mh && uv.y > hz) 
warp_50=`    {
warp_51=`        col = lerp(float3(0.06, 0.0, 0.12), float3(0.28, 0.05, 0.38), (uv.y - hz) / (mh - hz + 0.001));
warp_52=`    }
warp_53=`    col += float3(0.3, 0.9, 1.0) * smoothstep(0.004, 0.0, abs(uv.y - mh)) * step(hz, uv.y);
warp_54=`
warp_55=`    // Perspective Grid Floor below horizon
warp_56=`    if (uv.y < hz) 
warp_57=`    {
warp_58=`        float d = hz - uv.y;
warp_59=`        float z = 0.12 / d;
warp_60=`        float2 g = float2(uv.x * z + 0.5, z + time * 1.2);
warp_61=`        float2 f = abs(frac(g) - 0.5);
warp_62=`        float lw = clamp(0.035 * z, 0.03, 0.45);
warp_63=`        float line = smoothstep(0.5 - lw, 0.5, max(f.x, f.y));
warp_64=`
warp_65=`        col = float3(0.04, 0.0, 0.08) + float3(1.0, 0.25, 0.85) * line * (0.7 + mid_att) * exp(-z * 0.09);
warp_66=`        col += float3(0.8, 0.2, 0.6) * exp(-d * 22.0) * 0.6;
warp_67=`    }
warp_68=`
warp_69=`    ret = col;
warp_70=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
