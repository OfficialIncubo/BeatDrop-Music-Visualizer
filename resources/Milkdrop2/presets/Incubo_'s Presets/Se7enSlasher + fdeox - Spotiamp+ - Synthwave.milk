b1ed=0.250
warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float specLog(float x){ return get_fft(pow(clamp(x,0.0,1.0), 1.8)); }
warp_7=`#if defined (HAS_FFT_PEAK)
warp_8=`float specLogCap(float x){ return get_fft_peak(pow(clamp(x,0.0,1.0), 1.8)); }
warp_9=`#endif
warp_10=`
warp_11=`shader_body
warp_12=`{
warp_13=`    float2 sc = uv;
warp_14=`    float3 col = 0;
warp_15=`    //Obligatory Y flipping
warp_16=`    uv.y = 1-uv.y;
warp_17=`    uv = (uv-.5)*aspect.xy;
warp_18=`
warp_19=`        float hz = -0.08;
warp_20=`        col = lerp(float3(0.05,0.0,0.12), float3(0.55,0.08,0.45), smoothstep(0.5,hz,uv.y));
warp_21=`        float2 sp = uv - float2(0, 0.12);
warp_22=`        float sr = 0.26 + bass_att*0.03;
warp_23=`        float sun = smoothstep(sr, sr-0.01, length(sp));
warp_24=`        float gap = step(0, sin(sp.y*70 - time*2.0) + 1 + sp.y*9);
warp_25=`        sun *= sp.y > -0.02 ? 1 : gap;
warp_26=`        col = lerp(col, lerp(float3(1.0,0.85,0.25), float3(1.0,0.2,0.55), smoothstep(0.26,-0.2,sp.y)), sun);
warp_27=`        col += float3(1.0,0.3,0.6)*0.3*exp(-length(sp)*4.0);
warp_28=`        float mh = hz + 0.02 + specLog(abs(sc.x-0.5)*1.7)*0.2;
warp_29=`        if (uv.y < mh && uv.y > hz) col = lerp(float3(0.06,0.0,0.12), float3(0.28,0.05,0.38), (uv.y-hz)/(mh-hz+0.001));
warp_30=`        col += float3(0.3,0.9,1.0)*smoothstep(0.004,0.0,abs(uv.y-mh))*step(hz,uv.y);
warp_31=`        if (uv.y < hz) {
warp_32=`          float d = hz - uv.y;
warp_33=`          float z = 0.12/d;
warp_34=`          float2 g = float2(uv.x*z + 0.5, z + time*1.2);
warp_35=`          float2 f = abs(frac(g)-0.5);
warp_36=`          float lw = clamp(0.035*z, 0.03, 0.45);
warp_37=`          float line = smoothstep(0.5-lw, 0.5, max(f.x, f.y));
warp_38=`          col = float3(0.04,0.0,0.08) + float3(1.0,0.25,0.85)*line*(0.7+mid)*exp(-z*0.09);
warp_39=`          col += float3(0.8,0.2,0.6)*exp(-d*22.0)*0.6;
warp_40=`        }
warp_41=`    ret = col;
warp_42=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
