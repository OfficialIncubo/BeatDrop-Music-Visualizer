warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float specLog(float x){ return get_fft(pow(saturate(x), 1.8)); }
warp_7=`#if defined (HAS_FFT_PEAK)
warp_8=`float specLogCap(float x){ return get_fft_peak(pow(saturate(x), 1.8)); }
warp_9=`#endif
warp_10=`
warp_11=`float hash(float2 p)
warp_12=`{
warp_13=`    return frac(sin(dot(p, float2(41.3, 289.1))) * 43758.5453);
warp_14=`}
warp_15=`
warp_16=`float3 hsv(float h, float s, float v)
warp_17=`{
warp_18=`    float4 k = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
warp_19=`    float3 p = abs(frac(h + k.xyz) * 6.0 - k.www);
warp_20=`    return v * lerp(k.xxx, saturate(p - k.xxx), s);
warp_21=`}
warp_22=`
warp_23=`shader_body
warp_24=`{
warp_25=`    uv.y = 1.0 - uv.y;
warp_26=`    float2 sc = uv;
warp_27=`
warp_28=`    float2 g = float2(24.0, 18.0);
warp_29=`    float cx = floor(sc.x * g.x);
warp_30=`    float v = specLog((cx + 0.5) / g.x);
warp_31=`    float y = sc.y * g.y + (time*10) + (1.0 + v * 6.0 + hash(float2(cx, 1.0)) * 2.0);
warp_32=`    float on = step(0.72 - v * 0.4, hash(float2(cx, floor(y))));
warp_33=`    float2 f = frac(float2(sc.x * g.x, y));
warp_34=`    float box = step(0.08, f.x) * step(f.x, 0.92) * step(0.08, f.y) * step(f.y, 0.92);
warp_35=`
warp_36=`    float3 col = hsv(frac(cx / g.x * 0.7 + 0.55), 0.75, 1.0) * on * box * (0.35 + v);
warp_37=`
warp_38=`    ret = col;
warp_39=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
