MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5.000
fGammaAdj=1.460
fDecay=0.935
FFTAttack=1.000
FFTDecay=0.600
fVideoEchoZoom=1.007
fVideoEchoAlpha=0.500
nVideoEchoOrientation=2
nWaveMode=15
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=1
bDarken=1
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=0.625
fWaveSmoothing=0.900
fWaveParam=0.000
fModWaveAlphaStart=0.880
fModWaveAlphaEnd=1.980
fWarpAnimSpeed=0.010
fWarpScale=0.010
fZoomExponent=1.00000
fShader=1.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.500
wave_y=0.500
ob_size=0.500
ob_r=0.010
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.260
ib_r=0.235
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=64.000
nMotionVectorsY=48.000
mv_dx=0.000
mv_dy=0.000
mv_l=1.000
mv_r=1.060
mv_g=1.000
mv_b=0.819
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`shader_body
warp_7=`{
warp_8=`    uv.y = 1.0 - uv.y;
warp_9=`
warp_10=`    // Standardized Spotiamp+ UV scaling (y spans [-1, 1])
warp_11=`    float2 my_uv = (uv - float2(0.5, 0.52)) * 2.0;
warp_12=`    my_uv.x /= aspect.y;
warp_13=`
warp_14=`    float3 col = float3(0.0, 0.0, 0.0);
warp_15=`    float t = time * 0.25;
warp_16=`
warp_17=`    for (int k = 0; k < 26; k++)
warp_18=`    {
warp_19=`        float fk = float(k);
warp_20=`        float y = (fk / 26.0) * 2.0 - 1.0;
warp_21=`        float ph = y * 4.0 + t * 2.2;
warp_22=`        
warp_23=`        float x1 = sin(ph) * 0.42;
warp_24=`        float x2 = sin(ph + 3.14159265) * 0.42;
warp_25=`        float dep = 0.55 + 0.45 * cos(ph);
warp_26=`        
warp_27=`        float e = get_fft(fk / 26.0);
warp_28=`        float radius = 0.030 + 0.022 * dep;
warp_29=`
warp_30=`        // Helix node positions
warp_31=`        float2 pa = float2(x1, y);
warp_32=`        float2 pb = float2(x2, y);
warp_33=`
warp_34=`        // Strand A (Blue node)
warp_35=`        col += float3(0.3, 0.8, 1.0) * (smoothstep(radius, 0.0, length(my_uv - pa))
warp_36=`             + smoothstep(radius * 2.6, 0.0, length(my_uv - pa)) * 0.25) * dep * (1.1 + e * 2.2);
warp_37=`
warp_38=`        // Strand B (Pink node)
warp_39=`        col += float3(1.0, 0.4, 0.7) * (smoothstep(radius, 0.0, length(my_uv - pb))
warp_40=`             + smoothstep(radius * 2.6, 0.0, length(my_uv - pb)) * 0.25) * dep * (1.1 + e * 2.2);
warp_41=`
warp_42=`        // Connecting rung line segment
warp_43=`        float2 ab = pb - pa; 
warp_44=`        float h2 = saturate(dot(my_uv - pa, ab) / dot(ab, ab));
warp_45=`        col += float3(0.6, 0.9, 0.7) * smoothstep(0.014, 0.0, length(my_uv - pa - ab * h2)) * (0.35 + e * 1.6);
warp_46=`    }
warp_47=`
warp_48=`    ret = col;
warp_49=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
