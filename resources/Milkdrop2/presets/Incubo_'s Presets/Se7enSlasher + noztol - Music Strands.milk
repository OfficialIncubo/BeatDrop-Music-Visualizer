b3x=1.000
b1ed=0.250
warp_1=`shader_body {
warp_2=`  ret = float4(0.0, 0.0, 0.0, 1.0);
warp_3=`}
comp_1=`#define INTERPOLANT 0
comp_2=`
comp_3=`float3 palette(float t) {
comp_4=`    float3 a = float3(0.5, 0.5, 0.5);
comp_5=`    float3 b = float3(0.5, 0.5, 0.5);
comp_6=`    float3 c = float3(1.0, 1.0, 1.0);
comp_7=`    float3 d = float3(0.0, 0.33, 0.67);
comp_8=`    return a + b * cos(6.2831853 * (c * t + d));
comp_9=`}
comp_10=`
comp_11=`float3 aces(float3 color) {    
comp_12=`    float3 v;
comp_13=`    v.x = 0.59719 * color.x + 0.35458 * color.y + 0.04823 * color.z;
comp_14=`    v.y = 0.07600 * color.x + 0.90834 * color.y + 0.01566 * color.z;
comp_15=`    v.z = 0.02840 * color.x + 0.13383 * color.y + 0.83777 * color.z;
comp_16=`    
comp_17=`    float3 a = v * (v + 0.0245786) - 0.000090537;
comp_18=`    float3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
comp_19=`    float3 r = a / b;
comp_20=`        
comp_21=`    float3 res;
comp_22=`    res.x =  1.60475 * r.x - 0.53108 * r.y - 0.07367 * r.z;
comp_23=`    res.y = -0.10208 * r.x + 1.10813 * r.y - 0.00605 * r.z;
comp_24=`    res.z = -0.00327 * r.x - 0.07276 * r.y + 1.07602 * r.z;
comp_25=`    return res; 
comp_26=`}
comp_27=`
comp_28=`float3 hash(float3 p) {
comp_29=`    float3 d = float3(
comp_30=`        dot(p, float3(127.1, 311.7, 74.7)),
comp_31=`        dot(p, float3(269.5, 183.3, 246.1)),
comp_32=`        dot(p, float3(113.5, 271.9, 124.6))
comp_33=`    );
comp_34=`    return -1.0 + 2.0 * frac(sin(d) * 43758.5453123);
comp_35=`}
comp_36=`
comp_37=`float noise(float3 p) {
comp_38=`    float3 i = floor(p);
comp_39=`    float3 f = frac(p);
comp_40=`    #if INTERPOLANT == 1
comp_41=`    float3 u = f*f*f*(f*(f*6-15)+10);
comp_42=`    #else
comp_43=`    float3 u = f*f*(3 - 2 * f);   
comp_44=`    #endif
comp_45=`
comp_46=`    float d000 = dot(hash(i + float3(0.0,0.0,0.0)), f - float3(0.0,0.0,0.0));
comp_47=`    float d100 = dot(hash(i + float3(1.0,0.0,0.0)), f - float3(1.0,0.0,0.0));
comp_48=`    float d010 = dot(hash(i + float3(0.0,1.0,0.0)), f - float3(0.0,1.0,0.0));
comp_49=`    float d110 = dot(hash(i + float3(1.0,1.0,0.0)), f - float3(1.0,1.0,0.0));
comp_50=`    float d001 = dot(hash(i + float3(0.0,0.0,1.0)), f - float3(0.0,0.0,1.0));
comp_51=`    float d101 = dot(hash(i + float3(1.0,0.0,1.0)), f - float3(1.0,0.0,1.0));
comp_52=`    float d011 = dot(hash(i + float3(0.0,1.0,1.0)), f - float3(0.0,1.0,1.0));
comp_53=`    float d111 = dot(hash(i + float3(1.0,1.0,1.0)), f - float3(1.0,1.0,1.0));
comp_54=`
comp_55=`    return lerp(lerp(lerp(d000, d100, u.x), lerp(d010, d110, u.x), u.y),
comp_56=`                lerp(lerp(d001, d101, u.x), lerp(d011, d111, u.x), u.y), u.z);
comp_57=`}
comp_58=`
comp_59=`float pattern(float3 p) {
comp_60=`    return noise(p / 12.0) * 12.0;
comp_61=`}
comp_62=`
comp_63=`shader_body {
comp_64=`    float2 my_uv = uv * 2.0 - 1.0;
comp_65=`    my_uv.x *= (aspect.x / aspect.y);
comp_66=`    
comp_67=`    float d = 0.0; 
comp_68=`    float s = 0.0; 
comp_69=`    float3 p = float3(0.0, 0.0, 0.0);        
comp_70=`    float3 fragColor = float3(0.0, 0.0, 0.0);
comp_71=`
comp_72=`    float look = smoothstep(-1.0, 1.0, sin(time * 0.25 + 1.0));
comp_73=`
comp_74=`    // Read and scale audio inputs natively
comp_75=`    float bassFFT = pow(get_fft(0.05), 2.0);
comp_76=`    float midFFT  = pow(get_fft(0.40), 2.0);
comp_77=`    float highFFT = pow(get_fft(0.80), 2.0);
comp_78=`    float3 audioPop = float3(bassFFT, midFFT, highFFT) * 3.5;
comp_79=`
comp_80=`    // Raymarching pipeline
comp_81=`    for (int i = 0; i < 80; i++) {
comp_82=`        s = 0.01 + abs(s) * 0.4;
comp_83=`        d += s;
comp_84=`       
comp_85=`        p = float3(my_uv * d * 2.0, d + time * 2.0);
comp_86=`        
comp_87=`        // Path transformations
comp_88=`        float2 path = float2(sin(p.z * 0.15) * 2.5, cos(p.z * 0.1) * 2.5);
comp_89=`        p.xy -= path;
comp_90=`
comp_91=`        // Matrix rotation conversion
comp_92=`        float a = p.z * 0.05 + 2.0;
comp_93=`        float cosA = cos(a);
comp_94=`        float sinA = sin(a);
comp_95=`        float2 tempXY = p.xy;
comp_96=`        p.x = tempXY.x * cosA - tempXY.y * sinA;
comp_97=`        p.y = tempXY.x * sinA + tempXY.y * cosA;
comp_98=`
comp_99=`        // Density generation
comp_100=`        s = abs(sin(p.z + p.y + time) * (0.05 + 0.45 * look));
comp_101=`        float density = abs(pattern(p));
comp_102=`        s += density;
comp_103=`
comp_104=`        // Tunnel bounding limits
comp_105=`        float clear = length(p.xy) - 0.4;
comp_106=`        s = max(-clear, s); 
comp_107=`
comp_108=`        // Shading and accumulation
comp_109=`        float3 col = palette(d * 0.1 - time * 0.5);
comp_110=`        float3 finalCol = col * (audioPop + 0.02);
comp_111=`        float fade = exp(-d * 0.15);
comp_112=`
comp_113=`        fragColor += (finalCol * 0.02 / (s + 0.01)) * fade;
comp_114=`    }
comp_115=`
comp_116=`    // Post-processing passes
comp_117=`    fragColor = aces(fragColor);
comp_118=`    ret = float4(pow(abs(fragColor), float3(0.4545, 0.4545, 0.4545)), 1.0);
comp_119=`}
