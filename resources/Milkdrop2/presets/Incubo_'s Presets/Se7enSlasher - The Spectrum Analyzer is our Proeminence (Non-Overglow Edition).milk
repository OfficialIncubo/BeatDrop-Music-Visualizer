MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=2
[preset00]
fRating=5.000
fGammaAdj=1.200
fDecay=0.950
FFTAttack=0.500
FFTDecay=0.650
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=15
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=1
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=0.010
fWaveSmoothing=0.000
fWaveParam=0.000
fModWaveAlphaStart=0.000
fModWaveAlphaEnd=0.000
fWarpAnimSpeed=2.500
fWarpScale=2.000
fZoomExponent=1.00000
fShader=1.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.500
wave_y=0.500
ob_size=0.000
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.000
ib_r=0.000
ib_g=0.000
ib_b=0.000
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=0.000
mv_g=0.000
mv_b=0.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`// Preset generated by DeepSeek, modified for reduced glow
warp_2=`
warp_3=`#define NUM_BARS 48.0
warp_4=`#define BAR_SPACING 0.015
warp_5=`#define HEIGHT_SCALE 2.5
warp_6=`#define DISPLACE_STRENGTH 0.3
warp_7=`#define ROTATION_SPEED 0.2
warp_8=`#define GLOW_INTENSITY 0.12
warp_9=`
warp_10=`// Sample random texture for displacement
warp_11=`uniform sampler sampler_rand00;
warp_12=`
warp_13=`float3 hsv2rgb(float3 c) {
warp_14=`    float4 K = float4(1.0, 2.0/3.0, 1.0/3.0, 3.0);
warp_15=`    float3 p = abs(frac(c.xxx + K.xyz) * 6.0 - K.www);
warp_16=`    return c.z * lerp(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
warp_17=`}
warp_18=`
warp_19=`// 3D rotation matrix
warp_20=`float3 rotateY(float3 v, float angle) {
warp_21=`    float c = cos(angle);
warp_22=`    float s = sin(angle);
warp_23=`    return float3(v.x * c - v.z * s, v.y, v.x * s + v.z * c);
warp_24=`}
warp_25=`
warp_26=`shader_body
warp_27=`{
warp_28=`    // Original UV for random sampling
warp_29=`    float2 uv_orig_local = uv_orig;
warp_30=`
warp_31=`    
warp_32=`    // Setup 3D perspective
warp_33=`    float aspect = texsize.x / texsize.y;
warp_34=`    float2 uv_centered = (uv_orig_local * 2.0 - 1.0) * float2(aspect, 1.0);
warp_35=`    
warp_36=`    // Rotation over time
warp_37=`    float rot_angle = time * ROTATION_SPEED;
warp_38=`    
warp_39=`    // Create 3D bar positions
warp_40=`    float3 color = float3(0.0, 0.0, 0.0);
warp_41=`    
warp_42=`    // Calculate bar dimensions
warp_43=`    float total_unit = 1.0 / NUM_BARS;
warp_44=`    float actual_bar_width = total_unit - BAR_SPACING;
warp_45=`    
warp_46=`    // Frequency mapping
warp_47=`    float bass_freq = 50.0;
warp_48=`    float mid_freq = 500.0;
warp_49=`    float treble_freq = 5000.0;
warp_50=`    
warp_51=`    // Get FFT values for displacement strength
warp_52=`    float bass_fft = get_fft_hz(bass_freq);
warp_53=`    float mid_fft = get_fft_hz(mid_freq);
warp_54=`    float treble_fft = get_fft_hz(treble_freq);
warp_55=`    
warp_56=`    // Sample random texture for each frequency band
warp_57=`    float2 rand_coord = uv_orig_local;
warp_58=`    float rand_bass = tex2D(sampler_rand00, rand_coord).r;
warp_59=`    float rand_mid = tex2D(sampler_rand00, rand_coord).g;
warp_60=`    float rand_treble = tex2D(sampler_rand00, rand_coord).b;
warp_61=`    
warp_62=`    // Combined displacement strength per frequency
warp_63=`    float bass_displace = bass_fft * DISPLACE_STRENGTH * rand_bass;
warp_64=`    float mid_displace = mid_fft * DISPLACE_STRENGTH * rand_mid;
warp_65=`    float treble_displace = treble_fft * DISPLACE_STRENGTH * rand_treble;
warp_66=`    
warp_67=`    // Render bars
warp_68=`    for (float i = 0.0; i < NUM_BARS; i += 1.0) {
warp_69=`        float bar_index = i;
warp_70=`        float t_pos = bar_index / NUM_BARS;
warp_71=`        
warp_72=`        // Get FFT value for this bar (log-spaced)
warp_73=`        float log_min = log(30.0);
warp_74=`        float log_max = log(16000.0);
warp_75=`        float freq = exp(lerp(log_min, log_max, t_pos));
warp_76=`        float fft_val = get_fft_hz(freq) * HEIGHT_SCALE;
warp_77=`        
warp_78=`        // Bar position in 3D space
warp_79=`        float bar_x = (bar_index * total_unit + actual_bar_width * 0.5) * 2.0 - 1.0;
warp_80=`        bar_x *= aspect;
warp_81=`        
warp_82=`        // Apply frequency-specific displacement to X position
warp_83=`        float displace_x = 0.0;
warp_84=`        if (freq < 200.0) displace_x = bass_displace;
warp_85=`        else if (freq < 2000.0) displace_x = mid_displace;
warp_86=`        else displace_x = treble_displace;
warp_87=`        
warp_88=`        bar_x += displace_x * (rand_bass - 0.5) * 2.0;
warp_89=`        
warp_90=`        // Bar height
warp_91=`        float bar_h = fft_val;
warp_92=`        
warp_93=`        // Create 3D bar with depth
warp_94=`        float bar_z = bar_index / NUM_BARS * 2.0 - 1.0;
warp_95=`        
warp_96=`        // Apply mid-frequency displacement to Z
warp_97=`        bar_z += mid_displace * (rand_mid - 0.5) * 2.0;
warp_98=`        
warp_99=`        float3 bar_pos = float3(bar_x, 0.0, bar_z);
warp_100=`        
warp_101=`        // Rotate the entire scene
warp_102=`        bar_pos = rotateY(bar_pos, rot_angle);
warp_103=`        
warp_104=`        // Project to 2D
warp_105=`        float dist = 2.5;
warp_106=`        float2 screen_pos = bar_pos.xy / (bar_pos.z + dist);
warp_107=`        
warp_108=`        // Bar dimensions in screen space
warp_109=`        float bar_screen_width = actual_bar_width * aspect / (bar_pos.z + dist);
warp_110=`        float bar_screen_height = bar_h / (bar_pos.z + dist);
warp_111=`        
warp_112=`        // Check if pixel is inside bar
warp_113=`        float dx = abs(uv_centered.x - screen_pos.x);
warp_114=`        float dy = abs(uv_centered.y - screen_pos.y);
warp_115=`        
warp_116=`        float bar_mask = 1.0 - step(bar_screen_width * 0.5, dx);
warp_117=`        bar_mask *= 1.0 - step(bar_screen_height * 0.5, dy);
warp_118=`        
warp_119=`        // Apply treble displacement to vertical glow
warp_120=`        float glow_y = treble_displace * rand_treble * 2.0;
warp_121=`        
warp_122=`        float hue;
warp_123=`        if (bar_mask > 0.0) {
warp_124=`            // Color based on frequency with reduced saturation
warp_125=`            hue = t_pos + time * 0.1;
warp_126=`            float3 bar_color = hsv2rgb(float3(hue, 0.7, 0.8));
warp_127=`            
warp_128=`            // Add brightness based on distance
warp_129=`            float brightness = 1.0 / (1.0 + abs(bar_pos.z) * 0.5);
warp_130=`            color += bar_color * bar_mask * brightness;
warp_131=`        }
warp_132=`        
warp_133=`        // Add reduced glow effect (displaced by treble)
warp_134=`        float glow_dist = length(float2(dx, dy + glow_y));
warp_135=`        float glow = exp(-glow_dist * 12.0) * fft_val * GLOW_INTENSITY;
warp_136=`        float3 glow_color = hsv2rgb(float3(hue, 0.6, 0.7));
warp_137=`        color += glow_color * glow;
warp_138=`    }
warp_139=`    
warp_140=`    // Gamma correction for eye comfort
warp_141=`    color = pow(color, 1.0 / 2.0);
warp_142=`    
warp_143=`    ret = float4(color, 1.0);
warp_144=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    ret = tex2D(sampler_main, uv).xyz;
comp_4=`    
comp_5=`    // Gentle brightness boost
comp_6=`    ret *= 1.1;
comp_7=`}