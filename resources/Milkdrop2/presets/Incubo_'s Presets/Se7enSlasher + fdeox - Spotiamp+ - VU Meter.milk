b1ed=0.250
warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`shader_body
warp_7=`{
warp_8=`    float3 col = 0;
warp_9=`    //Obligatory Y flipping
warp_10=`    uv.y = 1-uv.y;
warp_11=`    
warp_12=`    float cell = floor(uv.x*3.0);
warp_13=`    float2 p = float2(frac(uv.x*3.0)-0.5, uv.y-0.12);
warp_14=`    p.x *= (texsize.x/3.0)/texsize.y;
warp_15=`    float lvl = cell < 0.5 ? bass_att/3 : (cell < 1.5 ? mid_att/3 : treb_att/3);
warp_16=`    float rr = length(p);
warp_17=`    // Mask by sweep angle: masking on p.y cut the dial in half rather than
warp_18=`    // ending it at the scale limits.
warp_19=`    float pa2 = atan2(p.y, p.x);
warp_20=`    float inArc = step(0.52, pa2) * step(pa2, 2.62);
warp_21=`    float arc = smoothstep(0.014,0.0, abs(rr-0.34)) * inArc;
warp_22=`    float ticks = inArc * smoothstep(0.045,0.0, abs(rr-0.30)) * smoothstep(0.82,1.0, sin(pa2*24.0));
warp_23=`    float angle = lerp(2.62, 0.52, clamp(lvl*1.25,0.0,1.0));
warp_24=`    float2 dir = float2(cos(angle), sin(angle));
warp_25=`    float needle = smoothstep(0.010,0.0, length(p - dir*clamp(dot(p,dir),0.0,0.32)));
warp_26=`    float hub = smoothstep(0.024,0.0, rr);
warp_27=`    col = float3(0.9,0.82,0.55)*arc*0.55 + float3(1.0,0.92,0.65)*ticks*0.5;
warp_28=`    col += lerp(float3(1.0,0.95,0.8), float3(1.0,0.3,0.15), smoothstep(0.6,1.0,lvl))*needle;
warp_29=`    col += float3(0.7,0.65,0.5)*hub;
warp_30=`    col += float3(0.05,0.045,0.04);
warp_31=`    
warp_32=`    ret = col;
warp_33=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
