warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float3 hsv(float h, float s, float v) {
warp_7=`    float3 rgb = clamp(abs(fmod(h*6+float3(0,4,2),6)-3)-1,0,1);
warp_8=`    return v * lerp(float3(1,1,1), rgb, s);
warp_9=`}
warp_10=`float hash(float2 p){ return frac(sin(dot(p,float2(41.3,289.1)))*43758.5); }
warp_11=`float noise(float2 p){
warp_12=`    float2 i=floor(p), f=frac(p); f=f*f*(3-2*f);
warp_13=`    return lerp(lerp(hash(i),hash(i+float2(1,0)),f.x),
warp_14=`                lerp(hash(i+float2(0,1)),hash(i+float2(1,1)),f.x), f.y);
warp_15=`}
warp_16=`float fbm(float2 p){ float v=0, a=.5; for(int k=0;k<4;k++){ v+=a*noise(p); p*=2; a*=.5; } return v; }
warp_17=`
warp_18=`shader_body {
warp_19=`        uv.y=1-uv.y; // Y UV flipping, first
warp_20=`        uv -= .5;
warp_21=`        float t = time*.25;
warp_22=`        float2 p = uv*2.0;
warp_23=`        p += float2(fbm(p+t), fbm(p-t))*(1.0+bass);
warp_24=`        float f = fbm(p*2+t);
warp_25=`        ret = hsv(frac(f+t*0.1+treb), 0.7, f*(0.5+vol+bass));
warp_26=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
