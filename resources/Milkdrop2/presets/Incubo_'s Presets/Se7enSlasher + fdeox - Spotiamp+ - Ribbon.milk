warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float3 pal(float x, float3 a, float3 b, float3 c, float3 d){ 
warp_7=`    return a + b * cos(M_PI_2 * (c * x + d)); 
warp_8=`}
warp_9=`
warp_10=`shader_body
warp_11=`{
warp_12=`    float3 col = 0;
warp_13=`    float t = time * 0.25;
warp_14=`
warp_15=`    //Obligatory Y flipping
warp_16=`    uv.y = 1-uv.y;
warp_17=`    uv = (uv-.5)*2;
warp_18=`
warp_19=`    float w = 0.0;
warp_20=`    for (int k=1;k<=4;k++){
warp_21=`      float fk=float(k);
warp_22=`      w += sin(uv.x*(2.0+fk*2.5) + t*(1.0+fk*0.4))*get_fft(fk/5.0)*0.35/fk;
warp_23=`    }
warp_24=`    float d = abs(uv.y - w);
warp_25=`    float thick = 0.06+vol*0.10;
warp_26=`    col = pal(frac(uv.x*0.35+t*0.08), float3(0.5,0.45,0.5), float3(.45,.45,.45), float3(1,1,1), float3(0.0,0.2,0.45));
warp_27=`    col *= smoothstep(thick,thick*0.2,d)*0.75 + smoothstep(0.012,0.0, abs(d-thick))*1.7;
warp_28=`    ret = col;
warp_29=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
