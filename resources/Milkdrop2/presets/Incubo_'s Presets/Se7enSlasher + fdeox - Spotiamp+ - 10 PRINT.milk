MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=2
[preset00]
fRating=5.000
fGammaAdj=1.460
fDecay=0.935
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.007
fVideoEchoAlpha=0.500
nVideoEchoOrientation=2
nWaveMode=15
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=1
bDarken=1
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=0.625
fWaveSmoothing=0.900
fWaveParam=0.000
fModWaveAlphaStart=0.880
fModWaveAlphaEnd=1.980
fWarpAnimSpeed=0.010
fWarpScale=0.010
fZoomExponent=1.00000
fShader=1.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.500
wave_y=0.500
ob_size=0.500
ob_r=0.010
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.260
ib_r=0.235
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=64.000
nMotionVectorsY=48.000
mv_dx=0.000
mv_dy=0.000
mv_l=1.000
mv_r=1.060
mv_g=1.000
mv_b=0.819
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float hash21(float2 p)
warp_7=`{
warp_8=`    p = frac(p * float2(123.34, 456.21));
warp_9=`    p += dot(p, p + 45.32);
warp_10=`    return frac(p.x * p.y);
warp_11=`}
warp_12=`
warp_13=`float3 hsv(float h, float s, float v)
warp_14=`{
warp_15=`    float4 k = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
warp_16=`    float3 p = abs(frac(h + k.xyz) * 6.0 - k.www);
warp_17=`    return v * lerp(k.xxx, saturate(p - k.xxx), s);
warp_18=`}
warp_19=`
warp_20=`shader_body
warp_21=`{
warp_22=`    uv.y = 1.0 - uv.y;
warp_23=`    float2 sc = uv;
warp_24=`    float2 my_uv = (uv - 0.5) * aspect.xy * 2;
warp_25=`
warp_26=`    float2 p = my_uv * (10.0 + mid_att * 4.0) + float2(0.0, time * 0.8);
warp_27=`    float2 id = floor(p);
warp_28=`    float2 f = frac(p);
warp_29=`
warp_30=`    float d = hash21(id) > 0.5 ? abs(f.x - f.y) : abs(f.x + f.y - 1.0);
warp_31=`
warp_32=`    float3 bg = float3(0.21, 0.16, 0.62);
warp_33=`    float3 col = lerp(bg, float3(0.49, 0.44, 0.95), smoothstep(0.12, 0.05, d * 0.707)) * (0.6 + vol_att * 0.6);
warp_34=`
warp_35=`    // C64 loading screen border flash
warp_36=`    if (abs(my_uv.x) > 0.44 * aspect.x || abs(my_uv.y) > 0.44)
warp_37=`    {
warp_38=`        col = lerp(float3(0.49, 0.44, 0.95), hsv(frac(floor(sc.y * 40.0 + time * 25.0) * 0.37), 0.8, 0.9), step(1.1, bass_att));
warp_39=`    }
warp_40=`
warp_41=`    ret = col;
warp_42=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
