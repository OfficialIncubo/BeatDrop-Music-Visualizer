warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float3 hsv(float h, float s, float v) {
warp_7=`    float3 rgb = clamp(abs(fmod(h*6+float3(0,4,2),6)-3)-1,0,1);
warp_8=`    return v * lerp(float3(1,1,1), rgb, s);
warp_9=`}
warp_10=`float hash(float2 p){ return frac(sin(dot(p,float2(41.3,289.1)))*43758.5); }
warp_11=`float noise(float2 p){
warp_12=`    float2 i=floor(p), f=frac(p); f=f*f*(3-2*f);
warp_13=`    return lerp(lerp(hash(i),hash(i+float2(1,0)),f.x),
warp_14=`                lerp(hash(i+float2(0,1)),hash(i+float2(1,1)),f.x), f.y);
warp_15=`}
warp_16=`float fbm(float2 p){ float v=0, a=.5; for(int k=0;k<4;k++){ v+=a*noise(p); p*=2; a*=.5; } return v; }
warp_17=`float3 pal(float x, float3 a, float3 b, float3 c, float3 d){ return a + b * cos(M_PI_2 * (c * x + d)); }
warp_18=`
warp_19=`shader_body {
warp_20=`        uv.y=1-uv.y; // Y UV flipping, first
warp_21=`        float t = time*.25;
warp_22=`        uv -= .5;
warp_23=`        uv *= aspect.xy;
warp_24=`        float2 p = uv*(2.4+mid_att*1.2);
warp_25=`        float2 ip = floor(p);
warp_26=`        float d1 = 9, d2 = 9; float2 best = float2(0,0);
warp_27=`        for (int j=-1;j<=1;j++)
warp_28=`            for (int i=-1;i<=1;i++){
warp_29=`          float2 g = ip+float2(float(i),float(j));
warp_30=`          float2 o = .5+.45*sin(t*1.5+M_PI_2*float2(hash(g), hash(g+7.7)));
warp_31=`          float d = length(g+o-p);
warp_32=`          if (d<d1){ d2=d1; d1=d; best=g; } else if (d<d2) d2=d;
warp_33=`         }
warp_34=`        float edge = smoothstep(0,.09,d2-d1);
warp_35=`        float e = get_fft(hash(best));
warp_36=`        ret = pal(frac(hash(best)*.9+t*.03), float3(.45,.4,.5), float3(.4,.4,.4), float3(1,1,1), float3(0,.2,.45));
warp_37=`        ret *= (.12+e*1.5)*edge + (1-edge)*.9;
warp_38=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
