warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float hash(float2 p) {
warp_7=`    return frac(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);
warp_8=`}
warp_9=`
warp_10=`float noise(float2 p){
warp_11=`  float2 i=floor(p), f=frac(p); f=f*f*(3.0-2.0*f);
warp_12=`  return lerp(lerp(hash(i),hash(i+float2(1.0,0.0)),f.x),
warp_13=`             lerp(hash(i+float2(0.0,1.0)),hash(i+float2(1.0,1.0)),f.x), f.y);
warp_14=`}
warp_15=`
warp_16=`float fbm(float2 p)
warp_17=`{
warp_18=`    float v=0;
warp_19=`    float a=.5;
warp_20=`    for(int k=0;k<4;k++)
warp_21=`    {
warp_22=`        v+=a*noise(p); p*=2.0; a*=0.5;
warp_23=`    }
warp_24=`    return v;
warp_25=`}
warp_26=`
warp_27=`shader_body
warp_28=`{
warp_29=`    uv = (uv-.5)*2*aspect.xy;
warp_30=`    uv.y = -uv.y;
warp_31=`
warp_32=`    float3 col = 0;
warp_33=`    float t = time*.25;
warp_34=`    float glow = 0.0;
warp_35=`    for (int k=0;k<3;k++) {
warp_36=`    float fk = float(k);
warp_37=`    float seed = fk*7.3 + floor(t+(2.0+bass*4.0));   // re-strikes on beats
warp_38=`    float jag = (fbm(float2(uv.y*3.5 + seed, seed*0.7 + t*0.6)) - 0.5)*1.3
warp_39=`              + (fbm(float2(uv.y*11.0 + seed, t*1.4)) - 0.5)*0.45;
warp_40=`    float d = abs(uv.x - ((fk-1.0)*0.42 + jag*(0.5+mid)));
warp_41=`    float flicker = 0.45 + 0.55*hash(float2(seed, floor(t*14.0)));
warp_42=`    glow += (0.006+bass*0.012)/(d+0.006)*flicker;
warp_43=`    }
warp_44=`    col = float3(0.35,0.55,1.0)*glow*0.5;
warp_45=`    col += float3(1,1,1)*pow(glow*0.5, 2.2);
warp_46=`    col += float3(0.25,0.4,0.9)*treb*0.35*glow;
warp_47=`
warp_48=`    ret = col;
warp_49=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
