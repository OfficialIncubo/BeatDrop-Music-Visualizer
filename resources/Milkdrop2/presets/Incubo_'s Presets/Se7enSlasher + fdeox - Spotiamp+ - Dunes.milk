PSVERSION_COMP=2
[preset00]
fRating=5.000
fGammaAdj=1.460
fDecay=0.935
FFTAttack=1.000
FFTDecay=0.350
fVideoEchoZoom=1.007
fVideoEchoAlpha=0.500
nVideoEchoOrientation=2
nWaveMode=15
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=1
bDarken=1
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=0.625
fWaveSmoothing=0.900
fWaveParam=0.000
fModWaveAlphaStart=0.880
fModWaveAlphaEnd=1.980
fWarpAnimSpeed=0.010
fWarpScale=0.010
fZoomExponent=1.00000
fShader=1.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.500
wave_y=0.500
ob_size=0.500
ob_r=0.010
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.260
ib_r=0.235
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=64.000
nMotionVectorsY=48.000
mv_dx=0.000
mv_dy=0.000
mv_l=1.000
mv_r=1.060
mv_g=1.000
mv_b=0.819
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`shader_body
warp_7=`{
warp_8=`    uv.y = 1.0 - uv.y;
warp_9=`    float2 sc = uv;
warp_10=`
warp_11=`    // Standardized Spotiamp+ UV scaling
warp_12=`    float2 my_uv = uv - 0.5;
warp_13=`    my_uv.x /= aspect.y;
warp_14=`
warp_15=`    float aspect_ratio = aspect.x / aspect.y;
warp_16=`
warp_17=`    // Sky gradient & Sun position scaled by true screen aspect ratio
warp_18=`    float3 col = lerp(float3(1.0, 0.6, 0.3), float3(0.3, 0.2, 0.5), smoothstep(-0.1, 0.5, my_uv.y));
warp_19=`    col += float3(1.0, 0.8, 0.5) * exp(-length(my_uv - float2(-0.3 * aspect_ratio, 0.02)) * 5.0) * (0.6 + bass_att * 0.6);
warp_20=`
warp_21=`    // Heat shimmer distortion
warp_22=`    float2 q = my_uv + float2(0.0, sin(my_uv.x * 40.0 + time * 6.0) * 0.006 * treb_att);
warp_23=`
warp_24=`    // Dune ridges
warp_25=`    for (int k = 0; k < 4; k++)
warp_26=`    {
warp_27=`        float fk = float(k);
warp_28=`        float ph = q.x * (2.0 + fk) + fk * 1.7 + time * (0.2 + fk * 0.1);
warp_29=`        float fft_val = get_fft(abs(sin(sc.x * 0.5 + fk * 0.2)));
warp_30=`        float h = -0.05 - fk * 0.12 + 0.06 * sin(ph) + 0.03 * sin(q.x * (5.0 + fk * 2.0) - fk) + fft_val * 0.02;
warp_31=`        
warp_32=`        float3 sand = lerp(float3(0.45, 0.22, 0.12), float3(0.95, 0.6, 0.35), 0.5 + 0.5 * cos(ph));
warp_33=`        sand = lerp(sand, col, (1.0 - fk / 3.0) * 0.35);
warp_34=`        if (q.y < h) col = sand;
warp_35=`    }
warp_36=`
warp_37=`    ret = col;
warp_38=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
