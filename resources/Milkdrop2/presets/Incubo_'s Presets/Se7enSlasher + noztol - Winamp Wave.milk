###################################################################################################

MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=2
PSVERSION_COMP=4
[preset00]
fRating=5.000
fGammaAdj=1.000
fDecay=0.980
FFTAttack=0.350
FFTDecay=0.650
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=0.000
fWaveSmoothing=0.000
fWaveParam=0.000
fModWaveAlphaStart=0.000
fModWaveAlphaEnd=0.000
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.00000
fShader=0.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=12.000
nMotionVectorsY=9.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`shader_body {
warp_2=`  // Black out warp layer since the visuals are fully raymarched in comp
warp_3=`  ret = float4(0.0, 0.0, 0.0, 1.0);
warp_4=`}
comp_1=`shader_body {
comp_2=`    // Map coordinates natively equivalent to GLSL's u_resolution adaptation
comp_3=`    float2 my_uv = uv * 2.0 - 1.0;
comp_4=`    float3 rayDir = normalize(float3(my_uv.x, my_uv.y * (aspect.y / aspect.x), -1.0));
comp_5=`    float rayDistance = 0.0;
comp_6=`    float3 accumulatedColor = float3(0.0, 0.0, 0.0);
comp_7=`
comp_8=`    // Pre-fetch 4 distinct audio frequencies: Bass, Low-Mid, High-Mid, Treble
comp_9=`    float4 audioBands = float4(
comp_10=`        get_fft(0.05),
comp_11=`        get_fft(0.25),
comp_12=`        get_fft(0.50),
comp_13=`        get_fft(0.75)
comp_14=`    );
comp_15=`
comp_16=`    // Cool Spectrum Palette (Electric Purple, Deep Blue, Teal, Vibrant Green)
comp_17=`    float3 colorBass    = float3(0.4, 0.0, 0.9); 
comp_18=`    float3 colorLowMid  = float3(0.0, 0.2, 1.0); 
comp_19=`    float3 colorHighMid = float3(0.0, 0.8, 0.6); 
comp_20=`    float3 colorTreble  = float3(0.0, 0.9, 0.2); 
comp_21=`
comp_22=`    for(int i = 0; i < 100; i++) {
comp_23=`        float3 rayPos = rayDir * rayDistance;
comp_24=`        
comp_25=`        // Map space into 4 distinct "strand" zones using a spatial sine wave
comp_26=`        float spatialPhase = rayPos.x * 1.5 + rayPos.z * 1.0;
comp_27=`        
comp_28=`        // Offset the phase by Pi/2 for each band to separate them in space
comp_29=`        float4 phases = spatialPhase + float4(0.0, 1.5708, 3.1415, 4.7123); 
comp_30=`        
comp_31=`        // Use a high power to sharpen the bands and create gaps between them
comp_32=`        float4 rawWeights = pow(max(sin(phases), 0.0), 6.0);
comp_33=`        float strandPresence = max(max(rawWeights.x, rawWeights.y), max(rawWeights.z, rawWeights.w));
comp_34=`        
comp_35=`        // Normalize the weights to blend colors and audio data
comp_36=`        float4 strandWeights = rawWeights / (dot(rawWeights, float4(1.0, 1.0, 1.0, 1.0)) + 0.0001);
comp_37=`        
comp_38=`        // The specific audio frequency and color driving this exact point in space
comp_39=`        float localAudioFreq = dot(strandWeights, audioBands);
comp_40=`        float3 localColor = strandWeights.x * colorBass + 
comp_41=`                            strandWeights.y * colorLowMid + 
comp_42=`                            strandWeights.z * colorHighMid + 
comp_43=`                            strandWeights.w * colorTreble;
comp_44=`
comp_45=`        // Apply fractal geometry deformation
comp_46=`        float scale = 0.1;
comp_47=`        for (int j = 0; j < 4; j++) {
comp_48=`            float waveAmplitude = 0.002 + (0.045 * localAudioFreq);
comp_49=`            float displacement = dot(sin(rayPos * scale * 16.0), float3(waveAmplitude, waveAmplitude, waveAmplitude)) / scale;
comp_50=`            rayPos -= displacement;
comp_51=`
comp_52=`            float angle = 0.3 * time;
comp_53=`            float c = cos(angle);
comp_54=`            float s = sin(angle);
comp_55=`            
comp_56=`            // 2D Rotation unroll (Equivalent to rayPos.xz *= mat2(cos, -sin, sin, cos))
comp_57=`            float2 tempXZ = rayPos.xz;
comp_58=`            rayPos.x = tempXZ.x * c - tempXZ.y * s;
comp_59=`            rayPos.z = tempXZ.x * s + tempXZ.y * c;
comp_60=`            
comp_61=`            scale *= 2.0;
comp_62=`        }
comp_63=`
comp_64=`        // Distance to the undulating "surface"
comp_65=`        float distanceToSurface = 0.01 + abs(rayPos.y);
comp_66=`        float glowIntensity = 0.001 / (distanceToSurface * distanceToSurface + 0.0015);
comp_67=`        glowIntensity *= strandPresence;
comp_68=`
comp_69=`        // Depth Fade: Darken waves that are further away to create contrast 
comp_70=`        float depthFade = exp(-rayDistance * 0.2);
comp_71=`
comp_72=`        // Accumulate light
comp_73=`        accumulatedColor += localColor * glowIntensity * depthFade;
comp_74=`
comp_75=`        // Advance the ray
comp_76=`        rayDistance += distanceToSurface;
comp_77=`    }
comp_78=`    
comp_79=`    // Output mapping
comp_80=`    ret = 1.0 - exp(-accumulatedColor * 0.08);
comp_81=`}
