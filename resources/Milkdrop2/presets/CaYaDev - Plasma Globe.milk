mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
wavecode_0_enabled=1
wavecode_0_samples=90
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=1
wavecode_0_scaling=1
wavecode_0_smoothing=0
wavecode_0_r=1
wavecode_0_g=1
wavecode_0_b=1
wavecode_0_a=1
wave_0_per_frame1=t1 = q5;
wave_0_per_frame2=t2 = q9;
wave_0_per_frame3=a = (0.55 + 0.45*1*q10)*min(1, q30);
wave_0_per_point1=st = (sample > 0.001);
wave_0_per_point2=off = off*0.9*st + ((rand(1001)*0.001) - 0.5)*0.006*(1 + q11);
wave_0_per_point3=s = sample;
wave_0_per_point4=env = sin(3.14159*s);
wave_0_per_point5=rr = 0.025 + (0.21 - 0.03)*s;
wave_0_per_point6=an = t1 + 1.4*sin(s*3 + t2*2 + 0)*s*(1 - s);
wave_0_per_point7=bx = rr*cos(an) - (off + value1*0.008)*sin(an)*env;
wave_0_per_point8=by = rr*sin(an) + (off + value1*0.008)*cos(an)*env;
wave_0_per_point9=x = 0.5 + bx;
wave_0_per_point10=y = 0.5 - by;
wave_0_per_point11=r = 0.85 + 0.15*s;
wave_0_per_point12=g = 0.45 + 0.4*(1 - s);
wave_0_per_point13=b = 1;
wavecode_1_enabled=1
wavecode_1_samples=90
wavecode_1_sep=0
wavecode_1_bSpectrum=0
wavecode_1_bUseDots=0
wavecode_1_bDrawThick=1
wavecode_1_bAdditive=1
wavecode_1_scaling=1
wavecode_1_smoothing=0
wavecode_1_r=1
wavecode_1_g=1
wavecode_1_b=1
wavecode_1_a=1
wave_1_per_frame1=t1 = q6;
wave_1_per_frame2=t2 = q9;
wave_1_per_frame3=a = (0.55 + 0.45*0*q10)*min(1, q30);
wave_1_per_point1=st = (sample > 0.001);
wave_1_per_point2=off = off*0.9*st + ((rand(1001)*0.001) - 0.5)*0.006*(1 + q11);
wave_1_per_point3=s = sample;
wave_1_per_point4=env = sin(3.14159*s);
wave_1_per_point5=rr = 0.025 + (0.21 - 0.03)*s;
wave_1_per_point6=an = t1 + 1.4*sin(s*3 + t2*2 + 1)*s*(1 - s);
wave_1_per_point7=bx = rr*cos(an) - (off + value1*0.008)*sin(an)*env;
wave_1_per_point8=by = rr*sin(an) + (off + value1*0.008)*cos(an)*env;
wave_1_per_point9=x = 0.5 + bx;
wave_1_per_point10=y = 0.5 - by;
wave_1_per_point11=r = 0.85 + 0.15*s;
wave_1_per_point12=g = 0.45 + 0.4*(1 - s);
wave_1_per_point13=b = 1;
wavecode_2_enabled=1
wavecode_2_samples=90
wavecode_2_sep=0
wavecode_2_bSpectrum=0
wavecode_2_bUseDots=0
wavecode_2_bDrawThick=1
wavecode_2_bAdditive=1
wavecode_2_scaling=1
wavecode_2_smoothing=0
wavecode_2_r=1
wavecode_2_g=1
wavecode_2_b=1
wavecode_2_a=1
wave_2_per_frame1=t1 = q7;
wave_2_per_frame2=t2 = q9;
wave_2_per_frame3=a = (0.55 + 0.45*0*q10)*min(1, q30);
wave_2_per_point1=st = (sample > 0.001);
wave_2_per_point2=off = off*0.9*st + ((rand(1001)*0.001) - 0.5)*0.006*(1 + q11);
wave_2_per_point3=s = sample;
wave_2_per_point4=env = sin(3.14159*s);
wave_2_per_point5=rr = 0.025 + (0.21 - 0.03)*s;
wave_2_per_point6=an = t1 + 1.4*sin(s*3 + t2*2 + 2)*s*(1 - s);
wave_2_per_point7=bx = rr*cos(an) - (off + value1*0.008)*sin(an)*env;
wave_2_per_point8=by = rr*sin(an) + (off + value1*0.008)*cos(an)*env;
wave_2_per_point9=x = 0.5 + bx;
wave_2_per_point10=y = 0.5 - by;
wave_2_per_point11=r = 0.85 + 0.15*s;
wave_2_per_point12=g = 0.45 + 0.4*(1 - s);
wave_2_per_point13=b = 1;
wavecode_3_enabled=1
wavecode_3_samples=90
wavecode_3_sep=0
wavecode_3_bSpectrum=0
wavecode_3_bUseDots=0
wavecode_3_bDrawThick=1
wavecode_3_bAdditive=1
wavecode_3_scaling=1
wavecode_3_smoothing=0
wavecode_3_r=1
wavecode_3_g=1
wavecode_3_b=1
wavecode_3_a=1
wave_3_per_frame1=t1 = q8;
wave_3_per_frame2=t2 = q9;
wave_3_per_frame3=a = (0.55 + 0.45*0*q10)*min(1, q30);
wave_3_per_point1=st = (sample > 0.001);
wave_3_per_point2=off = off*0.9*st + ((rand(1001)*0.001) - 0.5)*0.006*(1 + q11);
wave_3_per_point3=s = sample;
wave_3_per_point4=env = sin(3.14159*s);
wave_3_per_point5=rr = 0.025 + (0.21 - 0.03)*s;
wave_3_per_point6=an = t1 + 1.4*sin(s*3 + t2*2 + 3)*s*(1 - s);
wave_3_per_point7=bx = rr*cos(an) - (off + value1*0.008)*sin(an)*env;
wave_3_per_point8=by = rr*sin(an) + (off + value1*0.008)*cos(an)*env;
wave_3_per_point9=x = 0.5 + bx;
wave_3_per_point10=y = 0.5 - by;
wave_3_per_point11=r = 0.85 + 0.15*s;
wave_3_per_point12=g = 0.45 + 0.4*(1 - s);
wave_3_per_point13=b = 1;
per_frame_init_1=last = 0;
per_frame_init_2=touch = 0;
per_frame_init_3=tx = 0;
per_frame_init_4=wan = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.3)*((time - last) > 0.4);
per_frame_5=last = if(beat, time, last);
per_frame_6=touch = max(touch*pow(0.82, q30), beat);
per_frame_7=tx = if(beat, rand(628)*0.01, tx);
per_frame_8=wan = wan + (0.2 + 0.5*mid_att)/fps;
per_frame_9=q9 = wan;
per_frame_10=q10 = touch;
per_frame_11=q11 = min(treb_att, 2);
per_frame_12=q12 = min(bass_att, 2);
per_frame_13=q13 = tx;
per_frame_14=q5 = if(touch > 0.05, tx, wan*0.60 + 0.0);
per_frame_15=q6 = if(0, tx, wan*0.87 + 1.7);
per_frame_16=q7 = if(0, tx, wan*1.14 + 3.4);
per_frame_17=q8 = if(0, tx, wan*1.41 + 5.1);
warp_1=`shader_body
warp_2=`{
warp_3=`  ret = max(tex2D(sampler_main, uv).xyz * pow(0.55, q30) - 0.002 * max(q30, 1.0), 0.0);
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float2 p = (uv - 0.5) * aspect_sd.xy;
comp_4=`  float r = length(p);
comp_5=`  float px = 1.0 / texsize.x;
comp_6=`  float3 m = tex2D(sampler_main, uv).xyz;
comp_7=`  float3 b1 = GetBlur1(uv);
comp_8=`  float3 b2 = GetBlur2(uv);
comp_9=`  float3 b3 = GetBlur3(uv);
comp_10=`  float glowAll = lum(b3) * 3.0;
comp_11=`  float3 col = lerp(float3(0.01, 0.005, 0.02), float3(0.03, 0.01, 0.05), 1.0 - uv.y) + b3 * float3(0.4, 0.2, 0.7) * 0.6;
comp_12=`  float glass = 1.0 - smoothstep(0.21 - px, 0.21 + px, r);
comp_13=`  float3 inner = float3(0.02, 0.01, 0.05) + b2 * float3(0.5, 0.25, 0.9) * (0.6 + 0.3 * q12);
comp_14=`  float rim = smoothstep(0.21 * 0.82, 0.21, r) * glass;
comp_15=`  inner += float3(0.5, 0.35, 0.9) * rim * (0.08 + glowAll * 0.4);
comp_16=`  float2 hl = p - float2(-0.07, -0.08);
comp_17=`  inner += float3(1.0, 1.0, 1.0) * exp(-dot(hl, hl) * 900.0) * 0.18;
comp_18=`  float arc = saturate(-(p.x + p.y) / (0.21 * 1.2));
comp_19=`  inner += float3(1.0, 1.0, 1.0) * exp(-pow((r - 0.21 * 0.93) * 120.0, 2.0)) * arc * arc * 0.1;
comp_20=`  col = lerp(col, inner, glass);
comp_21=`  float core = exp(-r * r * 4000.0);
comp_22=`  col += float3(1.0, 0.8, 1.0) * core * (0.7 + 0.5 * q12) + float3(0.6, 0.3, 1.0) * exp(-r * 60.0) * 0.25;
comp_23=`  float2 bp = p - float2(0.0, 0.21 + 0.055);
comp_24=`  float base = step(abs(bp.x), 0.07 - bp.y * 0.4) * step(abs(bp.y), 0.05);
comp_25=`  col = lerp(col, float3(0.05, 0.05, 0.06) + glowAll * float3(0.06, 0.04, 0.1), base * (1.0 - glass));
comp_26=`  col += m * float3(0.95, 0.85, 1.0) * 1.3 + b1 * float3(0.7, 0.4, 1.0) * 1.0;
comp_27=`  float2 tp = p - 0.21 * float2(cos(q13), sin(q13));
comp_28=`  col += float3(1.0, 0.85, 1.0) * exp(-dot(tp, tp) * 6000.0) * q10 * 1.5;
comp_29=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.6;
comp_30=`  ret = 1.0 - exp(-col * 1.5);
comp_31=`}
