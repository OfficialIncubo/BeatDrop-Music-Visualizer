MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
per_frame_init_1=sway = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=sway = sway + (0.6 + 0.9*mid_att)/fps;
per_frame_5=dy = 0.035/fps;
per_frame_6=q1 = sway;
per_frame_7=q2 = time*0.045;
per_frame_8=q3 = 0.45 + 0.65*bass_att;
per_frame_9=q4 = treb_att;
per_frame_10=q5 = 0.6 + 0.4*sin(time*0.043);
warp_1=`shader_body
warp_2=`{
warp_3=`  float x = uv.x;
warp_4=`  float n1 = tex2D(sampler_noise_hq, float2(x * 0.7 + q2 * 0.3, 0.31)).x;
warp_5=`  float base = 0.55 + 0.05 * sin(x * 4.0 + q1) + 0.035 * sin(x * 9.0 - q1 * 1.4) + (n1 - 0.5) * 0.14 + 0.012 * sin(x * 26.0 - q1 * 3.0);
warp_6=`  float h = base - uv.y;
warp_7=`  float ray = tex2D(sampler_noise_hq, float2(x * 7.0 + q2, 0.73)).x;
warp_8=`  float ray2 = tex2D(sampler_noise_hq, float2(x * 19.0 - q2 * 2.0, 0.11)).x;
warp_9=`  ray = pow(ray, 3.0) * 1.6 + pow(ray2, 4.0) * 0.8;
warp_10=`  float upper = exp(-max(h, 0.0) * 9.0) * (0.2 + ray);
warp_11=`  float hem = exp(min(h, 0.0) * 90.0);
warp_12=`  float curtain = upper * hem;
warp_13=`  float3 green = float3(0.15, 1.0, 0.55);
warp_14=`  float3 violet = float3(0.75, 0.25, 1.0);
warp_15=`  float3 col = lerp(green, violet, saturate(h * 4.0 * q5));
warp_16=`  col = lerp(col, float3(1.0, 0.35, 0.5), saturate(n1 * 2.0 - 1.2));
warp_17=`  float sky = step(uv.y, 0.66);
warp_18=`  ret = tex2D(sampler_main, uv).xyz * pow(0.955, q30);
warp_19=`  ret += col * curtain * 0.032 * q3 * sky * q30;
warp_20=`}
comp_1=`sampler sampler_pw_noise_lq;
comp_2=`shader_body
comp_3=`{
comp_4=`  float hor = 0.68;
comp_5=`  float below = step(hor, uv.y);
comp_6=`  float d = uv.y - hor;
comp_7=`  float rn = tex2D(sampler_noise_hq, float2(uv.x * 2.0 + time * 0.02, uv.y * 14.0 - time * 0.15)).x - 0.5;
comp_8=`  float rip = rn * 0.012 + sin(uv.y * 90.0 - time * 1.3) * 0.0012;
comp_9=`  float2 u = lerp(uv, float2(uv.x + rip * saturate(d * 12.0), hor - d * 1.25), below);
comp_10=`  float m1 = tex2D(sampler_noise_hq, float2(u.x * 1.3, 0.2)).x;
comp_11=`  float m2 = tex2D(sampler_noise_hq, float2(u.x * 4.7, 0.6)).x;
comp_12=`  float ridge = hor - 0.02 - 0.075 * m1 - 0.012 * m2;
comp_13=`  float land = saturate((u.y - ridge) * 400.0);
comp_14=`  float3 a = tex2D(sampler_main, u).xyz;
comp_15=`  float3 glow = GetBlur2(u) * 0.5 + GetBlur3(u) * 0.45;
comp_16=`  float3 skycol = lerp(float3(0.01, 0.015, 0.05), float3(0.03, 0.06, 0.1), saturate((u.y - 0.2) * 2.0));
comp_17=`  float2 sp = u * texsize.xy / 512.0;
comp_18=`  float4 st = tex2D(sampler_pw_noise_lq, sp);
comp_19=`  float tw = 0.55 + 0.45 * sin(time * (1.3 + st.z * 4.0) + st.w * 30.0);
comp_20=`  float star = saturate((st.x * st.y - 0.975) * 45.0) * tw * (0.6 + 0.5 * q4);
comp_21=`  float3 s = skycol + a * 1.1 + glow + star * float3(0.85, 0.9, 1.0) * (1.0 - saturate(lum(a) * 3.0));
comp_22=`  float3 landcol = float3(0.006, 0.01, 0.02) + glow * 0.05;
comp_23=`  s = lerp(s, landcol, land);
comp_24=`  float fade = lerp(1.0, 0.55 * (1.0 - saturate(d * 2.2)), below);
comp_25=`  ret = s * fade;
comp_26=`  ret += float3(0.05, 0.12, 0.1) * exp(-abs(d) * 120.0) * (0.5 + 0.5 * lum(GetBlur3(float2(uv.x, 0.5))) * 4.0);
comp_27=`  ret = 1.0 - exp(-ret * 1.6);
comp_28=`}
