per_frame_1=warp = 0; 
per_frame_2=wave_r = 0.5 + 0.5*sin(time*6.5);
per_frame_3=wave_g = 0.5 + 0.5*sin(time*6.5 + 2.094);
per_frame_4=wave_b = 0.5 + 0.5*sin(time*6.5 + 4.188);
per_frame_5=
per_frame_6=// Filter rona (hue)
per_frame_7=q1 = 0.5 + 0.5*sin(time);
per_frame_8=q2 = 0.5 + 0.5*sin(time*5.3);
per_frame_9=q3 = 0.5 + 0.5*sin(time*5.7);
per_frame_10=
per_frame_11=// Efek pelangi spiral
per_frame_12=q4 = 1.0; // Membesarkan pada spiral
per_frame_13=q5 = 0.16; // Ukuran pada garisnya
per_frame_14=q6 = 0.5; // Kecepatan pada putaran spiral
per_pixel_1=rot=rot+0.015/(rad+0.03);
per_pixel_2=zoom=1.02;
comp_1=`shader_body
comp_2=`{
comp_3=`    //  =============== Layer 1 ===============
comp_4=`    float2 uv1 = uv;
comp_5=`    if(uv1.x >= 0.5) {uv1.x = 1-uv1.x;}
comp_6=`    if(uv1.y >= 0.5) {uv1.y = 1-uv1.y;}
comp_7=`    float3 col = tex2D(sampler_main, uv1).xyz;
comp_8=`    float gray = dot(col, float3(0.299, 0.587, 0.114));
comp_9=`    float3 layer1 = float3(gray, gray, gray) * 0.85;
comp_10=`
comp_11=`    //  =============== Layer 2  ===============
comp_12=`    float2 uvScaled = uv * 2.0;
comp_13=`    float2 m = float2( floor(frac(uvScaled.x * 0.5) * 2.0),
comp_14=`                       floor(frac(uvScaled.y * 0.5) * 2.0) );
comp_15=`    float2 uv2 = frac(uvScaled);
comp_16=`    uv2 = frac(uv2) * (1.0 - m) + m * frac(1.0 - uv2);
comp_17=`
comp_18=`    float3 layer2 = tex2D(sampler_main, uv2).xyz;
comp_19=`    layer2 *= float3(q1, q2, q3);
comp_20=`
comp_21=`    // Opacity - hitam/abu-abu transparan
comp_22=`    float lum2 = dot(layer2, float3(0.299, 0.587, 0.114));
comp_23=`    float opacity = smoothstep(0.0, 0.1, lum2);
comp_24=`
comp_25=`    //  =============== Layer 3 ===============
comp_26=`    float3 col3 = tex2D(sampler_main, uv).xyz;
comp_27=`    float gray3 = dot(col3, float3(0.299, 0.587, 0.114));
comp_28=`
comp_29=`    // EFEK PELANGI (RAINBOW)
comp_30=`    // Membuat warna pelangi berdasarkan posisi pixel + waktu
comp_31=`    float hue = frac(rad * q4 + ang * q5 + time * q6);
comp_32=`    
comp_33=`    // Konversi hue ke RGB (HSV → RGB sederhana)
comp_34=`    float3 rainbow;
comp_35=`    rainbow.r = abs(hue * 10.0 - 5.0) - 1.0;
comp_36=`    rainbow.g = 2.0 - abs(hue * 6.0 - 2.0);
comp_37=`    rainbow.b = 2.0 - abs(hue * 6.0 - 4.0);
comp_38=`    rainbow = saturate(rainbow);
comp_39=`    
comp_40=`    float3 layer3 = rainbow * gray3;
comp_41=`
comp_42=`    // EFEK HITAM/ABU-ABU MENJADI OPACITY
comp_43=`    // Semakin gelap → transparan, semakin terang → solid
comp_44=`    float grayOpacity = smoothstep(0.0, 0.5, gray3);
comp_45=`
comp_46=`    ret = layer1;
comp_47=`    ret = lerp(ret, layer2, opacity);
comp_48=`    ret = lerp(ret, layer3, grayOpacity);
comp_49=`
comp_50=`    ret *= 1.00; //gamma
comp_51=`}
