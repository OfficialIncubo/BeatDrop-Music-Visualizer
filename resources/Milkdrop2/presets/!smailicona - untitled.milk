b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
shapecode_0_enabled=1
shapecode_0_sides=5
shapecode_0_additive=0
shapecode_0_thickOutline=0
shapecode_0_textured=0
shapecode_0_num_inst=1
shapecode_0_x=0.500
shapecode_0_y=0.500
shapecode_0_rad=0.94761
shapecode_0_ang=0.00000
shapecode_0_tex_ang=0.00000
shapecode_0_tex_zoom=1.00000
shapecode_0_r=1.000
shapecode_0_g=0.000
shapecode_0_b=0.000
shapecode_0_a=1.000
shapecode_0_r2=0.000
shapecode_0_g2=0.000
shapecode_0_b2=0.000
shapecode_0_a2=0.000
shapecode_0_border_r=1.000
shapecode_0_border_g=1.000
shapecode_0_border_b=1.000
shapecode_0_border_a=0.300
shape_0_per_frame1=r = 2*q1;
shape_0_per_frame2=g = 2*q2;
shape_0_per_frame3=b = 2*q3;
shape_0_per_frame4=
shape_0_per_frame5=r2 = abs(cos(time/13.27))-q3;;
shape_0_per_frame6=g2 = 1-q4;
shape_0_per_frame7=b2 = abs(sin(time/13.14+240))-q1;
shape_0_per_frame8=
shape_0_per_frame9=temp  = temp+q4/3;
shape_0_per_frame10=ang = temp;
shape_0_per_frame11=
shape_0_per_frame12=
shape_0_per_frame13=border_r = r;
shape_0_per_frame14=border_g = g;
shape_0_per_frame15=border_b = b;
per_frame_1=q1 = bass*1.3;
per_frame_2=q2 = treb*1.3;
per_frame_3=q3 = mid*1.3;
per_frame_4=q4 = ((mid+treb+bass));
per_pixel_1=warp = (((1-abs(x-.5))+(1-abs(x-.5))))/12.5;
per_pixel_2=zoom = zoom+.0042
warp_1=`sampler sampler_rand00;
warp_2=`shader_body
warp_3=`{
warp_4=`    // sample previous frame
warp_5=`    
warp_6=`    // darken (decay) over time
warp_7=`//    ret *= 0.5; //or try: ret -= 0.004;
warp_8=`ret = tex2d(sampler_rand00,uv);//-ret;
warp_9=`//ret *= 0.795; //or try: ret -= 0.004;
warp_10=`
warp_11=`ret = tex2d(sampler_rand00,uv_orig)-ret;
warp_12=`//ret *= .95; //or try: ret -= 0.004;
warp_13=`//ret = tex2D( sampler_main, uv ).xyz-ret;
warp_14=`//ret *= 0.95; //or try: ret -= 0.004;    
warp_15=`ret=GetBlur3 (uv)-ret;
warp_16=`}
comp_1=`sampler sampler_pw_noise_lq;
comp_2=`float z, h1;
comp_3=`float2 rs, uv1, uv2, uv3;
comp_4=`float3 noise, ret1, ret2, rets;
comp_5=`
comp_6=`shader_body {
comp_7=`uv1 = (uv-.5);//*aspect.xy;
comp_8=`
comp_9=`h1 = .2;
comp_10=`z = h1/abs(pow(uv1.y,1));
comp_11=`rs.x = uv1.x * z;
comp_12=`rs.y = z/2 + time*4;
comp_13=`noise = tex2D(sampler_noise_hq,rs);
comp_14=`noise *= (noise >= .0);
comp_15=`ret1 = noise-.6;
comp_16=`
comp_17=`uv2 = 1*uv1 * (1-abs(uv1.x)) ;
comp_18=`float mask = saturate(64*uv1.y);
comp_19=`uv3 =frac(uv2-.5-ret1*.05* mask);
comp_20=`
comp_21=`ret1 = tex2D (sampler_main, uv3) + tex2D (sampler_main, float2(1-uv3.x,uv3.y))+
comp_22=`.02/(.02+length(uv3.y-.52))*slow_roam_sin;
comp_23=`
comp_24=`float2 uv2 = 32*(mul(uv,float2x2(.7,.7,-.7,.7))+ret1*.1+time/64)*aspect.xy;
comp_25=`float3 smask = (tex2D (sampler_pw_noise_lq,uv2/256)).g-.9;
comp_26=`float stars = saturate(.25/length(abs(frac(uv2)-.5))*smask);
comp_27=`
comp_28=`ret = ret1* (1+0*lum(ret1)) 
comp_29=`+ (stars*stars +rand_preset*(.5-uv.y)*float3 (0,0,1))* (1-mask);    
comp_30=`}
