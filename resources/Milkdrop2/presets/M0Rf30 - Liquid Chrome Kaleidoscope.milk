wavecode_1_scaling=1.000000
wavecode_1_smoothing=0.700000
wavecode_1_r=1.000000
wavecode_1_g=1.000000
wavecode_1_b=1.000000
wavecode_1_a=1.000000
wave_1_per_frame1=t1 = q3;
wave_1_per_point1=d = (sample-0.5)*0.9;
wave_1_per_point2=h = 0.04 + value1*0.55;
wave_1_per_point3=ca = cos(-q3*0.5); sa = sin(-q3*0.5);
wave_1_per_point4=x = 0.5 + (d*ca - h*sa)*0.5625;
wave_1_per_point5=y = 0.5 + (d*sa + h*ca);
wave_1_per_point6=r = 0.7; g = 0.9; b = 1;
