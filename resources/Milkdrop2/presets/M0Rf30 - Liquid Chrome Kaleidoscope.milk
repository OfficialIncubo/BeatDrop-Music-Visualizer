shapecode_0_border_a=0
shape_0_per_frame1=ia = instance*1.0471976 + q3*0.9;
shape_0_per_frame2=dd = 0.17 + 0.09*sin(q3*1.3 + instance*2.1);
shape_0_per_frame3=x = 0.5 + dd*cos(ia)*0.5625;
shape_0_per_frame4=y = 0.5 + dd*sin(ia);
shape_0_per_frame5=rad = 0.035 + 0.05*q1 + 0.015*sin(q3*2+instance);
shape_0_per_frame6=r = 0.8 + 0.2*sin(q7*5 + instance); g = 0.9; b = 1;
