wave_0_per_frame1=t1 = q3;
wave_0_per_point1=an = sample*6.2831853;
wave_0_per_point2=rd = 0.23 + 0.12*value1 + 0.04*sin(an*3 + q3*3);
wave_0_per_point3=x = 0.5 + rd*cos(an + q3*0.7)*0.5625;
wave_0_per_point4=y = 0.5 + rd*sin(an + q3*0.7);
wave_0_per_point5=r = 0.8 + 0.2*sin(an+q7*6); g = 0.85; b = 1;
wave_0_per_point6=a = 0.22 + 0.3*q1;
wavecode_1_enabled=1
