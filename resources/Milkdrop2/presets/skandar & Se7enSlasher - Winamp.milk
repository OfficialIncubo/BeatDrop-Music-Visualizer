###################################################################################################

MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=2
PSVERSION_COMP=4
[preset00]
fRating=5.000
fGammaAdj=1.000
fDecay=0.985
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=0.000
fWaveSmoothing=0.900
fWaveParam=0.000
fModWaveAlphaStart=0.000
fModWaveAlphaEnd=1.000
fWarpAnimSpeed=0.000
fWarpScale=0.000
fZoomExponent=1.00000
fShader=1.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=1.000
wave_g=0.250
wave_b=0.050
wave_x=0.500
wave_y=0.500
ob_size=0.000
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.000
ib_r=0.000
ib_g=0.000
ib_b=0.000
ib_a=0.000
nMotionVectorsX=12.000
nMotionVectorsY=9.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_1=temp=0.72*temp+0.98*bass_att;
per_frame_2=q1=temp;
per_frame_3=q2=0.25+0.10*sin(time*0.11);
per_frame_4=q3=0.25+0.02*sin(time*0.07);
per_frame_5=q4=0.13;
per_frame_6=q5=0.80;
per_frame_7=q6=0.50;
per_frame_8=q7=0.95;
per_frame_9=q8=0.15;
per_frame_10=wave_a=0;
warp_1=`shader_body
warp_2=`{
warp_3=`    ret = tex2D(sampler_main,uv).xyz;
warp_4=`    ret *= 0.985;
warp_5=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float2 p = (uv - 0.5) * aspect.xy;
comp_4=`    float r = length(p);
comp_5=`    float2 safeP = p / max(r, 0.00001);
comp_6=`
comp_7=`    float pulse = q1 * 0.08;
comp_8=`    float3 L = normalize(float3(0.0, -1.0, 1.5 - q7));
comp_9=`    float3 bg = float3(0.015, 0.015, 0.015);
comp_10=`    ret = bg;
comp_11=`    float scale = 0.90;
comp_12=`
comp_13=`    // Outer Frame
comp_14=`    float frameOuter = 1.0 - smoothstep(0.47 * scale, 0.48 * scale, r);
comp_15=`    float frameInner = smoothstep(0.39 * scale, 0.40 * scale, r);
comp_16=`    float frameMask = frameOuter * frameInner;
comp_17=`    float3 frameN = normalize(float3(p, 0.20));
comp_18=`    float frameShade = 0.5 + 0.5 * dot(frameN, L);
comp_19=`    float frameY = saturate((p.y / (0.48 * scale)) * 0.5 + 0.5);
comp_20=`    float3 frameGrad = lerp(float3(0.18, 0.18, 0.19), float3(0.04, 0.04, 0.045), frameY);
comp_21=`    float3 frameCol = frameGrad + frameShade * 0.025;
comp_22=`
comp_23=`    // 8 Symmetrical Mounting Holes
comp_24=`    float angle = atan2(p.y, p.x);
comp_25=`    float sector = 6.28318530 / 8.0;
comp_26=`    float holeIndex = floor((angle + sector * 0.5) / sector);
comp_27=`    float holeAngle = holeIndex * sector;
comp_28=`    float holeRadius = 0.435 * scale;
comp_29=`    float2 holeCenter = float2(cos(holeAngle), sin(holeAngle)) * holeRadius;
comp_30=`    float holeDist = length(p - holeCenter);
comp_31=`    float holeSize = 0.012 * scale;
comp_32=`    float holeBezel = 0.018 * scale;
comp_33=`    float holeMask = 1.0 - smoothstep(holeSize - 0.002 * scale, holeSize, holeDist);
comp_34=`    float bezelMask = (1.0 - smoothstep(holeBezel - 0.002 * scale, holeBezel, holeDist)) * (1.0 - holeMask);
comp_35=`    float3 darkRimCol = float3(0.010, 0.010, 0.012);
comp_36=`    float3 darkCenterCol = float3(0.015, 0.015, 0.018) + frameShade * 0.01;
comp_37=`    frameCol = lerp(frameCol, darkRimCol, bezelMask);
comp_38=`    frameCol = lerp(frameCol, darkCenterCol, holeMask);
comp_39=`    ret = lerp(ret, frameCol, frameMask);
comp_40=`
comp_41=`    // Surround Ring
comp_42=`    float surrCenter = (0.36 + pulse * 0.03) * scale;
comp_43=`    float surrWidth = 0.045 * scale;
comp_44=`    float surrDist = abs(r - surrCenter);
comp_45=`    float surrMask = 1.0 - smoothstep(surrWidth - 0.005 * scale, surrWidth, surrDist);
comp_46=`    float surrNX = (r - surrCenter) / max(surrWidth, 0.00001);
comp_47=`    float surrNZ = sqrt(max(0.0, 1.0 - surrNX * surrNX));
comp_48=`    float3 surrN = normalize(float3(safeP * surrNX, surrNZ));
comp_49=`    float surrDiff = pow(max(0.0, dot(surrN, L)), 1.05);
comp_50=`    float3 surrCol = float3(0.035, 0.037, 0.040) + surrDiff * 0.10 + pow(surrDiff, 7.0) * 0.53;
comp_51=`    ret = lerp(ret, surrCol, surrMask);
comp_52=`
comp_53=`    // Diaphragm Cone
comp_54=`    float excursion = q1 * 0.06;
comp_55=`    float r_cone = r * (1.0 - excursion);
comp_56=`    float coneInner = (0.12 - pulse * 0.02) * scale;
comp_57=`    float coneOuter = (0.32 + pulse * 0.06) * scale;
comp_58=`    float coneMask = (1.0 - smoothstep(coneOuter - 0.005 * scale, coneOuter, r)) * smoothstep(coneInner, coneInner + 0.01 * scale, r);
comp_59=`    float grooves = 0.5 + 0.5 * sin((r_cone * 400.0 / scale) - excursion * 15.0);
comp_60=`    float grooveLight = pow(max(0.0, dot(safeP, L.xy)), 1.15) * grooves;
comp_61=`    float coneDepth = saturate((r_cone - coneInner) / max(coneOuter - coneInner, 0.00001));
comp_62=`    float yPos = saturate((coneOuter - p.y) / max(2.0 * coneOuter, 0.00001));
comp_63=`    float3 cConeBlack = float3(0.035, 0.035, 0.04);
comp_64=`    float3 cConeAmber = float3(0.95, 0.45, 0.05);
comp_65=`    float3 coneBase = lerp(cConeBlack, cConeAmber, yPos);
comp_66=`    float bVal = saturate(q1);
comp_67=`    float hVal = time * 0.2 + r_cone * (12.0 + bVal * 10.0) + sin(r_cone * 30.0 - time * 6.0 + excursion * 12.0) * bVal * 4.0;
comp_68=`    float wavePattern = pow(0.5 + 0.5 * sin(hVal), 1.0 + bVal * 3.0);
comp_69=`    float3 cAmberWave = float3(1.0, 0.80, 0.35) * wavePattern * (0.4 + bVal * 0.8) * 0.20;
comp_70=`    coneBase += cAmberWave;
comp_71=`    coneBase *= 0.35 + coneDepth * 0.65;
comp_72=`    coneBase += grooveLight * 0.53 * 0.40;
comp_73=`    coneBase *= 0.75 + 0.25 * max(0.0, dot(safeP, L.xy));
comp_74=`    ret = lerp(ret, max(coneBase, bg), coneMask);
comp_75=`
comp_76=`    // Dust Cap Nose Base
comp_77=`    float capSize = (0.13 + pulse * 0.02) * scale;
comp_78=`    float capMask = 1.0 - smoothstep(capSize - 0.005 * scale, capSize, r);
comp_79=`    float2 capP = p / max(capSize, 0.00001);
comp_80=`    float capZ = sqrt(max(0.0, 1.0 - dot(capP, capP)));
comp_81=`    float3 capN = normalize(float3(capP, capZ));
comp_82=`    float capDiff = pow(max(0.0, dot(capN, L)), 1.05);
comp_83=`    float3 Rvec = reflect(-L, capN);
comp_84=`    float capSpec = pow(max(0.0, dot(Rvec, float3(0.0, 0.0, 1.0))), 24.0);
comp_85=`    float capY = saturate(capP.y * 0.5 + 0.5);
comp_86=`    float3 capGrad = lerp(float3(0.18, 0.18, 0.19), float3(0.04, 0.04, 0.045), capY);
comp_87=`    float3 capCol = capGrad + capDiff * 0.05 + capSpec * 0.53 * 0.40;
comp_88=`
comp_89=`    // Winamp Diamond Logo - two overlapping diamonds (drop-shadow style, like the real mark)
comp_90=`    float2 wp_base = capP * 1.5;
comp_91=`    float2 dP = float2(wp_base.x * 0.7071 - wp_base.y * 0.7071, wp_base.x * 0.7071 + wp_base.y * 0.7071);
comp_92=`    float dMax = max(abs(dP.x), abs(dP.y));
comp_93=`    float diamondA_fill = 1.0 - smoothstep(0.50, 0.53, dMax);
comp_94=`    float diamondA_interior = 1.0 - smoothstep(0.42, 0.45, dMax);
comp_95=`    float diamondA_border = diamondA_fill - diamondA_interior;
comp_96=`
comp_97=`    float2 wp_base2 = capP * 1.5;
comp_98=`    float2 dP2 = float2(wp_base2.x * 0.7071 - wp_base2.y * 0.7071, wp_base2.x * 0.7071 + wp_base2.y * 0.7071);
comp_99=`    float dMax2 = max(abs(dP2.x), abs(dP2.y));
comp_100=`    float diamondB_fill = 1.0 - smoothstep(0.50, 0.53, dMax2);
comp_101=`    float diamondB_interior = 1.0 - smoothstep(0.42, 0.45, dMax2);
comp_102=`    float diamondB_border = diamondB_fill - diamondB_interior;
comp_103=`    // Thinner Horizontally Flipped Vector Bolt SDF
comp_104=`    float2 bp = capP * 1.25;
comp_105=`    bp.x = -bp.x;
comp_106=`    // Vertices pinched along X to make the lightning bolt slender
comp_107=`    float2 v0 = float2( 0.42,  0.48);
comp_108=`    float2 v1 = float2( 0.18,  0.16);
comp_109=`    float2 v2 = float2( 0.28,  0.12);
comp_110=`    float2 v3 = float2( 0.28, -0.06);
comp_111=`    float2 v4 = float2(-0.42, -0.48);
comp_112=`    float2 v5 = float2(-0.18, -0.16);
comp_113=`    float2 v6 = float2(-0.28, -0.12);
comp_114=`    float2 v7 = float2(-0.28,  0.06);
comp_115=`    float hits = 0.0;
comp_116=`    hits += ((v0.y > bp.y) != (v1.y > bp.y)) && (bp.x < (v1.x - v0.x) * (bp.y - v0.y) / (v1.y - v0.y + 0.00001) + v0.x) ? 1.0 : 0.0;
comp_117=`    hits += ((v1.y > bp.y) != (v2.y > bp.y)) && (bp.x < (v2.x - v1.x) * (bp.y - v1.y) / (v2.y - v1.y + 0.00001) + v1.x) ? 1.0 : 0.0;
comp_118=`    hits += ((v2.y > bp.y) != (v3.y > bp.y)) && (bp.x < (v3.x - v2.x) * (bp.y - v2.y) / (v3.y - v2.y + 0.00001) + v2.x) ? 1.0 : 0.0;
comp_119=`    hits += ((v3.y > bp.y) != (v4.y > bp.y)) && (bp.x < (v4.x - v3.x) * (bp.y - v3.y) / (v4.y - v3.y + 0.00001) + v3.x) ? 1.0 : 0.0;
comp_120=`    hits += ((v4.y > bp.y) != (v5.y > bp.y)) && (bp.x < (v5.x - v4.x) * (bp.y - v4.y) / (v5.y - v4.y + 0.00001) + v4.x) ? 1.0 : 0.0;
comp_121=`    hits += ((v5.y > bp.y) != (v6.y > bp.y)) && (bp.x < (v6.x - v5.x) * (bp.y - v5.y) / (v6.y - v5.y + 0.00001) + v5.x) ? 1.0 : 0.0;
comp_122=`    hits += ((v6.y > bp.y) != (v7.y > bp.y)) && (bp.x < (v7.x - v6.x) * (bp.y - v6.y) / (v7.y - v6.y + 0.00001) + v6.x) ? 1.0 : 0.0;
comp_123=`    hits += ((v7.y > bp.y) != (v0.y > bp.y)) && (bp.x < (v0.x - v7.x) * (bp.y - v7.y) / (v0.y - v7.y + 0.00001) + v7.x) ? 1.0 : 0.0;
comp_124=`    float inBolt = fmod(hits, 2.0);
comp_125=`    // Edge Distance Field for Heavy Bolt Outline
comp_126=`    float d0 = length(bp - (v0 + clamp(dot(bp - v0, v1 - v0) / dot(v1 - v0, v1 - v0), 0.0, 1.0) * (v1 - v0)));
comp_127=`    float d1 = length(bp - (v1 + clamp(dot(bp - v1, v2 - v1) / dot(v2 - v1, v2 - v1), 0.0, 1.0) * (v2 - v1)));
comp_128=`    float d2 = length(bp - (v2 + clamp(dot(bp - v2, v3 - v2) / dot(v3 - v2, v3 - v2), 0.0, 1.0) * (v3 - v2)));
comp_129=`    float d3 = length(bp - (v3 + clamp(dot(bp - v3, v4 - v3) / dot(v4 - v3, v4 - v3), 0.0, 1.0) * (v4 - v3)));
comp_130=`    float d4 = length(bp - (v4 + clamp(dot(bp - v4, v5 - v4) / dot(v5 - v4, v5 - v4), 0.0, 1.0) * (v5 - v4)));
comp_131=`    float d5 = length(bp - (v5 + clamp(dot(bp - v5, v6 - v5) / dot(v6 - v5, v6 - v5), 0.0, 1.0) * (v6 - v5)));
comp_132=`    float d6 = length(bp - (v6 + clamp(dot(bp - v6, v7 - v6) / dot(v7 - v6, v7 - v6), 0.0, 1.0) * (v7 - v6)));
comp_133=`    float d7 = length(bp - (v7 + clamp(dot(bp - v7, v0 - v7) / dot(v0 - v7, v0 - v7), 0.0, 1.0) * (v0 - v7)));
comp_134=`    float minEdgeDist = min(min(min(d0, d1), min(d2, d3)), min(min(d4, d5), min(d6, d7)));
comp_135=`    float boltEdgeSmooth = smoothstep(0.0, 0.015, minEdgeDist);
comp_136=`    float boltCore = lerp(1.0 - boltEdgeSmooth, boltEdgeSmooth, inBolt);
comp_137=`    float boltOutline = smoothstep(0.065, 0.080, minEdgeDist);
comp_138=`    float boltOutlineMask = inBolt > 0.5 ? 1.0 : (1.0 - boltOutline);
comp_139=`    // Color Palette
comp_140=`    float goldGradient = saturate((wp_base.y - wp_base.x * 0.4 + 0.4) * 0.8);
comp_141=`    float3 goldLight = float3(1.00, 0.85, 0.25);
comp_142=`    float3 goldDark  = float3(0.85, 0.48, 0.05);
comp_143=`    float3 goldCol   = lerp(goldDark, goldLight, goldGradient);
comp_144=`    float3 whiteCol  = float3(0.95, 0.95, 0.95);
comp_145=`    float3 grayCol   = float3(0.80, 0.80, 0.80);
comp_146=`    float3 blackOutlineCol = float3(0.02, 0.02, 0.02);
comp_147=`
comp_148=`    // Let the dust cap's own diffuse light & specular shine play across the logo plaque too
comp_149=`    float logoShade = 0.65 + 0.55 * capDiff;
comp_150=`    float logoGlint = capSpec * 0.85;
comp_151=`    blackOutlineCol = saturate(blackOutlineCol * logoShade + logoGlint * 0.35);
comp_152=`    whiteCol = saturate(whiteCol * logoShade + logoGlint);
comp_153=`    grayCol = saturate(grayCol * logoShade + logoGlint * 0.80);
comp_154=`    goldCol = saturate(goldCol * logoShade + logoGlint);
comp_155=`
comp_156=`    // Composition Layering - back (shadow) diamond first, then front diamond, then bolt on top
comp_157=`    capCol = lerp(capCol, blackOutlineCol, diamondB_border * capMask);
comp_158=`    capCol = lerp(capCol, grayCol, diamondB_interior * capMask);
comp_159=`    capCol = lerp(capCol, blackOutlineCol, diamondA_border * capMask);
comp_160=`    capCol = lerp(capCol, whiteCol, diamondA_interior * capMask);
comp_161=`    capCol = lerp(capCol, blackOutlineCol, boltOutlineMask * capMask);
comp_162=`    capCol = lerp(capCol, goldCol, boltCore * capMask);
comp_163=`    ret = lerp(ret, capCol, capMask);
comp_164=`    // Final Occlusion & Silhouette
comp_165=`    float ao = (0.55 + 0.45 * smoothstep(0.0, 0.06 * scale, abs(r - coneOuter))) * (0.65 + 0.35 * smoothstep(0.0, 0.04 * scale, abs(r - capSize)));
comp_166=`    ret *= max(ao, 0.10 + 0.50 * 0.15);
comp_167=`    ret += 0.25 * 0.20;
comp_168=`    float silhouette = 1.0 - smoothstep(0.475 * scale, 0.48 * scale, r);
comp_169=`    ret = lerp(bg, ret, silhouette);
comp_170=`    ret += q1 * 0.003 * silhouette;
comp_171=`}
