MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
per_frame_init_1=dz = 0;
per_frame_init_2=cyc = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=dz = dz + (0.16 + 0.12*min(bass_att, 2))/fps;
per_frame_5=wrap = (dz > 8);
per_frame_6=cyc = cyc + wrap;
per_frame_7=dz = if(wrap, 0, dz);
per_frame_8=q1 = dz;
per_frame_9=q2 = cyc;
per_frame_10=q3 = time*0.02 + mid_att*0.03;
per_frame_11=q4 = min(bass_att, 2);
per_frame_12=q5 = min(treb_att, 2);
per_frame_13=q6 = time*0.03;
warp_1=`float3 mandel(float2 p, float zoomLog, float turn)
warp_2=`{
warp_3=`  float scale = 2.6 * exp(-zoomLog);
warp_4=`  float cs = cos(turn);
warp_5=`  float sn = sin(turn);
warp_6=`  float2 q = float2(p.x * cs - p.y * sn, p.x * sn + p.y * cs) * scale;
warp_7=`  float2 c = float2(-0.743643887, 0.131825904) + q;
warp_8=`  float2 z = float2(0.0, 0.0);
warp_9=`  float n = 0.0;
warp_10=`  float esc = 0.0;
warp_11=`  // no dynamic break: MilkDrop 2 renders this warp black when the loop has one (checked against
warp_12=`  // MilkDrop 2 itself); an escaped point keeps the value it escaped with, which the smooth colouring needs
warp_13=`  for (int i = 0; i < 56; i++) {
warp_14=`    float2 zn = float2(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + c;
warp_15=`    z = esc > 0.5 ? z : zn;
warp_16=`    esc = step(256.0, dot(z, z));
warp_17=`    n += 1.0 - esc;
warp_18=`  }
warp_19=`  float sm = n - log2(max(1.0001, log2(max(dot(z, z), 1.0001)))) + 4.0;
warp_20=`  float3 pal = 0.5 + 0.5 * cos(6.28318 * (float3(0.0, 0.15, 0.3) + sm * 0.035 + q3));
warp_21=`  pal = pow(pal, 1.4);
warp_22=`  return pal * esc * (0.25 + 0.75 * saturate(sm / 50.0)) + float3(0.01, 0.0, 0.02) * (1.0 - esc);
warp_23=`}
warp_24=`shader_body
warp_25=`{
warp_26=`  float2 p = (uv - 0.5) * aspect.xy;
warp_27=`  // fade out before single precision breaks up, then the next dive starts from the whole set
warp_28=`  float fade = saturate(q1 / 0.6) * saturate((8.0 - q1) / 0.8);
warp_29=`  float3 m = mandel(p, q1, q6 + q2 * 2.4) * fade;
warp_30=`  // a short trail for motion blur, the same per second at any frame rate
warp_31=`  ret = lerp(tex2D(sampler_main, uv).xyz, m, 1.0 - pow(0.35, q30));
warp_32=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float3 col = tex2D(sampler_main, uv).xyz;
comp_4=`  col += GetBlur1(uv) * (0.25 + 0.2 * q4);
comp_5=`  float edge = saturate(lum(col) - lum(GetBlur2(uv))) * (0.8 + 0.8 * q5);
comp_6=`  col += float3(1.0, 0.95, 0.9) * edge * 0.6;
comp_7=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.6;
comp_8=`  ret = 1.0 - exp(-col * 1.4);
comp_9=`}
