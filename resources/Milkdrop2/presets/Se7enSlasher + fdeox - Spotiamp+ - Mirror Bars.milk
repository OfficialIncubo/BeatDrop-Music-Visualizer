warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float specLog(float x){ return get_fft(pow(clamp(x,0.0,1.0), 1.8)); }
warp_7=`/*
warp_8=`float3 hsv(float h, float s, float v) {
warp_9=`    float3 rgb = clamp(abs(fmod(h*6+float3(0,4,2),6)-3)-1,0,1);
warp_10=`    return v * lerp(float3(1,1,1), rgb, s);
warp_11=`}
warp_12=`*/
warp_13=`
warp_14=`float3 pal(float x, float3 a, float3 b, float3 c, float3 d){ 
warp_15=`    return a + b * cos(M_PI_2 * (c * x + d));
warp_16=`}
warp_17=`
warp_18=`shader_body
warp_19=`{
warp_20=`    float3 col = 0;
warp_21=`    float t = time*.25;
warp_22=`    //Obligatory Y flipping
warp_23=`    uv.y = 1-uv.y;
warp_24=`    float2 sc = uv;
warp_25=`
warp_26=`    float n = 48.0;
warp_27=`    float bi = floor(sc.x*n);
warp_28=`    float fx = frac(sc.x*n);
warp_29=`    float v = specLog(abs((bi+0.5)/n - 0.5)*2.0);
warp_30=`    float y = sc.y - 0.42;
warp_31=`    float h = v*0.5;
warp_32=`    float bar = step(0.12, fx)*step(fx, 0.88);
warp_33=`    float3 c = pal(v + (bi/n)*0.3 + t*0.1, float3(.5,.5,.5), float3(.5,.5,.5), float3(1,1,1), float3(0.0,0.33,0.67));
warp_34=`    if (y >= 0.0) col = c*bar*step(y, h)*(0.5 + 0.6*y/(h+0.001));
warp_35=`    else col = c*bar*step(-y, h*0.5)*0.35*(1.0 + y/(h*0.5+0.001));
warp_36=`    col += float3(.6,.6,.6)*smoothstep(0.004,0.0,abs(y))*0.4;
warp_37=`    ret = col;
warp_38=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
