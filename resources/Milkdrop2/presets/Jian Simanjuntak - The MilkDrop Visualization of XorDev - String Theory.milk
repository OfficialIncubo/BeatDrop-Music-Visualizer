per_frame_1=wave_a = 0; // Spektrum dinonaktifkan dengan pakai nilai "0"
per_frame_2=
per_frame_3=q1 = 1.0; // Kecepatan pada tali warna-warni saat maju
per_frame_4=q2 = 0.1; // Kecepatan rotasi
per_frame_5=
per_frame_6=// ========== Gaya pada rotasi ========== 
per_frame_7=my_rotate = int(time / 5.0) % 8 + 1;
per_frame_8=
per_frame_9=q3 = if(equal(my_rotate, 1), 0.0, 
per_frame_10=     if(equal(my_rotate, 2), 1.0, 
per_frame_11=     if(equal(my_rotate, 3), 2.0, 
per_frame_12=     if(equal(my_rotate, 4), 3.0, 
per_frame_13=     if(equal(my_rotate, 5), 4.0, 
per_frame_14=     if(equal(my_rotate, 6), 5.0, 
per_frame_15=     if(equal(my_rotate, 7), 6.0, 7.0)))))));
per_frame_16=
per_frame_17=q4 = my_rotate;
per_frame_18=
per_frame_19=q5 = if(equal(my_rotate, 1), 11.0, 
per_frame_20=     if(equal(my_rotate, 2), 8.0, 
per_frame_21=     if(equal(my_rotate, 3), 7.0, 
per_frame_22=     if(equal(my_rotate, 4), 6.0, 
per_frame_23=     if(equal(my_rotate, 5), 5.0, 
per_frame_24=     if(equal(my_rotate, 6), 4.0, 
per_frame_25=     if(equal(my_rotate, 7), 3.0, 2.0)))))));
per_frame_26=// ============== end ==============
per_frame_27=
per_frame_28=q7 = (bass_att*1.5); // Kecerahan pada tali warna-warni
per_frame_29=
per_frame_30=
per_frame_31=// -- Written code by Jian Simanjuntak
per_frame_32=// -- Thank you for helping and keep up the good work
per_frame_33=//
per_frame_34=// -- Don't forget follow in social media:
per_frame_35=// Instagram : @jian_simanjuntak_milkdrop
per_frame_36=// Facebook : Jian Simanjuntak MilkDrop
per_frame_37=// Twitter : Jian Simanjuntak MilkDrop
warp_1=`// Shader by Xor
warp_2=`// https://fragcoord.xyz/s/siahbtd2
warp_3=`// Ported to MilkDrop v2.25c by Jian Simanjuntak
warp_4=`
warp_5=`shader_body
warp_6=`{
warp_7=`    float2 u_resolution = texsize.xy;
warp_8=`    float2 fragCoord = uv * texsize.xy;
warp_9=`    
warp_10=`    float3 p;
warp_11=`    float3 color_accumulator = 0;
warp_12=`    
warp_13=`    float z = 0.0;
warp_14=`    float d = 0.0;
warp_15=`    
warp_16=`    for (float i = 20.0; i <= 100.0; i++)
warp_17=`    {
warp_18=`        p = z * normalize(float3(fragCoord * 2.0 - u_resolution, -u_resolution.y));
warp_19=`        
warp_20=`        p.z -= time*q1;
warp_21=`
warp_22=`        float angle = z * 0.2 + time * q2;
warp_23=`        float4 rot_vec = cos(angle + float4(q3, q4, q5, q6));
warp_24=`        float2x2 rot_mat = transpose(float2x2(rot_vec.x, rot_vec.y, rot_vec.z, rot_vec.w));
warp_25=`        p.xy = mul(rot_mat, p.xy);
warp_26=`        
warp_27=`        // Kalkulasi jarak distance field (Signed Distance Function / Raymarch step)
warp_28=`        float3 inner_cos = cos(p.yzx + p.z - time * 0.2);
warp_29=`        float3 outer_cos = cos(p + inner_cos);
warp_30=`        d = length(outer_cos.xy) / 6.0;
warp_31=`        z += d;
warp_32=`        
warp_33=`        // Akumulasi warna berdasarkan fungsi sinus dan jarak d
warp_34=`        float4 sine_color = sin(p.x + time + float4(0.0, 2.0, 3.0, 0.0)) + q7;
warp_35=`        color_accumulator += sine_color.xyz / d;
warp_36=`    }
warp_37=`   
warp_38=`    ret = 1-exp(-(color_accumulator / 5e3)); // replaced tanh(x) with 1-exp(-x) for better tonemapping

warp_39=`}
comp_1=`shader_body
comp_2=`{
comp_3=`ret = GetPixel(uv);
comp_4=`}
