shapecode_3_border_b=0.500
shapecode_3_border_a=0.000
per_frame_init_1=yaw=0; zc=0; pks=0; bcnt=0; peak=0; avg=0; t0=0;
per_frame_1=dt = 1/fps;
per_frame_2=dec_med = pow(0.9, 30/fps);
per_frame_3=dec_slow = pow(0.99, 30/fps);
per_frame_4=dec_pks = pow(0.95, 30/fps);
per_frame_5=beat = max(max(bass, mid), treb);
per_frame_6=avg = avg*dec_slow + beat*(1-dec_slow);
per_frame_7=is_beat = above(beat, .2+avg+peak) * above(time, t0+.2);
per_frame_8=t0 = is_beat*time + (1-is_beat)*t0;
per_frame_9=peak = is_beat*beat + (1-is_beat)*peak*dec_med;
per_frame_10=bcnt = (bcnt + is_beat) % 97;
per_frame_11=pks = pks*dec_pks + min(peak,0.2)*(1-dec_pks);
per_frame_12=yaw = yaw + (0.50 + -0.10*pks)*dt;
per_frame_13=zc = zc + (0.50 + 0.00*pks)*dt;
per_frame_14=pitch = 0.05 + 0.05*sin(time*0.11) + 0.08*pks;
per_frame_15=q1 = cos(yaw);
per_frame_16=q2 = sin(yaw);
per_frame_17=q3 = cos(pitch);
per_frame_18=q4 = sin(pitch);
per_frame_19=q5 = 0.11*sin(time*0);
per_frame_20=q6 = 3.5 + 1.0*sin(time*0.00) + 0.0*pks;
per_frame_21=q7 = zc;
per_frame_22=q9 = bcnt;
per_frame_23=q10 = is_beat;
per_frame_24=q11 = min(0.15, 0.02 + 0.08*peak);
per_frame_25=q12 = 0.9 + 0.7*pks;
per_frame_26=q13 = 0.015 + 0.025*min(1,avg);
per_frame_27=zoom = 1; rot = 0; warp = 0; dx = 0; dy = 0; cx = 0.5; cy = 0.5; decay = 1;
warp_1=`#define sat saturate
warp_2=`static const float2 GRID = float2(32,18);
warp_3=`float hash21(float2 p){ float3 p3 = frac(float3(p.x,p.y,p.x)*0.1031); p3 += dot(p3, p3.yzx+33.33); return frac((p3.x+p3.y)*p3.z); }
warp_4=`shader_body {
warp_5=`  // ATLAS KACA JENDELA: 32x18 sel. Tiap sel = 1 "kamar" yang dipakai composite shader
warp_6=`  // R = kilau kaca, G = status lampu (feedback), B = acak warna lampu
warp_7=`  float2 g = uv_orig*GRID;
warp_8=`  float2 cid = clamp(floor(g), float2(0.0,0.0), GRID-1.0);
warp_9=`  float2 lw = saturate(g-cid);
warp_10=`  float prev = tex2D(sampler_pc_main, (cid+0.5)/GRID).g;
warp_11=`  float hc  = hash21(cid);
warp_12=`  float hc2 = hash21(cid+17.3);
warp_13=`  float stat = step(1.0-q13, hc);
warp_14=`  float tt = floor(time*0.4 + hc2*8.0);
warp_15=`  float fl = step(0.975, hash21(cid*1.7 + tt*3.1));
warp_16=`  float tgt = max(stat*(0.55+0.45*hc2), fl*(0.5+0.5*hc));
warp_17=`  float pulse = q10 * step(1.0-q11, hash21(cid + q9*float2(5.31,2.77)));
warp_18=`  float L = lerp(prev, tgt, 0.08);
warp_19=`  L = max(L, pulse);
warp_20=`  L = max(0.0, L-0.004);
warp_21=`  float sheen = 0.35 + 0.35*lw.y + 0.15*sin((lw.x*1.3+lw.y)*(5.0+10.0*hc)+hc2*6.28) + 0.15*hc;
warp_22=`  ret = float3(sat(sheen), L, hc2);
warp_23=`}
comp_1=`#define sat saturate
comp_2=`static const float2 GRID = float2(32,18);
comp_3=`static const int STEPS = 7;
comp_4=`static const float3 cam = float3(q5,q6,q7);
comp_5=`static const float2 yw = float2(q1,q2);
comp_6=`static const float2 pt = float2(q3,q4);
comp_7=`static const float gain = q12;
comp_8=`static const float3 FOG = float3(0.04,0.04,0.10);
comp_9=`float hash21(float2 p){ float3 p3 = frac(float3(p.x,p.y,p.x)*0.1031); p3 += dot(p3, p3.yzx+33.33); return frac((p3.x+p3.y)*p3.z); }
comp_10=`
comp_11=`shader_body {
comp_12=`
comp_13=`  // ---------- KAMERA ----------
comp_14=`  float2 pc = (uv-0.5)*aspect.xy;
comp_15=`  pc.y = -pc.y;
comp_16=`  float3 r = float3(pc*1.8, 1.0);
comp_17=`  float3 r1 = float3(r.x, r.y*pt.x + r.z*pt.y, r.z*pt.x - r.y*pt.y);
comp_18=`  float3 rd = normalize(float3(r1.x*yw.x + r1.z*yw.y, r1.y, r1.z*yw.x - r1.x*yw.y));
comp_19=`
comp_20=`  // ---------- GEDUNG: DDA kota grid, menara tinggi tak hingga (tinggi acak) ----------
comp_21=`  float2 o2 = cam.xz;
comp_22=`  float2 dir = rd.xz;
comp_23=`  float2 sg = step(0.0,dir)*2.0-1.0;
comp_24=`  float2 idir = sg/max(abs(dir),0.0001);
comp_25=`  float2 cell = floor(o2);
comp_26=`  float2 tMax = (cell + step(0.0,dir) - o2)*idir;
comp_27=`  float2 tDel = abs(idir);
comp_28=`  float tHit = 0.0;
comp_29=`  float faceX = 0.0;
comp_30=`  float2 hitCell = 0.0;
comp_31=`  for (int i=0; i<STEPS; i++) {
comp_32=`    float h0 = hash21(cell);
comp_33=`    float h1 = hash21(cell+3.7);
comp_34=`    float h2 = hash21(cell+9.1);
comp_35=`    float2 bmin = cell + float2(0.2+0.1*h1, 0.2+0.1*h2);
comp_36=`    float2 bmax = cell + float2(0.8-0.1*h2, 0.8-0.1*h0);
comp_37=`    float2 t1 = (bmin-o2)*idir;
comp_38=`    float2 t2 = (bmax-o2)*idir;
comp_39=`    float2 tn = min(t1,t2);
comp_40=`    float2 tf = max(t1,t2);
comp_41=`    float tnear = max(tn.x,tn.y);
comp_42=`    float tfar = min(tf.x,tf.y);
comp_43=`    float H = 3.0+10.0*h0;
comp_44=`    float y = cam.y + tnear*rd.y;
comp_45=`    float ok = (tHit<=0.0)*(tnear<tfar)*(tnear>0.0)*(y<H)*(y>0.0);
comp_46=`    tHit = lerp(tHit, tnear, ok);
comp_47=`    faceX = lerp(faceX, step(tn.y,tn.x), ok);
comp_48=`    hitCell = lerp(hitCell, cell, ok);
comp_49=`    float sx = step(tMax.x,tMax.y);
comp_50=`    float2 stp = float2(sx,1.0-sx);
comp_51=`    cell += stp*sg;
comp_52=`    tMax += stp*tDel;
comp_53=`  }
comp_54=`  float hitW = step(0.0001, tHit);
comp_55=`  float t = max(tHit, 0.05);
comp_56=`  float3 p = float3(o2.x + t*rd.x, cam.y + t*rd.y, o2.y + t*rd.z);
comp_57=`  float u = lerp(p.x, p.z, faceX);
comp_58=`
comp_59=`  // koordinat jendela
comp_60=`  float seed = hash21(hitCell + faceX*7.7);
comp_61=`  float2 gxy = float2(u*10.5 + seed*13.0, p.y*13.0);
comp_62=`  float2 id = floor(gxy);
comp_63=`  float2 f = frac(gxy);
comp_64=`  float fp = t*texsize.w*13.0;
comp_65=`  float aa = saturate(fp*1.5)+0.02;
comp_66=`
comp_67=`  // balok struktur: pelat lantai & kolom
comp_68=`  float slab = step(frac(id.y/10.0+0.001), 0.0010);
comp_69=`  float pier = step(frac(id.x/10.0+0.001), 0.0009);
comp_70=`  float st = max(slab,pier);
comp_71=`
comp_72=`  // area kaca + kusen
comp_73=`  float wx = (f.x-0.14)/0.72;
comp_74=`  float wy = (f.y-0.18)/0.62;
comp_75=`  float mx = smoothstep(0.0,aa,wx)*smoothstep(0.0,aa,1.0-wx);
comp_76=`  float my = smoothstep(0.0,aa,wy)*smoothstep(0.0,aa,1.0-wy);
comp_77=`  float hw  = hash21(id*1.31 + hitCell*5.17 + faceX*2.3);
comp_78=`  float hw2 = hash21(id*0.77 + hitCell*2.11 + 4.4);
comp_79=`  float hw3 = hash21(id*2.13 + hitCell*1.37 + 8.8);
comp_80=`  float bar = max(saturate(1.0-abs(wx-0.5)/(0.05+aa)), saturate(1.0-abs(wy-0.58)/(0.04+aa))*step(0.5,hw3));
comp_81=`  float glass = mx*my*(1.0-st)*(1.0-0.85*bar);
comp_82=`  glass = lerp(glass, 0.5*(1.0-st), saturate((fp-0.12)*3.0));
comp_83=`
comp_84=`  // ---------- MENTAHAN JENDELA ----------
comp_85=`  float2 acell = floor(float2(hw*GRID.x, hw2*GRID.y));
comp_86=`  float2 alw = clamp(float2(wx,wy), 0.12, 0.88);
comp_87=`  float3 at = GetPixel((acell+alw)/GRID);
comp_88=`
comp_89=`  // warna dinding
comp_90=`  float lightDir = lerp(0.7, 1.0, faceX);
comp_91=`  float3 wall = float3(0.075,0.07,0.19)*lightDir*(0.9+0.2*hw3);
comp_92=`  wall = lerp(wall, float3(0.19,0.18,0.38)*lightDir, st);
comp_93=`  float rail = step(0.06,f.y)*step(f.y,0.17)*step(frac(f.x*4.0),0.5)*(1.0-st)*(1.0-glass)*(1.0-saturate(fp*4.0));
comp_94=`  wall *= 1.0 + 0.7*rail;
comp_95=`  float3 glassDark = float3(0.035,0.04,0.075) + at.r*float3(0.03,0.035,0.06);
comp_96=`  float3 base = lerp(wall, glassDark, glass);
comp_97=`
comp_98=`  // ---------- CAHAYA LAMPU JENDELA ----------
comp_99=`  float L = at.g*at.g;
comp_100=`  float3 warm = lerp(float3(1.0,0.97,0.88), float3(1.0,0.62,0.28), step(0.82,at.b));
comp_101=`  float strong = 1.0 + 1.5*step(0.96,hw);
comp_102=`  float3 emis = warm*L*gain*strong*(1.3+0.7*at.r)*glass;
comp_103=`  float2 fc = (f-0.5)*2.0;
comp_104=`  float dh = length(fc);
comp_105=`  float halo = L*gain*exp(-dh*3.0)*saturate((1.4-dh)/0.9)*(1.0-glass)*0.35*(1.0-0.5*st);
comp_106=`  emis += warm*halo*0.6;
comp_107=`
comp_108=`  float fogT = 1.0-exp(-t*0.3);
comp_109=`  float3 col = lerp(base, FOG, fogT);
comp_110=`  emis *= lerp(1.0, 0.5, fogT);
comp_111=`
comp_112=`  // ---------- LANGIT & TANAH ----------
comp_113=`  float3 sky = FOG*(0.8+0.8*sat(rd.y)) + float3(0.02,0.02,0.05)*sat(1.0-abs(rd.y));
comp_114=`  float tg = -cam.y/min(rd.y,-0.0001);
comp_115=`  float gnd = step(tg, lerp(100000.0, tHit, hitW))*step(rd.y,-0.0001);
comp_116=`  float3 groundCol = float3(0.02,0.02,0.05)*exp(-tg*0.4) + FOG*(1.0-exp(-tg*0.4));
comp_117=`  hitW *= 1.0-gnd;
comp_118=`  float3 outc = lerp(sky, col, hitW);
comp_119=`  outc = lerp(outc, groundCol, gnd);
comp_120=`  emis *= hitW;
comp_121=`
comp_122=`  float vig = 1.0 - 0.5*sat(rad-0.3);
comp_123=`  outc *= vig;
comp_124=`  emis *= vig;
comp_125=`  ret = 1.0 - (1.0-outc)*exp(-emis*1.6);
comp_126=`}
