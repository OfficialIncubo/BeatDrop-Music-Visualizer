shape_3_per_frame1=n = instance / num_inst;
shape_3_per_frame2=
shape_3_per_frame3=// Kalkulasi pergerakan dinamis
shape_3_per_frame4=// Menggunakan kombinasi sin & cos berbasis waktu (time) dan index partikel
shape_3_per_frame5=x = 0.5 + 0.20 * sin(time * 0.2 + n * 6.28318) + 0.08 * cos(time * 0.1 + instance);
shape_3_per_frame6=y = 0.5 + 0.40 * cos(time * 0.2 + n * 6.28318) + 0.08 * sin(time * 0.1 + instance);
shape_3_per_frame7=
shape_3_per_frame8=// Modulasi ukuran radius berdasarkan respon musik dan animasi partikel
shape_3_per_frame9=// Menggunakan bass_att untuk reaksi musik yang mulus
shape_3_per_frame10=rad = 0.06 + 0.03 * sin(time * 3.0 + instance * 0.5) + 0.02 * (bass_att - 1.0);
shape_3_per_frame11=
shape_3_per_frame12=// Variasi warna
shape_3_per_frame13=r = 0.5 + 0.5 * sin(time * 3.0 + n * 1.98318);
shape_3_per_frame14=g = 0.5 + 0.5 * sin(time * 3.5 + n * 2.14159);
shape_3_per_frame15=b = 0.5 + 0.5 * cos(time * 2.8 + n * 3.28318);
per_frame_1=dec = pow(0.9,30/fps);
per_frame_2=dsl = pow(0.99,30/fps);
per_frame_3=beat = max(max(bass,mid),treb);
per_frame_4=avg = avg*dsl + beat*(1-dsl);
per_frame_5=is_beat = above(beat,.2+avg+peak)*above(time,t0+.2);
per_frame_6=t0 = is_beat*time + (1-is_beat)*t0;
per_frame_7=peak = is_beat*beat + (1-is_beat)*peak*dec;
per_frame_8=mov = mov + (.012+.015*(bass_att+mid_att+treb_att)/3)*30/fps;
per_frame_9=
per_frame_10=q3 = mov;
per_frame_11=q4 = peak;
per_frame_12=
per_frame_13=wave_a = 0;
per_frame_14=zoom = 0.9;
warp_1=`shader_body
warp_2=`{
warp_3=`
warp_4=`uv = lerp(uv_orig,uv,0.05);
warp_5=`
warp_6=`float2 d = texsize.zw * 4;
warp_7=`float3 dx = ( GetBlur1(uv + float2(1,0)*d) - GetBlur1(uv-float2(1,0)*d) );
warp_8=`float3 dy = ( GetBlur1(uv + float2(0,1)*d) - GetBlur1(uv-float2(0,1)*d) );
warp_9=`
warp_10=`uv += float2(lum(dx),lum(dy))*texsize.zw*4;
warp_11=`ret = tex2d(sampler_fc_main, uv) - 0.020;
warp_12=`
warp_13=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float2 p = (uv-0.5)*aspect.xy;
comp_4=`    float r = length(p)+0.0001;
comp_5=`    float a = atan2(p.y,p.x)/6.28318;
comp_6=`    float v = 1/(r+0.15)*0.6 + q3 + sin(r*10 - q3*8)*0.09;
comp_7=`    float2 t = float2(a*5, v);
comp_8=`    float3 c = GetPixel(t) + GetBlur1(frac(t))*float3(.5,.8,1.2);
comp_9=`    float glow = exp(-r*6)*(0.4+q4);
comp_10=`    ret = c*saturate(r*2.5) + glow*float3(1,.8,.6);
comp_11=`}
