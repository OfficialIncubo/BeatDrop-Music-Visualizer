comp_1=`shader_body
comp_2=`{
comp_3=`  float lw = texsize.w * 1.7;
comp_4=`  float amp = q1;
comp_5=`  float3 c1 = 0.8 + 0.2 * cos(6.28318 * (float3(0.0, 0.1, 0.2) + q2));
comp_6=`  float3 c2 = 0.55 + 0.45 * cos(6.28318 * (float3(0.55, 0.65, 0.75) + q2));
comp_7=`  float3 col = 0;
comp_8=`  float vis = 1.0;
comp_9=`  float sx, inside, env, h, top, dy;
comp_10=`  sx = (uv.x - 0.5) / 0.820 + 0.5;
comp_11=`  inside = step(0.0, sx) * step(sx, 1.0);
comp_12=`  env = saturate(sx * (1.0 - sx) * 4.0);
comp_13=`  h = tex2D(sampler_main, float2(0.05 + 0.9 * saturate(sx), 0.300)).x;
comp_14=`  top = 0.860 - h * env * env * 0.260 * amp;
comp_15=`  dy = uv.y - top;
comp_16=`  col += (saturate(1.0 - abs(dy) / lw) * 1.000 + saturate(1.0 - abs(dy) * 40.0) * 0.1) * inside * vis * lerp(c1, c2, 0.000);
comp_17=`  vis *= 1.0 - inside * smoothstep(-lw, lw, dy);
comp_18=`  sx = (uv.x - 0.5) / 0.787 + 0.5;
comp_19=`  inside = step(0.0, sx) * step(sx, 1.0);
comp_20=`  env = saturate(sx * (1.0 - sx) * 4.0);
comp_21=`  h = tex2D(sampler_main, float2(0.05 + 0.9 * saturate(sx), 0.330)).x;
comp_22=`  top = 0.810 - h * env * env * 0.249 * amp;
comp_23=`  dy = uv.y - top;
comp_24=`  col += (saturate(1.0 - abs(dy) / lw) * 0.945 + saturate(1.0 - abs(dy) * 40.0) * 0.1) * inside * vis * lerp(c1, c2, 0.091);
comp_25=`  vis *= 1.0 - inside * smoothstep(-lw, lw, dy);
comp_26=`  sx = (uv.x - 0.5) / 0.755 + 0.5;
comp_27=`  inside = step(0.0, sx) * step(sx, 1.0);
comp_28=`  env = saturate(sx * (1.0 - sx) * 4.0);
comp_29=`  h = tex2D(sampler_main, float2(0.05 + 0.9 * saturate(sx), 0.360)).x;
comp_30=`  top = 0.760 - h * env * env * 0.238 * amp;
comp_31=`  dy = uv.y - top;
comp_32=`  col += (saturate(1.0 - abs(dy) / lw) * 0.891 + saturate(1.0 - abs(dy) * 40.0) * 0.1) * inside * vis * lerp(c1, c2, 0.182);
comp_33=`  vis *= 1.0 - inside * smoothstep(-lw, lw, dy);
comp_34=`  sx = (uv.x - 0.5) / 0.722 + 0.5;
comp_35=`  inside = step(0.0, sx) * step(sx, 1.0);
comp_36=`  env = saturate(sx * (1.0 - sx) * 4.0);
comp_37=`  h = tex2D(sampler_main, float2(0.05 + 0.9 * saturate(sx), 0.390)).x;
comp_38=`  top = 0.710 - h * env * env * 0.227 * amp;
comp_39=`  dy = uv.y - top;
comp_40=`  col += (saturate(1.0 - abs(dy) / lw) * 0.836 + saturate(1.0 - abs(dy) * 40.0) * 0.1) * inside * vis * lerp(c1, c2, 0.273);
comp_41=`  vis *= 1.0 - inside * smoothstep(-lw, lw, dy);
comp_42=`  sx = (uv.x - 0.5) / 0.689 + 0.5;
comp_43=`  inside = step(0.0, sx) * step(sx, 1.0);
comp_44=`  env = saturate(sx * (1.0 - sx) * 4.0);
comp_45=`  h = tex2D(sampler_main, float2(0.05 + 0.9 * saturate(sx), 0.420)).x;
comp_46=`  top = 0.660 - h * env * env * 0.216 * amp;
comp_47=`  dy = uv.y - top;
comp_48=`  col += (saturate(1.0 - abs(dy) / lw) * 0.782 + saturate(1.0 - abs(dy) * 40.0) * 0.1) * inside * vis * lerp(c1, c2, 0.364);
comp_49=`  vis *= 1.0 - inside * smoothstep(-lw, lw, dy);
comp_50=`  sx = (uv.x - 0.5) / 0.656 + 0.5;
comp_51=`  inside = step(0.0, sx) * step(sx, 1.0);
comp_52=`  env = saturate(sx * (1.0 - sx) * 4.0);
comp_53=`  h = tex2D(sampler_main, float2(0.05 + 0.9 * saturate(sx), 0.450)).x;
comp_54=`  top = 0.610 - h * env * env * 0.205 * amp;
comp_55=`  dy = uv.y - top;
comp_56=`  col += (saturate(1.0 - abs(dy) / lw) * 0.727 + saturate(1.0 - abs(dy) * 40.0) * 0.1) * inside * vis * lerp(c1, c2, 0.455);
comp_57=`  vis *= 1.0 - inside * smoothstep(-lw, lw, dy);
comp_58=`  sx = (uv.x - 0.5) / 0.624 + 0.5;
comp_59=`  inside = step(0.0, sx) * step(sx, 1.0);
comp_60=`  env = saturate(sx * (1.0 - sx) * 4.0);
comp_61=`  h = tex2D(sampler_main, float2(0.05 + 0.9 * saturate(sx), 0.480)).x;
comp_62=`  top = 0.560 - h * env * env * 0.195 * amp;
comp_63=`  dy = uv.y - top;
comp_64=`  col += (saturate(1.0 - abs(dy) / lw) * 0.673 + saturate(1.0 - abs(dy) * 40.0) * 0.1) * inside * vis * lerp(c1, c2, 0.545);
comp_65=`  vis *= 1.0 - inside * smoothstep(-lw, lw, dy);
comp_66=`  sx = (uv.x - 0.5) / 0.591 + 0.5;
comp_67=`  inside = step(0.0, sx) * step(sx, 1.0);
comp_68=`  env = saturate(sx * (1.0 - sx) * 4.0);
comp_69=`  h = tex2D(sampler_main, float2(0.05 + 0.9 * saturate(sx), 0.510)).x;
comp_70=`  top = 0.510 - h * env * env * 0.184 * amp;
comp_71=`  dy = uv.y - top;
comp_72=`  col += (saturate(1.0 - abs(dy) / lw) * 0.618 + saturate(1.0 - abs(dy) * 40.0) * 0.1) * inside * vis * lerp(c1, c2, 0.636);
comp_73=`  vis *= 1.0 - inside * smoothstep(-lw, lw, dy);
comp_74=`  sx = (uv.x - 0.5) / 0.558 + 0.5;
comp_75=`  inside = step(0.0, sx) * step(sx, 1.0);
comp_76=`  env = saturate(sx * (1.0 - sx) * 4.0);
comp_77=`  h = tex2D(sampler_main, float2(0.05 + 0.9 * saturate(sx), 0.540)).x;
comp_78=`  top = 0.460 - h * env * env * 0.173 * amp;
comp_79=`  dy = uv.y - top;
comp_80=`  col += (saturate(1.0 - abs(dy) / lw) * 0.564 + saturate(1.0 - abs(dy) * 40.0) * 0.1) * inside * vis * lerp(c1, c2, 0.727);
comp_81=`  vis *= 1.0 - inside * smoothstep(-lw, lw, dy);
comp_82=`  sx = (uv.x - 0.5) / 0.525 + 0.5;
comp_83=`  inside = step(0.0, sx) * step(sx, 1.0);
comp_84=`  env = saturate(sx * (1.0 - sx) * 4.0);
comp_85=`  h = tex2D(sampler_main, float2(0.05 + 0.9 * saturate(sx), 0.570)).x;
comp_86=`  top = 0.410 - h * env * env * 0.162 * amp;
comp_87=`  dy = uv.y - top;
comp_88=`  col += (saturate(1.0 - abs(dy) / lw) * 0.509 + saturate(1.0 - abs(dy) * 40.0) * 0.1) * inside * vis * lerp(c1, c2, 0.818);
comp_89=`  vis *= 1.0 - inside * smoothstep(-lw, lw, dy);
comp_90=`  sx = (uv.x - 0.5) / 0.493 + 0.5;
comp_91=`  inside = step(0.0, sx) * step(sx, 1.0);
comp_92=`  env = saturate(sx * (1.0 - sx) * 4.0);
comp_93=`  h = tex2D(sampler_main, float2(0.05 + 0.9 * saturate(sx), 0.600)).x;
comp_94=`  top = 0.360 - h * env * env * 0.151 * amp;
comp_95=`  dy = uv.y - top;
comp_96=`  col += (saturate(1.0 - abs(dy) / lw) * 0.455 + saturate(1.0 - abs(dy) * 40.0) * 0.1) * inside * vis * lerp(c1, c2, 0.909);
comp_97=`  vis *= 1.0 - inside * smoothstep(-lw, lw, dy);
comp_98=`  sx = (uv.x - 0.5) / 0.460 + 0.5;
comp_99=`  inside = step(0.0, sx) * step(sx, 1.0);
comp_100=`  env = saturate(sx * (1.0 - sx) * 4.0);
comp_101=`  h = tex2D(sampler_main, float2(0.05 + 0.9 * saturate(sx), 0.630)).x;
comp_102=`  top = 0.310 - h * env * env * 0.140 * amp;
comp_103=`  dy = uv.y - top;
comp_104=`  col += (saturate(1.0 - abs(dy) / lw) * 0.400 + saturate(1.0 - abs(dy) * 40.0) * 0.1) * inside * vis * lerp(c1, c2, 1.000);
comp_105=`  vis *= 1.0 - inside * smoothstep(-lw, lw, dy);
comp_106=`  float haze = exp(-abs(uv.y - 0.3) * 7.0);
comp_107=`  col += c2 * haze * 0.07 * vis;
comp_108=`  col += float3(0.01, 0.01, 0.018);
comp_109=`  col *= 1.0 + q3 * 0.08 * sin(time * 30.0 + uv.x * 50.0);
comp_110=`  float2 v = uv - 0.5;
comp_111=`  col *= 1.0 - dot(v, v) * 0.6;
comp_112=`  ret = 1.0 - exp(-col * 2.0);
comp_113=`}
