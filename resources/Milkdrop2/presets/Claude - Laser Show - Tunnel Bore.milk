###################################################################################################

MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5.000
fGammaAdj=1.900
fDecay=0.970
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=1
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=1.000
fWaveSmoothing=0.630
fWaveParam=-1.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.331
fZoomExponent=1.00000
fShader=0.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=1.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_init_1=q1=0.0;
per_frame_init_2=q2=40.0;
per_frame_init_3=q5=0.0;
per_frame_init_4=q6=0.0;
per_frame_init_5=time_delay=0.0;
per_frame_init_6=rand_laser=rand(150);
per_frame_init_7=temp1 = 0;
per_frame_init_8=temp2 = 0;
per_frame_1=// SKELETON (kept intact, medium retrigger to vary tunnel speed/spoke count feel)
per_frame_2=time_delay = if(time_delay >= .35 && bass > 2, 0, time_delay += 1/fps);
per_frame_3=rand_laser = if(time_delay == 0, rand(150), rand_laser);
per_frame_4=
per_frame_5=// Custom variable mapping to feed the Comp Shader
per_frame_6=q1 = rand_laser;                          // color palette seed
per_frame_7=q2 = time_delay;                          // beat clock (0 = beat)
per_frame_8=temp1 += (0.7 + bass_att*0.9)/fps;        // forward-travel depth clock (drives spoke speed)
per_frame_9=temp2 += (0.15 + treb_att*0.2)/fps;       // slow tunnel rotation clock
per_frame_10=q3 = temp1;
per_frame_11=q4 = temp2;
per_frame_12=q6 = 0.5 + 0.5*sin(time*0.3 + rand_laser*0.04); // slow color drift phase
warp_1=`shader_body {}
comp_1=`float3 GetLaser(float2 uva, float2 origin, float angle, float3 color_vec, float focus) {
comp_2=`    float2 p = uva - origin;
comp_3=`    float2 dir = float2(cos(angle), sin(angle));
comp_4=`    float2 n = float2(-dir.y, dir.x);
comp_5=`    float line_dist = abs(dot(p, n));
comp_6=`    float along = dot(p, dir);
comp_7=`    float core = exp(-line_dist * (4200.0 * focus));
comp_8=`    float glow = 0.0016 / (line_dist + 0.0006);
comp_9=`    float intensity = (core + glow) * smoothstep(-0.02, 0.1, along);
comp_10=`    return color_vec * intensity;
comp_11=`}
comp_12=`
comp_13=`shader_body
comp_14=`{
comp_15=`    float aspect = texsize.x * texsize.z;
comp_16=`    float2 center = float2(0.5, 0.5);
comp_17=`    float2 p = uv - center;
comp_18=`    p.x *= aspect;
comp_19=`    float r = length(p);
comp_20=`    float a = atan2(p.y, p.x);
comp_21=`
comp_22=`    float col_sel = fmod(q1 * 1.9, 4.0);
comp_23=`    float3 col1, col2;
comp_24=`    if (col_sel < 1.0) { col1 = float3(0.0, 0.8, 1.0); col2 = float3(1.0, 0.0, 0.6); }
comp_25=`    else if (col_sel < 2.0) { col1 = float3(1.0, 0.5, 0.0); col2 = float3(1.0, 1.0, 0.0); }
comp_26=`    else if (col_sel < 3.0) { col1 = float3(0.6, 0.0, 1.0); col2 = float3(0.0, 1.0, 0.5); }
comp_27=`    else { col1 = float3(1.0, 1.0, 1.0); col2 = float3(0.3, 0.6, 1.0); }
comp_28=`
comp_29=`    float beat_strike = exp(-q2 * 4.5);
comp_30=`
comp_31=`    // 1. TUNNEL BORE
comp_32=`    // Radial spokes fixed in angle (like a tunnel's structural ribs) that race
comp_33=`    // inward from the rim toward the vanishing point, giving a flying-forward
comp_34=`    // illusion. q3 drives the "depth" travel clock; each spoke loops from rim
comp_35=`    // to center and respawns, staggered by its own index.
comp_36=`    float3 lasers = float3(0,0,0);
comp_37=`    int SPOKES = 10;
comp_38=`    for (int i = 0; i < SPOKES; i++) {
comp_39=`        float angle = (M_PI_2 / float(SPOKES)) * float(i) + q4 * 0.3;
comp_40=`        float2 dir = float2(cos(angle), sin(angle));
comp_41=`
comp_42=`        for (int k = 0; k < 3; k++) {
comp_43=`            float stagger = float(k) * 0.34;
comp_44=`            float depth = fmod(q3 * 0.5 + stagger + float(i)*0.07, 1.0);
comp_45=`            float ring_r = 0.62 * (1.0 - depth) + 0.02;
comp_46=`
comp_47=`            float2 spoke_point = dir * ring_r;
comp_48=`            float d = length(p - spoke_point);
comp_49=`            float core = exp(-pow(d/(0.010 + depth*0.004), 2.0));
comp_50=`            float glow = exp(-pow(d/0.05, 2.0)) * 0.25;
comp_51=`
comp_52=`            float fade = smoothstep(0.0, 0.15, depth) * smoothstep(1.0, 0.8, depth);
comp_53=`            float3 col = lerp(col1, col2, depth);
comp_54=`            lasers += col * (core + glow) * fade * 1.3;
comp_55=`        }
comp_56=`    }
comp_57=`
comp_58=`    // 2. Connecting ring arcs at a couple of depths, like tunnel cross-section rings
comp_59=`    float ring1 = smoothstep(0.012, 0.0, abs(r - (0.30 + 0.08*sin(q3*0.7))));
comp_60=`    float ring2 = smoothstep(0.010, 0.0, abs(r - (0.50 + 0.06*sin(q3*0.5+1.7))));
comp_61=`    lasers += lerp(col1,col2,0.3) * ring1 * 0.5;
comp_62=`    lasers += lerp(col1,col2,0.7) * ring2 * 0.4;
comp_63=`
comp_64=`    // 3. Smoke from MilkDrop's blur buffer
comp_65=`    float3 smoke = GetBlur2(uv).rgb * 0.6;
comp_66=`    float3 bg = smoke * col1 * 0.14;
comp_67=`
comp_68=`    // 4. Vanishing-point core, flares on beat
comp_69=`    float core_flare = exp(-r * 9.0) * (0.5 + beat_strike * 1.6);
comp_70=`    lasers += lerp(col1,col2,0.5) * core_flare;
comp_71=`
comp_72=`    // 5. Smooth non-seizure breathing
comp_73=`    float breathe = 0.8 + 0.2*sin(time*0.5 + q6*3.14159);
comp_74=`
comp_75=`    float3 final_rgb = (lasers + bg) * breathe;
comp_76=`    ret = final_rgb;
comp_77=`}
