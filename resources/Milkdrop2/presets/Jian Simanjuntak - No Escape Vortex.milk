shape_3_per_frame1=// =========== Posisi ===========
shape_3_per_frame2=pgg1_x = 0.08;
shape_3_per_frame3=pgg1_y = 0.8;
shape_3_per_frame4=
shape_3_per_frame5=                     pgg2_x = 0.29;
shape_3_per_frame6=                     pgg2_y = 0.67;
shape_3_per_frame7=
shape_3_per_frame8=pgg3_x = 0.20;
shape_3_per_frame9=pgg3_y = 0.90;
shape_3_per_frame10=
shape_3_per_frame11=                     pgg4_x = 0.43;
shape_3_per_frame12=                     pgg4_y = 0.89;
shape_3_per_frame13=
shape_3_per_frame14=x = (equal(instance, 0) * pgg1_x) + 
shape_3_per_frame15=      (equal(instance, 1) * pgg2_x) +
shape_3_per_frame16=      (equal(instance, 2) * pgg3_x) +
shape_3_per_frame17=      (equal(instance, 3) * pgg4_x);
shape_3_per_frame18=
shape_3_per_frame19=y = (equal(instance, 0) * pgg1_y) + 
shape_3_per_frame20=      (equal(instance, 1) * pgg2_y) +
shape_3_per_frame21=      (equal(instance, 2) * pgg3_y) +
shape_3_per_frame22=      (equal(instance, 3) * pgg4_y);
shape_3_per_frame23=
shape_3_per_frame24=// =========== Warna ===========
shape_3_per_frame25=jssbb_red1 = 1;
shape_3_per_frame26=jssbb_green1 = 1;
shape_3_per_frame27=jssbb_blue1 = 0;
shape_3_per_frame28=
shape_3_per_frame29=                   jssbb_red2 = 1;
shape_3_per_frame30=                   jssbb_green2 = 0;
shape_3_per_frame31=                   jssbb_blue2 = 0;
shape_3_per_frame32=
shape_3_per_frame33=r = (equal(instance, 0) * jssbb_red1) + 
shape_3_per_frame34=      (equal(instance, 1) * jssbb_red1) +
shape_3_per_frame35=      (equal(instance, 2) * jssbb_red2) +
shape_3_per_frame36=      (equal(instance, 3) * jssbb_red2);
shape_3_per_frame37=
shape_3_per_frame38=g = (equal(instance, 0) * jssbb_green1) + 
shape_3_per_frame39=       (equal(instance, 1) * jssbb_green1) +
shape_3_per_frame40=       (equal(instance, 2) * jssbb_green2) +
shape_3_per_frame41=       (equal(instance, 3) * jssbb_green2);
shape_3_per_frame42=
shape_3_per_frame43=b = (equal(instance, 0) * jssbb_blue1) + 
shape_3_per_frame44=       (equal(instance, 1) * jssbb_blue1) +
shape_3_per_frame45=       (equal(instance, 2) * jssbb_blue2) +
shape_3_per_frame46=       (equal(instance, 3) * jssbb_blue2);
shape_3_per_frame47=
shape_3_per_frame48=r2 = (equal(instance, 0) * jssbb_red1) + 
shape_3_per_frame49=      (equal(instance, 1) * jssbb_red1) +
shape_3_per_frame50=      (equal(instance, 2) * jssbb_red2) +
shape_3_per_frame51=      (equal(instance, 3) * jssbb_red2);
shape_3_per_frame52=
shape_3_per_frame53=g2 = (equal(instance, 0) * jssbb_green1) + 
shape_3_per_frame54=       (equal(instance, 1) * jssbb_green1) +
shape_3_per_frame55=       (equal(instance, 2) * jssbb_green2) +
shape_3_per_frame56=       (equal(instance, 3) * jssbb_green2);
shape_3_per_frame57=
shape_3_per_frame58=b2 = (equal(instance, 0) * jssbb_blue1) + 
shape_3_per_frame59=       (equal(instance, 1) * jssbb_blue1) +
shape_3_per_frame60=       (equal(instance, 2) * jssbb_blue2) +
shape_3_per_frame61=       (equal(instance, 3) * jssbb_blue2);
shape_3_per_frame62=
shape_3_per_frame63=// =========== Membesarkan ===========
shape_3_per_frame64=bass_rad_mod1 = (bass_att*0.7);
shape_3_per_frame65=bass_rad_mod2 = (bass_att*0.4);
shape_3_per_frame66=bass_rad_mod3 = (bass_att*0.3);
shape_3_per_frame67=bass_rad_mod4 = (bass_att*0.3);
shape_3_per_frame68=
shape_3_per_frame69=rad = (equal(instance, 0) *bass_rad_mod1) + 
shape_3_per_frame70=      (equal(instance, 1) * bass_rad_mod2) +
shape_3_per_frame71=      (equal(instance, 2) * bass_rad_mod3) +
shape_3_per_frame72=      (equal(instance, 3) * bass_rad_mod4);
per_frame_1=decay = 0.8;
per_frame_2=zoom = 0.99;
per_frame_3=
per_frame_4=step = int(time / 4) % 4;
per_frame_5=
per_frame_6=// Fungsi equal() akan bernilai 1 jika step cocok, dan 0 jika tidak cocok.
per_frame_7=dx = equal(step, 0)*1.09 + equal(step, 1)*1.05 - equal(step, 2)*1.05 - equal(step, 3)*1.05;
per_frame_8=
per_frame_9=// Karena dy selalu bernilai 1.0 pada keempat step tersebut, tidak perlu menggunakan fungsi equal()
per_frame_10=dy = 1.0;
per_frame_11=
per_frame_12=// Konfigurasi rotasi berdasarkan masing-masing step
per_frame_13=rot = equal(step, 0)*0.2 - equal(step, 1)*0.2 - equal(step, 2)*0.2 + equal(step, 3)*0.2;
