[preset00]
FFTAttack=0.500
FFTDecay=0.500
fRating=4.000
fGammaAdj=1.980
fDecay=0.500
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.500
nVideoEchoOrientation=3
nWaveMode=5
bAdditiveWaves=0
bWaveDots=1
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=1
bSolarize=0
bInvert=0
fWaveAlpha=0.001
fWaveScale=5.552
fWaveSmoothing=0.504
fWaveParam=-1.000
fModWaveAlphaStart=0.710
fModWaveAlphaEnd=1.300
fWarpAnimSpeed=1.459
fWarpScale=2.007
fZoomExponent=1.00000
fShader=0.000
zoom=0.99990
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=0.01000
sx=0.99990
sy=1.00000
wave_r=1.000
wave_g=0.000
wave_b=0.000
wave_x=0.500
wave_y=0.500
ob_size=0.010
ob_r=1.000
ob_g=1.000
ob_b=1.000
ob_a=0.000
ib_size=0.260
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=64.000
nMotionVectorsY=48.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.850
mv_r=0.500
mv_g=0.500
mv_b=0.500
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.000
per_frame_init_1=vol = 0; p1 = 0;
per_frame_init_2=vx = .2; vy = -0.1;
per_frame_init_3=kx = 0; ky = 0;
per_frame_init_4=
per_frame_init_5=n = -10000; loop (20000, megabuf(n)=sin(n*.01)*.02; gmegabuf(n)=0; n +=1; );
per_frame_init_6=
per_frame_init_7=MINBPM = 30; MAXBPM = 300; num_res = 512; 
per_frame_init_8=index = 0;
per_frame_init_9=loop (num_res,
per_frame_init_10=  n = index*8;
per_frame_init_11=  megabuf(n) = minbpm * pow(maxbpm/minbpm,index/(num_res-1));
per_frame_init_12=  index += 1;
per_frame_init_13=);
per_frame_init_14=
per_frame_init_15=t1 = rand(3); t2=rand(3); r1=5+rand(50);
per_frame_init_16=trel=rand(1000);
per_frame_init_17=n=0;
per_frame_1=dec_med = pow (0.96, 30/fps);
per_frame_2=dec_slow = pow (0.98, 30/fps);
per_frame_3=beat = max (max (bass, mid), treb); 
per_frame_4=avg = avg*dec_slow + beat*(1-dec_slow);
per_frame_5=is_beat = above(beat, .5+avg+peak) * above (time, t0+.1);
per_frame_6=t00 = is_beat*time + (1-is_beat)*t00;
per_frame_7=peak = is_beat * beat + (1-is_beat)*peak*dec_med;
per_frame_8=index0 = (index0 + is_beat) %8;
per_frame_9=index2 = (index2 + is_beat*bnot(index0))%2;
per_frame_10=index3 = (index3 + is_beat*bnot(index0) * bnot(index2))%2;
per_frame_11=
per_frame_12=q20 = avg;
per_frame_13=q21 = beat;
per_frame_14=q22 = peak;
per_frame_15=q23 = index0;
per_frame_16=q24 = is_beat;
per_frame_17=
per_frame_18=//vol = bass_att + treb_att;
per_frame_19=v2 = v2 * dec_slow + vol * (1-dec_slow) ;
per_frame_20=q26 = max(atan (vol - v2*.8),.3);
per_frame_21=
per_frame_22=q27 = index0 + 1;
per_frame_23=
per_frame_24=sw = sw*dec_med + (1-dec_med)*(index2%2);
per_frame_25=q28 = sw;
per_frame_26=
per_frame_27=k1 =  is_beat*bnot(index0);
per_frame_28=k2 =  is_beat*bnot(index0);
per_frame_29=
per_frame_30=p1 =  k1*(p1+1) + (1-k1)*p1;
per_frame_31=p2 = dec_slow * p2+ (1-dec_slow)*p1;
per_frame_32=rott = p2 * 3.1416/2;
per_frame_33=monitor = k1;
per_frame_34=q1 = cos(rott);
per_frame_35=q2 = sin(rott);
per_frame_36=q3 = -q2;
per_frame_37=q4 = q1;
per_frame_38=
per_frame_39=
per_frame_40=q5 = cos(time/6);
per_frame_41=q6 = -sin(time/6);
per_frame_42=q7 = -q6;
per_frame_43=q8 = q5;
per_frame_44=
per_frame_45=zoom = 1;
per_frame_46=rot = 0;
per_frame_47=
per_frame_48=movez = movez + .006*(q1+1.1)*30/fps;
per_frame_49=q29 = movez;
per_frame_50=rota = rota + .003*(2-q1)*30/fps;
per_frame_51=q30 = rota;
per_frame_52=q31 = 2 + 16*abs(cos(time/18));
per_frame_53=q32 = cos(time/23)/4;
per_frame_54=
per_frame_55=
per_frame_56=//==========
per_frame_57=dt = min (1/fps,0.1) ;
per_frame_58=dec_m = 1 - 4*dt; dec_s = 1 - dt;
per_frame_59=vol = (bass+mid+treb)/3 ;
per_frame_60=vol_=  vol_*dec_m + (1-dec_m)*vol; 
per_frame_61=exc = (vol-vol_)*1;
per_frame_62=
per_frame_63=index=0;
per_frame_64=loop (num_res,
per_frame_65=  n = index*8;
per_frame_66=  w = megabuf(n) * 4*asin(1)/60;
per_frame_67=  megabuf (n+1) *= 1-0.3*dt; //damping
per_frame_68=  ec = int (8*w*dt)+1; 
per_frame_69=  loop (ec,
per_frame_70=    megabuf(n+1) += (exc-sqr(w)*megabuf(n+2)) * dt/ec;
per_frame_71=    megabuf(n+2) += megabuf(n+1) * dt/ec);
per_frame_72=  bc = megabuf(n+1);  
per_frame_73=  bs = megabuf(n+2)*w;
per_frame_74=  megabuf (n+3) = megabuf(n+3) *dec_s + quad* (1-dec_s);
per_frame_75=  megabuf (n+4) = megabuf(n+3);
per_frame_76=  megabuf (n+5) = bc*.11/(1+omaxq)*sqrt(vol_);
per_frame_77=  megabuf (n+6) = bs*.11/(1+omaxq)*sqrt(vol_);
per_frame_78=  index += 1;
per_frame_79=);
per_frame_80=trel += BPM/60*6.2832*dt;
per_frame_81=q19 = min(1,max(0,1+2*sin(trel/64)));
per_frame_82=q18 = min(1,max(0,3*sin((t1+t2)*5)-.5)*(1-q24));
per_frame_83=
per_frame_84=sum = 0; n = 0; maxind = 0; 
per_frame_85=loop (num_res,
per_frame_86=    if (megabuf(n+3) > megabuf(maxind+3), maxind = n, 0);
per_frame_87=n+=8;);
per_frame_88=BPM = megabuf(maxind);
per_frame_89=q17 = BPM;
per_frame_90=idx += (megabuf(maxind+1)*mb<0);
per_frame_91=mb  =megabuf(maxind+1);
per_frame_92=
per_frame_93=
per_frame_94=t1 += (3+mid_att)*dt*0.0012;
per_frame_95=q9= mb;
per_frame_96=q10=min(1,max(-1,4*sin(t1*19)));
per_frame_97=q11= (1.5+sin(t1*13))*r1;
per_frame_98=q12=pow(sin(t1*17),3);
per_frame_99=q13=pow(sin(t1*11),3)*3;
per_frame_100=
per_frame_101=t2 += (3+bass_att)*dt*0.003;
per_frame_102=rot = .04*(sin(t2*3)+.3); 
per_frame_103=dx = .01 *pow(sin(t2*5),3);  
per_frame_104=dy = .02 *pow(sin(t2*7),3);  
per_frame_105=sy = 1+0.05*pow(sin(t2*11),3);
per_frame_106=q14 = aspecty;
per_frame_107=q15=megabuf(maxind+1);
per_frame_108=vt=max(0,min(1,(2.7*vol_-0.7)));
per_frame_109=vt_=dec_m*vt_+(1-dec_m)*vt;
per_frame_110=q16=vt_;
per_frame_111=//monitor = q23;
per_frame_112=//zoom=1; dx=dy=rot=0; 
per_frame_113=
per_frame_114=v3=v3*0.999+0.001*vol_;
per_frame_115=monitor = reg99;
warp_1=`float3 mus;
warp_2=`float2 rs, uv1, uv6, uv7, uv8;
warp_3=`float dx,dy;
warp_4=`shader_body {
warp_5=`uv = uv_orig;
warp_6=`uv1 = (uv-.5) * aspect.xy;
warp_7=`
warp_8=`//BACKGROUND
warp_9=`float2 z = lerp(uv1, 5*q20*mul(uv1,float2x2(_qb)), length(uv1));
warp_10=`float2 uvn =normalize(q13*uv1);
warp_11=`rs = clamp(tan(z)*uvn,-25,25)/2;
warp_12=`
warp_13=`//CRYSTAL
warp_14=`float mult = q31;
warp_15=`uv7 = sin(uv1*mult);
warp_16=`uv8 = uv7;
warp_17=`float2 dist = mul(uv8, float2x2(_qb));
warp_18=`dist *= uv1.x + uv1.y + q32;
warp_19=`
warp_20=`float2 ang2 = atan2 (uv8.yx,z.xy);
warp_21=`ang2 =  floor (.1*q11* ang2)/6;
warp_22=`float2 dir = mul(.5*uv8,float4(cos(ang2), sin(ang2)));
warp_23=`
warp_24=`
warp_25=`z = 1-cos(8*dist);
warp_26=`z = saturate (z);
warp_27=`
warp_28=`//ADD
warp_29=`float2 mask = (z.x + z.y >= .5); //momentan beliebig
warp_30=`//rs = q28*rs + (1-q28)*rs.yx;
warp_31=`uv += .05*rs.yx - .05*mask*rs.yx + .5*mask*z*normalize(dir);
warp_32=`
warp_33=`//ZENTRALSTRAHL
warp_34=`uv6 = mul(uv1,float2x2(_qb));
warp_35=`mus = (0.01/(sqrt(uv6.x)+.001))*(.15 + rad);
warp_36=`
warp_37=`//DOTS
warp_38=`float2 uv2 = .7*uv1+.3*sin(uv1*16+4*float2 (q5,q6));
warp_39=`uv2 *= .25*q16 + .25*q19;
warp_40=`float3 dots = q28*saturate(.001/(tex3D(sampler_noisevol_hq, tex2D(sampler_main, frac(uv2)))));
warp_41=`float3 blur = tex2D(sampler_pw_main, uv);
warp_42=`float3 crisp= tex2D(sampler_main, frac(uv));
warp_43=`float3 diff = crisp - blur/2;
warp_44=`float3 ret1 = crisp + mus + dots;
warp_45=`
warp_46=`float3 mod = tex2D (sampler_noise_hq,.5*uv+time*.01)-.2;
warp_47=`mod = 1-mod*diff;
warp_48=`
warp_49=`ret = ret1*mod - tex2D(sampler_main, mask)*ret1*mod + mod*tex2D(sampler_main, frac(mask))*ret1- .03;
warp_50=`//ret -= .03;
warp_51=`//ret = ret *.98- .03;
warp_52=`
warp_53=`}
comp_1=`float3 ret1, neu, crisp, blur;
comp_2=`float2 uv2, uv3;
comp_3=`
comp_4=`shader_body
comp_5=`{
comp_6=`float ang2, c, s;
comp_7=`uv = (uv -= 0.5)* aspect.xy;    
comp_8=`
comp_9=`float2 tmp = uv;
comp_10=`float dist = 1;
comp_11=`float inten = 1;
comp_12=`float mask = 0;
comp_13=`ret1 = 0;
comp_14=`int anz = 3;
comp_15=`float n = 0;
comp_16=`float t_rel = q29;
comp_17=`while (n <= anz) {
comp_18=`    ang2 = M_PI_2*n/anz+q30;
comp_19=`    c = cos(ang2);
comp_20=`    s = sin(ang2);
comp_21=`    uv2.x =  uv.x*c - uv.y*s;
comp_22=`    uv2.y =  uv.x*s + uv.y*c;
comp_23=`    uv2*= aspect.yx;
comp_24=`
comp_25=`    dist = 1-frac(n/anz+t_rel); //evtl sqrt !
comp_26=`
comp_27=`    inten =  4*dist*(1-dist*dist);
comp_28=`    uv3 = 3*uv2*dist + 0.5+.0*float2(q5,q6);
comp_29=`    crisp = tex2D(sampler_main, frac(3*uv2*dist + 0.5));
comp_30=`    blur = tex2D(sampler_fc_main, frac(uv3));
comp_31=`    ret1 = max(ret1,(crisp+blur)*inten);
comp_32=`n++;
comp_33=`}
comp_34=`
comp_35=`
comp_36=`//float3 ret1;
comp_37=`
comp_38=`ret = ret1;
comp_39=`//ret1 = GetPixel(.5+uv_orig*aspect.yx*1.2);
comp_40=`
comp_41=`
comp_42=`//ret = ret1-.1;
comp_43=`
comp_44=`}
