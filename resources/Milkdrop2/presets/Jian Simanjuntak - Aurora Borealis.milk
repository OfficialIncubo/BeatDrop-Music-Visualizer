per_frame_26=/////////////////////////////////////////////////////////////////////////////////////
per_frame_27=
per_frame_28=// Setelan perbesar tampilan visualisasi (zoom)
per_frame_29=q8 = 1.8;
per_frame_30=
comp_1=`float color_mod1, color_mod2;
comp_2=`float3 retp, color_effect, final_color;
comp_3=`
comp_4=`shader_body
comp_5=`{
comp_6=`float position_x = q5;
comp_7=`float position_y = q6;
comp_8=`
comp_9=`float uv_zoom = 1.0 + q8*(0.5 + 0.5);
comp_10=`uv = (uv - float2(position_x, position_y)) / uv_zoom + 0.5;
comp_11=`
comp_12=`    ret = tex2D(sampler_main, uv).xyz;
comp_13=`    ret *= 2.00; // Kontras
comp_14=`    retp = ret;
comp_15=`
comp_16=`    color_mod1 = dot(retp, float3(0.299, 0.587, 0.114));
comp_17=`    color_mod2 = smoothstep(0.2, 0.8, color_mod1);
comp_18=`    color_effect = lerp(float3(q13, q14, q15), float3(q16, q17, q18), color_mod1*1.5);
comp_19=`    final_color = lerp(color_effect, float3(q19, q20, q21), color_mod2*0.5);
comp_20=`    
comp_21=`    ret = final_color;
comp_22=`}
