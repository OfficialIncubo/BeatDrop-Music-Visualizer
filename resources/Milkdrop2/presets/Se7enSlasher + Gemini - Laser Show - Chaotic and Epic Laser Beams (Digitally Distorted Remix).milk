###################################################################################################

MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5.000
fGammaAdj=1.900
fDecay=0.970
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=1
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=1.000
fWaveSmoothing=0.630
fWaveParam=-1.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.331
fZoomExponent=1.00000
fShader=0.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=1.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_init_1=q1=0.0;
per_frame_init_2=q2=40.0;
per_frame_init_3=q5=0.0;
per_frame_init_4=q6=0.0;
per_frame_init_5=time_delay=0.0;
per_frame_init_6=rand_laser = rand(100);
per_frame_1=time_delay = if(time_delay >= .35 && (bass+mid+treb)*.5 > 1.8, 0, time_delay += 1/fps);
per_frame_2=rand_laser = if(time_delay == 0, rand(100), rand_laser); // Random seed from 0 to 100
per_frame_3=
per_frame_4=// We MUST assign these to Q variables so the comp shader can communicate with them
per_frame_5=q1 = rand_laser; // Tells the shader which pattern/color to use
per_frame_6=q2 = time_delay; // Tells the shader when a beat triggers (0 = beat)
per_frame_7=q3 = bass;       // Used for smooth, non-seizure brightness pulsing
warp_1=`shader_body{}
comp_1=`sampler2D sampler_rand42;
comp_2=`sampler2D sampler_rand99;
comp_3=`
comp_4=`float3 GetLaser(float2 uva, float2 origin, float angle, float3 color_vec, float focus) {
comp_5=`    float2 p = uva - origin;
comp_6=`    float2 dir = float2(cos(angle), sin(angle));
comp_7=`    float2 n = float2(-dir.y, dir.x);
comp_8=`    float line_dist = abs(dot(p, n));
comp_9=`    float along = dot(p, dir);
comp_10=`    float core = exp(-line_dist * (4000.0 * focus));
comp_11=`    float glow = 0.0015 / (line_dist + 0.0005);
comp_12=`    float intensity = (core + glow) * smoothstep(-0.02, 0.1, along);
comp_13=`    return color_vec * intensity;
comp_14=`}
comp_15=`
comp_16=`shader_body
comp_17=`{
comp_18=`    float seed = q1;
comp_19=`    float f_mode = fmod(seed, 4.0);
comp_20=`    float col_sel = fmod(seed * 3.14, 4.0);
comp_21=`    
comp_22=`    float3 col1, col2;
comp_23=`    if (col_sel < 1.0) { col1 = float3(1.0, 0.0, 0.5); col2 = float3(0.0, 1.0, 0.8); }
comp_24=`    else if (col_sel < 2.0) { col1 = float3(0.5, 1.0, 0.0); col2 = float3(1.0, 0.3, 0.0); }
comp_25=`    else if (col_sel < 3.0) { col1 = float3(0.4, 0.0, 1.0); col2 = float3(0.1, 0.4, 1.0); }
comp_26=`    else { col1 = float3(1.0, 0.8, 0.2); col2 = float3(1.0, 1.0, 1.0); }
comp_27=`
comp_28=`    float beat_strike = exp(-q2 * 4.0);
comp_29=`    float slow_pulse = 0.7 + 0.3 * sin(time * 3.0 + q3 * 0.4);
comp_30=`    float beam_focus = 1.0 + beat_strike * 3.0;
comp_31=`
comp_32=`    // DIGITAL LOGIC GLITCH
comp_33=`    // Discretize UVs for a tile-like noise lookup, heavily influenced by the transient beat strike
comp_34=`    float2 tile_uv = floor(uv * 64.0) / 64.0;
comp_35=`    float2 glitch_val = tex2D(sampler_rand42, tile_uv * float2(sin(time * 0.5) * 0.1, cos(time * 0.3) * 0.1) +.5).xy;
comp_36=`    float2 uv_glitch = uv + (glitch_val - 0.5) * 0.2 * beat_strike;
comp_37=`
comp_38=`    float grid = abs(frac(uv_glitch.y * 10.0 + time * 0.5) - 0.5) + abs(frac(uv_glitch.x * 10.0 + time * 0.3) - 0.5);
comp_39=`    float3 bg = float3(0.05, 0.05, 0.05) / (grid + 0.1);
comp_40=`    
comp_41=`    // HARDWARE-TEXTURED SMOKE
comp_42=`    // Replaces standard smooth smoke with a grittier rand99 composition
comp_43=`    float3 noise_smoke = tex2D(sampler_rand99, uv_glitch * 2.0 - time * 0.1).rgb;
comp_44=`    float3 smoke = GetBlur2(uv).rgb * 0.5 + noise_smoke * 0.5;
comp_45=`    bg = lerp(bg, smoke * col2, 0.4) * 0.5;
comp_46=`
comp_47=`    float3 lasers = float3(0, 0, 0);
comp_48=`
comp_49=`    if (f_mode < 1.0) {
comp_50=`        for (int i = 0; i < 8; i++) {
comp_51=`            float f = i / 7.0;
comp_52=`            float y_pos = 0.1 + f * 0.8;
comp_53=`            float a_L = 0.0 + sin(time * 2.0 + i) * 0.2 + beat_strike * 0.1;
comp_54=`            lasers += GetLaser(uv_glitch, float2(0.0, y_pos), a_L, col1, beam_focus);
comp_55=`            float a_R = 3.14 + sin(time * 2.1 - i) * 0.2 - beat_strike * 0.1;
comp_56=`            lasers += GetLaser(uv_glitch, float2(1.0, y_pos), a_R, col2, beam_focus);
comp_57=`        }
comp_58=`    } 
comp_59=`    else if (f_mode < 2.0) {
comp_60=`        for(int i = 0; i < 6; i++) {
comp_61=`            float f = i / 5.0;
comp_62=`            float sweep = sin(time * 1.5 + f * 3.14);
comp_63=`            lasers += GetLaser(uv_glitch, float2(0.5, 0.9), -1.57 + sweep * 0.8, col1, beam_focus);
comp_64=`            lasers += GetLaser(uv_glitch, float2(0.1, 0.1), 0.5 + sweep * 0.5, col2, beam_focus);
comp_65=`            lasers += GetLaser(uv_glitch, float2(0.9, 0.1), 2.64 - sweep * 0.5, lerp(col1, col2, 0.5), beam_focus);
comp_66=`        }
comp_67=`    }
comp_68=`    else if (f_mode < 3.0) {
comp_69=`        for(int i = 0; i < 16; i++) {
comp_70=`            float f = i / 15.0;
comp_71=`            float offset = sin(time * 2.0 + f * 6.28) * 0.3;
comp_72=`            float angle1 = 1.57 + sin(time + i * 0.2) * 0.3;
comp_73=`            float angle2 = -1.57 + cos(time + i * 0.2) * 0.3;
comp_74=`            lasers += GetLaser(uv_glitch, float2(0.5 + offset, -0.1), angle1, col1, beam_focus);
comp_75=`            lasers += GetLaser(uv_glitch, float2(0.5 - offset, 1.1), angle2, col2, beam_focus);
comp_76=`        }
comp_77=`    }
comp_78=`    else {
comp_79=`        for(int i = 0; i < 10; i++) {
comp_80=`            float f = i / 9.0;
comp_81=`            float x_pos = 0.2 + f * 0.6;
comp_82=`            float ang_T = -1.57 + sin(time * 4.0 + i) * 1.2 * beat_strike;
comp_83=`            float ang_B = 1.57 + cos(time * 4.0 - i) * 1.2 * beat_strike;
comp_84=`            lasers += GetLaser(uv_glitch, float2(x_pos, 1.0), ang_T, col1, beam_focus);
comp_85=`            lasers += GetLaser(uv_glitch, float2(x_pos, 0.0), ang_B, col2, beam_focus);
comp_86=`        }
comp_87=`    }
comp_88=`
comp_89=`    lasers *= slow_pulse;
comp_90=`    float center_flare = 0.02 / (length(uv_glitch - float2(0.5, 0.5)) + 0.01);
comp_91=`    float3 flare = center_flare * col1 * beat_strike * 0.5;
comp_92=`
comp_93=`    ret = bg + lasers + flare;
comp_94=`}
