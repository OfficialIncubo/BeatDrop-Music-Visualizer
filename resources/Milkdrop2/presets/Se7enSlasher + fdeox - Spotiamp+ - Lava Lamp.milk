warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float hash(float2 p)
warp_7=`{
warp_8=`    return frac(sin(dot(p, float2(41.3, 289.1))) * 43758.5453);
warp_9=`}
warp_10=`
warp_11=`shader_body
warp_12=`{
warp_13=`    float2 my_uv = (uv - .5) * aspect.xy * 2;
warp_14=`    float2 sc = float2(uv.x, 1.0 - uv.y);
warp_15=`
warp_16=`    float f = 0.0;
warp_17=`    for (int k = 0; k < 6; k++)
warp_18=`    {
warp_19=`        float fk = float(k);
warp_20=`        float2 c = float2(sin(fk * 2.3 + time * 0.7) * 0.2 * aspect.x, sin(time * (0.6 + hash(float2(fk, 1.0)) * 0.8) + fk * 1.7) * 0.4);
warp_21=`        float radius = 0.08 + 0.05 * hash(float2(fk, 2.0)) + bass_att * 0.03;
warp_22=`        f += radius * radius / max(dot(my_uv - c, my_uv - c), 0.0001);
warp_23=`    }
warp_24=`
warp_25=`    float blob = smoothstep(0.9, 1.1, f);
warp_26=`    float3 wax = lerp(float3(1.0, 0.25, 0.1), float3(1.0, 0.75, 0.2), saturate(f - 1.0));
warp_27=`    float3 bg = lerp(float3(0.25, 0.0, 0.3), float3(0.6, 0.1, 0.35), sc.y);
warp_28=`    float3 col = lerp(bg, wax, blob) + float3(1.0, 0.5, 0.3) * smoothstep(0.6, 1.0, f) * (1.0 - blob) * 0.3;
warp_29=`
warp_30=`    ret = col;
warp_31=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
