shape_0_per_frame1=i=instance;ph=q1;bn=q3;tr=q4;z=.17*(1+.05*bn);s1=sin(ph);s3=sin(2*ph);bl=below(time/3.3-int(time/3.3),.04);
shape_0_per_frame2=hx=0;hy=0;la=0;lh=0;aL=-.3;aR=.3;fL=aL-.2;fR=aR+.2;uL=-.18;uR=.18;lL=uL;lR=uR;
shape_0_per_frame3=hx=.14*s1;hy=.07*abs(s1)+.16*bn;la=.2*s1;lh=.3*sin(ph+1)+.12*s3;
shape_0_per_frame4=aL=-(1.4+1.2*s1);aR=1.4-1.2*s1;fL=aL-.5-.5*sin(2*ph+.5);fR=aR+.5+.5*sin(2*ph+.5);
shape_0_per_frame5=lfL=max(s1,0);lfR=max(-s1,0);uL=-.18-.45*lfL;uR=.18+.45*lfR;lL=uL+1.6*lfL;lR=uR-1.6*lfR;
shape_0_per_frame6=shx=hx+.75*sin(la);shy=hy+.75*cos(la);hdx=shx+.6*sin(lh);hdy=shy+.6*cos(lh);slx=shx-.3;sly=shy-.05;srx=shx+.3;sry=shy-.05;
shape_0_per_frame7=ealx=slx+.5*sin(aL);ealy=sly-.5*cos(aL);earx=srx+.5*sin(aR);eary=sry-.5*cos(aR);hlx=ealx+.45*sin(fL);hly=ealy-.45*cos(fL);hrx=earx+.45*sin(fR);hry=eary-.45*cos(fR);
shape_0_per_frame8=plx=hx-.17;ply=hy-.25;prx=hx+.17;pry=hy-.25;
shape_0_per_frame9=kLx=plx+.45*sin(uL);kLy=ply-.45*cos(uL);kRx=prx+.45*sin(uR);kRy=pry-.45*cos(uR);anLx=kLx+.45*sin(lL);anLy=kLy-.45*cos(lL);anRx=kRx+.45*sin(lR);anRy=kRy-.45*cos(lR);
shape_0_per_frame10=ox=0;oy=0;orad=0;pk=0;bk=0;gy=0;hl=0;aa=1;
shape_0_per_frame11=m=(i<16);f=i/15;ox=ox+m*(hx+.3+1.05*f+.3*f*sin(2*ph-4*f));oy=oy+m*(hy-.25+.6*sin(3*f));orad=orad+m*(.12-.07*f);pk=pk+m;
shape_0_per_frame12=m=(i>=16)*(i<21);f=(i-16)/4;ox=ox+m*(plx+(kLx-plx)*f);oy=oy+m*(ply+(kLy-ply)*f);orad=orad+m*(.15-.02*f);
shape_0_per_frame13=m=(i>=21)*(i<26);f=(i-21)/4;ox=ox+m*(kLx+(anLx-kLx)*f);oy=oy+m*(kLy+(anLy-kLy)*f);orad=orad+m*(.13-.02*f);
shape_0_per_frame14=m=(i>=26)*(i<29);f=(i-26)/2;ox=ox+m*(anLx-.17*f);oy=oy+m*(anLy-.07);orad=orad+m*(.115-.02*f);pk=pk+m;
shape_0_per_frame15=m=(i>=29)*(i<34);f=(i-29)/4;ox=ox+m*(prx+(kRx-prx)*f);oy=oy+m*(pry+(kRy-pry)*f);orad=orad+m*(.15-.02*f);
shape_0_per_frame16=m=(i>=34)*(i<39);f=(i-34)/4;ox=ox+m*(kRx+(anRx-kRx)*f);oy=oy+m*(kRy+(anRy-kRy)*f);orad=orad+m*(.13-.02*f);
shape_0_per_frame17=m=(i>=39)*(i<42);f=(i-39)/2;ox=ox+m*(anRx+.17*f);oy=oy+m*(anRy-.07);orad=orad+m*(.115-.02*f);pk=pk+m;
shape_0_per_frame18=m=(i>=42)*(i<54);f=(i-42)/11;ox=ox+m*(hx+(shx-hx)*f);oy=oy+m*(hy+(shy-hy)*f);orad=orad+m*(.45-.15*f+.05*sin(3.14*f));
shape_0_per_frame19=m=(i>=54)*(i<59);f=(i-54)/4;ox=ox+m*(slx+(ealx-slx)*f);oy=oy+m*(sly+(ealy-sly)*f);orad=orad+m*(.115-.015*f);
shape_0_per_frame20=m=(i>=59)*(i<64);f=(i-59)/4;ox=ox+m*(ealx+(hlx-ealx)*f);oy=oy+m*(ealy+(hly-ealy)*f);orad=orad+m*(.10-.01*f);
shape_0_per_frame21=m=(i==64);ox=ox+m*(hlx+.09*sin(fL));oy=oy+m*(hly-.09*cos(fL));orad=orad+m*.115;pk=pk+m;
shape_0_per_frame22=m=(i>=65)*(i<70);f=(i-65)/4;ox=ox+m*(srx+(earx-srx)*f);oy=oy+m*(sry+(eary-sry)*f);orad=orad+m*(.115-.015*f);
shape_0_per_frame23=m=(i>=70)*(i<75);f=(i-70)/4;ox=ox+m*(earx+(hrx-earx)*f);oy=oy+m*(eary+(hry-eary)*f);orad=orad+m*(.10-.01*f);
shape_0_per_frame24=m=(i==75);ox=ox+m*(hrx+.09*sin(fR));oy=oy+m*(hry-.09*cos(fR));orad=orad+m*.115;pk=pk+m;
shape_0_per_frame25=m=(i==76);ox=ox+m*(hdx-.31+.03*sin(2*ph+1));oy=oy+m*(hdy+.34+.03*cos(2*ph+1));orad=orad+m*.27;
shape_0_per_frame26=m=(i==77);ox=ox+m*(hdx+.31-.03*sin(2*ph+1));oy=oy+m*(hdy+.34+.03*cos(2*ph+1));orad=orad+m*.27;
shape_0_per_frame27=m=(i==78);ox=ox+m*(hdx-.31+.03*sin(2*ph+1));oy=oy+m*(hdy+.34+.03*cos(2*ph+1));orad=orad+m*.15;pk=pk+m;
shape_0_per_frame28=m=(i==79);ox=ox+m*(hdx+.31-.03*sin(2*ph+1));oy=oy+m*(hdy+.34+.03*cos(2*ph+1));orad=orad+m*.15;pk=pk+m;
shape_0_per_frame29=m=(i==80);ox=ox+m*hdx;oy=oy+m*hdy;orad=orad+m*.43;
shape_0_per_frame30=m=(i==81);ox=ox+m*hdx;oy=oy+m*(hdy-.18);orad=orad+m*.34;
shape_0_per_frame31=m=(i>=82)*(i<84);sg=(i==83)*2-1;ox=ox+m*(hdx+sg*.27);oy=oy+m*(hdy-.12);orad=orad+m*.09;pk=pk+m;aa=aa-m*.55;
shape_0_per_frame32=m=(i>=84)*(i<86);sg=(i==85)*2-1;ox=ox+m*(hdx+sg*.17);oy=oy+m*(hdy+.1);orad=orad+m*.075*(1-.85*bl);bk=bk+m;
shape_0_per_frame33=m=(i>=86)*(i<88);sg=(i==87)*2-1;ox=ox+m*(hdx+sg*.17+.025);oy=oy+m*(hdy+.13);orad=orad+m*.026*(1-bl);hl=hl+m;
shape_0_per_frame34=m=(i==88);ox=ox+m*hdx;oy=oy+m*(hdy-.13);orad=orad+m*.062;pk=pk+m;
shape_0_per_frame35=m=(i>=89)*(i<129);j=(i-89)%20;wk=j%10;wl=int(j/10);sg=(i>=109)*2-1;dw=.18+.05*wk;aw=.28-.5*wl+.06*sin(2*ph+2*wl);ox=ox+m*(hdx+sg*(.14+dw*cos(aw)));oy=oy+m*(hdy-.13+dw*sin(aw));orad=orad+m*.016;gy=gy+m;
shape_0_per_frame36=m=(i>=129)*(i<132);j=i-129;ox=ox+m*(hdx+(j-1)*.07);oy=oy+m*(hdy-.27+.035*abs(j-1));orad=orad+m*.017;pk=pk+m;bk=bk+m*.5;
shape_0_per_frame37=rr=1;gg=1-.34*pk;bb=1-.24*pk;dk=(1-.9*bk)*(1-.38*gy);ed=.94+.06*hl;
shape_0_per_frame38=x=.5+.03*sin(.4*time)+z*ox/q6;y=.42+z*oy;rad=z*orad;sides=24;ang=0;textured=0;additive=0;thick=0;a=aa;a2=aa;border_a=0;
shape_0_per_frame39=r=rr*dk;g=gg*dk;b=bb*dk;r2=r*ed;g2=g*ed;b2=b*ed;
per_frame_init_1=ph=0;avgb=1;tb=0;bnc=0;sz=0;
per_frame_1=dt=1/fps;dc=pow(.86,30/fps);
per_frame_2=avgb=avgb*.97+bass*.03;
per_frame_3=kick=above(bass,avgb*1.25+.08)*above(time,tb+.2);
per_frame_4=tb=kick*time+(1-kick)*tb;
per_frame_5=bnc=max(bnc*dc,kick);
per_frame_6=ph=ph+dt*(5.2+2.2*bass_att);
per_frame_7=sz=sz+dt*(.05+.04*bass_att+.10*bnc);
per_frame_8=q1=ph;
per_frame_9=q3=bnc;
per_frame_10=q4=treb_att;
per_frame_11=q6=aspecty;
per_frame_12=q7=sz;
per_frame_13=q9=time*.07;
per_frame_14=q10=.28*sin(time*.9);
per_frame_15=q11=.28*sin(time*.7+2);
warp_1=`sampler sampler_pw_noise_lq;
warp_2=`float3 starlayer(float2 p, float fk, float tt, float strch)
warp_3=`{
warp_4=`  float zd = frac(tt + fk*.25);
warp_5=`  float sc = lerp(16., 1.4, zd);
warp_6=`  float fade = smoothstep(0., .12, zd)*(1.-smoothstep(.8, 1., zd));
warp_7=`  float2 g = p*sc + fk*17.31;
warp_8=`  float2 id = floor(g);
warp_9=`  float2 gv = frac(g) - .5;
warp_10=`  float4 nz = tex2D(sampler_pw_noise_lq, (id + .5)/256.);
warp_11=`  float2 dv = gv - (nz.xy - .5)*.7;
warp_12=`  float2 rd = normalize(p + .0001);
warp_13=`  float al = dot(dv, rd);
warp_14=`  float pe = dv.x*rd.y - dv.y*rd.x;
warp_15=`  float d = length(float2(al/(1. + strch*zd*4.), pe));
warp_16=`  float sz = .045 + .08*nz.z*zd;
warp_17=`  float st = saturate(1. - d/sz);
warp_18=`  st = st*st*st;
warp_19=`  float tw = .65 + .35*sin(time*4. + nz.z*40.);
warp_20=`  float3 tint = lerp(float3(.65,.8,1.), float3(1.,.85,.6), (nz.w - .5)*2.);
warp_21=`  return tint*st*fade*tw*step(.5, nz.w)*(1.1 + nz.z*1.2);
warp_22=`}
warp_23=`shader_body
warp_24=`{
warp_25=`  float2 p = (uv_orig - .5)*float2(texsize.x*texsize.w, 1.);
warp_26=`  float3 col = 0.;
warp_27=`  for (int k = 0; k < 4; k++)
warp_28=`  {
warp_29=`    col += starlayer(p, (float)k, q7, q3);
warp_30=`  }
warp_31=`  float nb1 = tex2D(sampler_noise_lq, p*.35 + time*.003).r * tex2D(sampler_noise_lq, p*.9 - time*.002).g;
warp_32=`  float3 neb = float3(.02,.035,.09) + float3(.18,.07,.28)*nb1*nb1*.9;
warp_33=`  ret = col + neb;
warp_34=`}
comp_1=`float rat_spectrum(float band, float count)
comp_2=`{
comp_3=`    // Sample evenly within each logarithmic display band.
comp_4=`    float4 lo = pow((band + float4(0.0625, 0.1875, 0.3125, 0.4375)) / count, 1.0 / 0.62);
comp_5=`    float4 hi = pow((band + float4(0.5625, 0.6875, 0.8125, 0.9375)) / count, 1.0 / 0.62);
comp_6=`    lo = max(lo, 1.5 / 1024.0);
comp_7=`    hi = max(hi, 1.5 / 1024.0);
comp_8=`    float low_peak = max(max(get_fft(lo.x), get_fft(lo.y)), max(get_fft(lo.z), get_fft(lo.w)));
comp_9=`    float high_peak = max(max(get_fft(hi.x), get_fft(hi.y)), max(get_fft(hi.z), get_fft(hi.w)));
comp_10=`    float center = pow((band + 0.5) / count, 1.0 / 0.62);
comp_11=`    return saturate(0.80 * sqrt(max(max(low_peak, high_peak), 0.0)) * (0.9 + 0.65 * center));
comp_12=`}
comp_13=`float3 hsv(float h)
comp_14=`{
comp_15=`  return saturate(abs(frac(h + float3(0., .6667, .3333))*6. - 3.) - 1.);
comp_16=`}
comp_17=`float lightbeam(float2 p, float2 o, float2 t, float w0, float sp)
comp_18=`{
comp_19=`  float2 d = normalize(t - o);
comp_20=`  float2 v = p - o;
comp_21=`  float al = dot(v, d);
comp_22=`  float pe = v.x*d.y - v.y*d.x;
comp_23=`  float w = w0 + max(al, 0.)*sp;
comp_24=`  return step(0., al)*(1. - smoothstep(w*.3, w, abs(pe)))*exp(-al*.55);
comp_25=`}
comp_26=`shader_body
comp_27=`{
comp_28=`  float2 p = (uv - .5)*float2(texsize.x*texsize.w, 1.);
comp_29=`  float edge = smoothstep(.04, .075, uv.x);
comp_30=`  float3 scene = GetPixel(uv)*edge;
comp_31=`  float bn = q3;
comp_32=`
comp_33=`  // ---- lampu sorot ----
comp_34=`  float3 c0 = float3(1., .96, .88);
comp_35=`  float3 c1 = hsv(q9);
comp_36=`  float3 c2 = hsv(q9 + .5);
comp_37=`  float k0 = lightbeam(p, float2(0., -.62),  float2(0.,  .03), .06,  .16);
comp_38=`  float k1 = lightbeam(p, float2(-.62, -.62), float2(q10, .03), .045, .13);
comp_39=`  float k2 = lightbeam(p, float2(.62, -.62),  float2(q11, .03), .045, .13);
comp_40=`  float3 lgt = .38 + c0*k0*(1.08 + .6*bn) + c1*k1*(.7 + .5*bn) + c2*k2*(.7 + .5*bn);
comp_41=`  float3 col = scene*lgt;
comp_42=`  col += GetBlur2(uv)*edge*lgt*.22;
comp_43=`  col += (c0*k0*.22 + c1*k1*.14 + c2*k2*.14)*(.7 + .3*bn);
comp_44=`
comp_45=`  // ---- lantai panggung + lingkaran cahaya ----
comp_46=`  float fl = smoothstep(.29, .32, p.y);
comp_47=`  float pool = 1. - smoothstep(.3, 1., length((p - float2(0., .33))/float2(.36, .045)));
comp_48=`  float3 fcol = float3(.025,.02,.045) + c0*pool*.55*(.7 + .4*bn) + c1*pool*.15;
comp_49=`  col = lerp(col, col*.4 + fcol, fl);
comp_50=`
comp_51=`  // ---- spectrum bars rainbow ----
comp_52=`  float nbars = 64.;
comp_53=`  float cx = clamp(floor(uv.x*nbars), 0.0, nbars - 1.0);
comp_54=`  float fx = frac(uv.x*nbars);
comp_55=`  float amp = rat_spectrum(cx, nbars);
comp_56=`  float hgt = pow(amp, .85)*.25 + .004;
comp_57=`  float fb = 1. - uv.y;
comp_58=`  float colmask = (1. - smoothstep(.86, .94, fx))*smoothstep(.06, .14, fx);
comp_59=`  float inside = step(fb, hgt)*colmask;
comp_60=`  float seg = step(.22, frac(fb/.011));
comp_61=`  float3 bc = hsv(cx/nbars*.92 + q9*.3);
comp_62=`  float vg = .55 + .75*saturate(fb/max(hgt, .001));
comp_63=`  col = lerp(col, bc*vg*1.15, inside*seg);
comp_64=`  col += bc*exp(-max(fb - hgt, 0.)*55.)*.35*colmask;
comp_65=`
comp_66=`  // ---- vignette ----
comp_67=`  col *= 1. - .66*dot(p, p);
comp_68=`  ret = saturate(col);
comp_69=`}
