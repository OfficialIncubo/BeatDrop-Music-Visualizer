wavecode_0_r=1.000
wavecode_0_g=1.000
wavecode_0_b=1.000
wavecode_0_a=0.000
wave_0_per_point1=x = 0+(sample);
wave_0_per_point2=y = value1;
wave_0_per_point3=
wave_0_per_point4=gmegabuf(2000+int(sample*50)) = value1+value2;
shapecode_0_enabled=1
shapecode_0_sides=4
shapecode_0_additive=0
shapecode_0_thickOutline=0
shapecode_0_textured=0
shapecode_0_num_inst=1000
shapecode_0_x=0.500
shapecode_0_y=0.500
shapecode_0_rad=0.04983
shapecode_0_ang=0.00000
shapecode_0_tex_ang=0.00000
shapecode_0_tex_zoom=1.00000
shapecode_0_r=1.000
shapecode_0_g=1.000
shapecode_0_b=1.000
shapecode_0_a=1.000
shapecode_0_r2=1.000
shapecode_0_g2=1.000
shapecode_0_b2=1.000
shapecode_0_a2=1.000
shapecode_0_border_r=0.000
shapecode_0_border_g=0.000
shapecode_0_border_b=0.000
shapecode_0_border_a=0.000
shape_0_per_frame1=x = 0.015 + int(instance/20)*.0198;
shape_0_per_frame2=y = 0.0185 + (instance%20)*.0352;
shape_0_per_frame3=
shape_0_per_frame4=a = 0 + if(gmegabuf(2000+int(instance/20)) * 20 > (instance%20),1,if(gmegabuf(2000+int(instance/20)) * 20 < (instance%20),0,0));
shape_0_per_frame5=a2 = 0 + if(gmegabuf(2000+int(instance/20)) * 20 > (instance%20),1,if(gmegabuf(2000+int(instance/20)) * 20 < (instance%20),0,0));
shape_0_per_frame6=
shape_0_per_frame7=r = gmegabuf(2000+int(instance/20));
shape_0_per_frame8=g = sin(gmegabuf(2000+int(instance/20))*3);
shape_0_per_frame9=b = abs(gmegabuf(2000+int(instance/20))-1);
shape_0_per_frame10=
shape_0_per_frame11=r2 = gmegabuf(2000+int(instance/20));
shape_0_per_frame12=g2 = sin(gmegabuf(2000+int(instance/20))*3);
shape_0_per_frame13=b2 = abs(gmegabuf(2000+int(instance/20))-1);
per_frame_init_1=
per_frame_init_2=i = 0;
per_frame_init_3=loop(1000000,gmegabuf(i) = 0;i=i+1;);
per_frame_init_4=
per_frame_init_5=bassc = 0;
per_frame_init_6=trav = 0;
per_frame_init_7=
per_frame_init_8=q3 = 0;
per_frame_1=wave_a = 0;
per_frame_2=
per_frame_3=q1 = aspecty;
per_frame_4=
per_frame_5=q2 = if(above(bass*.4,q2),q2+bass*.2,q2-bass*.001)*.02;
per_frame_6=    
per_frame_7=trav += q2;
per_frame_8=q3 = trav;
per_frame_9=
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`
warp_6=`    ret -= ret*.05 + .005;
warp_7=`}
comp_1=`shader_body
comp_2=`{
comp_3=`
comp_4=`    float2 nUV = uv;
comp_5=`    nUV.x -= .5;
comp_6=`    nUV.x *= 2 - (uv.y * 1.5);
comp_7=`    nUV.x += .5;
comp_8=` 
comp_9=`    float2 rUV = float2(uv.x,-uv.y);
comp_10=`    rUV.x -= .5;
comp_11=`    rUV.x *= 2 - ((-uv.y+1) * 1.5);
comp_12=`    rUV.x += .5;
comp_13=`
comp_14=`    ret = tex2D(sampler_main, float2(nUV.x-(q3),nUV.y)).xyz;
comp_15=`    float3 ret2 = tex2D(sampler_main, float2(rUV.x-(q3),rUV.y)).xyz;
comp_16=`
comp_17=`    ret *= 2.00; //gamma
comp_18=`    ret = max(ret,ret2);
comp_19=`
comp_20=`    float3 bg = float3(bass_att,treb_att,mid_att)*.1;
comp_21=`    if(ret.x+ret.y+ret.z <= .1){
comp_22=`       ret = bg;
comp_23=`    }
comp_24=`}
