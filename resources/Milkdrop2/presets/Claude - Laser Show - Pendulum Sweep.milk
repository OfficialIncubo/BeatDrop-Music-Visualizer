MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5.000
fGammaAdj=1.880
fDecay=0.970
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=1
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=1.000
fWaveSmoothing=0.630
fWaveParam=-1.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.331
fZoomExponent=1.00000
fShader=0.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=1.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.000
wave_y=0.000
ob_size=0.010
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.010
ib_r=0.250
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.900
mv_r=1.000
mv_g=1.000
mv_b=1.000
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
per_frame_init_1=q1=0.0;
per_frame_init_2=q2=40.0;
per_frame_init_3=q5=0.0;
per_frame_init_4=q6=0.0;
per_frame_init_5=time_delay=0.0;
per_frame_init_6=rand_laser=rand(110);
per_frame_init_7=temp1 = 0;
per_frame_1=// SKELETON (kept intact, slower retrigger fits the hypnotic pendulum pacing)
per_frame_2=time_delay = if(time_delay >= .45 && bass > 2, 0, time_delay += 1/fps);
per_frame_3=rand_laser = if(time_delay == 0, rand(110), rand_laser);
per_frame_4=
per_frame_5=// Custom variable mapping to feed the Comp Shader
per_frame_6=q1 = rand_laser;                          // color palette seed
per_frame_7=q2 = time_delay;                          // beat clock (0 = beat)
per_frame_8=temp1 += q3 + (0.35 + mid_att*0.10)/fps;      // continuous pendulum swing clock (never resets)
per_frame_9=q3 = temp1;
per_frame_10=temp2 = if(time_delay == 0, 1.0, temp2 * 0.90); // swing-amplitude kick, decays back to rest
per_frame_11=q5 = temp2;
per_frame_12=q6 = 0.5 + 0.5*sin(time*0.22 + rand_laser*0.05); // slow color drift phase
warp_1=`shader_body {}
comp_1=`float3 GetLaser(float2 uva, float2 origin, float angle, float3 color_vec, float focus) {
comp_2=`    float2 p = uva - origin;
comp_3=`    float2 dir = float2(cos(angle), sin(angle));
comp_4=`    float2 n = float2(-dir.y, dir.x);
comp_5=`    float line_dist = abs(dot(p, n));
comp_6=`    float along = dot(p, dir);
comp_7=`    float core = exp(-line_dist * (4000.0 * focus));
comp_8=`    float glow = 0.0017 / (line_dist + 0.0007);
comp_9=`    float intensity = (core + glow) * smoothstep(-0.02, 0.1, along);
comp_10=`    return color_vec * intensity;
comp_11=`}
comp_12=`
comp_13=`shader_body
comp_14=`{
comp_15=`    float2 p = uv;
comp_16=`
comp_17=`    float col_sel = fmod(q1 * 2.3, 4.0);
comp_18=`    float3 col1, col2;
comp_19=`    if (col_sel < 1.0) { col1 = float3(0.9, 0.1, 0.2); col2 = float3(1.0, 0.7, 0.0); }
comp_20=`    else if (col_sel < 2.0) { col1 = float3(0.1, 0.6, 1.0); col2 = float3(0.6, 0.9, 1.0); }
comp_21=`    else if (col_sel < 3.0) { col1 = float3(0.8, 0.0, 1.0); col2 = float3(1.0, 0.2, 0.8); }
comp_22=`    else { col1 = float3(0.2, 1.0, 0.5); col2 = float3(1.0, 1.0, 0.6); }
comp_23=`
comp_24=`    float beat_strike = exp(-q2 * 4.0);
comp_25=`    float beam_focus = 1.0 + beat_strike * 2.2;
comp_26=`
comp_27=`    // 1. PENDULUM SWEEP
comp_28=`    // Each beam hangs from a fixed point along the top edge and swings like a
comp_29=`    // pendulum: a damped sine drive with an extra harmonic gives it a slightly
comp_30=`    // asymmetric, physical "swing" feel rather than a perfectly even oscillation.
comp_31=`    // Bass hits add an impulse (q5) that briefly widens the swing amplitude,
comp_32=`    // like the pendulum getting kicked.
comp_33=`    float3 lasers = float3(0,0,0);
comp_34=`    int N = 7;
comp_35=`    for (int i = 0; i < N; i++) {
comp_36=`        float f = float(i) / float(N-1);
comp_37=`        float2 anchor = float2(0.08 + f*0.84, 1.02);
comp_38=`
comp_39=`        float phase_off = f * 1.8;
comp_40=`        float amp = 0.55 + q5*0.35; // swing amplitude, kicked wider on beat
comp_41=`        float swing = sin(q3 + phase_off) * amp + sin(q3*1.9 + phase_off*1.3) * amp * 0.18;
comp_42=`
comp_43=`        float angle = -1.5707963 + swing; // hangs downward, swings left/right
comp_44=`
comp_45=`        float3 col = lerp(col1, col2, frac(f*1.3 + q6));
comp_46=`        lasers += GetLaser(p, anchor, angle, col, beam_focus) * 0.85;
comp_47=`    }
comp_48=`
comp_49=`    // 2. Smoke from MilkDrop's blur buffer, kept low so beams read cleanly against it
comp_50=`    float3 smoke = GetBlur2(uv).rgb * 0.55;
comp_51=`    float3 bg = smoke * col2 * 0.13;
comp_52=`
comp_53=`    // 3. Soft anchor glow row along the top edge, like fixture housings
comp_54=`    float anchor_row = exp(-abs(p.y-1.0)*40.0) * 0.18;
comp_55=`    lasers += lerp(col1,col2,0.5) * anchor_row;
comp_56=`
comp_57=`    // 4. Beat impulse: brief brightening across all beams, additive not multiplicative
comp_58=`    float3 flash = lerp(col1,col2,0.5) * beat_strike * 0.3;
comp_59=`
comp_60=`    // 5. Slow non-seizure breathing so the scene stays alive between swings
comp_61=`    float breathe = 0.82 + 0.18*sin(time*0.45 + q6*3.14159);
comp_62=`
comp_63=`    float3 final_rgb = (lasers * breathe) + bg + flash;
comp_64=`    ret = final_rgb;
comp_65=`}
