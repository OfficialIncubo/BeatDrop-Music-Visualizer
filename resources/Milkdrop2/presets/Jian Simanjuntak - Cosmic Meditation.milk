shape_0_per_frame1=// =============== BINTANG ===============
shape_0_per_frame2=sample = instance / num_inst;
shape_0_per_frame3=
shape_0_per_frame4=speed = time * -0.2;
shape_0_per_frame5=
shape_0_per_frame6=oz = (sample + speed);
shape_0_per_frame7=oz = oz - int(oz); 
shape_0_per_frame8=oz = 1.0 - oz;
shape_0_per_frame9=oz = max(oz, 0.000);
shape_0_per_frame10=
shape_0_per_frame11=ox = sin(instance * 34.23 + 12.4);
shape_0_per_frame12=oy = cos(instance * 21.11 + 33.2);
shape_0_per_frame13=
shape_0_per_frame14=// Posisi X dan Y pada bintangnya
shape_0_per_frame15=x = 0.5 + (ox * 0.5) / oz;
shape_0_per_frame16=y = 0.0 + (oy * 0.5) / oz;
shape_0_per_frame17=
shape_0_per_frame18=// Membesarkan bentuk pada bintangnya 
shape_0_per_frame19=rad = min(0.015 / oz, 0.08);
