per_frame_1=// composite shader control
per_frame_2=mov = mov + (.012+.015*(bass_att+mid_att+treb_att)/3)*30/fps;
per_frame_3=q1 = mov;
per_frame_4=
per_frame_5=q2 = (bass_att+mid_att+treb_att)/3;
warp_1=`sampler sampler_SpiritualMeditation_Mask01;
warp_2=`
warp_3=`shader_body
warp_4=`{
warp_5=`float4 color = tex2D(sampler_SpiritualMeditation_Mask01, uv);
warp_6=`ret = float4(color.r, color.g, color.b, color.a);
warp_7=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float2 p = (uv-0.8)*aspect.xy;
comp_4=`    float3 col = GetBlur2(uv)*0.4 + float3(.01,.01,.03);
comp_5=`    float2 src = float2(-0.36,-0.6);                   // sumber di atas layar
comp_6=`    float2 v = p - src;
comp_7=`    float len = length(v);
comp_8=`    float aa = atan2(v.x, v.y);                    // 0 = lurus ke bawah
comp_9=`    for (int n = 0; n < 8; n++)
comp_10=`    {
comp_11=`        float fn = n;
comp_12=`        float ba = sin(q1*(0.1+fn*0.01) + fn*2.1)*0.8 + (fn-2)*0.05;
comp_13=`        float d = abs(frac((aa-ba)/6.28318 + 0.5) - 0.5)*6.28318;
comp_14=`        float beam = exp(-d*d*180)*(0.6+q2)/(1+len*2.6);
comp_15=`        float3 bc = float3(0.4, 0.4, 1.0);
comp_16=`        col += beam*bc;
comp_17=`    }
comp_18=`    col += GetPixel(uv)*1.0;
comp_19=`    col += float3(0.4,0.4,1.0)*saturate(p.y*-2);     // Garis agak terang
comp_20=`    ret = col;
comp_21=`}
