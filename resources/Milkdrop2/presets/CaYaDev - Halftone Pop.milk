nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
wavecode_0_enabled=1
wavecode_0_samples=200
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=0
wavecode_0_bAdditive=0
wavecode_0_scaling=1
wavecode_0_smoothing=0.5
wavecode_0_r=1
wavecode_0_g=1
wavecode_0_b=1
wavecode_0_a=1
wave_0_per_frame1=a = 0.45*min(1, q30)*min(1, max(0, treb_att - 0.8));
wave_0_per_point1=x = 0.1 + sample*0.8;
wave_0_per_point2=y = 0.5 + value1*0.18 + 0.08*sin(sample*9 + time);
wave_0_per_point3=r = 0.12;
wave_0_per_point4=g = 0.2;
wave_0_per_point5=b = 0.75;
shapecode_0_enabled=1
shapecode_0_sides=48
shapecode_0_additive=0
shapecode_0_thickOutline=0
shapecode_0_textured=0
shapecode_0_num_inst=1
shapecode_0_x=0.5
shapecode_0_y=0.5
shapecode_0_rad=0.12
shapecode_0_ang=0
shapecode_0_tex_ang=0
shapecode_0_tex_zoom=1
shapecode_0_r=1
shapecode_0_g=0.2
shapecode_0_b=0.35
shapecode_0_a=1
shapecode_0_r2=0.9
shapecode_0_g2=0.1
shapecode_0_b2=0.3
shapecode_0_a2=1
shapecode_0_border_r=1
shapecode_0_border_g=1
shapecode_0_border_b=1
shapecode_0_border_a=0
shape_0_per_frame1=x = 0.5 + 0.22*cos(q2)*q31;
shape_0_per_frame2=y = 0.5 + 0.22*sin(q2*1.3)*q32;
shape_0_per_frame3=rad = 0.07 + 0.03*q4;
shape_0_per_frame4=a = 1;
shape_0_per_frame5=a2 = 1;
shapecode_1_enabled=1
shapecode_1_sides=48
shapecode_1_additive=0
shapecode_1_thickOutline=0
shapecode_1_textured=0
shapecode_1_num_inst=1
shapecode_1_x=0.5
shapecode_1_y=0.5
shapecode_1_rad=0.1
shapecode_1_ang=0
shapecode_1_tex_ang=0
shapecode_1_tex_zoom=1
shapecode_1_r=0.1
shapecode_1_g=0.75
shapecode_1_b=1
shapecode_1_a=1
shapecode_1_r2=0.05
shapecode_1_g2=0.55
shapecode_1_b2=0.95
shapecode_1_a2=1
shapecode_1_border_r=1
shapecode_1_border_g=1
shapecode_1_border_b=1
shapecode_1_border_a=0
shape_1_per_frame1=x = 0.5 + 0.25*cos(q2*0.8 + 2.1)*q31;
shape_1_per_frame2=y = 0.5 + 0.2*sin(q2*1.1 + 2.1)*q32;
shape_1_per_frame3=rad = 0.06 + 0.03*q4;
shape_1_per_frame4=a = 1;
shape_1_per_frame5=a2 = 1;
shapecode_2_enabled=1
shapecode_2_sides=48
shapecode_2_additive=0
shapecode_2_thickOutline=0
shapecode_2_textured=0
shapecode_2_num_inst=1
shapecode_2_x=0.5
shapecode_2_y=0.5
shapecode_2_rad=0.1
shapecode_2_ang=0
shapecode_2_tex_ang=0
shapecode_2_tex_zoom=1
shapecode_2_r=1
shapecode_2_g=0.85
shapecode_2_b=0.1
shapecode_2_a=1
shapecode_2_r2=1
shapecode_2_g2=0.6
shapecode_2_b2=0.05
shapecode_2_a2=1
shapecode_2_border_r=1
shapecode_2_border_g=1
shapecode_2_border_b=1
shapecode_2_border_a=0
shape_2_per_frame1=x = 0.5 + 0.2*cos(q2*1.2 + 4.2)*q31;
shape_2_per_frame2=y = 0.5 + 0.24*sin(q2*0.9 + 4.2)*q32;
shape_2_per_frame3=rad = 0.055 + 0.025*q4;
shape_2_per_frame4=a = 1;
shape_2_per_frame5=a2 = 1;
per_frame_init_1=last = 0;
per_frame_init_2=burst = 0;
per_frame_init_3=orb = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.3)*((time - last) > 0.35);
per_frame_5=last = if(beat, time, last);
per_frame_6=burst = max(burst*pow(0.88, q30), beat);
per_frame_7=orb = orb + (0.25 + 0.3*mid_att)/fps;
per_frame_8=q1 = burst;
per_frame_9=q2 = orb;
per_frame_10=q3 = 0.004*(1 + mid_att)*q30;
per_frame_11=q4 = min(bass_att, 2);
per_frame_12=q5 = time*0.02;
warp_1=`shader_body
warp_2=`{
warp_3=`  float2 p = (uv - 0.5) * aspect.xy;
warp_4=`  float r = length(p);
warp_5=`  float an = q3 * (1.0 + 2.0 * exp(-r * 4.0));
warp_6=`  float cs = cos(an);
warp_7=`  float sn = sin(an);
warp_8=`  float2 p2 = float2(p.x * cs - p.y * sn, p.x * sn + p.y * cs) * (1.0 - 0.0025 * q30);
warp_9=`  float3 c = tex2D(sampler_main, 0.5 + p2 / aspect.xy).xyz;
warp_10=`  float3 bg = float3(0.96, 0.93, 0.84);
warp_11=`  c = lerp(c, bg, 1.0 - pow(0.985, q30));
warp_12=`  ret = c;
warp_13=`}
comp_1=`float screen(float2 u, float th, float ch)
comp_2=`{
comp_3=`  float cs = cos(th);
comp_4=`  float sn = sin(th);
comp_5=`  float cell = texsize.y / 115.0;
comp_6=`  float2 q = float2(u.x * cs - u.y * sn, u.x * sn + u.y * cs) / cell;
comp_7=`  float2 cc = floor(q) + 0.5;
comp_8=`  float2 back = float2(cc.x * cs + cc.y * sn, -cc.x * sn + cc.y * cs) * cell;
comp_9=`  float3 src = tex2D(sampler_main, back / texsize.xy).xyz;
comp_10=`  float3 cmy = 1.0 - src;
comp_11=`  float k = min(cmy.x, min(cmy.y, cmy.z));
comp_12=`  float4 ink = float4(cmy - k, k);
comp_13=`  float v = ch < 0.5 ? ink.x : (ch < 1.5 ? ink.y : (ch < 2.5 ? ink.z : ink.w));
comp_14=`  float dr = sqrt(saturate(v * 1.15)) * 0.62;
comp_15=`  float d = length(q - cc);
comp_16=`  return 1.0 - smoothstep(dr - 0.08, dr + 0.08, d);
comp_17=`}
comp_18=`shader_body
comp_19=`{
comp_20=`  float2 u = uv * texsize.xy;
comp_21=`  float c = screen(u, 0.2618, 0.0);
comp_22=`  float m = screen(u, 1.309, 1.0);
comp_23=`  float y = screen(u, 0.0, 2.0);
comp_24=`  float k = screen(u, 0.7854, 3.0);
comp_25=`  float3 paper = float3(0.97, 0.94, 0.85);
comp_26=`  float3 col = paper * (1.0 - c * float3(0.85, 0.15, 0.0)) * (1.0 - m * float3(0.05, 0.85, 0.3)) * (1.0 - y * float3(0.0, 0.08, 0.9)) * (1.0 - k * 0.92);
comp_27=`  float3 a0 = tex2D(sampler_main, uv).xyz;
comp_28=`  float3 bl = GetBlur1(uv);
comp_29=`  float edge = saturate(length(a0 - bl) * 6.0 - 0.35);
comp_30=`  col *= 1.0 - edge * 0.9;
comp_31=`  float2 p = (uv - 0.5) * aspect.xy;
comp_32=`  float an = atan2(p.y, p.x);
comp_33=`  float ray = step(0.82, frac(an * 5.0 + tex2D(sampler_noise_lq, float2(floor(an * 5.0) / 64.0, q5)).x));
comp_34=`  float bg = step(0.88, lum(a0));
comp_35=`  col = lerp(col, col * float3(1.0, 0.25, 0.2), ray * q1 * bg * smoothstep(0.08, 0.3, length(p)) * 0.8);
comp_36=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.35;
comp_37=`  ret = col;
comp_38=`}
