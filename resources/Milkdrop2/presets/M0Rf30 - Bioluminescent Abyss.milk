wave_1_per_point10=sw = (sin(f*5.5 - q8*1.3 + kk*1.7+2.1)*0.034 + sin(f*2.3 + q1*1.1 + kk*0.9)*0.03)*f*(0.6+0.7*f) + value1*0.04*f;
