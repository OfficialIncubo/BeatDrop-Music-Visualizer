wave_0_per_point1=u = sample/0.22;
wave_0_per_point2=dome = below(u,1);
wave_0_per_point3=ang = 3.14159*min(u,1);
wave_0_per_point4=s = max(sample-0.22,0)/0.78*7;
wave_0_per_point5=kk = min(int(s),6);
wave_0_per_point6=f = min(s - kk, 1);
wave_0_per_point7=f = if(equal(kk%2,1), 1-f, f);
wave_0_per_point8=ox = q13*(1 - 2*kk/6);
wave_0_per_point9=len = (0.20 + 0.14*abs(sin(kk*2.3+0.3)))*(1 + 0.25*q2);
wave_0_per_point10=sw = (sin(f*5.5 - q8*1.3 + kk*1.7+0.3)*0.034 + sin(f*2.3 + q1*1.1 + kk*0.9)*0.03)*f*(0.6+0.7*f) + value1*0.04*f;
wave_0_per_point11=x = if(dome, q4 - q13*cos(ang), q4 + ox*(1+0.35*f) + sw);
wave_0_per_point12=y = if(dome, q5 + q14*sin(ang), q5 - f*len);
wave_0_per_point13=dd = sin(ang)*0.4+0.6;
wave_0_per_point14=a = if(dome, 0.55*dd, 0.7*pow(1-f,1.4)) * (0.55 + 0.9*q2);
wave_0_per_point15=r = 0.15 + 0.2*q2; g = 0.85; b = 1.0;
