shape_3_per_frame4=r = 0.05; g = 0.45; b = 1; r2 = 0; g2 = 0.05; b2 = 0.2;
per_frame_init_1=ph=0; ph2=0; pulse=0; spk=0; energy=0.5; cd=0; bx=0.3; by=0.4; burst=0; bm=1; bd=0.3; tl=0;
per_frame_1=dt = min(max(time-tl,0.004),0.1); tl = time; bm = bm + (bass-bm)*(1-exp(-dt/0.8)); bd = bd + (abs(bass-bm)-bd)*(1-exp(-dt/2.5));
per_frame_2=energy = energy + (0.333*(bass_att+mid_att+treb_att) - energy)*min(1,2*dt);
per_frame_3=ph = ph + dt*(0.45 + 0.30*energy + 0.20*spk);
per_frame_4=ph2 = ph2 + dt*(0.9 + 0.4*spk);
per_frame_5=trig = min(max(((bass-bm)/max(bd,0.1) - 0.8)/1.5, 0), 1);
per_frame_6=pulse = max(pulse*pow(0.9, 60*dt), trig);
per_frame_7=spk = spk + (pulse - spk)*min(1, 14*dt);
per_frame_8=cd = max(cd - dt, 0);
per_frame_9=hit = above(trig, 0.35)*below(cd, 0.001);
per_frame_10=cd = cd + hit*0.28;
per_frame_11=bx = if(hit, 0.12 + rand(76)/100, bx);
per_frame_12=by = if(hit, 0.15 + rand(70)/100, by);
per_frame_13=burst = if(hit, 1, burst*pow(0.93, 60*dt));
per_frame_14=ax = 0.5 + 0.27*sin(ph*0.23+0.6) + 0.06*sin(ph*0.71);
per_frame_15=ay = 0.58 + 0.08*sin(ph*0.31+2.0) + 0.03*spk;
per_frame_16=cx2 = 0.5 + 0.32*sin(ph*0.17+3.4) + 0.05*sin(ph*0.53+1);
per_frame_17=cy2 = 0.36 + 0.08*sin(ph*0.27+0.5) + 0.03*spk;
per_frame_18=prA = sin(ph2*2.3);
per_frame_19=prB = sin(ph2*2.9+1.7);
per_frame_20=q1 = ph;
per_frame_21=q2 = spk;
per_frame_22=q3 = energy;
per_frame_23=q4 = ax;
per_frame_24=q5 = ay;
per_frame_25=q6 = cx2;
per_frame_26=q7 = cy2;
per_frame_27=q8 = ph2;
per_frame_28=q9 = bx;
per_frame_29=q10 = by;
per_frame_30=q11 = burst;
per_frame_31=q12 = pulse;
per_frame_32=q13 = 0.088*(1 + 0.08*prA + 0.14*spk);
per_frame_33=q14 = q13*0.6*(1 - 0.16*prA - 0.12*spk);
per_frame_34=q15 = 0.064*(1 + 0.08*prB + 0.14*spk);
per_frame_35=q16 = q15*0.6*(1 - 0.16*prB - 0.12*spk);
warp_1=`shader_body
warp_2=`{
warp_3=`  float2 p = (uv - 0.5) * aspect.xy;
warp_4=`  float T = q1;
warp_5=`  float pls = q2;
warp_6=`  float2 fl;
warp_7=`  fl.x = sin(p.y*5.3 + T*0.9 + sin(p.x*3.1 - T*0.6)*1.7);
warp_8=`  fl.y = cos(p.x*4.7 - T*0.8 + sin(p.y*3.7 + T*0.5)*1.7);
warp_9=`  float2 nz = tex2D(sampler_noise_lq, uv*0.5 + float2(T*0.02, -T*0.015)).xy - 0.5;
warp_10=`  float2 d = fl*0.0022 + nz*0.005;
warp_11=`  float zm = 0.9985 - 0.011*pls;
warp_12=`  float2 uvs = 0.5 + (uv - 0.5)*zm + d;
warp_13=`  float3 c = tex2D(sampler_main, uvs).rgb;
warp_14=`  float3 b1 = GetBlur1(uvs);
warp_15=`  float3 b2 = GetBlur2(uvs);
warp_16=`  float3 lw = float3(0.33, 0.34, 0.33);
warp_17=`  float dl = dot(b1 - b2, lw)*1.2 + dot(c - b1, lw)*1.0;
warp_18=`  float fac = clamp(0.78 + dl*3.8, 0.5, 1.08);
warp_19=`  float3 r = c*fac;
warp_20=`  float mx = max(r.r, max(r.g, r.b));
warp_21=`  r *= min(1.0, (0.40 + 0.12*pls)/max(mx,0.001));
warp_22=`  r = max(r - 0.011, 0.0);
warp_23=`  ret = r;
warp_24=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float2 p = (uv - 0.5) * aspect.xy;
comp_4=`  float2 offs = (uv - 0.5)*(0.004 + 0.006*q2);
comp_5=`  float3 c;
comp_6=`  c.r = tex2D(sampler_main, uv - offs).r;
comp_7=`  c.g = tex2D(sampler_main, uv).g;
comp_8=`  c.b = tex2D(sampler_main, uv + offs).b;
comp_9=`  c += GetBlur1(uv)*0.45 + GetBlur2(uv)*0.45 + GetBlur3(uv)*0.4;
comp_10=`  float2 eo = float2(0.0035, 0.0062);
comp_11=`  float e = dot(tex2D(sampler_main, uv + eo).rgb - tex2D(sampler_main, uv - eo).rgb, float3(0.33, 0.34, 0.33));
comp_12=`  c += float3(0.3, 0.7, 1.0)*max(e, 0.0)*2.2 - float3(0.0, 0.1, 0.1)*max(-e, 0.0);
comp_13=`  c = max(c, 0.0);
comp_14=`  float l = dot(c, float3(0.3, 0.5, 0.2));
comp_15=`  float3 deep = float3(0.0, 0.02, 0.08);
comp_16=`  float3 midc = lerp(float3(0.0, 0.42, 1.0), float3(0.18, 0.22, 1.0), 0.5 + 0.5*sin(q1*0.25));
comp_17=`  float3 hi = float3(0.35, 1.0, 1.0);
comp_18=`  float3 pal = lerp(deep, midc, smoothstep(0.0, 0.35, l));
comp_19=`  pal = lerp(pal, hi, smoothstep(0.35, 0.95, l));
comp_20=`  float vm = saturate((c.r - c.g)*3.0 + 0.1);
comp_21=`  pal = lerp(pal, float3(0.55, 0.25, 1.0)*(0.3 + l*1.4), vm*0.8);
comp_22=`  float3 ret0 = lerp(c, pal, 0.5);
comp_23=`  ret0 *= 1.0 + 0.9*q2;
comp_24=`  ret0 = 1.0 - exp(-ret0*1.45);
comp_25=`  float v = length(p);
comp_26=`  ret0 *= 1.0 - smoothstep(0.35, 1.0, v)*0.85;
comp_27=`  ret0 += float3(0.0, 0.012, 0.04)*(0.4 + uv.y);
comp_28=`  ret = ret0;
comp_29=`}
