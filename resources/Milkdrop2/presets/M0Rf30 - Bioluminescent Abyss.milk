wave_2_per_point1=h1 = sin(sample*7919.3)*43758.5; h1 = h1 - floor(h1);
wave_2_per_point2=h2 = sin(sample*3571.7+1.3)*24634.6; h2 = h2 - floor(h2);
wave_2_per_point3=h3 = sin(sample*1237.9+2.1)*35421.1; h3 = h3 - floor(h3);
wave_2_per_point4=xx = h1 + 0.03*sin(q8*0.25*(h3+0.3) + h2*6.28) + q1*0.006*(h2-0.5);
wave_2_per_point5=yy = h2 + q1*0.010*(0.3+h3)*(h1-0.35);
wave_2_per_point6=x = xx - floor(xx);
wave_2_per_point7=y = yy - floor(yy);
wave_2_per_point8=tw = 0.5 + 0.5*sin(q8*1.4*(h1+0.5) + h2*30);
wave_2_per_point9=a = (0.15 + 0.85*h3*h3)*tw*(0.6 + 1.2*q2*h1);
wave_2_per_point10=r = 0.25 + 0.5*h1; g = 0.75 + 0.25*h2; b = 1.0;
