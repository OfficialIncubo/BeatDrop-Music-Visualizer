wave_3_per_point1=t = sample*6.2832;
wave_3_per_point2=wb = 1 + 0.22*sin(t*3 + q1*0.8) + 0.1*sin(t*5 - q1*0.5);
wave_3_per_point3=x = 0.5 + 0.34*cos(t + q1*0.12)*wb*0.9 + 0.05*sin(q1*0.2);
wave_3_per_point4=y = 0.5 + 0.30*sin(t + q1*0.12)*wb + value1*0.05;
