per_frame_init_1=hue=.33; 
per_frame_init_2=msat=1; 
per_frame_init_3=rainbow=5;
per_frame_init_4=cols=48;
per_frame_init_5=spd=.35; 
per_frame_init_6=tail=3.5;
per_frame_init_7=flick=6; 
per_frame_init_8=ph=0;
per_frame_1=// === matrix code control ===
per_frame_2=h = hue + rainbow*time*.05; h = h - int(h);
per_frame_3=cr = min(1,max(0,abs(h*6-3)-1));
per_frame_4=cg = min(1,max(0,2-abs(h*6-2)));
per_frame_5=cb = min(1,max(0,2-abs(h*6-4)));
per_frame_6=q27 = 1+(cr-1)*msat; q28 = 1+(cg-1)*msat; q29 = 1+(cb-1)*msat;
per_frame_7=
per_frame_8=ph = ph + spd*(1+.5*(bass_att-1))/fps; 
per_frame_9=q26 = ph;
per_frame_10=
per_frame_11=q25 = cols; q30 = tail; q31 = flick;
per_frame_12=
per_frame_13=wave_a = 0;
per_frame_14=zoom = 1.01;
warp_1=`sampler sampler_matrixtrails_code;
warp_2=` 
warp_3=`#define MT_COLS      8.0     // jumlah kolom glyph pada atlas
warp_4=`#define MT_ROWS      10.0    // jumlah baris sel pada atlas
warp_5=`#define MT_USED_ROWS 4.0     // baris yang benar-benar berisi glyph
warp_6=` 
warp_7=`float hash1(float2 p)
warp_8=`{
warp_9=`    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
warp_10=`}
warp_11=` 
warp_12=`// mask glyph (0..1) untuk sel 'id', koordinat lokal f (0..1)
warp_13=`float glyph(float2 id, float2 f, float tick)
warp_14=`{
warp_15=`    float h  = hash1(id + tick);
warp_16=`    float gi = floor(h * MT_COLS * MT_USED_ROWS);
warp_17=`    float gx = fmod(gi, MT_COLS);
warp_18=`    float gy = floor(gi / MT_COLS);
warp_19=`    float2 auv = (float2(gx, gy) + .08 + .84*f) / float2(MT_COLS, MT_ROWS);
warp_20=`    return tex2D(sampler_matrixtrails_code, auv).x;
warp_21=`}
warp_22=` 
warp_23=`// jejak hujan per kolom: x = ekor, y = kepala
warp_24=`float2 rainTrail(float colId, float t)
warp_25=`{
warp_26=`    float spdc    = .5 + hash1(float2(colId, 1.7));
warp_27=`    float off     = hash1(float2(colId, 4.1));
warp_28=`    float headPos = frac(q26*spdc + off);
warp_29=`    float d       = frac(headPos - t);              // 0 di kepala, makin besar ke atas
warp_30=`    return float2(exp(-d*q30), saturate(1 - d*40));
warp_31=`}
warp_32=` 
warp_33=`// satu layer matrix dengan jumlah sel eksplisit
warp_34=`float3 matrixLayerC(float2 uvm, float2 cells)
warp_35=`{
warp_36=`    float2 g  = uvm * cells;
warp_37=`    float2 id = floor(g);
warp_38=`    float2 f  = frac(g);
warp_39=`    float2 tr = rainTrail(id.x, id.y / cells.y);
warp_40=`    float tick = floor(time*q31 + hash1(id)*8);
warp_41=`    float gl   = glyph(id, f, tick);
warp_42=`    float3 mc  = float3(q27, q28, q29);
warp_43=`    return gl * (mc*tr.x + lerp(mc, 1, .7)*tr.y*2);
warp_44=`}
warp_45=` 
warp_46=`float3 matrixLayer(float2 uvm, float cols)
warp_47=`{
warp_48=`    return matrixLayerC(uvm, float2(cols, cols*texsize.y/texsize.x));
warp_49=`}
warp_50=`
warp_51=`shader_body
warp_52=`{
warp_53=`    float3 m = matrixLayer(uv_orig, q25);
warp_54=`    ret = tex2D(sampler_main, uv).xyz * .72 + m * .8;     // feedback = glow/smear
warp_55=`    ret = ret - .003;
warp_56=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float3 crisp = tex2D(sampler_main, uv).xyz;
comp_4=`    float3 glow = GetBlur2(uv);
comp_5=`    float mask = saturate(1.0 - rad * 0.8);
comp_6=`    ret = (crisp + glow * 1.5) * mask;
comp_7=`}
