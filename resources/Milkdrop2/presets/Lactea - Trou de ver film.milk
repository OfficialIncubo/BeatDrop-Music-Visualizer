MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=2
[preset00]
fRating=5.000000
fGammaAdj=1.000
fDecay=1.000
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=1.000
fWaveSmoothing=0.500
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.000
fWarpScale=1.000
fZoomExponent=1.000
fShader=0.000
zoom=1.000
rot=0.000
cx=0.500
cy=0.500
dx=0.000
dy=0.000
warp=0.000
sx=1.000
sy=1.000
wave_r=1.000
wave_g=1.000
wave_b=1.000
wave_x=0.500
wave_y=0.500
ob_size=0.000
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.000
ib_r=0.000
ib_g=0.000
ib_b=0.000
ib_a=0.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=0.000
mv_g=0.000
mv_b=0.000
mv_a=0.000
per_frame_1=dt = min(max(time - tprev, 0), 0.1);
per_frame_2=tprev = time;
per_frame_3=pulse = pulse * 0.95 + 0.05 * min(max(bass_att - 1.0, 0), 1.5);
per_frame_4=q5 = pulse;
per_frame_5=travel = travel + dt * (0.4 + 0.5 * pulse);
per_frame_6=q1 = travel;
per_frame_7=q3 = 0.5 + 0.13 * sin(time * 0.41) + 0.05 * sin(time * 1.13);
per_frame_8=q4 = 0.5 + 0.10 * cos(time * 0.33) + 0.05 * sin(time * 0.97 + 1);
per_frame_9=mids = mids * 0.95 + 0.05 * min(max(mid_att - 0.8, 0), 1.5);
per_frame_10=q6 = mids;
warp_1=`shader_body
warp_2=`{
warp_3=`    float2 c = float2(q3, q4);
warp_4=`    float2 p = (uv - c) * aspect.xy;
warp_5=`    float r = max(length(p), 0.001);
warp_6=`    float a = atan2(p.y, p.x) / 6.2831853;
warp_7=`    float z = 0.18 / r + q1;
warp_8=`    float sw = a + 0.02 / r + time * 0.015;
warp_9=`    float2 t1 = float2(sw, z * 0.22);
warp_10=`    float n = tex2D(sampler_noise_lq_lite, t1).x * 0.5 + tex2D(sampler_noise_lq_lite, t1 * 2.0 + 0.31).x * 0.3 + tex2D(sampler_noise_lq_lite, t1 * 4.0 + 0.67).x * 0.2;
warp_11=`    float cl = smoothstep(0.22, 0.88, n) * (0.85 + 0.3 * q6);
warp_12=`    float wall = saturate(r * 2.4);
warp_13=`    float core = smoothstep(0.02, 0.2, r);
warp_14=`    float3 navy = float3(0.1, 0.06, 0.28);
warp_15=`    float3 blue = float3(0.1, 0.32, 0.95);
warp_16=`    float3 cyan = float3(0.45, 0.85, 1.0);
warp_17=`    float3 white = float3(0.93, 0.97, 1.0);
warp_18=`    float3 col = lerp(navy, blue, cl * core);
warp_19=`    col = lerp(col, cyan, saturate(cl * cl * wall * 1.3));
warp_20=`    col = lerp(col, white, saturate(pow(cl, 4.0) * wall * 0.9));
warp_21=`    col *= 0.45 + 0.75 * core;
warp_22=`    float flare = q5 * (exp(-r * 45.0) + 0.25 * exp(-abs(p.y) * 220.0) * exp(-abs(p.x) * 5.0));
warp_23=`    col += white * flare;
warp_24=`    float2 src = c + (uv - c) * (0.975 - 0.01 * q5);
warp_25=`    float3 prev = tex2D(sampler_main, src).xyz;
warp_26=`    ret = lerp(col, max(col, prev * 0.9), 0.4);
warp_27=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float3 c = GetPixel(uv);
comp_4=`    float3 glow = GetBlur1(uv) * 0.35 + GetBlur2(uv) * 0.3;
comp_5=`    float2 d = uv - 0.5;
comp_6=`    ret = (c + glow) * (1.1 - dot(d, d) * 0.9);
comp_7=`}
