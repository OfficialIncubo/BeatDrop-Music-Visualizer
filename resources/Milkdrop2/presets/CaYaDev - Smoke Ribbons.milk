per_frame_init_1=ptk = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=q1 = time*0.05;
per_frame_5=q2 = 0.9 + 0.7*min(bass_att, 2);
per_frame_6=q3 = min(treb_att, 2);
per_frame_7=q4 = time*0.13;
per_frame_8=tk = floor(time*12);
per_frame_9=tick = (abs(tk - ptk) > 0.5);
per_frame_10=ptk = tk;
per_frame_11=q13 = tick*0.004;
per_frame_12=q5 = time*1.10;
per_frame_13=q6 = 0;
per_frame_14=q7 = time*1.23;
per_frame_15=q8 = 0;
per_frame_16=q9 = time*1.36;
per_frame_17=q10 = 0;
per_frame_18=q11 = time*1.49;
per_frame_19=q12 = 0;
per_frame_20=q33 = time*1.62;
per_frame_21=q34 = 0;
per_frame_22=q35 = time*1.75;
per_frame_23=q36 = 0;
per_frame_24=q37 = time*1.88;
per_frame_25=q38 = 0;
per_frame_26=q39 = time*2.01;
per_frame_27=q40 = 0;
warp_1=`float pot(float3 q)
warp_2=`{
warp_3=`  return tex3D(sampler_noisevol_hq, q).x + 0.5 * tex3D(sampler_noisevol_hq, q * 2.3 + 0.4).x;
warp_4=`}
warp_5=`shader_body
warp_6=`{
warp_7=`  float hgt = saturate((0.72 - uv.y) / 0.72);
warp_8=`  float3 q = float3(uv * float2(1.4, 0.8) + float2(0.0, q1 * 0.6), q4 * 0.15);
warp_9=`  float e = 0.02;
warp_10=`  float dx = pot(q + float3(e, 0.0, 0.0)) - pot(q - float3(e, 0.0, 0.0));
warp_11=`  float dy = pot(q + float3(0.0, e, 0.0)) - pot(q - float3(0.0, e, 0.0));
warp_12=`  float2 curl = float2(dy * 0.8, -dx * 1.4);
warp_13=`  float turb = hgt * hgt * q2;
warp_14=`  float2 vel = float2(0.0, 0.0032) + curl * 0.03 * turb;
warp_15=`  float2 u2 = uv + vel * q30;
warp_16=`  float3 c = tex2D(sampler_main, u2).xyz;
warp_17=`  c = lerp(c, GetBlur1(u2), 0.06 * hgt * min(1.0, q30));
warp_18=`  // the floor steps on a time tick from frame code (q13): long-lived thin smoke, yet no 8-bit stall
warp_19=`  ret = max(c * pow(0.994, q30) - q13, 0.0) * step(uv.y, 0.74);
warp_20=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float3 sm = tex2D(sampler_main, uv).xyz;
comp_4=`  float3 b1 = GetBlur1(uv);
comp_5=`  float3 b2 = GetBlur2(uv);
comp_6=`  float3 bg = lerp(float3(0.01, 0.01, 0.02), float3(0.05, 0.04, 0.07), 1.0 - uv.y);
comp_7=`  bg += float3(0.08, 0.06, 0.1) * exp(-length((uv - float2(0.5, 0.15)) * float2(1.2, 2.0)) * 2.5);
comp_8=`  float3 dens = sm * 0.9 + b1 * 0.7 + b2 * 0.4;
comp_9=`  float3 col = bg * (1.0 - saturate(lum(dens)) * 0.3) + dens * 1.1;
comp_10=`  col += float3(1.0, 0.95, 0.9) * saturate(lum(sm) - 0.5) * 0.3;
comp_11=`  float sticks = 0.0;
comp_12=`  float tips = 0.0;
comp_13=`  sticks += (1.0 - smoothstep(0.0015, 0.0025, abs(uv.x - 0.140))) * step(0.715, uv.y) * step(uv.y, 0.92);
comp_14=`  tips += exp(-length((uv - float2(0.140, 0.712)) * aspect.xy) * 900.0);
comp_15=`  sticks += (1.0 - smoothstep(0.0015, 0.0025, abs(uv.x - 0.243))) * step(0.715, uv.y) * step(uv.y, 0.92);
comp_16=`  tips += exp(-length((uv - float2(0.243, 0.712)) * aspect.xy) * 900.0);
comp_17=`  sticks += (1.0 - smoothstep(0.0015, 0.0025, abs(uv.x - 0.346))) * step(0.715, uv.y) * step(uv.y, 0.92);
comp_18=`  tips += exp(-length((uv - float2(0.346, 0.712)) * aspect.xy) * 900.0);
comp_19=`  sticks += (1.0 - smoothstep(0.0015, 0.0025, abs(uv.x - 0.449))) * step(0.715, uv.y) * step(uv.y, 0.92);
comp_20=`  tips += exp(-length((uv - float2(0.449, 0.712)) * aspect.xy) * 900.0);
comp_21=`  sticks += (1.0 - smoothstep(0.0015, 0.0025, abs(uv.x - 0.551))) * step(0.715, uv.y) * step(uv.y, 0.92);
comp_22=`  tips += exp(-length((uv - float2(0.551, 0.712)) * aspect.xy) * 900.0);
comp_23=`  sticks += (1.0 - smoothstep(0.0015, 0.0025, abs(uv.x - 0.654))) * step(0.715, uv.y) * step(uv.y, 0.92);
comp_24=`  tips += exp(-length((uv - float2(0.654, 0.712)) * aspect.xy) * 900.0);
comp_25=`  sticks += (1.0 - smoothstep(0.0015, 0.0025, abs(uv.x - 0.757))) * step(0.715, uv.y) * step(uv.y, 0.92);
comp_26=`  tips += exp(-length((uv - float2(0.757, 0.712)) * aspect.xy) * 900.0);
comp_27=`  sticks += (1.0 - smoothstep(0.0015, 0.0025, abs(uv.x - 0.860))) * step(0.715, uv.y) * step(uv.y, 0.92);
comp_28=`  tips += exp(-length((uv - float2(0.860, 0.712)) * aspect.xy) * 900.0);
comp_29=`  col = lerp(col, float3(0.13, 0.08, 0.05), saturate(sticks));
comp_30=`  col += float3(1.0, 0.45, 0.15) * tips * (0.8 + 0.6 * q3);
comp_31=`  col += float3(0.6, 0.25, 0.08) * exp(-abs(uv.y - 0.92) * 80.0) * 0.08;
comp_32=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.6;
comp_33=`  ret = 1.0 - exp(-col * 1.5);
comp_34=`}
