per_frame_init_1=q1=0.0;
per_frame_init_2=q2=40.0;
per_frame_init_3=q5=0.0;
per_frame_init_4=q6=0.0;
per_frame_init_5=time_delay=0.0;
per_frame_init_6=rand_laser=rand(120);
per_frame_init_7=rand_pattern=rand(200);
per_frame_init_8=temp1 = temp2 = temp3 = 0;
per_frame_1=// SKELETON (Values tweaked for rapid club-tempo tracking)
per_frame_2=time_delay = if(time_delay >= 0.22 && bass > 2.0, 0, time_delay += 1/fps);
per_frame_3=rand_laser = if(time_delay == 0, rand(120), rand_laser);
per_frame_4=rand_pattern = if(time_delay == 0, rand(200), rand_pattern);
per_frame_5=
per_frame_6=// Custom variable mapping to feed the Comp Shader
per_frame_7=q1 = time_delay;
per_frame_8=q2 = rand_laser;
per_frame_9=temp1 += 0.012 * (bass + 0.4); // Smooth audio integration clocks
per_frame_10=q3 = temp1;
per_frame_11=q4 = rand_pattern + time;
per_frame_12=temp2 += 0.007 * (treb + 0.4);
per_frame_13=q5 = temp2;
per_frame_14=temp3 = if(time_delay == 0, 1.0, temp3 * 0.94); // Decaying beat flash multiplier
per_frame_15=q6 = temp3;
warp_1=`shader_body {
warp_2=`
warp_3=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float2 p = uv;
comp_4=`    float3 lasers = float3(0, 0, 0);
comp_5=`    
comp_6=`    // 1. Swirling Volumetric Fog Background
comp_7=`    float smoke = sin(p.x * 12.0 + q3) * cos(p.y * 9.0 - q4);
comp_8=`    smoke += sin(p.y * 24.0 + q5) * cos(p.x * 15.0 + q3) * 0.5;
comp_9=`    smoke = clamp(smoke * 0.35 + 0.65, 0.0, 1.0);
comp_10=`    
comp_11=`    // 2. Select laser color scheme based on random beat index
comp_12=`    float3 color = float3(0.0, 1.0, 0.4); // Default Cyber Green
comp_13=`    if(fmod(floor(q2), 4.0) == 1.0) color = float3(0.0, 0.5, 1.0); // Neon Blue
comp_14=`    if(fmod(floor(q2), 4.0) == 2.0) color = float3(1.0, 0.0, 0.5); // Acid Pink
comp_15=`    if(fmod(floor(q2), 4.0) == 3.0) color = float3(1.0, 0.8, 1.0); // Pure White Core
comp_16=`    
comp_17=`    // 3. Render left & right multi-beam scanning fixtures
comp_18=`    for(int i = 0; i < 6; i++)
comp_19=`    {
comp_20=`        // Fan sweep oscillations driven by mid/bass clocks
comp_21=`        float sweep = sin(q4 * 1.5) * 0.15;
comp_22=`        float ang_l = 0.15 + float(i) * 0.14 + sweep + (frac(q2) * 0.05);
comp_23=`        float ang_r = 3.14159 - (0.15 + float(i) * 0.14 - sweep + (frac(q2) * 0.05));
comp_24=`        
comp_25=`        float2 dir_l = float2(cos(ang_l), sin(ang_l));
comp_26=`        float2 dir_r = float2(cos(ang_r), sin(ang_r));
comp_27=`        
comp_28=`        // Exact pixel distance vectors to line targets
comp_29=`        float d_l = abs((p.y - 0.25) * dir_l.x - (p.x - 0.0) * dir_l.y);
comp_30=`        float d_r = abs((p.y - 0.25) * dir_r.x - (p.x - 1.0) * dir_r.y);
comp_31=`        float d = min(d_l, d_r);
comp_32=`        
comp_33=`        // Ultra-sharp laser core combined with exponential volumetric bloom
comp_34=`        float core = smoothstep(0.0035, 0.0, d);
comp_35=`        float glow = exp(-d * 75.0) * 0.35 + exp(-d * 18.0) * 0.15;
comp_36=`        
comp_37=`        lasers += (core + glow) * color;
comp_38=`    }
comp_39=`    
comp_40=`    // 4. Mix the laser beams into the atmospheric smoke
comp_41=`    float3 final_rgb = lasers * (0.4 + 0.6 * smoke);
comp_42=`    
comp_43=`    // 5. Anti-seizure safety: smooth, non-flash continuous brightness pulse
comp_44=`    final_rgb *= (0.75 + 0.25 * sin(q3 * 3.14159));
comp_45=`    
comp_46=`    ret = final_rgb;
comp_47=`}
