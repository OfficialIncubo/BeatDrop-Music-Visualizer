MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=q1 = time*0.02;
per_frame_5=q2 = 0.5 + 0.7*mid_att;
per_frame_6=q3 = treb_att;
per_frame_7=pb = 0.5 + 0.6*min(1.5, bass_att);
per_frame_8=q4 = -0.26 + 0.04*sin(time*0.07);
per_frame_9=q5 = -0.07 + 0.05*sin(time*0.11);
per_frame_10=q6 = pb*pow(0.5 + 0.5*sin(time*1.7), 4);
per_frame_11=q7 = 0.23 + 0.04*sin(time*0.05 + 2);
per_frame_12=q8 = -0.13 + 0.05*sin(time*0.09 + 1);
per_frame_13=q9 = pb*pow(0.5 + 0.5*sin(time*1.9 + 2), 4);
per_frame_14=q10 = 0.0 + 0.06*sin(time*0.06 + 4);
per_frame_15=q11 = 0.0 + 0.05*sin(time*0.13 + 3);
per_frame_16=q12 = pb*pow(0.5 + 0.5*sin(time*2.2 + 4), 4);
warp_1=`sampler sampler_pw_noise_lq;
warp_2=`shader_body
warp_3=`{
warp_4=`  float2 cur = (tex2D(sampler_noise_lq, uv * 0.7 + q1).xy - 0.5) * 0.0012 * q2 * q30;
warp_5=`  cur.y -= 0.0002 * q30;
warp_6=`  float3 m = tex2D(sampler_main, uv + cur).xyz;
warp_7=`  float2 sp = uv * texsize.xy / 256.0 + rand_frame.xy * 7.0;
warp_8=`  float4 st = tex2D(sampler_pw_noise_lq, sp);
warp_9=`  float born = saturate((st.x * st.y - (0.9965 - 0.002 * q3)) * 500.0) * step(st.z, q30);
warp_10=`  ret = float3(max(m.x * pow(0.985, q30) - 0.002 * max(q30, 1.0), born), 0, 0);
warp_11=`}
comp_1=`float3 jelly(float2 p, float2 c, float s, float pulse, float ph)
comp_2=`{
comp_3=`  float2 d = (p - c) / s;
comp_4=`  float w = 1.0 - 0.2 * pulse;
comp_5=`  float2 e = float2(d.x / w, (d.y + 0.1) / (0.75 + 0.2 * pulse));
comp_6=`  float r = length(e);
comp_7=`  float top = step(e.y, 0.0);
comp_8=`  float skirt = 0.08 * sin(e.x * 9.0 + time * 3.0 + ph);
comp_9=`  float under = saturate(1.0 - abs(e.y - skirt) * 12.0) * saturate(1.0 - abs(e.x) * 1.05);
comp_10=`  float body = saturate((1.0 - r) * 6.0) * top;
comp_11=`  float rim = exp(-abs(r - 1.0) * 14.0) * top;
comp_12=`  float3 col = float3(0.0, 0.0, 0.0);
comp_13=`  col.x = body * (0.18 + 0.25 * saturate(-e.y)) + rim * 0.9 + under * 0.6 + body * pulse * 0.4;
comp_14=`  float tent = 0.0;
comp_15=`  for (float k = 0.0; k < 4.5; k += 1.0) {
comp_16=`    float t = d.y - 0.05;
comp_17=`    float tx = (k / 4.0 - 0.5) * 1.3 * w;
comp_18=`    float x = tx + (0.12 + 0.12 * q3) * t * sin(t * 2.4 - time * (1.6 + 0.2 * k) + k * 1.7 + ph);
comp_19=`    float fade = saturate(1.0 - t / (2.6 + 0.4 * sin(k * 2.3 + ph))) * step(0.0, t);
comp_20=`    tent += exp(-abs(d.x - x) * 40.0) * fade * fade;
comp_21=`  }
comp_22=`  col.x += tent * 0.55;
comp_23=`  col.y = saturate(1.0 - r * 0.7) * top * 0.25 + exp(-length(d - float2(0.0, 0.8)) * 1.2) * 0.12;
comp_24=`  return col.xxx + float3(0.0, 0.0, col.y);
comp_25=`}
comp_26=`shader_body
comp_27=`{
comp_28=`  float2 p = (uv - 0.5) * aspect.xy;
comp_29=`  float plank = tex2D(sampler_main, uv).x;
comp_30=`  float3 deep = lerp(float3(0.0, 0.05, 0.1), float3(0.0, 0.005, 0.02), uv.y);
comp_31=`  float c1 = tex2D(sampler_noise_hq, uv * float2(2.0, 1.0) + float2(time * 0.03, 0.0)).x;
comp_32=`  float c2 = tex2D(sampler_noise_hq, uv * float2(1.6, 0.8) - float2(time * 0.02, 0.0)).x;
comp_33=`  float caust = pow(1.0 - abs(c1 - c2), 12.0) * saturate(1.0 - uv.y * 1.6);
comp_34=`  float3 col = deep + float3(0.1, 0.35, 0.45) * caust * 0.18;
comp_35=`  col += float3(0.25, 0.95, 1.0) * plank * 1.2 + float3(0.1, 0.6, 0.9) * GetBlur1(uv).x * 1.5;
comp_36=`  col += jelly(p, float2(q4, q5), 0.1, q6, 0.1) * float3(0.55, 0.35, 1.0) * 1;
comp_37=`  col += jelly(p, float2(q7, q8), 0.075, q9, 2.1) * float3(0.3, 0.6, 1.0) * 0.75;
comp_38=`  col += jelly(p, float2(q10, q11), 0.05, q12, 4.1) * float3(0.85, 0.35, 0.9) * 0.55;
comp_39=`  ret = 1.0 - exp(-col * 1.5);
comp_40=`}
