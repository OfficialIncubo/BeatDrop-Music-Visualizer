per_frame_1=// Welcome new members //
per_frame_2=// Introduce my name is Jian Simanjuntak //
per_frame_3=// Nice to meet you, i'm from Pekanbaru City, Indonesia //
per_frame_4=// I am the editor of MilkDrop Visualization Presets //
per_frame_5=
per_frame_6=// WARP SHADER, SHAPECODE CONTROL //
per_frame_7=q8 =oldq8+ 0.005*(pow(1.2*bass+0.4*bass_att+0.1*treb+0.1*treb_att+0.1*mid+0.1*mid_att,6)/fps);
per_frame_8=oldq8 = q8;
per_frame_9=
per_frame_10=//Se7enSlasher - My Slow-Decrease Bass Code
per_frame_11=oldbass += bass*1.75;
per_frame_12=oldbass = if (oldbass < bass, oldbass, oldbass/=1.10);
per_frame_13=q12 = oldbass;
per_frame_14=q13 = min(q12/50, 1);
per_frame_15=
per_frame_16=//Se7enSlasher - UV Zooming
per_frame_17=q14 = 3.5;
per_frame_18=q15 = q14/2; //Don't modify here.
per_frame_19=
per_frame_20=// END //
per_frame_21=
per_frame_22=// SHAPECODE CONTROL MOVEMENT //
per_frame_23=q1=.4*time;
per_frame_24=q2=.2*time;
per_frame_25=q3=.3*time;
per_frame_26=// END //
per_frame_27=
per_frame_28=// COMPOSITE SHADER CONTROL //
per_frame_29=rg1 = max(rg1*0.9, 0.00 + 0.5*min(2,max(0,treb_att-1)*1.3));
per_frame_30=rg2 = max(rg2*0.9, 0.00 + 0.5*min(2,max(0,mid_att-1)*1.3));
per_frame_31=rg3 = max(rg3*0.9, 0.00 + 0.5*min(2,max(0,bass_att-1)*1.3));
per_frame_32=
per_frame_33=rg4 = min(2,max(0,mid_att-1)*1.3);
per_frame_34=
per_frame_35=q27 = rg1;
per_frame_36=q28= rg2;
per_frame_37=monitor = q13;
warp_1=`//Original shader by Nrx
warp_2=`//ShaderToy Original: https://www.shadertoy.com/view/lsBXDW
warp_3=`//MilkDrop (HLSL) Port by Jian Simanjuntak & DJ XcitMosphere/Incubo_/Se7enSlasher
warp_4=`
warp_5=`//BEGIN//
warp_6=`
warp_7=`float3 hsv2rgb (in float3 hsv) {
warp_8=`hsv.yz = clamp (hsv.yz, 0.0, 1.0); //Don't multiply with q8 or it increases the saturation in time.
warp_9=`return hsv.z * (1.0 + 0.5 * hsv.y * (cos (2.0 * 3.14159 * (hsv.x +float3 (0.0, 2.0 / 3.0, 1.0 / 3.0))) - 1.0)); //Still, don't multiply the q8, too.
warp_10=`}
warp_11=`
warp_12=`float rand (in float2 seed) {
warp_13=`return frac (sin (dot (seed, float2 (12.9898, 78.233))) * 137.5453);
warp_14=`}
warp_15=`shader_body
warp_16=`{
warp_17=`    //float2 st = (5.* uv-2 - uv.xy) / max(uv.x-.5, uv.y+2.5); //3D Perspective-Like
warp_18=`    float2 st = uv * q14 - q15;
warp_19=`    st *= 1.0 - 0.2 * cos (st.yx) * sin (3.14159 * 0.5 * q13);
warp_20=`    st *= 5.0;
warp_21=`    float random = rand (floor (st));
warp_22=`    float2 black = smoothstep (1.0, 0.8, cos (st * 3.14159 * 2.0));
warp_23=`    float3 color = hsv2rgb (float3 (random, 1.0, 1.0));
warp_24=`    color *= black.x * black.y * smoothstep (1.0, 0.0, length (frac (st) - 0.5));
warp_25=`    color *= 0.5 + 0.5 * cos (random + random * time + time + 3.14159 * 0.5 * q13);
warp_26=`    ret = float4 (color, 1.0);
warp_27=`}
comp_1=`//shining shader by martin
comp_2=`
comp_3=`#define sat saturate
comp_4=`float z, z0, radi;
comp_5=`float2 uv1, uv2, uva, dz;
comp_6=`static const int anz = 95;
comp_7=`static float beat = (q5 + q6 + q7)/3;
comp_8=`static const float2 hor = texsize.zw*float2(1,0);
comp_9=`static const float2 ver = texsize.zw*float2(1,0).yx;
comp_10=`float3 Get1 (float2 uvi, float par)
comp_11=`{return lerp(GetBlur1(uvi), GetPixel(uvi), 0*saturate(par/2))*par;}
comp_12=`
comp_13=`shader_body {
comp_14=`float sunx =  q31*0.5 +0.55, suny = q32*0.5 + 0.34;
comp_15=`//if(sqrt(pow(uv.x - q31*0.5 -0.55 ,2) + pow(uv.y-q32*0.5 - 0.34,2))<0.05) {ret = 1;}
comp_16=`float2 sunpos = float2(0.5,0.5);
comp_17=`uva = (uv-0.5)*aspect.xy+0.5;
comp_18=`float sun = (.01 / length (uva-sunpos));
comp_19=`
comp_20=`dz.x = lum(GetPixel(uv-hor)) - lum(GetPixel(uv+hor));
comp_21=`dz.y = lum(GetPixel(uv-ver)) - lum(GetPixel(uv+ver));
comp_22=`
comp_23=`float3 shine = GetPixel(uv); 
comp_24=`
comp_25=`radi = 1;
comp_26=`for (int n=1; n <= anz; n++)
comp_27=`{
comp_28=`  shine += (1 + 2*q28)/anz*Get1((uv-sunpos)*radi+sunpos,radi);
comp_29=`  radi -= 0.75/anz;;
comp_30=`}
comp_31=`ret += max(shine,0*GetPixel(uv));
comp_32=`//ret = shine+GetPixel(uv);
comp_33=`
comp_34=`}
