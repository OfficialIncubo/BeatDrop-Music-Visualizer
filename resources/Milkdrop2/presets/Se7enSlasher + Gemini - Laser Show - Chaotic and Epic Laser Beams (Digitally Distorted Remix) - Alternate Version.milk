per_frame_init_1=q1=0.0;
per_frame_init_2=q2=40.0;
per_frame_init_3=q5=0.0;
per_frame_init_4=q6=0.0;
per_frame_init_5=time_delay=0.0;
per_frame_init_6=rand_laser = rand(100);
per_frame_1=time_delay = if(time_delay >= .35 && (bass+mid+treb)*.5 > 1.8, 0, time_delay += 1/fps);
per_frame_2=rand_laser = if(time_delay == 0, rand(100), rand_laser);
per_frame_3=
per_frame_4=q1 = rand_laser; 
per_frame_5=q2 = time_delay; 
per_frame_6=q3 = bass;       
warp_1=`shader_body{}
comp_1=`sampler2D sampler_rand77; // Introduce the random texture sampler
comp_2=`
comp_3=`// Math function to draw a glowing 2D laser beam
comp_4=`float3 GetLaser(float2 uva, float2 origin, float angle, float3 color_vec, float focus) {
comp_5=`    float2 p = uva - origin;
comp_6=`    float2 dir = float2(cos(angle), sin(angle));
comp_7=`    float2 n = float2(-dir.y, dir.x);
comp_8=`    float line_dist = abs(dot(p, n));
comp_9=`    float along = dot(p, dir);
comp_10=`    float core = exp(-line_dist * (4000.0 * focus));
comp_11=`    float glow = 0.0015 / (line_dist + 0.0005);
comp_12=`    float intensity = (core + glow) * smoothstep(-0.02, 0.1, along);
comp_13=`    return color_vec * intensity;
comp_14=`}
comp_15=`
comp_16=`shader_body
comp_17=`{
comp_18=`    float seed = q1; 
comp_19=`    float f_mode = fmod(seed, 4.0);
comp_20=`    float col_sel = fmod(seed * 3.14, 4.0); 
comp_21=`    
comp_22=`    float3 col1, col2;
comp_23=`    if (col_sel < 1.0) { col1 = float3(1.0, 0.0, 0.5); col2 = float3(0.0, 1.0, 0.8); }
comp_24=`    else if (col_sel < 2.0) { col1 = float3(0.5, 1.0, 0.0); col2 = float3(1.0, 0.3, 0.0); }
comp_25=`    else if (col_sel < 3.0) { col1 = float3(0.4, 0.0, 1.0); col2 = float3(0.1, 0.4, 1.0); }
comp_26=`    else { col1 = float3(1.0, 0.8, 0.2); col2 = float3(1.0, 1.0, 1.0); }
comp_27=`
comp_28=`    float beat_strike = exp(-q2 * 4.0);
comp_29=`    float slow_pulse = 0.7 + 0.3 * sin(time * 3.0 + q3 * 0.4);
comp_30=`    float beam_focus = 1.0 + beat_strike * 3.0; 
comp_31=`
comp_32=`    // --- TILE-BASED VRAM GLITCH MAPPING ---
comp_33=`    // Quantize UV to simulate a 48x48 2D sprite tilemap
comp_34=`    float2 tile_uv = floor(uv * 48.0) / 48.0; 
comp_35=`    
comp_36=`    // Sample a random texture using the quantized UVs
comp_37=`    float4 rand_tex = tex2D(sampler_rand77, tile_uv + time * 0.05 + q2 * 0.1);
comp_38=`    
comp_39=`    // Apply displacement offset simulating a hardware logic error
comp_40=`    float2 uv_glitch = uv;
comp_41=`    if (rand_tex.r > 0.6) uv_glitch.x += (rand_tex.g - 0.5) * 0.2 * beat_strike;
comp_42=`    if (rand_tex.b > 0.6) uv_glitch.y += (rand_tex.r - 0.5) * 0.2 * beat_strike;
comp_43=`    
comp_44=`    // BACKGROUND & SMOKE (Using glitched UVs)
comp_45=`    float grid = abs(frac(uv_glitch.y * 10.0 + time * 0.5) - 0.5) + abs(frac(uv_glitch.x * 10.0 + time * 0.3) - 0.5);
comp_46=`    float3 bg = float3(0.05, 0.05, 0.05) / (grid + 0.1);
comp_47=`    float3 smoke = GetBlur2(uv_glitch).rgb * 0.8;
comp_48=`    bg = lerp(bg, smoke * col2, 0.4) * 0.5;
comp_49=`
comp_50=`    // LASER RENDERER (Using glitched UVs)
comp_51=`    float3 lasers = float3(0, 0, 0);
comp_52=`    if (f_mode < 1.0) {
comp_53=`        for (int i = 0; i < 8; i++) {
comp_54=`            float f = i / 7.0;
comp_55=`            float y_pos = 0.1 + f * 0.8;
comp_56=`            float2 o_L = float2(0.0, y_pos);
comp_57=`            float a_L = 0.0 + sin(time * 2.0 + i) * 0.2 + beat_strike * 0.1;
comp_58=`            lasers += GetLaser(uv_glitch, o_L, a_L, col1, beam_focus);
comp_59=`            
comp_60=`            float2 o_R = float2(1.0, y_pos);
comp_61=`            float a_R = 3.14 + sin(time * 2.1 - i) * 0.2 - beat_strike * 0.1;
comp_62=`            lasers += GetLaser(uv_glitch, o_R, a_R, col2, beam_focus);
comp_63=`        }
comp_64=`    } else if (f_mode < 2.0) {
comp_65=`        float2 o_T = float2(0.5, 0.9);
comp_66=`        float2 o_BL = float2(0.1, 0.1);
comp_67=`        float2 o_BR = float2(0.9, 0.1);
comp_68=`        for(int i = 0; i < 6; i++) {
comp_69=`            float f = i / 5.0;
comp_70=`            float sweep = sin(time * 1.5 + f * 3.14);
comp_71=`            lasers += GetLaser(uv_glitch, o_T, -1.57 + sweep * 0.8, col1, beam_focus);
comp_72=`            lasers += GetLaser(uv_glitch, o_BL, 0.5 + sweep * 0.5, col2, beam_focus);
comp_73=`            lasers += GetLaser(uv_glitch, o_BR, 2.64 - sweep * 0.5, lerp(col1, col2, 0.5), beam_focus);
comp_74=`        }
comp_75=`    } else if (f_mode < 3.0) {
comp_76=`        for(int i = 0; i < 16; i++) {
comp_77=`            float f = i / 15.0;
comp_78=`            float offset = sin(time * 2.0 + f * 6.28) * 0.3;
comp_79=`            float2 o1 = float2(0.5 + offset, -0.1);
comp_80=`            float2 o2 = float2(0.5 - offset, 1.1);
comp_81=`            float a1 = 1.57 + sin(time + i * 0.2) * 0.3;
comp_82=`            float a2 = -1.57 + cos(time + i * 0.2) * 0.3;
comp_83=`            lasers += GetLaser(uv_glitch, o1, a1, col1, beam_focus);
comp_84=`            lasers += GetLaser(uv_glitch, o2, a2, col2, beam_focus);
comp_85=`        }
comp_86=`    } else {
comp_87=`        for(int i = 0; i < 10; i++) {
comp_88=`            float f = i / 9.0;
comp_89=`            float x_pos = 0.2 + f * 0.6;
comp_90=`            float2 o_T = float2(x_pos, 1.0);
comp_91=`            float2 o_B = float2(x_pos, 0.0);
comp_92=`            float ang_T = -1.57 + sin(time * 4.0 + i) * 1.2 * beat_strike;
comp_93=`            float ang_B = 1.57 + cos(time * 4.0 - i) * 1.2 * beat_strike;
comp_94=`            lasers += GetLaser(uv_glitch, o_T, ang_T, col1, beam_focus);
comp_95=`            lasers += GetLaser(uv_glitch, o_B, ang_B, col2, beam_focus);
comp_96=`        }
comp_97=`    }
comp_98=`
comp_99=`    lasers *= slow_pulse;
comp_100=`
comp_101=`    // Digital Artifact Overlay
comp_102=`    float3 artifacts = rand_tex.rgb * beat_strike * 0.25 * col1;
comp_103=`
comp_104=`    float center_flare = 0.02 / (length(uv_glitch - float2(0.5, 0.5)) + 0.01);
comp_105=`    float3 flare = center_flare * col1 * beat_strike * 0.5;
comp_106=`
comp_107=`    ret = bg + lasers + flare + artifacts;
comp_108=`}
