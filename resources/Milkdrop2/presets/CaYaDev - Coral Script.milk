MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
shapecode_0_enabled=1
shapecode_0_sides=24
shapecode_0_additive=1
shapecode_0_thickOutline=0
shapecode_0_textured=0
shapecode_0_num_inst=1
shapecode_0_x=0.5
shapecode_0_y=0.5
shapecode_0_rad=0.03
shapecode_0_ang=0
shapecode_0_tex_ang=0
shapecode_0_tex_zoom=1
shapecode_0_r=1
shapecode_0_g=0
shapecode_0_b=0
shapecode_0_a=0
shapecode_0_r2=1
shapecode_0_g2=0
shapecode_0_b2=0
shapecode_0_a2=0
shapecode_0_border_r=1
shapecode_0_border_g=1
shapecode_0_border_b=1
shapecode_0_border_a=0
shape_0_per_frame1=x = 0.15 + 0.7*(rand(1000)*0.001);
shape_0_per_frame2=y = 0.15 + 0.7*(rand(1000)*0.001);
shape_0_per_frame3=rad = 0.02 + 0.04*max(bass - 1.0, 0);
shape_0_per_frame4=a = min(1, 2*max(bass - 1.15, 0));
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=zoom = 1.0 + (0.012 + 0.02*sin(time*0.13))/fps;
per_frame_5=rot = 0.02*sin(time*0.07)/fps;
per_frame_6=q1 = 0.55 + 0.35*mid_att;
per_frame_7=q2 = cos(time*0.23)*0.7;
per_frame_8=q3 = sin(time*0.19)*0.7;
per_frame_9=q4 = time*0.02;
warp_1=`shader_body
warp_2=`{
warp_3=`  float k = min(1.0, q30);
warp_4=`  float3 m = tex2D(sampler_main, uv).xyz;
warp_5=`  float d = lum(GetBlur1(uv)) - lum(GetBlur2(uv));
warp_6=`  float n = tex2D(sampler_noise_lq, uv * 3.0 + rand_frame.xy).x - 0.5;
warp_7=`  float v = m.x + (d * 2.4 * q1 + n * 0.02) * k;
warp_8=`  v = saturate((v - 0.5) * (1.0 + 0.06 * k) + 0.5);
warp_9=`  float age = lerp(m.y, v, 0.04 * k);
warp_10=`  ret = float3(v, age, 0.0);
warp_11=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float2 d = texsize.zw * 2.0;
comp_4=`  float v = tex2D(sampler_main, uv).x;
comp_5=`  float age = tex2D(sampler_main, uv).y;
comp_6=`  float hx = GetBlur1(uv + float2(d.x, 0)).x - GetBlur1(uv - float2(d.x, 0)).x;
comp_7=`  float hy = GetBlur1(uv + float2(0, d.y)).x - GetBlur1(uv - float2(0, d.y)).x;
comp_8=`  float3 n = normalize(float3(hx, hy, 0.12));
comp_9=`  float3 L = normalize(float3(q2, q3, 0.8));
comp_10=`  float diff = saturate(dot(n, L));
comp_11=`  float spec = pow(saturate(dot(reflect(-L, n), float3(0, 0, 1))), 24.0);
comp_12=`  float s = GetBlur1(uv).x;
comp_13=`  float3 deep = float3(0.0, 0.08, 0.12);
comp_14=`  float3 reef = lerp(float3(0.0, 0.45, 0.5), float3(1.0, 0.42, 0.32), saturate(s * 1.3));
comp_15=`  reef = lerp(reef, float3(1.0, 0.75, 0.55), saturate(age - 0.6) * 1.5);
comp_16=`  float3 col = lerp(deep, reef, smoothstep(0.25, 0.75, s));
comp_17=`  col *= 0.55 + 0.75 * diff;
comp_18=`  col += spec * 0.35 * smoothstep(0.3, 0.7, s);
comp_19=`  float caust = tex2D(sampler_noise_hq, uv * 1.5 + float2(q4, q4 * 0.7)).x;
comp_20=`  col += float3(0.1, 0.25, 0.3) * pow(caust, 4.0) * 0.6;
comp_21=`  col += GetBlur3(uv).x * float3(0.0, 0.15, 0.2) * 0.5;
comp_22=`  float2 c = uv - 0.5;
comp_23=`  col *= 1.0 - dot(c, c) * 0.8;
comp_24=`  ret = col;
comp_25=`}
