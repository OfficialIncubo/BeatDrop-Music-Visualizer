warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float hash21(float2 p)
warp_7=`{
warp_8=`    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
warp_9=`}
warp_10=`
warp_11=`float vnoise(float2 p)
warp_12=`{
warp_13=`    float2 i = floor(p);
warp_14=`    float2 f = frac(p);
warp_15=`    f = f * f * (3.0 - 2.0 * f);
warp_16=`    float a = hash21(i);
warp_17=`    float b = hash21(i + float2(1.0, 0.0));
warp_18=`    float c = hash21(i + float2(0.0, 1.0));
warp_19=`    float d = hash21(i + float2(1.0, 1.0));
warp_20=`    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
warp_21=`}
warp_22=`
warp_23=`float fbm(float2 p)
warp_24=`{
warp_25=`    float s = 0.0;
warp_26=`    float a = 0.5;
warp_27=`    for (int i = 0; i < 4; i++)
warp_28=`    {
warp_29=`        s += a * vnoise(p);
warp_30=`        p *= 2.0;
warp_31=`        a *= 0.5;
warp_32=`    }
warp_33=`    return s;
warp_34=`}
warp_35=`
warp_36=`float3 hsv(float h, float s, float v)
warp_37=`{
warp_38=`    float4 k = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
warp_39=`    float3 p = abs(frac(h + k.xyz) * 6.0 - k.www);
warp_40=`    return v * lerp(k.xxx, saturate(p - k.xxx), s);
warp_41=`}
warp_42=`
warp_43=`shader_body
warp_44=`{
warp_45=`    uv.y = 1.0 - uv.y
warp_46=`;
warp_47=`    // Standardized Spotiamp+ UV scaling
warp_48=`    float2 my_uv = uv - 0.5;
warp_49=`    my_uv.x /= aspect.y;
warp_50=`
warp_51=`    float2 p = my_uv - 0.05 * float2(sin(time * 1.3), cos(time * 0.9) * 0.6);
warp_52=`    float pr = length(p);
warp_53=`    float pa = atan2(p.y, p.x);
warp_54=`
warp_55=`    float pupil = 0.06 + bass_att * 0.02;
warp_56=`    float lid = abs(my_uv.y) - 0.28 * (1.0 - pow(abs(my_uv.x) / 0.55, 2.0));
warp_57=`    float blink = step(0.97, frac(time * 0.12));
warp_58=`    float open = smoothstep(0.01, -0.01, lid + blink * 0.3);
warp_59=`
warp_60=`    float3 e = float3(0.92, 0.9, 0.88) * (1.0 - 0.5 * pow(pr / 0.5, 2.0));
warp_61=`    float fibres = 0.5 + 0.5 * sin(pa * 40.0 + fbm(float2(pa * 3.0, pr * 10.0)) * 6.0);
warp_62=`    float3 ic = lerp(float3(0.1, 0.35, 0.3), float3(0.4, 0.8, 0.6), fibres * smoothstep(pupil, 0.2, pr));
warp_63=`    ic = lerp(ic, hsv(frac(time * 0.1), 0.6, 0.8), mid * 0.5);
warp_64=`
warp_65=`    e = lerp(e, ic, smoothstep(0.205, 0.195, pr));
warp_66=`    e = lerp(e, float3(0.0, 0.0, 0.0), smoothstep(pupil + 0.005, pupil - 0.005, pr));
warp_67=`    e += float3(1.0, 1.0, 1.0) * smoothstep(0.03, 0.0, length(p - float2(-0.06, 0.06))) * 0.8;
warp_68=`
warp_69=`    float3 col = e * open;
warp_70=`
warp_71=`    ret = col;
warp_72=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
