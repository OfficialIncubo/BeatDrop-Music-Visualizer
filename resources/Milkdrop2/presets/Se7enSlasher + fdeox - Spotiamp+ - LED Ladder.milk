warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float specLog(float x){ return get_fft(pow(clamp(x,0.0,1.0), 1.8)); }
warp_7=`
warp_8=`shader_body
warp_9=`{
warp_10=`    float3 col = 0;
warp_11=`    //Obligatory Y flipping
warp_12=`    uv.y = 1-uv.y;
warp_13=`
warp_14=`    // ledladder: segmented level meters, the rack-gear look
warp_15=`    float cols = 16.0, rows = 14.0;
warp_16=`    float2 g = float2(floor(uv.x*cols), floor(uv.y*rows));
warp_17=`    float2 f = frac(float2(uv.x*cols, uv.y*rows));
warp_18=`    float h = specLog((g.x+0.5)/cols)*1.05;
warp_19=`    float lit = step((g.y+0.5)/rows, h);
warp_20=`    float seg = smoothstep(0.08,0.2,f.x)*smoothstep(0.08,0.2,f.y)
warp_21=`              * smoothstep(0.08,0.2,1.0-f.x)*smoothstep(0.08,0.2,1.0-f.y);
warp_22=`    float3 on = lerp(float3(0.15,1.0,0.3), float3(1.0,0.85,0.1), (g.y+0.5)/rows);
warp_23=`    on = lerp(on, float3(1.0,0.2,0.1), smoothstep(0.72,1.0,(g.y+0.5)/rows));
warp_24=`    col = seg*(on*lit + float3(0.05,0.06,0.07)*(1.0-lit));
warp_25=`    ret = col;
warp_26=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
