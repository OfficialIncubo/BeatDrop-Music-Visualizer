per_frame_init_1=last = -100;
per_frame_init_2=det = 0;
per_frame_init_3=ptk = 0;
per_frame_init_4=ph_0 = 0.0;
per_frame_init_5=ph_1 = 0.7;
per_frame_init_6=ph_2 = 1.4;
per_frame_init_7=ph_3 = 2.1;
per_frame_init_8=ph_4 = 2.8;
per_frame_init_9=ph_5 = 3.5;
per_frame_init_10=ph_6 = 4.2;
per_frame_init_11=ph_7 = 4.9;
per_frame_init_12=ph_8 = 5.6;
per_frame_init_13=ph_9 = 6.3;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.4)*((time - last) > 20);
per_frame_5=go = ((beat + ((time - last) > 45)) > 0);
per_frame_6=last = if(go, time, last);
per_frame_7=age = time - last;
per_frame_8=tk = floor(time*4);
per_frame_9=tick = (abs(tk - ptk) > 0.5);
per_frame_10=ptk = tk;
per_frame_11=q4 = tick*0.004 + go;
per_frame_12=det = det + (0.002 + 0.01*mid_att)/fps;
per_frame_13=q1 = age;
per_frame_14=q2 = min(bass_att, 2);
per_frame_15=q3 = time*0.01;
per_frame_16=q5 = age*1.50;
per_frame_17=q6 = 1 + 0.004*sin(det*1.00);
per_frame_18=ph_0 = if(go, rand(628)*0.01, ph_0);
per_frame_19=q7 = ph_0;
per_frame_20=q8 = age*1.70;
per_frame_21=q9 = 1 + 0.004*sin(det*1.37);
per_frame_22=ph_1 = if(go, rand(628)*0.01, ph_1);
per_frame_23=q10 = ph_1;
per_frame_24=q11 = age*1.90;
per_frame_25=q12 = 1 + 0.004*sin(det*1.74);
per_frame_26=ph_2 = if(go, rand(628)*0.01, ph_2);
per_frame_27=q13 = ph_2;
per_frame_28=q14 = age*1.50;
per_frame_29=q15 = 1 + 0.004*sin(det*2.11);
per_frame_30=ph_3 = if(go, rand(628)*0.01, ph_3);
per_frame_31=q16 = ph_3;
per_frame_32=q33 = age*1.70;
per_frame_33=q34 = 1 + 0.004*sin(det*2.48);
per_frame_34=ph_4 = if(go, rand(628)*0.01, ph_4);
per_frame_35=q35 = ph_4;
per_frame_36=q36 = age*1.90;
per_frame_37=q37 = 1 + 0.004*sin(det*2.85);
per_frame_38=ph_5 = if(go, rand(628)*0.01, ph_5);
per_frame_39=q38 = ph_5;
per_frame_40=q39 = age*1.50;
per_frame_41=q40 = 1 + 0.004*sin(det*3.22);
per_frame_42=ph_6 = if(go, rand(628)*0.01, ph_6);
per_frame_43=q41 = ph_6;
per_frame_44=q42 = age*1.70;
per_frame_45=q43 = 1 + 0.004*sin(det*3.59);
per_frame_46=ph_7 = if(go, rand(628)*0.01, ph_7);
per_frame_47=q44 = ph_7;
per_frame_48=q45 = age*1.90;
per_frame_49=q46 = 1 + 0.004*sin(det*3.96);
per_frame_50=ph_8 = if(go, rand(628)*0.01, ph_8);
per_frame_51=q47 = ph_8;
per_frame_52=q48 = age*1.50;
per_frame_53=q49 = 1 + 0.004*sin(det*4.33);
per_frame_54=ph_9 = if(go, rand(628)*0.01, ph_9);
per_frame_55=q50 = ph_9;
warp_1=`shader_body
warp_2=`{
warp_3=`  // fade steps on a time tick from frame code (q4) and a new swing clears the plates, so the whole damped
warp_4=`  // figure stays on the plate; the slow multiplicative part only tames the brightest crossings
warp_5=`  float3 c = tex2D(sampler_main, uv).xyz;
warp_6=`  ret = max(c * pow(0.9992, q30) - q4, 0.0);
warp_7=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float2 p = (uv - 0.5) * aspect_sd.xy;
comp_4=`  float3 ink = tex2D(sampler_main, uv).xyz;
comp_5=`  float3 halo = GetBlur1(uv) * 0.8 + GetBlur2(uv) * 0.6;
comp_6=`  float3 paper = lerp(float3(0.02, 0.04, 0.09), float3(0.04, 0.07, 0.14), 1.0 - length(p) * 1.6);
comp_7=`  float2 g = abs(frac(p * 24.0) - 0.5) / (24.0 / texsize.x);
comp_8=`  float grid = 1.0 - smoothstep(0.4, 1.0, min(g.x, g.y));
comp_9=`  float2 g2 = abs(frac(p * 4.8) - 0.5) / (4.8 / texsize.x);
comp_10=`  float grid2 = 1.0 - smoothstep(0.5, 1.3, min(g2.x, g2.y));
comp_11=`  paper += float3(0.15, 0.3, 0.5) * (grid * 0.12 + grid2 * 0.18);
comp_12=`  float2 cell = float2(floor((p.x + 0.425) / 0.17), step(0.0, p.y));
comp_13=`  float2 cc = float2(-0.34 + clamp(cell.x, 0.0, 4.0) * 0.17, lerp(-0.12, 0.12, cell.y));
comp_14=`  float pr = length(p - cc);
comp_15=`  paper += float3(0.1, 0.18, 0.3) * (1.0 - smoothstep(0.0, 2.0 / texsize.x, abs(pr - 0.072))) * 0.6;
comp_16=`  paper += float3(0.02, 0.04, 0.07) * (1.0 - smoothstep(0.07, 0.072, pr));
comp_17=`  float3 col = paper + ink * 1.6 + halo * (0.6 + 0.3 * q2);
comp_18=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.5;
comp_19=`  ret = 1.0 - exp(-col * 1.4);
comp_20=`}
