per_frame_1=// Composite Shader //
per_frame_2=dt = 0.02;
per_frame_3=
per_frame_4=h = h + v*dt;
per_frame_5=
per_frame_6=v = v*0.986 + a*dt;
per_frame_7=a = -(h - 0.5)*0.4 + sqrt(- min(0,(w1v+w2v)*0.1)) - .175;
per_frame_8=
per_frame_9=monitor = w2;
per_frame_10=
per_frame_11=
per_frame_12=w1 = w1 + w1v*dt;
per_frame_13=w1v = w1v*0.98 + w1a*dt;
per_frame_14=w1a = -(w1)*20 - w2a*0.1   + av*30;
per_frame_15=
per_frame_16=w2 = w2 + w2v*dt;
per_frame_17=w2v = w2v*0.98 + w2a*dt;
per_frame_18=w2a = -(w2-w1)*20;
per_frame_19=
per_frame_20=bb = bb*0.99 + bass*0.02;
per_frame_21=mm = mm*0.99 + mid*0.02;
per_frame_22=tt = tt*0.99 + treb*0.02;
per_frame_23=
per_frame_24=mi = min(min(bb,mm),tt);
per_frame_25=ma = max(max(bb,mm),tt);
per_frame_26=av = (bb+mm+tt-mi-ma);
per_frame_27=q5 = av;
per_frame_28=avn = (av-mi)/(ma-mi);
per_frame_29=av = abs(avo-avn);
per_frame_30=avo = avn;
per_frame_31=
per_frame_32=q1 = h*0.8 + 0.12;
per_frame_33=q2 = (w1);
per_frame_34=q3 = (w2 + w1);
per_frame_35=q4 = 0.1+ avo*0.1;
per_frame_36=
per_frame_37=
per_frame_38=
per_frame_39=mx = max(max(bb,mm),tt);
per_frame_40=mn = min(min(bb,mm),tt);
per_frame_41=
per_frame_42=h1 = (bb-mn)/(mx-mn);
per_frame_43=h2 = (mm-mn)/(mx-mn);
per_frame_44=h3 = (tt-mn)/(mx-mn);
per_frame_45=
per_frame_46=v = 0.25/fps;
per_frame_47=bm = bm + (h1-h2)*v;
per_frame_48=mt = mt + (h2-h3)*v;
per_frame_49=bt = bt + (h1-h3)*v;
per_frame_50=
per_frame_51=w = bm*2;
per_frame_52=q3 = sin(w);
per_frame_53=q4 = cos(w);
per_frame_54=
per_frame_55=
per_frame_56=
per_frame_57=q10 = bm;
per_frame_58=q11 = mt;
per_frame_59=q12 = bt;
per_frame_60=// END //
warp_1=`//Original shader by Tubeman
warp_2=`//ShaderToy Original: https://www.shadertoy.com/view/l3fSDr
warp_3=`//MilkDrop (HLSL) Port by Jian Simanjuntak
warp_4=`
warp_5=`//BEGIN//
warp_6=`
warp_7=`float3 pal(float t) {
warp_8=`    float3 b = float3(.45, .45, .45);
warp_9=`    float3 c = float3(.35, .35, .35);
warp_10=`    return b + c*cos(6.28318*(t*float3(1, 1, 1)+float3(.7,.39, .2)));
warp_11=`}
warp_12=`
warp_13=`float gyroid(float3 p, float scale) {
warp_14=`    p *= scale;
warp_15=`    float bias = lerp(1.1, 2.65, sin(time*.4 + p.x/3. + p.z/4.)*.5+.5);
warp_16=`    float g = abs(dot(sin(p*1.01), cos(p.zxy*1.61)) - bias)/(scale*1.5)-.1;
warp_17=`    return g;
warp_18=`}
warp_19=`
warp_20=`float scene(float3 p) {
warp_21=`    float g1 = .7*gyroid(p, 4.);
warp_22=`    return g1;
warp_23=`}
warp_24=`
warp_25=`// from @blackle
warp_26=`float3 norm(float3 p) {
warp_27=`    float3x3 k = float3x3(p,p,p) - float3x3(0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01);
warp_28=`    return normalize(scene(p) - float3(scene(k[0]),scene(k[1]),scene(k[2])));
warp_29=`}
warp_30=`	shader_body {
warp_31=`    uv = (uv * 2)-1;
warp_32=`    float3 init = float3(time*.25,1.5,.3);
warp_33=`    float3 cam = normalize(float3(1., uv ));
warp_34=`    
warp_35=`    // basic raymarcher from @blackle
warp_36=`    float3 p = init;
warp_37=`    bool hit = false;
warp_38=`    for ( int i = 0; i < 100 && !hit; i++) {
warp_39=`        if (distance(p,init) > 8.) int test = 0;
warp_40=`       float d = scene(p);
warp_41=`       if (d*d < 0.00001) hit = true;
warp_42=`       p += cam*d;
warp_43=`    }
warp_44=`    float3 n = norm(p);
warp_45=`
warp_46=`    float ao = 1.-smoothstep(-.3,.75,scene(p+n*.4))
warp_47=`             * smoothstep(-3.,3.,scene(p+n*1.));
warp_48=`             
warp_49=`    float fres = -max(0., pow(.8-abs(dot(cam,n)), 3.));
warp_50=`    float3 vign = smoothstep(0.,1.,(1.-(length(uv*.8)-.1)));
warp_51=`    float3 col = pal(.1-time*.01 + p.x*.28 + p.y*.2 + p.z*.2);
warp_52=`    col = (float3(fres, fres, fres)+col)*ao;
warp_53=`    col = lerp(col, float3(0,0,0), !hit ? 1. : smoothstep(0.,8.,distance(p,init)));
warp_54=`    col = lerp(float3(0,0,0),col, vign+.1);
warp_55=`    col = smoothstep(0.,1.+.3*sin(time+p.x*4.+p.z*4.),col);
warp_56=`    ret = col;
warp_57=`    ret = sqrt(ret);
warp_58=`}
warp_59=`// Thank you for warp shader edited by Jian Simanjuntak //
comp_1=`float2 complex_div(float2 numerator, float2 denominator){
comp_2=`   return float2( numerator.x*denominator.x + numerator.y*denominator.y,
comp_3=`                  numerator.y*denominator.x - numerator.x*denominator.y)/
comp_4=`          (denominator.x*denominator.x + denominator.y*denominator.y);
comp_5=`}
comp_6=`
comp_7=`float2 uv_polar(float2 domain, float2 center){
comp_8=`   float2 c = domain - center;
comp_9=`   float rad_hq = length(c);
comp_10=`   float ang_hq = atan2(c.x,c.y);
comp_11=`   return float2(ang_hq*M_INV_PI_2, rad_hq);
comp_12=`}
comp_13=`
comp_14=`float2 uv_polar_logarithmic(float2 domain, float2 center, int fins, float log_factor, float2 coord){
comp_15=`   float2 polar = uv_polar(domain, center);
comp_16=`   return float2(polar.x*fins+coord.x, log_factor*log(polar.y) + coord.y);
comp_17=`}
comp_18=`
comp_19=`float2 uv_moebius_transformation(float2 domain, float2 zeroPoint, float2 infinityPoint,float zoom){
comp_20=`   return complex_div((domain - zeroPoint)*zoom, domain - infinityPoint)+0.5;
comp_21=`}
comp_22=`
comp_23=`float2 uv_bipolar(float2 domain, float2 northPole, float2 southPole, int fins, float log_factor, float2 coord){
comp_24=`   float2 help_uv = uv_moebius_transformation(domain, northPole, southPole, 1);
comp_25=`   return uv_polar_logarithmic(help_uv,0.5,fins,log_factor,coord);
comp_26=`}
comp_27=`
comp_28=`
comp_29=`float2 uv_rotate( float2 domain, float2 center, float sinw, float cosw, float scale){
comp_30=`   float2 uv_r = (domain-center);
comp_31=`   return center + float2( cosw*uv_r.x - sinw*uv_r.y, sinw*uv_r.x + cosw*uv_r.y)*scale;
comp_32=`}
comp_33=`
comp_34=`
comp_35=`shader_body
comp_36=`{
comp_37=`float2 uvo = uv;
comp_38=`
comp_39=`float2 rotate_uv = 0.5-uv_rotate(0 + (uv-0.5)*aspect.xy, 0, q4, q5, 2)*0.667;
comp_40=`float2 bipolar_uv = uv_bipolar(rotate_uv,float2(0,0.5),float2(1,0.5), 2, 0.38, float2(q11,q12));
comp_41=`uv = 0.5 + (0.5 - abs( frac( bipolar_uv * 1.0 ) * 2.0 - 1.0 ))*0.9;
comp_42=`float2 uv_x = 1.0 - abs( frac( uv ) * 2.0 - 1.0 ); // Eo.S' mirror code
comp_43=`
comp_44=`uv_x = 0.5 + (uv_x-0.5)*float2(0.75,-0.9) - float2(0,0.05);
comp_45=`
comp_46=`ret.x = GetPixel(uv_x).x;
comp_47=`
comp_48=`// ***** Flexis rotating caleidoscope code *****
comp_49=`
comp_50=`float2 cntr = float2(q13,q14); float sin = q11; float cos = q12; float scale = q15;
comp_51=`float2 uv_r = (uv-cntr)*aspect.xy;
comp_52=`       uv_r = scale*float2( cos*uv_r.x - sin*uv_r.y, sin*uv_r.x + cos*uv_r.y); // rotation
comp_53=`       uv_r = cntr + uv_r*aspect.zw;
comp_54=`       uv_r = 1.0 - abs( frac( uv_r * 0.5 ) * 2.0 - 1.0 ); // mirror
comp_55=`
comp_56=`sin = q17; cos = q18; scale = q16;
comp_57=`float2 uv_rr = (uv_r-cntr)*aspect.xy;
comp_58=`       uv_rr = scale*float2( cos*uv_rr.x - sin*uv_rr.y, sin*uv_rr.x + cos*uv_rr.y); // counter-rotation
comp_59=`       uv_rr = cntr + (uv_rr)*aspect.zw;
comp_60=`
comp_61=`float2 uv_y = uv_rr;
comp_62=`
comp_63=`// ***** :) *****
comp_64=`
comp_65=`
comp_66=`
comp_67=`    ret = tex2D(sampler_main, uv).xyz;
comp_68=`    ret *= 1.00; //gamma
comp_69=`}
