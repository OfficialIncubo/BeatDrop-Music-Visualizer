MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=5.000
fGammaAdj=1.460
fDecay=0.935
FFTAttack=0.500
FFTDecay=0.700
fVideoEchoZoom=1.007
fVideoEchoAlpha=0.500
nVideoEchoOrientation=2
nWaveMode=15
bAdditiveWaves=1
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=1
bDarken=1
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=0.625
fWaveSmoothing=0.900
fWaveParam=0.000
fModWaveAlphaStart=0.880
fModWaveAlphaEnd=1.980
fWarpAnimSpeed=0.010
fWarpScale=0.010
fZoomExponent=1.00000
fShader=1.000
zoom=1.00000
rot=0.00000
cx=0.500
cy=0.500
dx=0.00000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=0.000
wave_g=0.000
wave_b=0.000
wave_x=0.500
wave_y=0.500
ob_size=0.500
ob_r=0.010
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.260
ib_r=0.235
ib_g=0.250
ib_b=0.250
ib_a=0.000
nMotionVectorsX=64.000
nMotionVectorsY=48.000
mv_dx=0.000
mv_dy=0.000
mv_l=1.000
mv_r=1.060
mv_g=1.000
mv_b=0.819
mv_a=0.000
b1n=0.000
b2n=0.000
b3n=0.000
b1x=1.000
b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`shader_body
warp_7=`{
warp_8=`    float3 col = 0;
warp_9=`    float t = time*.25;
warp_10=`    float fb = .9;
warp_11=`    //Obligatory Y flipping
warp_12=`    float2 uvX =0;
warp_13=`    uvX.y = 1-uvX.y;
warp_14=`    uvX = (uv-.5)*2;
warp_15=`    
warp_16=`    // scope: a trace built from the spectrum, drawn like a CRT
warp_17=`    float y = 0.0;
warp_18=`    for (int k=1;k<=6;k++){
warp_19=`      float fk = float(k);
warp_20=`      y += get_fft(fk/7.0) * sin(uvX.x*(6.0+fk*7.0) + t*(2.0+fk)) / fk;
warp_21=`    }
warp_22=`    y *= .45;
warp_23=`    float d = abs(uvX.y - y);
warp_24=`    col = float3(0.25,1.0,0.45)*(smoothstep(0.045,0.0,d) + smoothstep(0.28,0.0,d)*0.25);
warp_25=`    col += float3(0.1,0.35,0.15)*smoothstep(0.004,0.0,abs(uvX.y))*0.5;
warp_26=`
warp_27=`    // Dynamic rotation angle (fa) and slight zoom factor (fz) driven by audio
warp_28=`    float fa = 0.03 + 0.05 * sin(t * 0.6) + mid * 0.08;
warp_29=`    float fz = 0.988 - bass * 0.020;
warp_30=`
warp_31=`    // Rotation Matrix applied to UVs around center (0.5, 0.5)
warp_32=`    float2 fuv = uv - 0.5;
warp_33=`    float cos_a = cos(fa);
warp_34=`    float sin_a = sin(fa);
warp_35=`    float2 fq = float2(
warp_36=`        cos_a * fuv.x - sin_a * fuv.y,
warp_37=`        sin_a * fuv.x + cos_a * fuv.y
warp_38=`    ) * fz + 0.5;
warp_39=`
warp_40=`    // Sample previous frame from MilkDrop's buffer
warp_41=`    float3 prev = GetPixel(fq).xyz;
warp_42=`
warp_43=`    // Apply 0.90 decay factor (with audio modulation & dark subtract)
warp_44=`    float decay = fb - 0.02 * treb;
warp_45=`    prev = prev * decay - 0.006;
warp_46=`
warp_47=`    // Vignette mask to keep edges clean from outward drift
warp_48=`    float r = length((uv - 0.5) * aspect.xy);
warp_49=`    prev *= smoothstep(1.6, 0.2, r);
warp_50=`
warp_51=`    // Combine current frame and trailed previous frame (max blend prevents white saturation)
warp_52=`    col = max(col, max(prev, float3(0, 0, 0)));
warp_53=`    
warp_54=`    ret = col;
warp_55=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
