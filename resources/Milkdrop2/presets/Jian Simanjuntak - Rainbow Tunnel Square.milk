per_frame_1=decay = 1;
per_frame_2=warp = 0;
per_frame_3=zoom = 1;
per_frame_4=
per_frame_5=dx = 1.005;
per_frame_6=
per_frame_7=ob_r = 0.5 + 0.5 * sin(time * 3.8);
per_frame_8=ob_g = 0.5 + 0.5 * sin(time * 0.9 + 5.2);
per_frame_9=ob_b = 0.5 + 0.5 * sin(time * 1.1 + 6.3);
per_frame_10=
per_frame_11=// === Bagian dinding pada terowongan ===
per_frame_12=q1 = 0.5; // Ukuran dinding
per_frame_13=q2 = 2.0; // Kecepatan terowongan berjalan
per_frame_14=q3 = 0.35; // Setelan sudut pandang pada kamera
per_frame_15=
per_frame_16=// === Setelan kamera pada terowongan ===
per_frame_17=q4 = 0.09; // Kecepatan putaran kamera
per_frame_18=q5 = 3.5; // Menengok Kanan/Kiri
per_frame_19=q6 = 3.5; // Menengok Atas/Bawah
comp_1=`shader_body
comp_2=`{
comp_3=`    float2 uv_c = uv - 0.5;
comp_4=`
comp_5=`    // Pembentukan Vektor Sinar 3D (Ray Direction) dari kamera
comp_6=`    float3 rd = normalize(float3(uv_c.x, uv_c.y, q3));
comp_7=`
comp_8=`    // Sekuensial Rotasi Kamera (Kanan -> Atas -> Kiri -> Bawah -> Kanan)
comp_9=`    // Fungsi cos(t) dan sin(t) membentuk rotasi sekuensial searah jarum jam secara periodik
comp_10=`    float t_cam = time * q4;
comp_11=`    float yaw   = cos(t_cam) * q5; // Menengok Kanan/Kiri
comp_12=`    float pitch = sin(t_cam) * q6; // Menengok Atas/Bawah
comp_13=`
comp_14=`    // Matriks Rotasi Yaw (Sumbu Y)
comp_15=`    float cosY = cos(yaw);
comp_16=`    float sinY = sin(yaw);
comp_17=`    float3 rd_yaw;
comp_18=`    rd_yaw.x = rd.x * cosY + rd.z * sinY;
comp_19=`    rd_yaw.y = rd.y;
comp_20=`    rd_yaw.z = -rd.x * sinY + rd.z * cosY;
comp_21=`
comp_22=`    // Matriks Rotasi Pitch (Sumbu X)
comp_23=`    float cosP = cos(pitch);
comp_24=`    float sinP = sin(pitch);
comp_25=`    float3 rd_rot;
comp_26=`    rd_rot.x = rd_yaw.x;
comp_27=`    rd_rot.y = rd_yaw.y * cosP - rd_yaw.z * sinP;
comp_28=`    rd_rot.z = rd_yaw.y * sinP + rd_yaw.z * cosP;
comp_29=`
comp_30=`    // Interseksi Sinar dengan Dinding Lorong Persegi 3D
comp_31=`    float2 abs_rd = abs(rd_rot.xy);
comp_32=`    float max_rd = max(abs_rd.x, abs_rd.y);
comp_33=`    max_rd = max(max_rd, 0.001); // Mencegah deviasi angka nol
comp_34=`
comp_35=`    // Jarak tempuh sinar hingga menabrak dinding lorong
comp_36=`    float dist = 1.0 / max_rd;
comp_37=`    float3 hit = rd_rot * dist;
comp_38=`
comp_39=`    // Pemetaan Koordinat Tekstur & Efek Mirroring
comp_40=`    float2 tunnel_uv;
comp_41=`    
comp_42=`    // Pemetaan keliling dinding kotak
comp_43=`    tunnel_uv.x = (abs_rd.x > abs_rd.y) ? hit.y : hit.x;
comp_44=`    
comp_45=`    // Pemetaan kedalaman Z ditambah pergerakan waktu maju
comp_46=`    tunnel_uv.y = hit.z * q1 + time * q2;
comp_47=`
comp_48=`    // Efek mirrorized pada tekstur menggunakan abs & frac
comp_49=`    float2 final_uv = frac(abs(tunnel_uv));
comp_50=`
comp_51=`    // Mengambil piksel tekstur utama
comp_52=`    float3 col = tex2D(sampler_main, final_uv).xyz;
comp_53=`
comp_54=`    // Penggelapan jarak jauh (Depth Fog)
comp_55=`    float fog = saturate(1.0 - (dist * 0.035));
comp_56=`    col *= fog;
comp_57=`
comp_58=`    float3 color = float3(1.0, 1.0, 1.0) - col;
comp_59=`    ret = float4(color, 1.0);
comp_60=`}
