MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
wavecode_0_enabled=1
wavecode_0_samples=512
wavecode_0_sep=0
wavecode_0_bSpectrum=1
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=0
wavecode_0_scaling=1
wavecode_0_smoothing=0.3
wavecode_0_r=1
wavecode_0_g=1
wavecode_0_b=1
wavecode_0_a=1
wave_0_per_frame1=a = 1;
wave_0_per_point1=x = 0.5 + (sample - 0.5)*0.9/q31;
wave_0_per_point2=y = 0.5 + 0.440/q32;
wave_0_per_point3=h = min(1, sqrt(max(0, value1)*2.5*(1 + sample*5)));
wave_0_per_point4=r = h;
wave_0_per_point5=g = h;
wave_0_per_point6=b = h;
per_frame_init_1=last = 0;
per_frame_init_2=g = 0;
per_frame_init_3=seed = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=beat = (bass > 1.35)*((time - last) > 0.5);
per_frame_5=last = if(beat, time, last);
per_frame_6=seed = if(beat, rand(1000)*0.001, seed);
per_frame_7=g = max(g*pow(0.8, q30), beat);
per_frame_8=q1 = g;
per_frame_9=q2 = seed;
per_frame_10=q3 = time*0.03 + mid_att*0.05;
per_frame_11=q4 = treb_att;
warp_1=`shader_body
warp_2=`{
warp_3=`  float row = abs(uv.y - 0.120);
warp_4=`  float pk = max(tex2D(sampler_main, uv).x - 0.02 * q30, tex2D(sampler_main, float2(uv.x, 0.060)).x);
warp_5=`  ret = row < 0.01 ? pk : 0.0;
warp_6=`}
comp_1=`sampler sampler_pw_noise_lq;
comp_2=`float3 scene(float2 u)
comp_3=`{
comp_4=`  float nb = 40.0;
comp_5=`  float k = floor(u.x * nb);
comp_6=`  float fx = frac(u.x * nb);
comp_7=`  float bx = (k + 0.5) / nb;
comp_8=`  float rx = 0.05 + 0.9 * pow(bx, 1.8);
comp_9=`  float h = tex2D(sampler_main, float2(rx, 0.060)).x;
comp_10=`  float pk = tex2D(sampler_main, float2(rx, 0.120)).x;
comp_11=`  float base = 0.8;
comp_12=`  float y = (base - u.y) / 0.62;
comp_13=`  float seg = step(0.22, frac(y * 22.0));
comp_14=`  float bar = step(0.12, fx) * step(fx, 0.88);
comp_15=`  float on = step(0.0, y) * step(y, h) * seg * bar;
comp_16=`  float cap = step(0.0, y) * step(abs(y - pk - 0.02), 0.012) * bar * step(0.03, pk);
comp_17=`  float3 low = 0.5 + 0.5 * cos(6.28318 * (float3(0.5, 0.6, 0.7) + q3));
comp_18=`  float3 high = 0.5 + 0.5 * cos(6.28318 * (float3(0.9, 0.0, 0.1) + q3));
comp_19=`  float3 c = pow(lerp(low, high, saturate(y * 1.3)), 2.2) * 1.5;
comp_20=`  float3 col = c * on * 1.1 + float3(1.0, 1.0, 1.0) * cap * 0.9;
comp_21=`  col += c * step(0.0, y) * step(y, 1.0) * bar * seg * 0.035;
comp_22=`  col += low * 0.05 * exp(-abs(u.y - base) * 12.0);
comp_23=`  float ry = (u.y - base) / 0.62;
comp_24=`  float refl = step(0.0, ry) * step(ry, h) * bar * step(0.22, frac(ry * 22.0)) * exp(-ry * 9.0);
comp_25=`  col += c * refl * 0.35;
comp_26=`  float grid = step(0.985, frac(u.x * 20.0)) + step(0.98, frac(u.y * 12.0));
comp_27=`  col += float3(0.03, 0.02, 0.06) * grid * 0.6;
comp_28=`  return col;
comp_29=`}
comp_30=`shader_body
comp_31=`{
comp_32=`  float2 bs = float2(10.0, 16.0) + floor(q2 * 4.0) * float2(4.0, 6.0);
comp_33=`  float2 blk = floor(uv * bs);
comp_34=`  float4 h = tex2D(sampler_pw_noise_lq, (blk * float2(13.0, 7.0) + floor(q2 * 97.0)) / 256.0);
comp_35=`  float amt = saturate(q1 * 1.2);
comp_36=`  float hit = step(1.0 - amt * 0.35, h.x) * step(0.05, amt);
comp_37=`  float2 u = uv + float2((h.y - 0.5) * 0.14, (h.z - 0.5) * 0.03) * hit;
comp_38=`  float jit = (tex2D(sampler_noise_lq, float2(uv.y * 40.0, time * 3.0)).x - 0.5) * 0.012 * q1;
comp_39=`  u.x += jit;
comp_40=`  float3 high = 0.5 + 0.5 * cos(6.28318 * (float3(0.9, 0.0, 0.1) + q3));
comp_41=`  float sh = 0.003 + 0.014 * q1;
comp_42=`  float3 col;
comp_43=`  col.r = scene(u + float2(sh, 0.0)).r;
comp_44=`  col.g = scene(u).g;
comp_45=`  col.b = scene(u - float2(sh, 0.0)).b;
comp_46=`  float inv = hit * step(0.9, h.w);
comp_47=`  col = lerp(col, (float3(1.0, 1.0, 1.0) - col) * high, inv * 0.6);
comp_48=`  col *= 0.9 + 0.1 * sin(uv.y * 900.0);
comp_49=`  col += float3(0.02, 0.008, 0.04);
comp_50=`  float2 v = uv - 0.5;
comp_51=`  col *= 1.0 - dot(v, v) * 0.5;
comp_52=`  ret = 1.0 - exp(-col * 1.5);
comp_53=`}
