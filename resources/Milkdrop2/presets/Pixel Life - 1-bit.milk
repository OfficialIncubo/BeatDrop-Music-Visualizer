MILKDROP_PRESET_VERSION=201
PSVERSION=3
PSVERSION_WARP=3
PSVERSION_COMP=3
[preset00]
fRating=4.00000
fGammaAdj=1.00000
fDecay=1.00000
fVideoEchoZoom=1.00000
fVideoEchoAlpha=0.00000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.00000
fWaveScale=1.00000
fWaveSmoothing=0.00000
fWaveParam=0.00000
fModWaveAlphaStart=0.75000
fModWaveAlphaEnd=0.95000
fWarpAnimSpeed=1.00000
fWarpScale=1.00000
fZoomExponent=1.00000
fShader=0.00000
zoom=1.00000
rot=0.00000
cx=0.50000
cy=0.50000
dx=0.00000
dy=0.00000
warp=0.00000
sx=1.00000
sy=1.00000
wave_r=1.00000
wave_g=1.00000
wave_b=1.00000
wave_x=0.50000
wave_y=0.50000
ob_size=0.00000
ob_r=0.00000
ob_g=0.00000
ob_b=0.00000
ob_a=0.00000
ib_size=0.00000
ib_r=0.00000
ib_g=0.00000
ib_b=0.00000
ib_a=0.00000
nMotionVectorsX=0.00000
nMotionVectorsY=0.00000
mv_dx=0.00000
mv_dy=0.00000
mv_l=0.00000
mv_r=0.00000
mv_g=0.00000
mv_b=0.00000
mv_a=0.00000
per_frame_init_1=t0 = time;
per_frame_init_2=seeded = 0;
per_frame_init_3=laststep = -1;
per_frame_init_4=pending = 0;
per_frame_init_5=lasthit = 0;
per_frame_init_6=q8 = 0;
per_frame_init_7=q9 = 0;
per_frame_init_8=q13 = 1;
per_frame_init_9=q14 = 1;
per_frame_init_10=nextglider = 0.8;
per_frame_1=el = time - t0;
per_frame_2=st = int(el*15);
per_frame_3=q1 = above(st, laststep);
per_frame_4=laststep = st;
per_frame_5=q2 = below(el, 2.8);
per_frame_6=q3 = (1 - q2)*(1 - seeded);
per_frame_7=seeded = max(seeded, q3);
per_frame_8=q4 = 8;
per_frame_9=q5 = 12;
per_frame_10=q11 = if(q1, rand(1000)/1000, q11);
per_frame_11=q12 = if(q1, rand(1000)/1000, q12);
per_frame_12=q15 = 2.0;
per_frame_13=beat = above(bass, 1.25)*above(bass, bass_att*1.12)*above(time - lasthit, 0.25);
per_frame_14=lasthit = if(beat, time, lasthit);
per_frame_15=auto = 1*above(el, nextglider);
per_frame_16=nextglider = if(auto + beat, el + 1 + rand(150)/100, nextglider);
per_frame_17=pending = max(pending, max(beat, auto));
per_frame_18=fire = q1*pending*(1 - q2);
per_frame_19=pending = pending*(1 - q1*(1 - q2));
per_frame_20=q8 = if(fire, rand(400), q8);
per_frame_21=q9 = if(fire, rand(400), q9);
per_frame_22=q13 = if(fire, if(rand(2), 1, -1), q13);
per_frame_23=q14 = if(fire, if(rand(2), 1, -1), q14);
per_frame_24=q7 = fire*1;
per_frame_25=q10 = fire*0;
warp_1=`shader_body
warp_2=`{
warp_3=`    // The grid: square cells of whole pixels, 80 rows, as many columns as fit; it wraps.
warp_4=`    float cs = max(floor(texsize.y/80), 1);
warp_5=`    float2 G = floor(texsize.xy/cs);
warp_6=`    float2 cid = floor(uv*texsize.xy/cs);
warp_7=`    float2 k = cs*texsize.zw;                       // one cell, in uv
warp_8=`    float2 c = (cid + 0.5)*k;
warp_9=`    float3 me = tex2D(sampler_pw_main, c).xyz;
warp_10=`    float n = 0;
warp_11=`    for (int j = -1; j <= 1; j++)
warp_12=`        for (int i = -1; i <= 1; i++)
warp_13=`            if (i != 0 || j != 0)
warp_14=`                n += step(0.5, tex2D(sampler_pw_main, (fmod(cid + float2(i, j) + G, G) + 0.5)*k).x);
warp_15=`    float alive = step(0.5, me.x);
warp_16=`    // The rule: bit n of q4 (birth) or q5 (survive).
warp_17=`    float next = lerp(fmod(floor(q4/exp2(n)), 2), fmod(floor(q5/exp2(n)), 2), alive);
warp_18=`    float rnd = tex2D(sampler_noise_lq, (cid + 0.5)/256.0 + float2(q11, q12)).x;
warp_19=`    // SOUND LINE: across the middle, each column's frequency band (low on the left) seeds cells.
warp_20=`    float band = get_fft(0.01 + 0.45*cid.x/G.x)*q15;
warp_21=`    next = max(next, step(abs(cid.y - floor(G.y*0.5)), 0.5)*step(rnd, band - 0.15));
warp_22=`    // GLIDERS: a beat (q7) fires one from (q8, q9), heading (q13, q14) = (+-1, +-1).
warp_23=`    float2 r = fmod(cid - fmod(float2(q8, q9), G) + G, G);
warp_24=`    float2 o = float2(q13 > 0 ? r.x : 2 - r.x, q14 > 0 ? r.y : 2 - r.y);
warp_25=`    float glider = (o.x == 1 && o.y == 0) || (o.x == 2 && o.y == 1) || (o.y == 2 && o.x <= 2) ? 1 : 0;
warp_26=`    float box = step(r.x, 3)*step(r.y, 3);
warp_27=`    next = lerp(next, glider, q7*box);
warp_28=`    float now = lerp(alive, next, q1);               // q1: a generation this frame
warp_29=`    float born = q1*now*(1 - alive);
warp_30=`    float age = lerp(me.y, born > 0.5 ? 1.0 : (now > 0.5 ? max(me.y*0.9, 0.55) : me.y*0.72), q1);
warp_31=`    // The start. While the previous preset blends out (q2), its picture would leak into the grid
warp_32=`    // as random cells, so the grid is held empty; then the random field, once (q3).
warp_33=`    float start = step(1 - 0.25, rnd);
warp_34=`    now = lerp(now, start, q3);
warp_35=`    age = lerp(age, start, q3);
warp_36=`    now *= 1 - q2;
warp_37=`    age *= 1 - q2;
warp_38=`    float outside = 1 - step(cid.x, G.x - 1)*step(cid.y, G.y - 1);
warp_39=`    ret = float3(now, age, 0)*(1 - outside);
warp_40=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float cs = max(floor(texsize.y/80), 1);
comp_4=`    float2 G = floor(texsize.xy/cs);
comp_5=`    float2 px = floor(uv*texsize.xy);
comp_6=`    float2 cid = floor(px/cs);
comp_7=`    float2 sp = floor((px - cid*cs)/cs*5);           // the sprite pixel inside the cell, 0..4
comp_8=`    float inside = step(cid.x, G.x - 1)*step(cid.y, G.y - 1);
comp_9=`    float3 s = tex2D(sampler_pw_main, (cid + 0.5)*cs*texsize.zw).xyz;
comp_10=`    float alive = step(0.5, s.x);
comp_11=`    float3 c0 = float3(0.004, 0.004, 0.004), c1 = float3(1.000, 1.000, 1.000), c2 = float3(1.000, 1.000, 1.000), c3 = float3(1.000, 1.000, 1.000);
comp_12=`    // 4 x 4 Bayer threshold, per sprite pixel: the dither every layer uses.
comp_13=`    float2 bp = fmod(cid*5 + sp, 4);
comp_14=`    float b2 = fmod(bp.x, 2)*2 + fmod(bp.y, 2);
comp_15=`    float2 bq = floor(bp/2);
comp_16=`    float bayer = (b2*4 + fmod(bq.x, 2)*2 + fmod(bq.y, 2) + 0.5)/16;
comp_17=`
comp_18=`    // BACKGROUND LAYER
comp_19=`    // Stars: a few sprite pixels, drifting left, twinkling.
comp_20=`    float3 col = c0;
comp_21=`    float2 sc = floor((px + float2(time*12, 0))/cs*5/3);
comp_22=`    float star = tex2D(sampler_noise_lq, sc/256.0).x;
comp_23=`    float tw = 0.5 + 0.5*sin(time*3 + star*40);
comp_24=`    col = lerp(col, lerp(c1, c3, step(0.996, star)), step(0.985, star)*step(0.3, tw));
comp_25=`
comp_26=`    // GLOW LAYER: the colony's light, in whole cells and dithered steps, not a smooth blur.
comp_27=`    float glow = GetBlur2((cid + 0.5)*cs*texsize.zw).x*0.4;
comp_28=`    col = lerp(col, c1, step(bayer, glow*1.6));
comp_29=`
comp_30=`    // TRAIL LAYER: cells that just died fade out through the dither.
comp_31=`    float trail = (1 - alive)*step(bayer, s.y*1.2 - 0.15);
comp_32=`    col = lerp(col, c3, trail);
comp_33=`
comp_34=`    // LIFE LAYER: each live cell a 5 x 5 sprite, rounded, lit from the top left: a highlight, a
comp_35=`    // body (the lightest colour while newborn), a shadow edge.
comp_36=`    float corner = (sp.x == 0 || sp.x == 4) && (sp.y == 0 || sp.y == 4) ? 1 : 0;
comp_37=`    float shade = (sp.x == 4 || sp.y == 4) ? 1 : 0;
comp_38=`    float light = (sp.x == 1 && sp.y == 1) ? 1 : 0;
comp_39=`    float3 body = s.y > 0.85 ? c3 : c2;
comp_40=`    float3 sprite = light > 0.5 ? c3 : (shade > 0.5 ? c1 : body);
comp_41=`    col = lerp(col, sprite, alive*(1 - corner));
comp_42=`
comp_43=`    ret = col*inside;
comp_44=`}
