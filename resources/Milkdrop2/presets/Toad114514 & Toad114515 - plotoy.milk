per_frame_6=dy=sin(bass*25);
per_frame_7=ib_r=sin(mid) - cos(mid);
per_frame_8=ib_g=sin(mid-.6) * cos(bass_att);
per_frame_9=ib_b=sin(mid-.7) / cos(treb_att);
per_frame_10=q1=sin(cos(sin(abs(mid)*.1+.2)));
per_frame_11=q2=sin(cos(mid)*60-.6+abs(treb));
per_frame_12=q3=abs(equal(mid,time*.6/1));
