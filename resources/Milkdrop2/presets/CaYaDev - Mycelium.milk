wave_1_per_frame1=t1 = q7;
wave_1_per_frame2=t2 = q1;
wave_1_per_frame3=t3 = q2;
wave_1_per_frame4=t4 = q3;
wave_1_per_frame5=a = 0.9;
wave_1_per_point1=s = sample;
wave_1_per_point2=on = (s < t1);
wave_1_per_point3=st = (s > 0.001);
wave_1_per_point4=an = an*st + (1 - st)*(1.5708 + t3*1.3);
wave_1_per_point5=an = an + 0.05*sin(s*31 + t3*7 + 1) + 0.04*sin(s*83 + t3*3.1 + 2);
wave_1_per_point6=px = px*st + (1 - st)*t4;
wave_1_per_point7=py = py*st + (1 - st)*t2;
wave_1_per_point8=px = px + cos(an)*0.0022;
wave_1_per_point9=py = py + sin(an)*0.0022;
wave_1_per_point10=fork = (s*12 - floor(s*12) < 0.04)*(s > 0.1);
wave_1_per_point11=x = 0.5 + (px - 0.5)/q31;
wave_1_per_point12=y = 0.5 + (py - 0.5)/q32;
wave_1_per_point13=tipd = abs(s - t1);
wave_1_per_point14=tip = (tipd < 0.012)*on;
wave_1_per_point15=br = on*(0.35 + 0.65*tip + 0.4*fork);
wave_1_per_point16=r = 0.25*br;
wave_1_per_point17=g = 0.85*br;
wave_1_per_point18=b = 0.75*br;
