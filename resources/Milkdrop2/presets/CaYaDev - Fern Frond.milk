wave_2_per_frame2=t2 = q2;
wave_2_per_frame3=a = 0.35*min(1, q30);
wave_2_per_point1=rr = rand(1000)*0.001;
wave_2_per_point2=nx = if(rr < 0.02, 0, if(rr < 0.86, 0.85*fx + 0.04*fy, if(rr < 0.93, 0.2*fx - 0.26*fy, -0.15*fx + 0.28*fy)));
wave_2_per_point3=ny = if(rr < 0.02, 0.16*fy, if(rr < 0.86, -0.04*fx + 0.85*fy + 1.6, if(rr < 0.93, 0.23*fx + 0.22*fy + 1.6, 0.26*fx + 0.24*fy + 0.44)));
wave_2_per_point4=fx = nx;
wave_2_per_point5=fy = ny;
wave_2_per_point6=h = fy/10;
wave_2_per_point7=bend = (t1*0.12 + 0.03*sin(t2*1.3 + 2))*h*h;
wave_2_per_point8=bx = 1*fx*0.042 + bend + 0.12;
wave_2_per_point9=by = h*0.84 - 0.47;
wave_2_per_point10=x = 0.5 + bx/q31;
wave_2_per_point11=y = 0.5 + by/q32;
wave_2_per_point12=r = 0.4;
wave_2_per_point13=g = 0.85;
wave_2_per_point14=b = 0.3;
wavecode_3_enabled=1
