wave_1_per_frame2=t2 = q2;
wave_1_per_frame3=a = 0.35*min(1, q30);
wave_1_per_point1=rr = rand(1000)*0.001;
wave_1_per_point2=nx = if(rr < 0.02, 0, if(rr < 0.86, 0.85*fx + 0.04*fy, if(rr < 0.93, 0.2*fx - 0.26*fy, -0.15*fx + 0.28*fy)));
wave_1_per_point3=ny = if(rr < 0.02, 0.16*fy, if(rr < 0.86, -0.04*fx + 0.85*fy + 1.6, if(rr < 0.93, 0.23*fx + 0.22*fy + 1.6, 0.26*fx + 0.24*fy + 0.44)));
