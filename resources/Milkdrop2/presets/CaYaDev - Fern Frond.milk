wavecode_3_sep=0
wavecode_3_bSpectrum=0
wavecode_3_bUseDots=1
wavecode_3_bDrawThick=0
wavecode_3_bAdditive=1
wavecode_3_scaling=1
wavecode_3_smoothing=0
wavecode_3_r=1
wavecode_3_g=1
wavecode_3_b=1
wavecode_3_a=0.5
wave_3_per_frame1=t1 = q1;
wave_3_per_frame2=t2 = q2;
wave_3_per_frame3=a = 0.35*min(1, q30);
wave_3_per_point1=rr = rand(1000)*0.001;
wave_3_per_point2=nx = if(rr < 0.02, 0, if(rr < 0.86, 0.85*fx + 0.04*fy, if(rr < 0.93, 0.2*fx - 0.26*fy, -0.15*fx + 0.28*fy)));
wave_3_per_point3=ny = if(rr < 0.02, 0.16*fy, if(rr < 0.86, -0.04*fx + 0.85*fy + 1.6, if(rr < 0.93, 0.23*fx + 0.22*fy + 1.6, 0.26*fx + 0.24*fy + 0.44)));
wave_3_per_point4=fx = nx;
wave_3_per_point5=fy = ny;
wave_3_per_point6=h = fy/10;
wave_3_per_point7=bend = (t1*0.12 + 0.03*sin(t2*1.3 + 3))*h*h;
wave_3_per_point8=bx = -1*fx*0.036 + bend + 0.35;
wave_3_per_point9=by = h*0.72 - 0.47;
wave_3_per_point10=x = 0.5 + bx/q31;
wave_3_per_point11=y = 0.5 + by/q32;
wave_3_per_point12=r = 0.7;
wave_3_per_point13=g = 1;
wave_3_per_point14=b = 0.45;
per_frame_init_1=gust = 0;
per_frame_init_2=ptk = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=gust = gust + (min(bass_att, 2) - 1 - gust)*min(1, 1.2/fps);
per_frame_5=q1 = gust;
per_frame_6=q2 = time;
per_frame_7=q3 = min(treb_att, 2);
per_frame_8=tk = floor(time*8);
per_frame_9=tick = (abs(tk - ptk) > 0.5);
per_frame_10=ptk = tk;
per_frame_11=q4 = tick*0.004;
warp_1=`shader_body
warp_2=`{
warp_3=`  // the floor steps on a time tick from frame code (q4), so the fade keeps its pace at any frame rate
warp_4=`  float3 c = tex2D(sampler_main, uv).xyz;
warp_5=`  ret = max(c * pow(0.94, q30) - q4, 0.0);
warp_6=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float3 bg = lerp(float3(0.01, 0.025, 0.015), float3(0.03, 0.06, 0.035), 1.0 - uv.y);
comp_4=`  bg += float3(0.15, 0.2, 0.08) * exp(-length((uv - float2(0.3, 0.1)) * float2(1.0, 1.6)) * 2.5) * 0.4;
comp_5=`  float3 m = tex2D(sampler_main, uv).xyz;
comp_6=`  float3 col = bg + m * 1.3 + GetBlur1(uv) * 0.5 + GetBlur2(uv) * 0.3;
comp_7=`  float dew = step(0.997, tex2D(sampler_noise_lq, uv * texsize.xy / 256.0 + time * 0.11).x) * lum(m) * q3 * 3.0;
comp_8=`  col += float3(0.9, 1.0, 0.95) * dew;
comp_9=`  col *= 1.0 - dot(uv - 0.5, uv - 0.5) * 0.6;
comp_10=`  ret = 1.0 - exp(-col * 1.5);
comp_11=`}
