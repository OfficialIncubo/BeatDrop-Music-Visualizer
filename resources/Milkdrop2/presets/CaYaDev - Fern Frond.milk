wave_1_per_point6=h = fy/10;
wave_1_per_point7=bend = (t1*0.12 + 0.03*sin(t2*1.3 + 1))*h*h;
wave_1_per_point8=bx = -1*fx*0.036 + bend + -0.11;
wave_1_per_point9=by = h*0.88 - 0.47;
wave_1_per_point10=x = 0.5 + bx/q31;
wave_1_per_point11=y = 0.5 + by/q32;
wave_1_per_point12=r = 0.2;
wave_1_per_point13=g = 0.65;
