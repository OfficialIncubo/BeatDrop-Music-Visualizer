shape_0_per_frame1=// Menggunakan shape segi empat panjang
shape_0_per_frame2=sides = 4;
shape_0_per_frame3=
shape_0_per_frame4=// Menentukan sudut (angle) untuk setiap instance dalam lingkaran penuh (2*PI atau ~6.28)
shape_0_per_frame5=my_angle = (instance / num_inst) * 6.2831;
shape_0_per_frame6=
shape_0_per_frame7=// Membuat nilai posisi (pos) dari 0 ke 1, lalu kembali ke 0 (Mirroring)
shape_0_per_frame8=pos = (instance / num_inst) * 2;
shape_0_per_frame9=pos = if(above(pos, 1), 2 - pos, pos);
shape_0_per_frame10=
shape_0_per_frame11=// Mengambil respons frekuensi audio (kiri = bass, tengah = mid, kanan = treb)
shape_0_per_frame12=my_val = bass * (1 - pos) + mid * (0.5 - abs(pos - 0.5)) * 2 + treb * pos;
shape_0_per_frame13=
shape_0_per_frame14=// Mengatur jari-jari (radius) dasar lingkaran dan menambahkannya dengan pantulan audio
shape_0_per_frame15=radius_base = 0.05;
shape_0_per_frame16=radius_audio = radius_base + (my_val * 0.15);
shape_0_per_frame17=
shape_0_per_frame18=// Menempatkan posisi X dan Y secara melingkar dari titik tengah layar (0.5, 0.5)
shape_0_per_frame19=x = 0.5 + sin(my_angle) * radius_audio;
shape_0_per_frame20=y = 0.5 + cos(my_angle) * radius_audio;
shape_0_per_frame21=
shape_0_per_frame22=// Merotasi setiap bar agar mengarah lurus keluar dari pusat lingkaran
shape_0_per_frame23=ang = -my_angle;
shape_0_per_frame24=
shape_0_per_frame25=// Mengatur ketebalan bar yang merespons ketukan musik
shape_0_per_frame26=rad = 0.01 + (my_val * 0.03);
shape_0_per_frame27=
shape_0_per_frame28=// Warna RGB dinamis yang berputar seiring waktu dan menyesuaikan posisi
shape_0_per_frame29=r = 0.5 + 0.5 * sin(time * 1.5 + pos * 3.14);
shape_0_per_frame30=g = 0.5 + 0.5 * cos(time * 1.2 + pos * 3.14);
shape_0_per_frame31=b = 1 - pos;
shape_0_per_frame32=a = 1;
