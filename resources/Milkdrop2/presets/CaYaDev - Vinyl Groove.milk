MILKDROP_PRESET_VERSION=201
PSVERSION=4
PSVERSION_WARP=4
PSVERSION_COMP=4
[preset00]
fRating=5
fGammaAdj=1
fDecay=1
fVideoEchoZoom=1
fVideoEchoAlpha=0
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=1
fWaveSmoothing=0.75
fWaveParam=0
fModWaveAlphaStart=0.75
fModWaveAlphaEnd=0.95
fWarpAnimSpeed=1
fWarpScale=1
fZoomExponent=1
fShader=0
zoom=1
rot=0
cx=0.5
cy=0.5
dx=0
dy=0
warp=0
sx=1
sy=1
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_size=0
ob_r=0
ob_g=0
ob_b=0
ob_a=0
ib_size=0
ib_r=0
ib_g=0
ib_b=0
ib_a=0
nMotionVectorsX=12
nMotionVectorsY=9
mv_dx=0
mv_dy=0
mv_l=0.9
mv_r=1
mv_g=1
mv_b=1
mv_a=0
b1n=0
b2n=0
b3n=0
b1x=1
b2x=1
b3x=1
b1ed=0
wavecode_0_enabled=1
wavecode_0_samples=32
wavecode_0_sep=0
wavecode_0_bSpectrum=0
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=0
wavecode_0_scaling=1
wavecode_0_smoothing=0
wavecode_0_r=1
wavecode_0_g=1
wavecode_0_b=1
wavecode_0_a=1
wave_0_per_frame1=t1 = q7;
wave_0_per_frame2=t2 = q8;
wave_0_per_frame3=t3 = q11;
wave_0_per_frame4=t4 = q10*1.6;
wave_0_per_frame5=tt = max(q12 + q13 + q14, 0.01);
wave_0_per_frame6=sb = q12/tt;
wave_0_per_frame7=sm = q13/tt;
wave_0_per_frame8=st = q14/tt;
wave_0_per_frame9=r = 1.3*sb + 0.25*sm + 0.4*st;
wave_0_per_frame10=g = 0.35*sb + 1.2*sm + 0.55*st;
wave_0_per_frame11=b = 0.15*sb + 0.45*sm + 1.4*st;
wave_0_per_frame12=a = 1;
wave_0_per_point1=k = floor(sample*31 + 0.5);
wave_0_per_point2=xx = t1 - t4*sample;
wave_0_per_point3=yy = t2 + t3*(2*(k - 2*floor(k/2)) - 1);
wave_0_per_point4=x = 0.5 + (xx - 0.5)/q31;
wave_0_per_point5=y = 0.5 + (0.5 - yy)/q32;
per_frame_init_1=spin = 0;
per_frame_init_2=ps = 0;
per_frame_init_3=ptk = 0;
per_frame_1=q30 = 60/max(fps, 15);
per_frame_2=q31 = aspectx;
per_frame_3=q32 = aspecty;
per_frame_4=w = 0.9;
per_frame_5=spin = spin + w/fps;
per_frame_6=side = time/90 - floor(time/90);
per_frame_7=reset = (side < ps);
per_frame_8=ps = side;
per_frame_9=tk = floor(time*2);
per_frame_10=tick = (abs(tk - ptk) > 0.5);
per_frame_11=ptk = tk;
per_frame_12=q2 = spin;
per_frame_13=q3 = 0.24 - 0.14*side;
per_frame_14=q5 = min(bass_att, 2);
per_frame_15=q6 = -0.62 + 0.1*side;
per_frame_16=ph = (-q6 - spin)/6.28318;
per_frame_17=q7 = ph - floor(ph);
per_frame_18=q8 = 0.05 + 0.9*(q3 - 0.09)/0.16;
per_frame_19=q9 = tick*0.004 + reset;
per_frame_20=q10 = (w/fps)/6.28318;
per_frame_21=q11 = (0.0016 + 0.003*min(vol, 2))/0.16*0.9;
per_frame_22=q12 = bass;
per_frame_23=q13 = mid;
per_frame_24=q14 = treb;
warp_1=`shader_body
warp_2=`{
warp_3=`  // fade steps on a time tick from frame code (q9), so it does not depend on the frame rate
warp_4=`  ret = max(tex2D(sampler_main, uv).xyz - q9, 0.0);
warp_5=`}
comp_1=`float seg(float2 p, float2 a, float2 b)
comp_2=`{
comp_3=`  float2 pa = p - a;
comp_4=`  float2 ba = b - a;
comp_5=`  float k = saturate(dot(pa, ba) / dot(ba, ba));
comp_6=`  return length(pa - ba * k);
comp_7=`}
comp_8=`shader_body
comp_9=`{
comp_10=`  float2 p = (uv - 0.5) * aspect.xy;
comp_11=`  float r = length(p);
comp_12=`  float a = atan2(p.y, p.x);
comp_13=`  float px = 1.0 / texsize.x;
comp_14=`  float3 col = lerp(float3(0.05, 0.045, 0.05), float3(0.1, 0.09, 0.09), uv.y);
comp_15=`  col += tex2D(sampler_noise_hq, float2(uv.x * 3.0, uv.y * 0.05)).x * 0.025;
comp_16=`  float plat = 1.0 - smoothstep(0.268 - px, 0.268 + px, r);
comp_17=`  float3 metal = float3(0.32, 0.32, 0.34) * (0.7 + 0.3 * cos(a * 2.0 + 0.8));
comp_18=`  float dots = step(abs(frac((a - q2 * 0.97) * 28.0 / 6.28318) - 0.5), 0.18) * step(abs(r - 0.26), 0.004);
comp_19=`  metal += float3(1.0, 0.45, 0.2) * dots * (0.25 + 0.9 * q5);
comp_20=`  col = lerp(col, metal, plat);
comp_21=`  float rec = 1.0 - smoothstep(0.252 - px, 0.252 + px, r);
comp_22=`  float groove = 0.5 + 0.5 * sin(r * 2600.0);
comp_23=`  float band = step(0.004, abs(frac(r * 22.0) - 0.5));
comp_24=`  float3 vin = float3(0.018, 0.018, 0.02) + groove * 0.012 * band;
comp_25=`  float sheen = pow(abs(cos(a - 0.7)), 30.0) + pow(abs(cos(a + 2.1)), 60.0) * 0.6;
comp_26=`  float3 rainbow = 0.5 + 0.5 * cos(6.28318 * (float3(0.0, 0.33, 0.67) + r * 9.0));
comp_27=`  vin += sheen * (0.08 + 0.05 * groove) * lerp(float3(1.0, 1.0, 1.0), rainbow, 0.35) * band * step(0.09, r);
comp_28=`  float2 pu = float2(frac((a - q2) * 0.159155), 0.05 + 0.9 * (r - 0.09) / 0.16);
comp_29=`  float3 eng = tex2D(sampler_main, pu).xyz * step(0.09, r);
comp_30=`  vin = lerp(vin, eng * 1.2 + 0.03, saturate(lum(eng) * 6.0)) + GetBlur1(pu) * 0.5 * step(0.09, r);
comp_31=`  col = lerp(col, vin, rec);
comp_32=`  float la = a - q2;
comp_33=`  float lab = 1.0 - smoothstep(0.085 - px, 0.085 + px, r);
comp_34=`  float3 lc = float3(0.82, 0.24, 0.14);
comp_35=`  float txt = step(0.45, tex2D(sampler_noise_lq, float2(floor(frac(la * 0.159155) * 64.0) / 256.0, 0.3)).x) * step(abs(r - 0.047), 0.004);
comp_36=`  lc = lerp(lc, float3(0.95, 0.8, 0.45), txt + step(abs(r - 0.03), 0.0018));
comp_37=`  lc *= 0.8 + 0.2 * step(abs(r - 0.068), 0.003);
comp_38=`  lc = lerp(lc, float3(0.98, 0.92, 0.8), step(abs(r - 0.072), 0.0015 + 0.004 * step(0.7, frac(la * 3.0))));
comp_39=`  lc *= 0.85 + 0.15 * cos(a - 0.7);
comp_40=`  col = lerp(col, lc, lab);
comp_41=`  col = lerp(col, float3(0.75, 0.75, 0.78), 1.0 - smoothstep(0.006 - px, 0.006 + px, r));
comp_42=`  float2 piv = float2(0.33, -0.2);
comp_43=`  float2 sty = q3 * float2(cos(q6), -sin(q6));
comp_44=`  float2 dir = normalize(sty - piv);
comp_45=`  float2 elbow = sty - dir * 0.06 + float2(-dir.y, dir.x) * 0.012;
comp_46=`  float arm = min(seg(p, piv, elbow), seg(p, elbow, sty - dir * 0.012));
comp_47=`  float sh = 1.0 - smoothstep(0.0, 0.02, seg(p - float2(0.006, 0.01), piv, elbow));
comp_48=`  col *= 1.0 - sh * 0.35;
comp_49=`  float3 steel = float3(0.78, 0.8, 0.84) * (0.75 + 0.25 * sin(arm * 900.0));
comp_50=`  col = lerp(col, steel, 1.0 - smoothstep(0.0035 - px, 0.0035 + px, arm));
comp_51=`  float head = seg(p, sty - dir * 0.03, sty);
comp_52=`  col = lerp(col, float3(0.15, 0.15, 0.17), 1.0 - smoothstep(0.009 - px, 0.009 + px, head));
comp_53=`  float pv = length(p - piv);
comp_54=`  col = lerp(col, float3(0.5, 0.5, 0.55) * (0.7 + 0.3 * cos(atan2(p.y - piv.y, p.x - piv.x) - 0.7)), 1.0 - smoothstep(0.03 - px, 0.03 + px, pv));
comp_55=`  col = lerp(col, float3(0.2, 0.2, 0.22), 1.0 - smoothstep(0.012 - px, 0.012 + px, pv));
comp_56=`  float2 v = uv - 0.5;
comp_57=`  col *= 1.0 - dot(v, v) * 0.6;
comp_58=`  ret = 1.0 - exp(-col * 1.4);
comp_59=`}
