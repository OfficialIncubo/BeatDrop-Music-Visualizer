b2x=1.000
b3x=1.000
b1ed=0.250
warp_1=`/*
warp_2=`This shader has been ported to BeatDrop/MilkDrop (HLSL) by Incubo_/Se7enSlasher/DJ XcitMosphere.
warp_3=`Try Spotiamp+: https://github.com/fdeox/spotiamp-plus
warp_4=`*/
warp_5=`
warp_6=`float3 pal(float t, float3 a, float3 b, float3 c, float3 d)
warp_7=`{
warp_8=`    return a + b * cos(6.2831853 * (c * t + d));
warp_9=`}
warp_10=`
warp_11=`shader_body
warp_12=`{
warp_13=`    uv.y = 1.0 - uv.y;
warp_14=`    float2 my_uv = (uv - 0.5) * aspect.xy * 2;
warp_15=`    float r = length(my_uv);
warp_16=`    float a = atan2(my_uv.y, my_uv.x);
warp_17=`
warp_18=`    float n = 3.0 + floor(mid_att * 2);
warp_19=`    float angle = M_PI_2 / n;
warp_20=`    float acc = 0.0;
warp_21=`
warp_22=`    for (int k = 0; k < 6; k++)
warp_23=`    {
warp_24=`        float fk = float(k);
warp_25=`        float scale = frac(time * 0.22 + fk / 6.0);
warp_26=`        float aa = a + time * (0.5 - fk * 0.12) + fk;
warp_27=`        float d = abs(cos(floor(0.5 + aa / angle) * angle - aa) * r - scale * 1.25);
warp_28=`        acc += (1.0 - scale) * (0.004 + bass_att * 0.010) / (d + 0.006);
warp_29=`    }
warp_30=`
warp_31=`    float3 col = pal(frac(0.15 + time * 0.05 + treb_att * 0.2),
warp_32=`                     float3(0.5, 0.5, 0.5),
warp_33=`                     float3(0.5, 0.5, 0.5),
warp_34=`                     float3(1.0, 0.9, 0.75),
warp_35=`                     float3(0.1, 0.3, 0.55));
warp_36=`
warp_37=`    col *= acc * (0.7 + vol_att * 0.9);
warp_38=`
warp_39=`    ret = col;
warp_40=`}
comp_1=`shader_body
comp_2=`{ ret = GetPixel(uv); }
