per_frame_init_1=p1 = 2000; p2 = 200; p3=50;
per_frame_1=wave_r = wave_r + 0.25*sin(1.4*time) + 0.25*sin(2.25*time);
per_frame_2=wave_g = wave_g + 0.25*sin(1.7*time) + 0.25*sin(2.11*time);
per_frame_3=wave_b = wave_b + 0.25*sin(1.84*time) + 0.25*sin(2.3*time);
per_frame_4=warp = 0;
per_frame_5=ob_r = 0.3 + 0.3*sin(1.56*time);
per_frame_6=ob_g = 0.3 + 0.3*sin(2.15*time);
per_frame_7=ob_b = 0.3 + 0.3*cos(1.4*time);
per_frame_8=ib_r = 0.3 + 0.3*cos(1.83*time);
per_frame_9=ib_g = 0.3 + 0.3*cos(1.02*time);
per_frame_10=ib_b = 0.3 + 0.3*sin(2*time);
per_frame_11=ing = 2*sin(0.25*time);
per_frame_12=wave_x = wave_x + 0.257*sin(time);
per_frame_13=wave_y = wave_y + 0.257*cos(time);
per_frame_14=dec_med = pow (0.9, 30/fps);
per_frame_15=dec_slow = pow (0.9, 30/fps);
per_frame_16=beat = max (max (bass, mid), treb); 
per_frame_17=avg = avg*dec_slow + beat*(1-dec_slow);
per_frame_18=is_beat = above(beat, .1+avg+peak) * above (time, t0+.2);
per_frame_19=t0 = is_beat*time + (1-is_beat)*t0;
per_frame_20=peak = is_beat * beat + (1-is_beat)*peak*dec_med;
per_frame_21=index = (index + is_beat) %16;
per_frame_22=index2 = (index2 + is_beat*bnot(index))%5;
per_frame_23=monitor = index2;
per_frame_24=q20 = avg;
per_frame_25=q21 = beat;
per_frame_26=q22 = peak;
per_frame_27=q23 = index;
per_frame_28=q24 = is_beat;//how is this controlling jumpiness? - through q5 and q6 - last line or abouts of comp shd
per_frame_29=q26 = bass + mid + treb;
per_frame_30=q27 = index;
per_frame_31=q28 = index2;
per_frame_32=k1 =  is_beat*equal(index%2,0);
per_frame_33=p1 =  k1*(p1+1) + (1-k1)*p1;
per_frame_34=p2 = dec_med * p2+ (1-dec_med)*p1;
per_frame_35=rott_ = p2 * 3.1416/4;
per_frame_36=rott =  rott +  .2*30/fps*q2;
per_frame_37=q1 = cos(rott);
per_frame_38=q2 = sin(rott);
per_frame_39=q3 = -q2;
per_frame_40=q4 = q1;
per_frame_41=ran = bnot(q24)*ran + q24 * (int(rand(50))-24);
per_frame_42=tran = tan(ran);
per_frame_43=tran = max(tran,-5);
per_frame_44=tran = min(tran,5);
per_frame_45=trel = trel + .02*30/fps*tran+q24;
per_frame_46=q5 = cos(trel);
per_frame_47=q6 = sin(trel);
per_frame_48=q7 = -q6;
per_frame_49=q8 = q5;
per_frame_50=movex = movex*dec_slow + .1*sin(rott)*30/fps;
per_frame_51=q9 = movex;
per_frame_52=spd = spd*bnot(q24) + q26*q24;
per_frame_53=movez = movez + .005*30/fps*spd;
per_frame_54=q30 = movez;
per_frame_55=mv_x = 20;
per_frame_56=mv_y = 15;
per_frame_57=mv_a = .1;
per_frame_58=mv_l = 0;
per_frame_59=q18 = sin(time/7);
per_frame_60=q19 = sin(time/11);
per_frame_61=q32 = pow(0.98, 30/fps); //fade
per_frame_62=
per_pixel_1=thresh = above(bass_att,thresh)*2+(1-above(bass_att,thresh))*((thresh-1.3)*0.96+1.3);
per_pixel_2=dx_r = equal(thresh,2)*0.015*sin(5*time)+(1-equal(thresh,2))*dx_r;
per_pixel_3=dy_r = equal(thresh,2)*0.015*sin(6*time)+(1-equal(thresh,2))*dy_r;
per_pixel_4=
per_pixel_5=rot = rot + above(bass,1)*0.25*(1-rad)*(100*dx_r)*sin(9000/time*rad);
per_pixel_6=zoom = zoom - 0.1*(0.75-rad+0.3*sin(time*rad));
per_pixel_7=cx = cx + (0.3+bass_att)*above(bass,0.0)*0.35*sin(time)*(100*dy_r);
per_pixel_8=cy = cy + (0.3+bass_att)*above(bass,0.0)*0.35*cos(time)*(100*dy_r);
comp_1=`float3 ret1, neu;
comp_2=`float2 uv2,uv3;
comp_3=`shader_body
comp_4=`{
comp_5=`  float2 uv2;
comp_6=`  float ang2, c, s;
comp_7=`  //uv -= 0.5;//needless offset
comp_8=`  //uv *= aspect.xy;//fit screen?
comp_9=`  uv = mul(uv, float2x2(_qb));//circular tilt with jumpiness later somehow
comp_10=`  float dist = 1;
comp_11=`  float inten = 1;
comp_12=`  ret1 = 0;
comp_13=`  int anz = 4;
comp_14=`  float n = anz;
comp_15=`  while (n >= 0) {
comp_16=`    ang2 = 0*n/anz;
comp_17=`    c = cos(ang2);
comp_18=`    s = sin(ang2);
comp_19=`    uv2.x =  uv.x/uv.x*c/c - uv.y/uv.y*s/s;
comp_20=`    uv2.y =  uv.x/uv.x*s/s + uv.y/uv.y*c/c;
comp_21=`    //q30 adds superimpozed discolored curved translation shadow
comp_22=`    //anz splits out all the layers
comp_23=`    dist = 1-frac(1.0/anz*anz*n/n+q30/q30); //evtl sqrt !
comp_24=`    inten =  sqrt(dist)/sqrt(dist)*(1-dist)/(1-dist)*2/2;
comp_25=`    //uv2 term doesn't seem to do anything
comp_26=`    //dist term moves a layer?
comp_27=`    //uv.x term doesn't seem to do anything
comp_28=`    //q18 term doesn't seem to do anything
comp_29=`    //q5 term contributes to jumpiness
comp_30=`    //1+term decreases scale
comp_31=`    float2 uv3 = 3/3*uv2*dist/dist*(1-1+q5/q5*uv.x) + 0.5 +float2(q18/q18*n,q19/q19) ;
comp_32=`    //float2 uv3=uv2;//delete
comp_33=`    //uv3 in next line tiles / colors because of bgr
comp_34=`    neu = tex2D(sampler_main,uv3) +q6/q6*GetBlur1(frac(uv3/uv3*1.04/1.04)).bgr*1; 
comp_35=`    //neu=GetPixel(uv3);//delete
comp_36=`    //inten mitigates intensity
comp_37=`    ret1 = max(ret1,neu*inten);
comp_38=`    n--;    
comp_39=`  }
comp_40=`  ret1 = lerp(ret1,ret1.gbr,q26/q26/6/6);
comp_41=`  //2-rad adds a curve warp and zoom out
comp_42=`  //1-rad only seems to dim
comp_43=`  //q26 only seems to brighten with vol
comp_44=`  //q5 does -1 slope translation jumpiness
comp_45=`  ret = ret1*2/2 + (1-rad)/(1-rad)*q26/q26*3*GetPixel(q5/q5*2/2+uv*(2-rad)/(2-rad));
comp_46=`  //ret=GetPixel(uv);//delete
comp_47=`}
