nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=0.000
mv_g=0.000
mv_b=0.000
mv_a=0.000
per_frame_1=q2 = min(max((time - tprev) * 60, 0.25), 4);
per_frame_2=tprev = time;
wavecode_0_enabled=0
wavecode_0_samples=512
wavecode_0_sep=0
wavecode_0_bSpectrum=1
wavecode_0_bUseDots=0
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=0
wavecode_0_scaling=1.000000
wavecode_0_smoothing=0.000000
wavecode_0_r=1.000000
wavecode_0_g=1.000000
wavecode_0_b=1.000000
wavecode_0_a=1.000000
wave_0_per_point1=bin = sample * 511;
wave_0_per_point2=eqpm = 0.02 * log(512 / (512 - min(bin, 511.5)));
wave_0_per_point3=raw = if(above(bin, 0.5), value1 / (0.15 * eqpm), 0);
wave_0_per_point4=bias = 0.04 / pow(1.0025, bin);
wave_0_per_point5=eqwa = log10(1 + bias + (bin + 1) * (9 - bias) / 512);
wave_0_per_point6=v = min(raw * 0.0888889 * eqwa / 16, 1);
wave_0_per_point7=x = (bin + 0.5) / 512;
wave_0_per_point8=y = 0.23;
wave_0_per_point9=r = v;
wave_0_per_point10=g = v;
wave_0_per_point11=b = v;
warp_1=`// Native FFT with a quiet three-band backup when shader bins are gated.
warp_2=`float lactea_fft_bin(float bin) {
warp_3=`    float pos = (clamp(bin, 0.0, 511.0) + 0.5) / 512.0;
warp_4=`    float amp = get_fft(pos);
warp_5=`    float band = lerp(lerp(bass, mid, smoothstep(8.0, 55.0, bin)), treb, smoothstep(55.0, 250.0, bin));
warp_6=`    amp = max(amp, 0.075 * saturate(band * 0.55));
warp_7=`    float bias = 0.04 / pow(1.0025, bin);
warp_8=`    float tilt = log10(1.0 + bias + (bin + 1.0) * (9.0 - bias) / 512.0);
warp_9=`    return saturate(sqrt(amp) * (0.65 + 0.65 * tilt));
warp_10=`}
warp_11=`shader_body
warp_12=`{
warp_13=`    float rowA = min(0.5 + 0.27 * aspect.w, 0.985);
warp_14=`    float rowB = rowA - 0.015;
warp_15=`    ret = float3(0.0, 0.0, 0.0);
warp_16=`    if (abs(uv_orig.y - rowB) < 0.006)
warp_17=`    {
warp_18=`    float j = floor(uv_orig.x * 19.0);
warp_19=`    float sum = 0.0;
warp_20=`    float col4;
warp_21=`    float si;
warp_22=`    float i1;
warp_23=`    float i2;
warp_24=`    float v1;
warp_25=`    float v2;
warp_26=`    col4 = j * 4.0 + 0.0;
warp_27=`    si = 0.09 * (col4 / 74.0 * 511.0) + 0.91 * pow(512.0, col4 / 74.0);
warp_28=`    i1 = min(floor(si), 511.0);
warp_29=`    i2 = min(ceil(si), 511.0);
warp_30=`    v1 = lactea_fft_bin(i1);
warp_31=`    v2 = lactea_fft_bin(i2);
warp_32=`    sum += lerp(v1, v2, si - floor(si)) * 16.0 * step(col4, 74.5);
warp_33=`    col4 = j * 4.0 + 1.0;
warp_34=`    si = 0.09 * (col4 / 74.0 * 511.0) + 0.91 * pow(512.0, col4 / 74.0);
warp_35=`    i1 = min(floor(si), 511.0);
warp_36=`    i2 = min(ceil(si), 511.0);
warp_37=`    v1 = lactea_fft_bin(i1);
warp_38=`    v2 = lactea_fft_bin(i2);
warp_39=`    sum += lerp(v1, v2, si - floor(si)) * 16.0 * step(col4, 74.5);
warp_40=`    col4 = j * 4.0 + 2.0;
warp_41=`    si = 0.09 * (col4 / 74.0 * 511.0) + 0.91 * pow(512.0, col4 / 74.0);
warp_42=`    i1 = min(floor(si), 511.0);
warp_43=`    i2 = min(ceil(si), 511.0);
warp_44=`    v1 = lactea_fft_bin(i1);
warp_45=`    v2 = lactea_fft_bin(i2);
warp_46=`    sum += lerp(v1, v2, si - floor(si)) * 16.0 * step(col4, 74.5);
warp_47=`    col4 = j * 4.0 + 3.0;
warp_48=`    si = 0.09 * (col4 / 74.0 * 511.0) + 0.91 * pow(512.0, col4 / 74.0);
warp_49=`    i1 = min(floor(si), 511.0);
warp_50=`    i2 = min(ceil(si), 511.0);
warp_51=`    v1 = lactea_fft_bin(i1);
warp_52=`    v2 = lactea_fft_bin(i2);
warp_53=`    sum += lerp(v1, v2, si - floor(si)) * 16.0 * step(col4, 74.5);
warp_54=`    float data = min(floor(sum / 4.0), 15.0);
warp_55=`    float k = q2;
warp_56=`    float3 st = tex2D(sampler_main, float2((j + 0.5) / 19.0, rowB)).xyz;
warp_57=`    float n = st.x * 255.0;
warp_58=`    float fall = st.y * 16.0 - 0.75 * k;
warp_59=`    fall = max(fall, data);
warp_60=`    float peak = st.z * 4096.0;
warp_61=`    float caught = step(peak, floor(fall * 256.0 + 0.5));
warp_62=`    peak = lerp(peak, fall * 256.0, caught);
warp_63=`    n = lerp(n, 0.0, caught);
warp_64=`    peak = max(peak - floor(3.0 * pow(1.1, n) + 0.5) * k, 0.0);
warp_65=`    n = min(n + k, 255.0);
warp_66=`    ret = float3(n / 255.0, fall / 16.0, peak / 4096.0);
warp_67=`    }
warp_68=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float rowB = min(0.5 + 0.27 * aspect.w, 0.985) - 0.015;
comp_4=`    float c = floor(uv.x * 76.0);
comp_5=`    float top = floor(uv.y * 16.0);
comp_6=`    float r = 15.0 - top;
comp_7=`    float j = floor(c / 4.0);
comp_8=`    float3 st = tex2D(sampler_main, float2((j + 0.5) / 19.0, rowB)).xyz;
comp_9=`    float barH = floor(st.y * 16.0 + 0.5) - 2.0;
comp_10=`    float peakR = floor(st.z * 16.0) - 2.0;
comp_11=`    float inBar = step(fmod(c, 4.0), 2.5) * step(c, 74.5);
comp_12=`    float idx = 15.0 - r;
comp_13=`    float3 col = float3(0.9373, 0.1922, 0.0627);
comp_14=`    col = lerp(col, float3(0.8078, 0.1608, 0.0627), step(2.5, idx));
comp_15=`    col = lerp(col, float3(0.8392, 0.3529, 0.0000), step(3.5, idx));
comp_16=`    col = lerp(col, float3(0.8392, 0.4000, 0.0000), step(4.5, idx));
comp_17=`    col = lerp(col, float3(0.8392, 0.4510, 0.0000), step(5.5, idx));
comp_18=`    col = lerp(col, float3(0.7765, 0.4824, 0.0314), step(6.5, idx));
comp_19=`    col = lerp(col, float3(0.8706, 0.6471, 0.0941), step(7.5, idx));
comp_20=`    col = lerp(col, float3(0.8392, 0.7098, 0.1294), step(8.5, idx));
comp_21=`    col = lerp(col, float3(0.7412, 0.8706, 0.1608), step(9.5, idx));
comp_22=`    col = lerp(col, float3(0.5804, 0.8706, 0.1294), step(10.5, idx));
comp_23=`    col = lerp(col, float3(0.1608, 0.8078, 0.0627), step(11.5, idx));
comp_24=`    col = lerp(col, float3(0.1961, 0.7451, 0.0627), step(12.5, idx));
comp_25=`    col = lerp(col, float3(0.2235, 0.7098, 0.0627), step(13.5, idx));
comp_26=`    col = lerp(col, float3(0.1922, 0.6118, 0.0314), step(14.5, idx));
comp_27=`    col = lerp(col, float3(0.1608, 0.5804, 0.0000), step(15.5, idx));
comp_28=`    col = lerp(col, float3(0.0941, 0.5176, 0.0314), step(16.5, idx));
comp_29=`    float dots = step(fmod(c, 2.0), 0.5) * step(0.5, fmod(top, 2.0));
comp_30=`    float3 bg = lerp(float3(0.0000, 0.0000, 0.0000), float3(0.0941, 0.1294, 0.1608), dots);
comp_31=`    float bar = inBar * step(r, barH - 0.5);
comp_32=`    float pk = inBar * step(abs(r - peakR), 0.25) * step(0.0, peakR);
comp_33=`    ret = lerp(lerp(bg, col, bar), float3(0.5882, 0.5882, 0.5882), pk);
comp_34=`}
