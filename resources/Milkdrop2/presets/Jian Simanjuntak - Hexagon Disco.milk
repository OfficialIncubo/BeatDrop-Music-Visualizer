shapecode_3_border_g=0.700
shapecode_3_border_b=0.500
shapecode_3_border_a=0.000
shape_3_per_frame1=// Menentukan bentuk poligon
shape_3_per_frame2=sides = 6;
shape_3_per_frame3=
shape_3_per_frame4=// Membuat bentuk bergerak memantul ke kiri-kanan dan atas-bawah mengikuti waktu
shape_3_per_frame5=x = 0.5 + 0.17 * sin(time * 2.5);
shape_3_per_frame6=y = 0.5 + 0.1 * cos(time * 1.5) + (bass * 0.05);
shape_3_per_frame7=
shape_3_per_frame8=// Membuat ukuran bentuk membesar setiap kali ada hentakan treble
shape_3_per_frame9=rad = 0.25;
shape_3_per_frame10=
shape_3_per_frame11=// Membuat bentuk berputar secara dinamis merespons frekuensi 'mid'
shape_3_per_frame12=ang = ang + 0.2 * mid;
shape_3_per_frame13=
shape_3_per_frame14=// Warna acak
shape_3_per_frame15=r = q1;
shape_3_per_frame16=g = q2;
shape_3_per_frame17=b = q3;
shape_3_per_frame18=r2 = q1;
shape_3_per_frame19=g2 = q2;
shape_3_per_frame20=b2 = q3;
per_frame_1=// *************** SHAPECODE PER_FRAME ***************
per_frame_2=
per_frame_3=// ------ BAGIAN 1
per_frame_4=// Membuat variabel kustom untuk warna
per_frame_5=my_red = (bass / 1.3);
per_frame_6=my_green = (mid / 1.3);
per_frame_7=my_blue = (treb / 1.3);
per_frame_8=
per_frame_9=// Mengaplikasikan variabel kustom ke gelombang suara
per_frame_10=q1 = my_red;
per_frame_11=q2 = my_green;
per_frame_12=q3 = my_blue;
per_frame_13=
per_frame_14=// ------ BAGIAN 2
per_frame_15=q4 = 0.415; // Memperbesar 
per_frame_16=q5 = 100; // Memperbentuk
per_frame_17=
per_frame_18=// Kecepatan rotasi betuk
per_frame_19=q6 = -4; // ------------------------------- Bentuk pertama
per_frame_20=q7 = 4; // ------------------------------- Bentuk kedua
per_frame_21=q8 = 4; // ------------------------------- Bentuk ketiga
per_frame_22=q9 = -4; // ------------------------------- Bentuk Keempat
per_frame_23=
per_frame_24=// *************** SETELAN DARI PER_VERTEX ***************
per_frame_25=q10 = 0.052; // Piksel X
per_frame_26=q11 = 0.053; // Piksel Y
per_pixel_1=// Menghitung koordinat dasar yang disesuaikan dengan ukuran piksel layar
per_pixel_2=zz_x = x * pixelsx * q10;
per_pixel_3=zz_y = y * pixelsy * q11;
per_pixel_4=
per_pixel_5=// Menghitung faktor distorsi menggunakan gelombang trigonometri dan variabel Q
per_pixel_6=h1 = cos(zz_y * 0.8) * sin(-zz_y);
per_pixel_7=h2 = sin(zz_x) * cos(zz_y * 0.9);
per_pixel_8=
per_pixel_9=// Mengaplikasikan pergerakan ke variabel dx dan dy
per_pixel_10=// Dibagi dengan pixelsx dan pixelsy sebagai ekuivalen dari texsize.zw (1/texsize.xy)
per_pixel_11=dx = (h1 * 5) / pixelsx;
per_pixel_12=dy = (h2 * 5) / pixelsy;
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame
warp_4=`   float3 pre = tex2D( sampler_main, uv_orig);
warp_5=`   float3 warped = tex2D( sampler_main, uv -floor(uv));
warp_6=`    
warp_7=`  ret = lerp( pre, warped, 0.5);
warp_8=`    // darken (decay) over time
warp_9=`    ret *= 0.98; //or try: ret -= 0.004;
warp_10=`}
comp_1=`//shining shader by martin
comp_2=`
comp_3=`#define sat saturate
comp_4=`float z, z0, radi;
comp_5=`float2 uv1, uv2, uva, dz;
comp_6=`static const int anz = 95;
comp_7=`static float beat = (q5 + q6 + q7)/3;
comp_8=`static const float2 hor = texsize.zw*float2(1,0);
comp_9=`static const float2 ver = texsize.zw*float2(1,0).yx;
comp_10=`float3 Get1 (float2 uvi, float par)
comp_11=`{return lerp(GetBlur1(uvi), GetPixel(uvi), 0*saturate(par/2))*par;}
comp_12=`
comp_13=`shader_body {
comp_14=`float sunx =  q31*0.5 +0.55, suny = q32*0.5 + 0.34;
comp_15=`//if(sqrt(pow(uv.x - q31*0.5 -0.55 ,2) + pow(uv.y-q32*0.5 - 0.34,2))<0.05) {ret = 1;}
comp_16=`float2 sunpos = float2(0.5,0.5);
comp_17=`uva = (uv-0.5)*aspect.xy+0.5;
comp_18=`float sun = (.01 / length (uva-sunpos));
comp_19=`
comp_20=`dz.x = lum(GetPixel(uv-hor)) - lum(GetPixel(uv+hor));
comp_21=`dz.y = lum(GetPixel(uv-ver)) - lum(GetPixel(uv+ver));
comp_22=`
comp_23=`float3 shine = GetPixel(uv); 
comp_24=`
comp_25=`radi = 1;
comp_26=`for (int n=1; n <= anz; n++)
comp_27=`{
comp_28=`  shine += (1 + 2*q2)/anz*Get1((uv-sunpos)*radi+sunpos,radi);
comp_29=`  radi -= 0.75/anz;;
comp_30=`}
comp_31=`ret += max(shine,0*GetPixel(uv));
comp_32=`//ret = shine+GetPixel(uv);
comp_33=`
comp_34=`}
