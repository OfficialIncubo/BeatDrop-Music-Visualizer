shape_0_per_frame5=    (equal(instance, 3) * 0.150);
shape_0_per_frame6=
shape_0_per_frame7=// Mengatur posisi Y untuk keempat bentuk
shape_0_per_frame8=y = (equal(instance, 0) * 0.720) + 
shape_0_per_frame9=    (equal(instance, 1) * 0.300) + 
shape_0_per_frame10=    (equal(instance, 2) * 0.720) + 
shape_0_per_frame11=    (equal(instance, 3) * 0.300);
shape_0_per_frame12=
shape_0_per_frame13=// Mengatur rotasi yang berbeda untuk setiap putaran bentuk
shape_0_per_frame14=ang = (equal(instance, 0) * (ang + (time * q6))) + 
shape_0_per_frame15=      (equal(instance, 1) * (ang + (time * q7))) + 
shape_0_per_frame16=      (equal(instance, 2) * (ang + (time * q8))) + 
shape_0_per_frame17=      (equal(instance, 3) * (ang + (time * q9)));
shape_0_per_frame18=
