comp_2=`{
comp_3=`    float2 uv_echo = (uv - 0.5)*0.993*float2(-1,1) + 0.5;
comp_4=`    ret = tex2D(sampler_main, uv).xyz; 
comp_5=`    ret *= 2.00; //gamma
comp_6=`    ret =  sqrt(ret); //brighten
comp_7=`    ret =   1-ret*(1-ret)*4;
comp_8=`}
