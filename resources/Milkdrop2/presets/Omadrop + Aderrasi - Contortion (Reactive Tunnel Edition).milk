per_frame_1=q25=min(max((bass-bass_att)*1.85,0),1.50);
per_frame_2=q26=min(max((mid-mid_att)*1.65,0),1.35);
per_frame_3=q27=min(max((treb-treb_att)*1.80,0),1.35);
per_frame_4=q28=min(max((bass_att-0.78)*1.15,0),1.25);
per_frame_5=q29=max(q25,q29*0.70);
per_frame_6=q30=max(q26,q30*0.62);
per_frame_7=q31=max(q27,q31*0.42);
per_frame_8=q32=min(max((bass_att+mid_att+treb_att)/3-0.72,0),1.20);
per_frame_9=wave_r=0.42+0.22*sin(1.4*time)+0.30*q29;
per_frame_10=wave_g=0.42+0.22*sin(1.7*time)+0.26*q30;
per_frame_11=wave_b=0.46+0.22*sin(1.84*time)+0.34*q31;
per_frame_12=warp=0;
per_frame_13=ob_r=0.22+0.22*sin(1.56*time)+0.36*q29;
per_frame_14=ob_g=0.22+0.22*sin(2.15*time)+0.30*q30;
per_frame_15=ob_b=0.24+0.22*cos(1.4*time)+0.38*q31;
per_frame_16=ing=2*sin(0.25*time);
per_frame_17=wave_x=0.5+0.0257*sin(time)+0.028*q30*sin(2.3*time);
per_frame_18=wave_y=0.5+0.0257*cos(time)+0.022*q31*cos(3.1*time);
per_frame_19=wave_scale=2.85+0.46*q29+0.22*q32;
per_frame_20=wave_a=0.58+0.22*q30+0.20*q31;
per_frame_21=ob_size=0.006+0.016*q29+0.006*q32;
per_frame_22=ib_size=0.004+0.010*q30;
per_pixel_1=thresh=above(bass_att,thresh)*2+(1-above(bass_att,thresh))*((thresh-1.3)*0.96+1.3);
per_pixel_2=dx_r=equal(thresh,2)*0.015*sin(5*time)+(1-equal(thresh,2))*dx_r;
per_pixel_3=dy_r=equal(thresh,2)*0.015*sin(6*time)+(1-equal(thresh,2))*dy_r;
per_pixel_4=reactive_depth=q29*(0.105+0.155*(1-rad))+q28*0.032*(0.72-rad);
per_pixel_5=reactive_turn=q30*0.082*(1-rad)*sin(2*ang)+q31*0.016*sin(14*ang+5*time);
per_pixel_6=rot=rot+above(bass,1)*0.18*(1-rad)*(100*dx_r)+reactive_turn;
per_pixel_7=zoom=zoom+0.2*(0.5-rad)+reactive_depth;
per_pixel_8=cx=cx+q30*0.042*sin(ang*2+time)*(1-rad)+q31*0.010*sin(9*ang);
per_pixel_9=cy=cy+q30*0.042*cos(ang*2-time)*(1-rad)+q31*0.010*cos(11*ang);
per_pixel_10=dy=dy-dy_r+q31*0.006*sin(18*ang+7*time)*(1-rad);
per_pixel_11=dx=dx-dx_r+q31*0.006*cos(16*ang-6*time)*(1-rad);
